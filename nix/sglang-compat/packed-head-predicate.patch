+        from sglang.srt.layers.quantization.compressed_tensors.schemes.compressed_tensors_wNa16 import (
+            CompressedTensorsWNA16,
+        )
+
+        scheme = getattr(lm_head, "scheme", None)
+        if not isinstance(quant_method, CompressedTensorsLinearMethod) or not isinstance(
+            scheme, CompressedTensorsWNA16
+        ):
+            return False
