+            or weight.ndim != 2
+            or weight.numel() == 0
+            or not weight.is_contiguous()
+            or weight.device.type != "cuda"
+            or scale.dtype not in (torch.float16, torch.bfloat16)
+            or scale.ndim != 2
+            or scale.numel() == 0
+            or not scale.is_contiguous()
+            or scale.device != weight.device
+            or workspace.dtype != torch.int32
+            or workspace.ndim != 1
+            or workspace.numel() == 0
+            or workspace.device != weight.device
+            or not isinstance(getattr(scheme, "is_k_full", None), bool)
+        ):
+            return False
+        for attr_name in ("weight_zero_point", "weight_g_idx", "g_idx_sort_indices"):
+            parameter = getattr(lm_head, attr_name, None)
+            if not (
+                isinstance(parameter, torch.Tensor)
+                and parameter.dtype == torch.int32
+                and parameter.device == weight.device
+                and parameter.is_contiguous()
+            ):
+                return False
+        return True
 
