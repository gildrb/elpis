+"""Isolated TP1 W8 embedding candidate. Not production-qualified."""
+
+import torch
+from torch import nn
+
+
+class PackedW8Embedding(nn.Module):
+    """No dense .weight API; one immutable initial checkpoint load only."""
+
+    def __init__(self):
+        super().__init__()
+        if torch.get_default_dtype() != torch.bfloat16:
+            raise ValueError("Packed embedding requires BF16 model dtype")
+        self.num_embeddings = 248320
+        self.embedding_dim = 5120
+        self.weight_packed = nn.Parameter(
+            torch.empty((248320, 1280), dtype=torch.int32), requires_grad=False
+        )
+        self.weight_scale = nn.Parameter(
+            torch.empty((248320, 40), dtype=torch.bfloat16), requires_grad=False
+        )
+        self.weight_shape = nn.Parameter(
+            torch.empty((2,), dtype=torch.int64), requires_grad=False
+        )
+        self._loaded: set[str] = set()
+        self._ready = False
+
+    def load_tensor(self, name: str, value: torch.Tensor) -> None:
+        if self._ready or name in self._loaded:
+            raise ValueError("Reload or duplicate embedding tensor")
+        expected = {
+            "weight_packed": ((248320, 1280), torch.int32),
+            "weight_scale": ((248320, 40), torch.bfloat16),
+            "weight_shape": ((2,), torch.int64),
+        }
+        if name not in expected:
+            raise ValueError("Unexpected embedding tensor")
+        shape, dtype = expected[name]
+        if tuple(value.shape) != shape or value.dtype != dtype:
+            raise ValueError("Embedding tensor shape/dtype mismatch")
+        if name == "weight_shape" and value.tolist() != [248320, 5120]:
+            raise ValueError("Embedding logical shape mismatch")
+        if name == "weight_scale":
+            if not torch.isfinite(value).all().item() or not (value > 0).all().item():
+                raise ValueError("Invalid embedding scales")
+        with torch.no_grad():
+            self.get_parameter(name).copy_(value)
+        self._loaded.add(name)
+
+    def finish_loading(self) -> None:
+        if self._ready or self._loaded != {"weight_packed", "weight_scale", "weight_shape"}:
+            raise ValueError("Incomplete or repeated embedding load")
+        self._ready = True
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        if not self._ready:
+            raise RuntimeError("Embedding load has not completed")
+        if input_ids.dtype not in (torch.int32, torch.int64):
+            raise ValueError("Token IDs must be int32 or int64")
+        if input_ids.device != self.weight_packed.device:
+            raise ValueError("Token IDs and embedding must share a device")
+        # index_select checks token bounds, unlike a hand-written unchecked gather.
+        ids = input_ids.reshape(-1)
+        packed = self.weight_packed.index_select(0, ids)
+        scales = self.weight_scale.index_select(0, ids)
+        # Explicit FP32 product and BF16 rounding reproduce convert-embedding.py.
+        shifts = torch.arange(4, device=ids.device, dtype=torch.int32) * 8
+        values = ((packed.unsqueeze(-1) >> shifts) & 255).to(torch.float32) - 128
+        values = values.reshape(-1, 40, 128) * scales.float().unsqueeze(-1)
+        return values.to(torch.bfloat16).reshape(*input_ids.shape, 5120)
