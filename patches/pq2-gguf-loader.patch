diff --git a/python/sglang/srt/model_loader/gguf_name_maps.py b/python/sglang/srt/model_loader/gguf_name_maps.py
index 434f337..4f21959 100644
--- a/python/sglang/srt/model_loader/gguf_name_maps.py
+++ b/python/sglang/srt/model_loader/gguf_name_maps.py
@@ -67,6 +67,81 @@ def build_muse_glimmer_name_map(config: PretrainedConfig) -> Dict[str, str]:
 # Keyed by HF ``config.model_type`` (loader.py looks it up with that), which is
 # not the GGUF ``general.architecture`` that GGUF_NATIVE_CONFIG_BUILDERS uses:
 # llama.cpp spells the arch "muse-glimmer" while the HF config says "muse_glimmer".
+# Qwen3.5 (hybrid gated-delta-net + gated full attention) packed by PrismML
+# llama.cpp as arch "qwen35" (HF model_type "qwen3_5"). Layer kinds alternate
+# with the same (i + 1) % full_attention_interval convention llama.cpp uses:
+# a layer is linear/GDN unless it is the last of each interval block.
+_QWEN35_GLOBAL_TENSORS = {
+    "token_embd": "model.embed_tokens",
+    "output_norm": "model.norm",
+    "output": "lm_head",
+}
+
+_QWEN35_LINEAR_TENSORS = {
+    "attn_qkv": "linear_attn.in_proj_qkv",
+    "attn_gate": "linear_attn.in_proj_z",
+    "ssm_conv1d": "linear_attn.conv1d",
+    "ssm_out": "linear_attn.out_proj",
+    "ssm_norm": "linear_attn.norm",
+}
+
+# In-projections that the checkpoint stores fused but HF splits; shard routing
+# (shard ids (0, 1, 2) / 0 / 1) is Qwen3_5ForCausalLM.load_weights' job.
+_QWEN35_SSM_PROJECTIONS = {
+    "ssm_beta": "linear_attn.in_proj_b",
+    "ssm_alpha": "linear_attn.in_proj_a",
+}
+
+_QWEN35_FULL_TENSORS = {
+    # PrismML names the fused per-head [query, gate] projection attn_q on full
+    # attention layers; this matches the HF q_proj layout (24 heads x
+    # [256 query, 256 gate]) that routes to the "q" shard of qkv_proj.
+    "attn_q": "self_attn.q_proj",
+    "attn_k": "self_attn.k_proj",
+    "attn_v": "self_attn.v_proj",
+    "attn_q_norm": "self_attn.q_norm",
+    "attn_k_norm": "self_attn.k_norm",
+    "attn_output": "self_attn.o_proj",
+}
+
+_QWEN35_SCALAR_TENSORS = {
+    "ssm_dt.bias": "linear_attn.dt_bias",
+    "ssm_a": "linear_attn.A_log",
+}
+
+
+def build_qwen35_name_map(config: PretrainedConfig) -> Dict[str, str]:
+    interval = getattr(config, "full_attention_interval", 4) or 4
+    num_layers = config.num_hidden_layers
+    name_map = {
+        f"{gguf}.weight": f"{hf}.weight"
+        for gguf, hf in _QWEN35_GLOBAL_TENSORS.items()
+    }
+    for layer in range(num_layers):
+        prefix = f"model.layers.{layer}."
+        block = f"blk.{layer}."
+        is_linear = (layer + 1) % interval != 0
+        table = _QWEN35_LINEAR_TENSORS if is_linear else _QWEN35_FULL_TENSORS
+        for gguf, hf in table.items():
+            name_map[f"{block}{gguf}.weight"] = f"{prefix}{hf}.weight"
+        if is_linear:
+            for gguf, hf in _QWEN35_SSM_PROJECTIONS.items():
+                name_map[f"{block}{gguf}.weight"] = f"{prefix}{hf}.weight"
+            for gguf, hf in _QWEN35_SCALAR_TENSORS.items():
+                name_map[f"{block}{gguf}"] = f"{prefix}{hf}"
+        name_map[f"{block}attn_norm.weight"] = f"{prefix}input_layernorm.weight"
+        name_map[f"{block}post_attention_norm.weight"] = (
+            f"{prefix}post_attention_layernorm.weight"
+        )
+        name_map[f"{block}ffn_gate.weight"] = f"{prefix}mlp.gate_proj.weight"
+        name_map[f"{block}ffn_up.weight"] = f"{prefix}mlp.up_proj.weight"
+        name_map[f"{block}ffn_down.weight"] = f"{prefix}mlp.down_proj.weight"
+    return name_map
+
+
 GGUF_HF_NAME_MAP_BUILDERS: Dict[str, Callable[[PretrainedConfig], Dict[str, str]]] = {
     "muse_glimmer": build_muse_glimmer_name_map,
+    "qwen3_5": build_qwen35_name_map,
+    # The text-only serving wrapper uses the Qwen3_5TextConfig model_type.
+    "qwen3_5_text": build_qwen35_name_map,
 }
