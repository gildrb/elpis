diff --git a/python/sglang/srt/model_loader/weight_utils.py b/python/sglang/srt/model_loader/weight_utils.py
index 965123f..365e3d1 100644
--- a/python/sglang/srt/model_loader/weight_utils.py
+++ b/python/sglang/srt/model_loader/weight_utils.py
@@ -1371,6 +1371,98 @@ def get_gguf_extra_tensor_names(
     return [gguf_to_hf_name_map[key] for key in extra_keys]
 
 
+def _gdn_v_head_index() -> "torch.Tensor":
+    """Source index for the GGML rep-major v-head order -> SGLang k-group-major."""
+    import numpy as _np
+    idx = _np.empty(48, dtype=_np.int64)
+    for h_f in range(48):
+        g, r = h_f // 3, h_f % 3
+        idx[h_f] = r * 16 + g
+    return torch.from_numpy(idx)
+
+
+def _apply_gguf_value_transform(
+    hf_name: str, weight_type, weight
+) -> torch.Tensor:
+    """Value-level fixes for GGUF checkpoints that store derived forms.
+
+    The PrismML qwen35 GGUF stores the decoded GDN decay ``ssm_a`` (always
+    negative) where HF carries ``A_log``; and conv1d as a 2-D
+    [conv_dim, kernel] matrix where the SGLang parameter is pre-unsqueezed
+    to [conv_dim, 1, kernel]. Everything else passes through unchanged.
+    """
+    if weight_type.name == "BF16":
+        # gguf-py hands BF16 tensors over as raw little-endian bytes; the
+        # values must be bit-reinterpreted, never numerically cast. BF16
+        # tensors still need the GDN v-head reorder below (in_proj_b/a).
+        raw = torch.tensor(weight)
+        if raw.shape[-1] % 2 != 0:
+            raise ValueError(f"GGUF {hf_name}: odd BF16 byte count")
+        tensor = raw.view(torch.bfloat16)
+    else:
+        tensor = torch.tensor(weight)
+    # Quantized tensors are renamed to .qweight before this call; match on
+    # the logical parameter name so PQ2 rows get the same fixes as F32.
+    match_name = hf_name.replace(".qweight", ".weight")
+    if match_name.endswith("linear_attn.A_log"):
+        values = tensor.to(torch.float32)
+        if bool((values >= 0).any()):
+            raise ValueError(
+                f"GGUF {hf_name}: ssm_a must be negative decay values, "
+                f"min={values.min().item()}"
+            )
+        return torch.log(-values)
+    # GDN v-head reordering: the GGUF stores the 48 v-heads in the llama.cpp
+    # tiling (head = rep*16 + k_group, i.e. rep-major), while SGLang's GDN
+    # groups v-heads k-group-major (head = k_group*3 + rep). Verified against
+    # the retained checkpoint for the conv channels, z rows and per-head
+    # vectors; without the reorder the delta rule mixes head groups.
+    _GDN_V_PERM_SUFFIXES = (
+        "linear_attn.in_proj_z.weight",
+        "linear_attn.in_proj_b.weight",
+        "linear_attn.in_proj_a.weight",
+        "linear_attn.conv1d.weight",
+        "linear_attn.dt_bias",
+    )
+    if match_name.endswith("linear_attn.in_proj_qkv.weight"):
+        q_part = tensor[:2048]
+        k_part = tensor[2048:4096]
+        v_part = tensor[4096:].reshape(48, 128, *tensor.shape[1:])[_gdn_v_head_index()]
+        return torch.cat([q_part, k_part, v_part.reshape(6144, *tensor.shape[1:])], dim=0)
+    if any(match_name.endswith(s) for s in _GDN_V_PERM_SUFFIXES):
+        if match_name.endswith("linear_attn.conv1d.weight"):
+            # tensor arrives as [conv_dim, kernel]; the serving parameter is
+            # [conv_dim, 1, kernel].
+            head_view = tensor.reshape(80, 128, tensor.shape[-1])
+            head_view = torch.cat([head_view[:32], head_view[32:][_gdn_v_head_index()]], dim=0)
+            return head_view.reshape(tensor.shape[0], 1, tensor.shape[1])
+        if match_name.endswith("linear_attn.in_proj_z.weight"):
+            return tensor.reshape(48, 128, *tensor.shape[1:])[_gdn_v_head_index()].reshape(6144, *tensor.shape[1:])
+        return tensor[_gdn_v_head_index()]
+    # The PrismML GGUF stores Gemma-style RMSNorm weights pre-offset by 1
+    # (llama.cpp convention: the graph computes x/rms * w_gguf, the HF model
+    # computes x/rms * (1 + w_hf)); SGLang's RMSNorm is x/rms * w, so the
+    # offset must be removed. The GDN ssm_norm is stored verbatim (verified
+    # against the retained checkpoint) and must not be touched.
+    _GEMMA_OFFSET_NORM_SUFFIXES = (
+        "input_layernorm.weight",
+        "post_attention_layernorm.weight",
+        "self_attn.q_norm.weight",
+        "self_attn.k_norm.weight",
+    )
+    if match_name == "model.norm.weight" or any(
+        match_name.endswith(suffix) for suffix in _GEMMA_OFFSET_NORM_SUFFIXES
+    ):
+        return tensor.to(torch.float32) - 1.0
+    if (
+        match_name.endswith("linear_attn.conv1d.weight")
+        and tensor.ndim == 2
+        and weight_type.name == "F32"
+    ):
+        return tensor.reshape(tensor.shape[0], 1, tensor.shape[1])
+    return tensor
+
+
 def gguf_quant_weights_iterator(
     gguf_file: str, gguf_to_hf_name_map: Dict[str, str]
 ) -> Generator[Tuple[str, torch.Tensor], None, None]:
@@ -1436,6 +1527,9 @@ def gguf_quant_weights_iterator(
         is_moe_weight = any(
             pattern in tensor_name for pattern in MOE_WEIGHT_PATTERNS.keys()
         )
+        _gguf_hf_name = (
+            gguf_to_hf_name_map.get(tensor_name) if not is_moe_weight else None
+        )
 
         if is_moe_weight:
             # MoE weights: split packed format into individual expert weights
@@ -1465,7 +1559,7 @@ def gguf_quant_weights_iterator(
 
             if weight_type.name != "F32":
                 name = name.replace("weight", "qweight")
-            param = torch.tensor(weight)
+            param = _apply_gguf_value_transform(name, weight_type, weight)
             yield name, param
 
 
