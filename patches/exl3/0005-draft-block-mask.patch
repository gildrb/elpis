 # TODO: Support DFlash models trained in Speculators (includes lm_head for speculator with limited vocabulary?)
 
+# DFlash2 draft attention mask (elpis patch 0005-draft-block-mask). The reference drafter
+# (z-lab dflash/model.py, _attention_mask) lets key k be seen by query q iff q - k < W and, for a
+# non-causal checkpoint (config is_causal false), k - q < W; a causal one (is_causal true, or
+# absent on a sliding_attention layer) adds k <= q. The paged kernels keep key n for query q iff
+# n >= q - left and (right < 0 or n <= q + right), so the reference mask is exactly (W - 1, W - 1)
+# or, causal, (W - 1, 0). EXL3_DFLASH2_WINDOW overrides W; every other combination fails closed.
+DFLASH2_ARCH = "DFlash2DraftModel"
+DFLASH2_WINDOW_ENV = "EXL3_DFLASH2_WINDOW"
+DFLASH2_WINDOW_MAX = 1 << 30
+
+
+def dflash2_kernel_window(window: int, is_causal: bool | None, layer_types: list) -> tuple[int, int]:
+    kinds = set(layer_types)
+    if not kinds <= {"sliding_attention", "full_attention"}:
+        raise ValueError(f"DFlash2: unsupported layer_types {sorted(kinds)}")
+    if "full_attention" in kinds and is_causal:
+        raise ValueError("DFlash2: causal full_attention layers are not expressible (the engine runs them bidirectional)")
+    raw = os.environ.get(DFLASH2_WINDOW_ENV)
+    if raw is not None:
+        if "sliding_attention" not in kinds:
+            raise ValueError(f"{DFLASH2_WINDOW_ENV} is set but the draft has no sliding_attention layer")
+        if re.fullmatch(r"[1-9][0-9]*", raw) is None:
+            raise ValueError(f"{DFLASH2_WINDOW_ENV} must be a positive decimal integer, got {raw!r}")
+        window = int(raw)
+    if type(window) is not int or not 1 <= window <= DFLASH2_WINDOW_MAX:
+        raise ValueError(f"DFlash2: sliding window {window!r} outside [1, {DFLASH2_WINDOW_MAX}]")
+    causal = True if is_causal is None else is_causal
+    return (window - 1, 0 if causal else window - 1)
+
+
 class DFlashConfig(Config):
     arch_string = "DFlashDraftModel"
 
