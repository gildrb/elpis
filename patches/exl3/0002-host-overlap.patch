+"""
+Prebuilt GDN recurrent-state rewinds for greedy speculative verification.
+
+After a history-free verify every GDN layer holds the verified slot's commit as pending, and the round's
+acceptance decision only selects how many verified tokens the commit keeps. GDNState.rewind() builds each
+layer's rewind jobs in Python at decision time, a few microseconds per layer while the GPU waits for them.
+RewindPlans builds the identical job lists for every possible outcome of the round while the verify forward
+still runs, reusing a slot's lists from earlier rounds while every address they encode is unchanged, so the
+decision only launches them.
+"""
+
+from __future__ import annotations
+import torch
+from ..ext import exllamav3_ext as ext
+from ..modules.gated_delta_net import GDNState, GDNLayerState
+
+
+class _ReplayView:
+    """
+    The fields GDNLayerState.replay_job reads, so the layer's own job builder can run for every outcome without
+    consuming the layer's pending verify
+    """
+    __slots__ = ("pending", "recurrent_state", "module")
+
+
+class RewindPlans:
+
+    def __init__(self):
+        # slot -> (key, launches): launches[n] lists (device_index, conv_jobs, replay_jobs) in the order
+        # GDNState.rewind(n) dispatches them, key every address and size the jobs encode
+        self.plans = {}
+        self.planned_rewinds = 0
+
+
+    def prepare(self, state, window: int) -> tuple | None:
+        """
+        Plan the rewind that ends a verify round of `window` drafted tokens on `state`, or return None when the
+        state is not a single-process GDN state whose every layer holds that verify as pending. Call after the
+        verify forward was launched and before anything else touches the state.
+        """
+        if type(state) is not GDNState or state.cache.model.loaded_tp or state.last_history != window:
+            return None
+        slot = state.slot
+        layers = list(state.cache.get_all_recurrent_layers().values())
+        entries = []
+        key = [window]
+        for l in layers:
+            if type(l) is not GDNLayerState:
+                return None
+            entry = getattr(l, "pending", {}).get(slot)
+            if entry is None or entry[4] != window + 1:
+                return None
+            entries.append(entry)
+            key += (
+                id(l),
+                l.conv_state.data_ptr(),
+                l.recurrent_state.data_ptr(),
+                entry[0].data_ptr(),
+                entry[1].data_ptr(),
+                entry[2].data_ptr(),
+                entry[3],
+            )
+        key = tuple(key)
+        plan = self.plans.get(slot)
+        if plan is None or plan[0] != key:
+            plan = (key, self._build(layers, entries, slot, window))
+            self.plans[slot] = plan
+        return state, layers, entries, plan[1]
+
+
+    @staticmethod
+    def _build(layers: list, entries: list, slot: int, window: int) -> list:
+        """
+        Job lists of GDNState.rewind(n) for n in 0..window, built by the layers' own job builders: conv rewind
+        jobs by the side-effect-free GDNLayerState.rewind_conv_job, replay jobs by GDNLayerState.replay_job on a
+        view that holds only the pending entry
+        """
+        view = _ReplayView()
+        launches = []
+        for num_tokens in range(window + 1):
+            by_device = {}
+            for l, entry in zip(layers, entries):
+                conv_jobs, replay_jobs = by_device.setdefault(torch.device(l.device).index, ([], []))
+                cj = l.rewind_conv_job(slot, window, num_tokens)
+                if cj is not None:
+                    conv_jobs.append(cj)
+                view.pending = {slot: entry}
+                view.recurrent_state = l.recurrent_state
+                view.module = l.module
+                replay_jobs.append(GDNLayerState.replay_job(view, slot, window + 1 - num_tokens))
+            launches.append([(device_index, c, r) for device_index, (c, r) in by_device.items()])
+        return launches
+
+
+    def rewind(self, prepared: tuple, num_tokens: int):
+        """
+        Same effect and the same launches as state.rewind(num_tokens) for the state `prepared` planned
+        """
+        state, layers, entries, launches = prepared
+        slot = state.slot
+        if any(l.pending.get(slot) is not entry for l, entry in zip(layers, entries)):
+            raise RuntimeError("GDN rewind plan is stale: a layer's pending verify changed after planning")
+        for l in layers:
+            del l.pending[slot]
+        for device_index, conv_jobs, replay_jobs in launches[num_tokens]:
+            if conv_jobs:
+                ext.batched_conv_rewind(conv_jobs, device_index)
+            if replay_jobs:
+                ext.batched_state_replay(replay_jobs, device_index)
+        state.position -= num_tokens
+        state.last_history = 0
+        self.planned_rewinds += 1
