+    def _greedy_checkpoint(self, job: Job, window: int) -> int:
+        """
+        Committed-token count in 1..window after which job.is_checkpoint_boundary() first holds in this round, or 0
+        if no draft position reaches a boundary. Each commit advances the K/V position and the sequence length
+        together, so is_checkpoint_boundary() keeps one interval branch for the whole round.
+        """
+        seq = job.sequences[0]
+        seq_pos = seq.kv_position
+        if seq_pos >= len(seq.sequence_ids) - 1 - self.max_chunk_size * 2:
+            interval = self.recurrent_checkpoint_interval
+        else:
+            interval = self.recurrent_checkpoint_interval_pp
+        n = interval - (seq_pos - job.cached_pages * PAGE_SIZE) % interval
+        return n if n <= window else 0
+
