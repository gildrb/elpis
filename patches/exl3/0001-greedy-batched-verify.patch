+"""
+Admitted acceptance decision for greedy speculative verification.
+
+The decision is the Bend-proven acceptance leaf, compiled into a CPU library and admitted by its own loader
+(artifact identity plus an exhaustive differential against the Bend specification table) when the generator is
+constructed. This module only binds that loader; it never computes or approximates the decision.
+"""
+
+from __future__ import annotations
+import importlib.util
+from pathlib import Path
+import torch
+
+ACCEPTOR_DIR = Path("/opt/qwen/bend-exl3")
+ACCEPTOR_LOADER = ACCEPTOR_DIR / "exl3_bend_accept.py"
+
+
+class GreedyAccept:
+    """
+    Decide how many verifier tokens a greedy speculative round commits.
+
+    For a window of k drafted tokens, verify_ids holds the target's greedy token for each of the k + 1 verified
+    positions and proposals the k drafted tokens. Returns (count, eos): verify_ids[:count] is committed, eos tells
+    whether the last committed token ends the job (stop token, or token budget reached). Otherwise, count == k + 1
+    means every proposal was accepted and the bonus token committed, and count <= k means the proposal at
+    count - 1 was rejected or a recurrent checkpoint boundary was reached there.
+    """
+
+    def __init__(self, window: int):
+        spec = importlib.util.spec_from_file_location("exl3_bend_accept", ACCEPTOR_LOADER)
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"Greedy acceptance loader is missing: {ACCEPTOR_LOADER}")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        self.acceptor = module.admit(str(ACCEPTOR_DIR))
+
+        # Reject an unsupported window now rather than at the first verify round: a one-token budget ends the
+        # job at the first committed token whatever the tokens are
+        if self.acceptor.accept([0] * (window + 1), [0] * window, (), 1, 0) != (1, True):
+            raise RuntimeError(f"Greedy acceptance does not admit a {window}-token draft window")
+
+
+    def __call__(
+        self,
+        verify_ids: torch.Tensor,
+        proposals: torch.Tensor,
+        stop_tokens: set[int],
+        budget: int,
+        checkpoint: int,
+    ) -> tuple[int, bool]:
+        """
+        :param verify_ids:
+            Host int64 tensor (k + 1,), target greedy token per verified position
+
+        :param proposals:
+            Host int64 tensor (k,), drafted tokens
+
+        :param stop_tokens:
+            Token IDs that end the job
+
+        :param budget:
+            Tokens the job may still generate, >= 1
+
+        :param checkpoint:
+            Committed count in 1..k at which a recurrent checkpoint boundary stops acceptance, or 0 for none
+        """
+        count, eos = self.acceptor.accept(
+            verify_ids.tolist(),
+            proposals.tolist(),
+            tuple(sorted(stop_tokens)),
+            budget,
+            checkpoint,
+        )
+        if type(count) is not int or type(eos) is not bool or not 1 <= count <= verify_ids.shape[0]:
+            raise RuntimeError("Greedy acceptance returned a malformed decision")
+        return count, eos
