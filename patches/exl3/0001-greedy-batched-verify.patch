+    def _greedy_verify_eligible(self, job: Job) -> bool:
+        """
+        Whether a verify round of this job can commit through the batched greedy path: a single-sequence job whose
+        sampler collapsed to exactly the fused greedy reducer, with no logit mask, filter, forced or healing token,
+        stop string, banned string, loop detector or per-token output, and no requeue before its token budget ends.
+        Each excluded feature can change a later position's sampling or stop outcome through state the verifier
+        rows cannot see; stop tokens and the token budget are inputs of the acceptance decision itself.
+        """
+        sampler = job.sampler
+        return (
+            isinstance(sampler, CustomSampler)
+            and sampler.fused_only
+            and len(sampler.steps) == 1
+            and type(sampler.steps[0]) is SS_Fused
+            and sampler.steps[0].mode == SS_Fused.MODE_GREEDY
+            and len(job.sequences) == 1
+            and job.new_tokens >= 0
+            and job.new_tokens >= job.min_new_tokens
+            and job.forced_ids is None
+            and not job.filters
+            and not job.return_probs
+            and job.return_top_tokens == 0
+            and not job.return_logits
+            and not job.stop_strings
+            and job.banned_strings_utf32_offsets is None
+            and job.loop_detector is None
+            and job.checkpoint is None
+            and job.device_logit_mask is None
+            and job.max_new_tokens <= job.max_rq_tokens - self.num_draft_tokens
+        )
+
