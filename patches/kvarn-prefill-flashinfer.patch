+def packed_attention_out_nosync(Q, view, request_page_table, query_request_ids,
+                                lower_bounds, upper_bounds, scale, fixedworkspace):
+    """Sync-free verify/decode launch: fixed SPLITS-way grid, no host reads.
+
+    Every .item() in the launch path stalls the pipeline once per layer per
+    step (32 device->host syncs per verify step across 16 full-attention
+    layers). The reducer already collapses empty splits (their LSE is -inf,
+    weight zero), so launching all splits unconditionally is bit-compatible
+    with the counted launch and removes the syncs entirely. Grid shape is
+    static per deployment, which also makes this path CUDA-graph ready.
+    """
+    if Q.ndim != 3 or Q.shape[2] != view.layout.head_dim:
+        raise ValueError("native query shape mismatch")
+    queries, heads, d = Q.shape
+    if heads % view.layout.kv_heads != 0:
+        raise ValueError("native attention requires grouped heads")
+    if Q.dtype != fixedworkspace.output.dtype:
+        raise ValueError("invalid native query dtype")
+    table = request_page_table.to(torch.int32).contiguous()
+    request_ids = query_request_ids.to(torch.int32).contiguous()
+    lower = lower_bounds.to(torch.int32).contiguous()
+    upper = upper_bounds.to(torch.int32).contiguous()
+    output = fixedworkspace.output[:queries, :heads]
+    partial, lse = fixedworkspace.native_partial_output, fixedworkspace.native_partial_lse
+    kv_heads = view.layout.kv_heads
+    group = heads // kv_heads
+    rows = triton.next_power_of_2(queries)
+    splits = partial.shape[2]
+    o = KVarNOffsets.from_layout(view.layout)
+    empty = upper <= lower
+    if bool(empty.all().item()):
+        output.zero_()
+        return output
+    _packed_attention_split[(kv_heads, splits)](
+        Q, table, request_ids, lower, upper,
+        view.packed, view.raw_keys, view.raw_values, view.page_to_tail_slot,
+        view.committed_mask, view.provisional_mask, view.preview_ready, view.sink_pages,
+        partial, lse, fixedworkspace.native_status, scale, queries,
+        Q_STRIDE=Q.stride(0), Q_HEAD_STRIDE=Q.stride(1),
+        TABLE_STRIDE=table.stride(0), TABLE_WIDTH=table.shape[1], REQUESTS=table.shape[0],
+        PARTIAL_Q_STRIDE=partial.stride(0), PARTIAL_H_STRIDE=partial.stride(1),
+        LSE_Q_STRIDE=lse.stride(0), LSE_H_STRIDE=lse.stride(1),
+        D=d, H=kv_heads, HQ=heads, PAGES=view.packed.shape[0],
+        SLOTS=view.raw_keys.shape[0], TILE_BYTES=view.layout.tile_bytes,
+        SPLITS=splits, ROWS=rows, BLOCK=32,
+        K_SCALE=o.k_scale, K_ZERO=o.k_zero, K_TOKEN=o.k_token,
+        V_PACKED=o.v_packed, V_CHANNEL=o.v_channel, V_SCALE=o.v_scale, V_ZERO=o.v_zero,
+        num_warps=4, num_stages=1)
+    _packed_attention_reduce[(queries, heads)](
+        partial, lse, output,
+        PARTIAL_Q_STRIDE=partial.stride(0), PARTIAL_H_STRIDE=partial.stride(1),
+        LSE_Q_STRIDE=lse.stride(0), LSE_H_STRIDE=lse.stride(1),
+        OUTPUT_Q_STRIDE=output.stride(0), OUTPUT_H_STRIDE=output.stride(1),
+        D=d, SPLITS=splits, N_SPLITS=splits, num_warps=4, num_stages=1)
+    output[empty] = 0
+    return output
+
