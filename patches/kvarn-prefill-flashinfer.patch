+@triton.jit
+def _materialize_page(
+    Table, Packed, RawK, RawV, PageToSlot, Committed, Provisional, Preview, Sink,
+    KOut, VOut, Status,
+    TABLE_STRIDE: tl.constexpr, REQUEST: tl.constexpr,
+    D: tl.constexpr, H: tl.constexpr, PAGES: tl.constexpr, SLOTS: tl.constexpr,
+    TILE_BYTES: tl.constexpr,
+    K_SCALE: tl.constexpr, K_ZERO: tl.constexpr, K_TOKEN: tl.constexpr,
+    V_PACKED: tl.constexpr, V_CHANNEL: tl.constexpr, V_SCALE: tl.constexpr,
+    V_ZERO: tl.constexpr,
+):
+    logical = tl.program_id(0)
+    kv_head = tl.program_id(1)
+    d = tl.arange(0, D)
+    page = tl.load(Table + REQUEST * TABLE_STRIDE + logical)
+    in_range = (page > 0) & (page < PAGES)
+    slot = tl.load(PageToSlot + page, mask=in_range, other=-1)
+    page_ok = in_range & (slot < SLOTS)
+    tl.atomic_or(Status, tl.where(~in_range, 1, 0))
+    sink = tl.load(Sink + page, mask=page_ok, other=0)
+    preview = tl.load(Preview + page, mask=page_ok, other=0)
+    use_raw = page_ok & (slot >= 0) & (sink | ~preview)
+    safe_slot = tl.where(slot >= 0, slot, 0)
+    base = (tl.where(page > 0, page, 1).to(tl.int64) * H + kv_head) * TILE_BYTES
+    halves = (Packed + base).to(tl.pointer_type(tl.float16))
+    ks = tl.load(halves + K_SCALE // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+    kz = tl.load(halves + K_ZERO // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+    vc = tl.load(halves + V_CHANNEL // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+    token = tl.arange(0, 32)
+    for start in range(0, 128, 32):
+        tok = start + token
+        committed = tl.load(Committed + page * 128 + tok, mask=page_ok, other=0)
+        provisional = tl.load(Provisional + page * 128 + tok, mask=page_ok, other=0)
+        written = committed | provisional
+        raw_mask = use_raw & written
+        keys_raw = tl.load(RawK + (safe_slot.to(tl.int64) * 128 + tok[:, None]) * H * D
+                           + kv_head * D + d[None, :],
+                           mask=raw_mask[:, None], other=0.0).to(tl.float32)
+        values_raw = tl.load(RawV + (safe_slot.to(tl.int64) * 128 + tok[:, None]) * H * D
+                             + kv_head * D + d[None, :],
+                             mask=raw_mask[:, None], other=0.0).to(tl.float32)
+        kt = tl.load(halves + K_TOKEN // 2 + tok, mask=page_ok, other=0.0).to(tl.float32)
+        kbyte = tl.load(Packed + base + d[:, None] * 64 + tok[None, :] // 2,
+                        mask=page_ok, other=0).to(tl.int32)
+        keys_rot = (((kbyte >> ((tok[None, :] % 2) * 4)) & 15).to(tl.float32) * ks[:, None]
+                    + kz[:, None]) * kt[None, :]
+        keys_rot = tl.trans(keys_rot)
+        vs = tl.load(halves + V_SCALE // 2 + tok, mask=page_ok, other=0.0).to(tl.float32)
+        vz = tl.load(halves + V_ZERO // 2 + tok, mask=page_ok, other=0.0).to(tl.float32)
+        vbyte = tl.load(Packed + base + V_PACKED + tok[:, None] * (D // 4) + d[None, :] // 4,
+                        mask=page_ok, other=0).to(tl.int32)
+        values_rot = (((vbyte >> ((d[None, :] % 4) * 2)) & 3).to(tl.float32) * vs[:, None]
+                      + vz[:, None]) * vc[None, :]
+        packed_ok = page_ok & (~use_raw) & written
+        keys = tl.where(raw_mask[:, None], keys_raw, tl.where(packed_ok[:, None], keys_rot, 0.0))
+        values = tl.where(raw_mask[:, None], values_raw, tl.where(packed_ok[:, None], values_rot, 0.0))
+        dest = (logical.to(tl.int64) * 128 + tok[:, None]) * H * D + kv_head * D + d[None, :]
+        tl.store(KOut + dest, keys.to(tl.float16), mask=page_ok)
+        tl.store(VOut + dest, values.to(tl.float16), mask=page_ok)
+
