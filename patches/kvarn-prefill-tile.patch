+def _needed_splits(lower: torch.Tensor, upper: torch.Tensor, splits: int) -> int:
+    live = upper > lower
+    if int(live.sum().item()) == 0:
+        return 0
+    max_upper = int(upper[live].max().item())
+    min_lower = int(lower[live].min().item())
+    first = min(min_lower // 128, max_upper // 128)
