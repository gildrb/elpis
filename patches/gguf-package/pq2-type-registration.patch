# gguf-py 0.19.0 build-time extension: register the PrismML PQ2_0 ternary
# format as a first-class quantization type.
#
# PQ2_0 (serialized type 142) is a distinct GGMLQuantizationType member, never
# an alias of TQ2_0: aliasing a 34-byte/128-weight block layout onto the
# TQ2_0 member makes enum resolution select the 66-byte/256-weight TQ2_0
# geometry (the historical bonsai_bootstrap.py defect). Geometry per the
# pinned PrismML-Eng/llama.cpp reference (release prism-b10683-d8f26ee):
# block_pq2_0 { ggml_half d; uint8_t qs[QK_PQ2_0/4]; }, QK_PQ2_0 = 128,
# i.e. (block_size, type_size) = (128, 34).
--- a/site-packages/gguf/constants.py
+++ b/site-packages/gguf/constants.py
@@ -4091,6 +4091,7 @@ class GGMLQuantizationType(IntEnum):
     MXFP4   = 39
     NVFP4   = 40
     Q1_0    = 41
+    PQ2_0   = 142
 
 
 class ExpertGatingFuncType(IntEnum):
@@ -4264,6 +4265,7 @@ GGML_QUANT_SIZES: dict[GGMLQuantizationType, tuple[int, int]] = {
     GGMLQuantizationType.MXFP4:   (32, 1 + 16),
     GGMLQuantizationType.NVFP4:   (64, 4 + 32),
     GGMLQuantizationType.Q1_0:    (128, 2 + 16),
+    GGMLQuantizationType.PQ2_0:   (128, 2 + 32),
 }
 
 
