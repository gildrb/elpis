+def _read_native_input(path: Path) -> bytes:
+    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as source:
+        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
+            raise ValueError("Native DFLASH identity inputs must be regular files")
+        data = source.read(1024 * 1024 + 1)
+    if len(data) > 1024 * 1024:
+        raise ValueError("Native DFLASH identity input exceeds its size bound")
+    return data
+
+
+def _load_native_draft_vocab(
+    vocab_path: str, target_path: str, draft_path: str
+) -> tuple[torch.Tensor, dict[str, str | int | bool]]:
+    # Full target/draft shard authentication remains the launcher's existing
+    # verify-models.py prerequisite. Bind this input to that pair's pinned
+    # configs and reference bytes; never infer checkpoint identity from names.
+    for path, expected in (
+        (Path(target_path) / "config.json", _NATIVE_TARGET_CONFIG_SHA256),
+        (Path(draft_path) / "config.json", _NATIVE_DRAFT_CONFIG_SHA256),
+        (Path(target_path) / "mtp_draft_vocab_ids.pt", _NATIVE_VOCAB_REFERENCE_SHA256),
+    ):
+        if hashlib.sha256(_read_native_input(path)).hexdigest() != expected:
+            raise ValueError("Native DFLASH model/vocabulary input identity mismatch")
+    if not vocab_path:
+        raise ValueError("Native DFLASH requires QWEN_DRAFT_VOCAB_JSON")
+    data = _read_native_input(Path(vocab_path))
+    decoded: object = json.loads(data)
+    if not isinstance(decoded, list) or len(decoded) != 40960:
+        raise ValueError("Native DFLASH requires the pinned 40960 ordered token IDs")
+    ids: list[int] = []
+    for token in decoded:
+        if not isinstance(token, int) or isinstance(token, bool) or not 0 <= token < 248320:
+            raise ValueError("Native DFLASH vocabulary IDs must be valid target integers")
+        ids.append(token)
+    ordered_sha256 = hashlib.sha256(struct.pack("<40960q", *ids)).hexdigest()
+    if ordered_sha256 != _NATIVE_VOCAB_ORDERED_SHA256:
+        raise ValueError("Native DFLASH ordered vocabulary differs from the pinned input")
+    return torch.tensor(ids, dtype=torch.long, device="cpu"), {
+        "schema_version": 1,
+        "acceptance_simulated": False,
+        "vocabulary_count": len(ids),
+        "vocabulary_encoding": "int64-le",
+        "vocabulary_ordered_sha256": ordered_sha256,
+        "vocabulary_json_sha256": hashlib.sha256(data).hexdigest(),
+        "vocabulary_reference_sha256": _NATIVE_VOCAB_REFERENCE_SHA256,
+        "target_config_sha256": _NATIVE_TARGET_CONFIG_SHA256,
+        "draft_config_sha256": _NATIVE_DRAFT_CONFIG_SHA256,
+    }
+
+
+def _native_text_rope_backing(
+    model: torch.nn.Module, context_length: int, block_size: int
+) -> tuple[int, int]:
+    # Ordinary text only: prepare_block writes prefix_len + [0, block_size).
+    # Conservatively back a full block starting at the declared context bound.
+    # Multimodal position axes can exceed text positions and are NOT qualified.
+    if type(context_length) is not int or context_length <= 0 or block_size <= 0:
+        raise ValueError("Native DFLASH requires positive text context and lookahead")
+    required_rows = context_length + block_size
+    minimum_rows: Optional[int] = None
+    module_count = 0
+    for module in model.modules():
+        if not isinstance(module, RotaryEmbedding):
+            continue
+        cache = module.cos_sin_cache
+        if cache.ndim != 2 or cache.shape[1] != module.rotary_dim:
+            raise ValueError("Native DFLASH has invalid text RoPE backing geometry")
+        rows = int(cache.shape[0])
+        if rows < required_rows:
+            raise ValueError(
+                f"Native DFLASH text RoPE has {rows} rows; needs {required_rows} "
+                "before speculative capture/publication"
+            )
+        minimum_rows = rows if minimum_rows is None else min(minimum_rows, rows)
+        module_count += 1
+    if minimum_rows is None:
+        raise ValueError("Native DFLASH could not establish text RoPE backing")
+    return minimum_rows, module_count
+
 
