+_NATIVE_VOCAB_REFERENCE_SHA256 = (
+    "8af9028616e41932e0c949cd5364d2da0a69d15375af9bb404cab1e4d723f581"
+)
+_NATIVE_VOCAB_ORDERED_SHA256 = (
+    "328af76c651b989efb40e31e6b1bfdb1b4a0928e1124359f8fb04654b1e44584"
