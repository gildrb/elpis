+_NATIVE_TARGET_CONFIG_SHA256 = (
+    "5a3e7312dee3a6c5909beb854b05ac818be836683730e4facba81f547b77fd62"
+)
+_NATIVE_DRAFT_CONFIG_SHA256 = (
+    "61d6276fe8d76295232cb02d26cbb0d29c25565911f50441e779c88c9220c556"
+)
