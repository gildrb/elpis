+++ b/python/sglang/srt/layers/attention/kvarn_backend.py
@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Eager C1 KVarN target attention. No dense-cache or graph fallback."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+import torch
+
+from sglang.srt.layers.attention.base_attn_backend import AttentionBackend, SharedReadEnds
+from sglang.srt.layers.radix_attention import AttentionType, RadixAttention
+from sglang.srt.mem_cache.kvarn.kernels import packed_attention
+from sglang.kernels.ops.kvarn.decode import packed_attention_out
+from sglang.srt.mem_cache.kvarn.pool import KVarNTokenToKVPool
+from sglang.srt.mem_cache.kvarn_allocator import KVarNPageAllocator
+from sglang.srt.mem_cache.memory_pool import HybridLinearKVPool
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, ForwardMode
+
+if TYPE_CHECKING:
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+
+@dataclass(frozen=True)
+class KVarNMetadata:
+    request_page_table: torch.Tensor
+    query_request_ids: torch.Tensor
+    lower_bounds: torch.Tensor
+    upper_bounds: torch.Tensor
+
+
+class KVarNAttnBackend(AttentionBackend):
+    """Full-attention child of HybridLinearAttnBackend; GDN stays upstream.
+
+    Portable storage has host-dependent tile bookkeeping. Graph capture is
+    deliberately rejected until storage and packed attention are graph safe.
+    """
+
+    def __init__(self, model_runner: ModelRunner):
+        super().__init__()
+        outer_pool = model_runner.token_to_kv_pool
+        if not isinstance(outer_pool, HybridLinearKVPool):
+            raise TypeError("KVarN target requires HybridLinearKVPool")
+        pool = outer_pool.full_kv_pool
+        if not isinstance(pool, KVarNTokenToKVPool):
+            raise TypeError("KVarN target requires a packed full-attention pool")
+        if pool.layout.head_dim != 256 or pool.layout.kv_heads != 4:
+            raise ValueError("KVarN target requires D256 and four KV heads")
+        allocator = model_runner.token_to_kv_pool_allocator
+        if not isinstance(allocator, KVarNPageAllocator):
+            raise TypeError("KVarN attention requires its page-owning allocator")
+        self._allocator = allocator
+        self._dummy_pages: torch.Tensor | None = None
+        self.pool = pool
+        self.layer_mapping = dict(outer_pool.full_attention_layer_id_mapping)
+        self.req_to_token = model_runner.req_to_token_pool.req_to_token
+        device = model_runner.device
+        # Metadata spans one bounded prefill chunk. The attention output arena
+        # only holds eight query rows and is reused across those microchunks.
+        max_queries = 1024
+        if pool.workspace.output.shape[0] < 8 or pool.capacity.max_write_tokens < 128:
+            raise ValueError("KVarN requires eight output rows and 128 write rows")
+        self._page_table = torch.empty(
+            (1, self.req_to_token[:, ::128].shape[1]),
+            dtype=self.req_to_token.dtype, device=device
+        )
+        self._request_ids = torch.zeros(max_queries, dtype=torch.int64, device=device)
+        self._lower_bounds = torch.zeros(max_queries, dtype=torch.int64, device=device)
+        self._upper_bounds = torch.empty(max_queries, dtype=torch.int64, device=device)
+        self.forward_metadata: KVarNMetadata | None = None
+
+    def shared_read_ends(self, fm: ForwardMode) -> SharedReadEnds:
+        return SharedReadEnds.POST_REPLAY
+
+    def init_cuda_graph_state(self, max_bs: int, max_num_tokens: int) -> None:
+        if not self.pool.supports_cuda_graph or not self.pool.native_enabled:
+            raise NotImplementedError("KVarN transactional storage is eager-only")
+        if max_bs != 1 or max_num_tokens > self._upper_bounds.numel():
+            raise ValueError("KVarN graph geometry exceeds one-request metadata capacity")
+
+    def on_after_cuda_graph_warmup(self) -> None:
+        if self.pool.native_enabled:
+            self.pool.check_native_status()
+        pages = self._dummy_pages
+        if pages is None:
+            return
+        # The allocator owns this reservation for the runner lifetime. Never
+        # reset real request/radix pages or layer-global provisional state here.
+        for layer_id in self.pool.layout.layer_ids:
+            self.pool.reset_graph_dummy_pages(layer_id, pages)
+
+    def get_cuda_graph_seq_len_fill_value(self) -> int:
+        return 0
+
+    def init_forward_metadata_out_graph(
+        self, forward_batch: ForwardBatch, in_capture: bool = False
+    ) -> None:
+        if in_capture and (not self.pool.supports_cuda_graph or not self.pool.native_enabled):
+            raise NotImplementedError("KVarN does not support graph capture")
+        if in_capture:
+            if (forward_batch.batch_size != 1
+                    or not forward_batch.forward_mode.is_target_verify()
+                    or forward_batch.out_cache_loc.numel() != 8):
+                raise ValueError("KVarN capture requires one eight-token verify request")
+            # Row zero is upstream's reserved graph-padding row. The physical
+            # page is reserved through the allocator, never hardcoded or page zero.
+            locations = self._allocator.reserve_graph_dummy_page()
+            self._dummy_pages = locations[:1].div(128, rounding_mode="floor")
+            self.req_to_token[0, :128].copy_(locations)
+            forward_batch.req_pool_indices.zero_()
+            forward_batch.out_cache_loc.copy_(locations[:8])
+            forward_batch.positions.copy_(torch.arange(
+                8, dtype=forward_batch.positions.dtype, device=locations.device
+            ))
+            forward_batch.seq_lens.zero_()
+            if forward_batch.seq_lens_cpu is not None:
+                forward_batch.seq_lens_cpu.zero_()
+            forward_batch.seq_lens_sum = 0
+            self.pool.mark_sink_pages(self._dummy_pages)
+            for layer_id in self.pool.layout.layer_ids:
+                self.pool.reset_graph_dummy_pages(layer_id, self._dummy_pages)
+        if forward_batch.batch_size != 1:
+            raise ValueError("KVarN target currently supports one request")
+        positions = forward_batch.positions
+        if positions is None or positions.ndim != 1:
+            raise ValueError("KVarN requires one-dimensional token positions")
+        count = positions.numel()
+        if count > self._upper_bounds.numel():
+            raise ValueError("KVarN query metadata capacity exceeded")
+        self.forward_metadata = KVarNMetadata(
+            self._page_table, self._request_ids[:count],
+            self._lower_bounds[:count], self._upper_bounds[:count],
+        )
+        sink_pages = self.req_to_token[:, :1].index_select(
+            0, forward_batch.req_pool_indices
+        ).flatten().div(128, rounding_mode="floor")
+        self.pool.mark_sink_pages(sink_pages)
+
+    def init_forward_metadata_in_graph(self, forward_batch: ForwardBatch) -> None:
+        # Static-shape tensor operations. The surrounding storage path remains
+        # eager-only; this hook does not by itself advertise graph support.
+        metadata = self.forward_metadata
+        if metadata is None:
+            raise RuntimeError("KVarN metadata buffers were not selected")
+        torch.index_select(
+            self.req_to_token[:, ::128], 0, forward_batch.req_pool_indices,
+            out=self._page_table,
+        )
+        self._page_table.div_(128, rounding_mode="floor")
+        torch.add(forward_batch.positions, 1, out=metadata.upper_bounds)
+
+    def forward_decode(
+        self, q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+        layer: RadixAttention, forward_batch: ForwardBatch,
+        save_kv_cache: bool = True,
+    ) -> torch.Tensor:
+        return self.forward_extend(q, k, v, layer, forward_batch, save_kv_cache)
+
+    def forward_extend(
+        self, q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+        layer: RadixAttention, forward_batch: ForwardBatch,
+        save_kv_cache: bool = True,
+    ) -> torch.Tensor:
+        metadata = self.forward_metadata
+        if metadata is None:
+            raise RuntimeError("KVarN metadata was not initialized")
+        if (layer.is_cross_attention or layer.attn_type != AttentionType.DECODER
+                or layer.sliding_window_size > 0 or layer.logit_cap > 0):
+            raise NotImplementedError("KVarN target supports uncapped causal full attention")
+        if layer.k_scale is not None or layer.v_scale is not None:
+            raise ValueError("KVarN does not accept external KV quantization scales")
+        if not save_kv_cache or k is None or v is None:
+            raise NotImplementedError("KVarN target requires explicit KV writes")
+        local_layer = self.layer_mapping[layer.layer_id]
+        queries = q.reshape(-1, layer.tp_q_head_num, layer.head_dim).contiguous()
+        keys = k.reshape(-1, layer.tp_k_head_num, layer.head_dim).contiguous()
+        values = v.reshape(-1, layer.tp_v_head_num, layer.v_head_dim).contiguous()
+        if queries.shape[0] != metadata.upper_bounds.numel():
+            raise ValueError("KVarN query count does not match positions")
+        provisional = forward_batch.forward_mode.is_target_verify()
+        if provisional and queries.shape[0] != 8:
+            raise ValueError("KVarN target verify requires an eight-token linear block")
+        attention = packed_attention_out if self.pool.native_enabled else packed_attention
+        result = torch.empty_like(queries)
+        chunk_size = min(8, self.pool.workspace.output.shape[0])
+        for start in range(0, queries.shape[0], chunk_size):
+            stop = min(start + chunk_size, queries.shape[0])
+            self.pool.begin_write(
+                local_layer, forward_batch.out_cache_loc[start:stop],
+                keys[start:stop], values[start:stop], provisional=provisional,
+            )
+            result[start:stop].copy_(attention(
+                queries[start:stop], self.pool.layer_view(local_layer),
+                metadata.request_page_table, metadata.query_request_ids[start:stop],
+                metadata.lower_bounds[start:stop], metadata.upper_bounds[start:stop],
+                layer.scaling, self.pool.workspace,
+            ))
+            self.pool.finish_attention(local_layer)
+        return result.reshape(-1, layer.tp_q_head_num * layer.v_head_dim)
