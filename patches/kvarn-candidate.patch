@@ -0,0 +1,600 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Page-owned raw staging and packed KV storage for the eager prototype.
+
+Allocator free/copy hooks are mandatory. Request completion is not page release:
+radix-cached sink and incomplete pages retain their raw slots until actual eviction.
+"""
+from __future__ import annotations
+from typing import TYPE_CHECKING, Literal
+import torch
+from sglang.srt.mem_cache.memory_pool import KVCache
+from .types import KVarNCapacity, KVarNLayerView, KVarNLayout, KVarNWorkspace
+from .kernels import gather_visible, store_tile
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.radix_attention import RadixAttention
+
+class KVarNCapacityError(RuntimeError):
+    """Evict actual unreferenced radix pages or reduce chunk size, then retry."""
+
+class KVarNTokenToKVPool(KVCache):
+    def __init__(self, layout: KVarNLayout, capacity: KVarNCapacity,
+                 dtype: torch.dtype, device: str, enable_memory_saver: bool = False,
+                 *, max_query_heads: int) -> None:
+        if dtype not in (torch.float16, torch.bfloat16):
+            raise ValueError("raw cache requires fp16/bf16")
+        if enable_memory_saver:
+            raise ValueError("KVarN eager prototype does not support memory-saver regions")
+        super().__init__(capacity.token_capacity, 128, dtype, len(layout.layer_ids),
+                         device, False, min(layout.layer_ids), max(layout.layer_ids), "KVarN")
+        self._qualification_mode: Literal["disabled", "native", "capture"] = "disabled"
+        self._graph_dummy_pages: frozenset[int] = frozenset()
+        self.layout = layout
+        self.capacity = capacity
+        self.head_num = layout.kv_heads
+        self.head_dim = layout.head_dim
+        self.v_head_dim = layout.head_dim
+        self.num_pages = capacity.token_capacity // 128 + 1
+        self.kv_cache_layout = "kvarn_k4v2_g128"
+        self.workspace = KVarNWorkspace.create(layout, capacity, dtype, device,
+            max_query_heads)
+        self._views: dict[int, KVarNLayerView] = {}
+        self._owners: dict[int, list[int]] = {}
+        for layer in layout.layer_ids:
+            raw_shape = (capacity.tail_slots, 128, layout.kv_heads, layout.head_dim)
+            self._views[layer] = KVarNLayerView(
+                torch.empty((self.num_pages, layout.kv_heads, layout.tile_bytes), dtype=torch.uint8, device=device),
+                torch.empty(raw_shape, dtype=dtype, device=device),
+                torch.empty(raw_shape, dtype=dtype, device=device),
+                torch.full((self.num_pages,), -1, dtype=torch.int32, device=device),
+                torch.zeros(self.num_pages, dtype=torch.int32, device=device), layout,
+                torch.zeros((self.num_pages, 128), dtype=torch.bool, device=device),
+                torch.zeros((self.num_pages, 128), dtype=torch.bool, device=device),
+                torch.zeros(self.num_pages, dtype=torch.bool, device=device),
+                torch.full((capacity.tail_slots,), -1, dtype=torch.int32, device=device),
+                torch.zeros(self.num_pages, dtype=torch.bool, device=device))
+            self._owners[layer] = [-1] * capacity.tail_slots
+        self.mem_usage = self.allocation_bytes / (1024 ** 3)
+
+    @property
+    def native_enabled(self) -> bool:
+        """Explicit experimental selection, not a runtime correctness approval."""
+        return self._qualification_mode != "disabled"
+
+    @property
+    def supports_cuda_graph(self) -> bool:
+        """True only for explicitly admitted experimental capture qualification."""
+        return self._qualification_mode == "capture"
+
+    @property
+    def allocation_bytes(self) -> int:
+        total = self.workspace.allocation_bytes
+        for view in self._views.values():
+            tensors = (view.packed, view.raw_keys, view.raw_values, view.page_to_tail_slot,
+                       view.valid_lengths, view.committed_mask, view.provisional_mask, view.sink_pages, view.tail_to_page, view.preview_ready)
+            total += sum(t.numel() * t.element_size() for t in tensors)
+        return total
+
+    def get_kv_size_bytes(self) -> tuple[int, int]:
+        """Mixed packed records are charged to K; the pair sums to all bytes."""
+        raw_v = sum(view.raw_values.numel() * view.raw_values.element_size()
+                    for view in self._views.values())
+        return self.allocation_bytes - raw_v, raw_v
+
+    def available_tail_slots(self, layer_id: int | None = None) -> int:
+        layers = self.layout.layer_ids if layer_id is None else (layer_id,)
+        if layer_id is not None:
+            self.layer_view(layer_id)
+        return min(int((self._views[layer].tail_to_page < 0).sum().item()) for layer in layers)
+
+    def clear(self) -> None:
+        """Allocator reset only: all radix/request references must already be gone."""
+        self.workspace.native_status.zero_()
+        self.workspace.native_seal_pages.fill_(-1)
+        for layer, view in self._views.items():
+            view.page_to_tail_slot.fill_(-1)
+            view.valid_lengths.zero_()
+            view.committed_mask.zero_()
+            view.provisional_mask.zero_()
+            view.sink_pages.zero_()
+            view.tail_to_page.fill_(-1)
+            view.preview_ready.zero_()
+            view.raw_keys.zero_()
+            view.raw_values.zero_()
+            self._owners[layer] = [-1] * self.capacity.tail_slots
+            for page in self._graph_dummy_pages:
+                view.sink_pages[page] = True
+
+    def layer_view(self, layer_id: int) -> KVarNLayerView:
+        if layer_id not in self._views:
+            raise ValueError(f"layer {layer_id} is not owned by this pool")
+        return self._views[layer_id]
+
+    def _locations(self, locations: torch.Tensor, maximum: int) -> list[int]:
+        if locations.ndim != 1 or locations.dtype not in (torch.int32, torch.int64):
+            raise ValueError("locations must be a one-dimensional integer tensor")
+        if locations.numel() > maximum:
+            raise KVarNCapacityError("bounded operation capacity exceeded")
+        result = [int(loc.item()) for loc in locations]
+        if len(set(result)) != len(result):
+            raise ValueError("duplicate physical locations")
+        if len(result) > 0 and (min(result) < 128 or max(result) >= self.num_pages * 128):
+            raise ValueError("physical location outside pool (page zero reserved)")
+        return result
+
+    def begin_write(self, layer_id: int, locs: torch.Tensor, K: torch.Tensor,
+                    V: torch.Tensor, provisional: bool) -> None:
+        view = self.layer_view(layer_id)
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.store import begin_write_out
+            begin_write_out(view, locs, K, V, provisional, self.workspace)
+            return
+        locations = self._locations(locs, self.capacity.max_write_tokens)
+        expected = (len(locations), self.head_num, self.head_dim)
+        if tuple(K.shape) != expected or tuple(V.shape) != expected:
+            raise ValueError("KV shape must match locations and layout")
+        if K.dtype != self.dtype or V.dtype != self.dtype or K.device != view.packed.device or V.device != view.packed.device:
+            raise ValueError("KV dtype/device must match pool")
+        if not bool(torch.isfinite(K).all().item()) or not bool(torch.isfinite(V).all().item()):
+            raise ValueError("nonfinite KV input")
+        pages = sorted({loc // 128 for loc in locations})
+        if len(pages) > 2:
+            raise ValueError("a bounded KVarN write may touch at most two physical pages")
+        for loc in locations:
+            page, offset = divmod(loc, 128)
+            if bool(view.committed_mask[page, offset].item()):
+                raise ValueError("committed KV is immutable; use allocator copy-on-write")
+        new_pages = [page for page in pages if int(view.page_to_tail_slot[page].item()) < 0]
+        free = [slot for slot, owner in enumerate(self._owners[layer_id]) if owner < 0]
+        if len(new_pages) > len(free):
+            raise KVarNCapacityError("raw slot pressure; evict actual radix-owned pages before retry")
+        # All shape/location/ownership/capacity checks precede the first mutation.
+        for page, slot in zip(new_pages, free):
+            self._owners[layer_id][slot] = page
+            view.tail_to_page[slot] = page
+            view.page_to_tail_slot[page] = slot
+            view.raw_keys[slot].zero_()
+            view.raw_values[slot].zero_()
+        for page in pages:
+            view.preview_ready[page] = False
+        for row, loc in enumerate(locations):
+            page, offset = divmod(loc, 128)
+            slot = int(view.page_to_tail_slot[page].item())
+            view.raw_keys[slot, offset].copy_(K[row])
+            view.raw_values[slot, offset].copy_(V[row])
+            view.provisional_mask[page, offset] = provisional
+            view.committed_mask[page, offset] = not provisional
+            view.valid_lengths[page] = max(int(view.valid_lengths[page].item()), offset + 1)
+
+        # Preview full written tiles, but retain raw ownership until acceptance.
+        # Query 127 (upper=128) sees raw; query 128 (upper=129) sees preview.
+        for page in pages:
+            if bool(view.sink_pages[page].item()):
+                continue
+            written = view.committed_mask[page] | view.provisional_mask[page]
+            if bool(written.all().item()):
+                slot = int(view.page_to_tail_slot[page].item())
+                store_tile(view.raw_keys[slot], view.raw_values[slot], view.packed[page], self.layout)
+                view.preview_ready[page] = True
+
+    def finish_attention(self, layer_id: int) -> None:
+        """Post-attention barrier. Rejected proposals never enter tile statistics."""
+        view = self.layer_view(layer_id)
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.store import complete_tiles_out
+            complete_tiles_out(view, self.workspace, seal=True)
+            return
+        owned = tuple(enumerate(self._owners[layer_id]))
+        for slot, page in owned:
+            if page < 0 or bool(view.sink_pages[page].item()):
+                continue
+            if bool(view.provisional_mask[page].any().item()):
+                continue
+            if bool(view.committed_mask[page].all().item()):
+                store_tile(view.raw_keys[slot], view.raw_values[slot], view.packed[page], self.layout)
+                view.page_to_tail_slot[page] = -1
+                view.preview_ready[page] = False
+                self._owners[layer_id][slot] = -1
+                view.tail_to_page[slot] = -1
+
+    def commit_prefix(self, layer_id: int, locations_2d: torch.Tensor,
+                      accepted_lengths: torch.Tensor) -> None:
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.store import commit_prefix_out
+            commit_prefix_out(self.layer_view(layer_id), locations_2d, accepted_lengths, self.workspace)
+            return
+        if locations_2d.ndim != 2 or accepted_lengths.shape != (locations_2d.shape[0],):
+            raise ValueError("acceptance requires [batch,width] locations and [batch] lengths")
+        if accepted_lengths.dtype not in (torch.int32, torch.int64):
+            raise ValueError("accepted lengths must be integers")
+        locations = self._locations(locations_2d.flatten(), self.capacity.max_write_tokens)
+        width = locations_2d.shape[1]
+        accepted: list[int] = []
+        for row in range(locations_2d.shape[0]):
+            length = int(accepted_lengths[row].item())
+            if not 0 <= length <= width:
+                raise ValueError("accepted prefix outside proposal width")
+            accepted.extend(locations[row * width:row * width + length])
+        view = self.layer_view(layer_id)
+        for loc in accepted:
+            page, offset = divmod(loc, 128)
+            if not bool(view.provisional_mask[page, offset].item()):
+                raise ValueError("accepted token was not staged provisionally")
+        for loc in accepted:
+            page, offset = divmod(loc, 128)
+            view.committed_mask[page, offset] = True
+            view.provisional_mask[page, offset] = False
+        self.discard_provisional(layer_id)
+        self.finish_attention(layer_id)
+
+    def discard_provisional(self, layer_id: int) -> None:
+        view = self.layer_view(layer_id)
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.store import discard_provisional_out
+            discard_provisional_out(view, self.workspace)
+            return
+        owned = tuple(enumerate(self._owners[layer_id]))
+        for slot, page in owned:
+            if page < 0:
+                continue
+            mask = view.provisional_mask[page]
+            if bool(mask.any().item()):
+                view.preview_ready[page] = False
+            view.raw_keys[slot].masked_fill_(mask[:, None, None], 0)
+            view.raw_values[slot].masked_fill_(mask[:, None, None], 0)
+            mask.zero_()
+            valid_offsets = torch.nonzero(view.committed_mask[page], as_tuple=False).flatten()
+            length = 0 if valid_offsets.numel() == 0 else int(valid_offsets[-1].item()) + 1
+            view.valid_lengths[page] = length
+            if length == 0 and not bool(view.sink_pages[page].item()):
+                view.page_to_tail_slot[page] = -1
+                view.preview_ready[page] = False
+                self._owners[layer_id][slot] = -1
+                view.tail_to_page[slot] = -1
+
+    def mark_sink_pages(self, pages: torch.Tensor) -> None:
+        """Call with each request's first physical page, including radix cache hits."""
+        ids = self._page_ids(pages)
+        for view in self._views.values():
+            for page in ids:
+                if int(view.valid_lengths[page].item()) > 0 and int(view.page_to_tail_slot[page].item()) < 0:
+                    raise ValueError("sink declaration must precede sealing")
+        for view in self._views.values():
+            for page in ids:
+                view.sink_pages[page] = True
+                view.preview_ready[page] = False
+
+    def _page_ids(self, pages: torch.Tensor) -> list[int]:
+        if pages.ndim != 1 or pages.dtype not in (torch.int32, torch.int64):
+            raise ValueError("pages must be integer vector")
+        ids = [int(page.item()) for page in pages]
+        if len(set(ids)) != len(ids):
+            raise ValueError("duplicate page IDs")
+        if len(ids) > 0 and (min(ids) <= 0 or max(ids) >= self.num_pages):
+            raise ValueError("invalid physical page")
+        return ids
+
+    def release_pages(self, pages: torch.Tensor) -> None:
+        """Allocator actual-free hook, after radix reference count reaches zero."""
+        ids = self._page_ids(pages)
+        if len(self._graph_dummy_pages.intersection(ids)) > 0:
+            raise ValueError("allocator-reserved graph pages cannot be released")
+        for layer, view in self._views.items():
+            for page in ids:
+                slot = int(view.page_to_tail_slot[page].item())
+                if slot >= 0:
+                    self._owners[layer][slot] = -1
+                    view.tail_to_page[slot] = -1
+                    view.raw_keys[slot].zero_()
+                    view.raw_values[slot].zero_()
+                view.page_to_tail_slot[page] = -1
+                view.valid_lengths[page] = 0
+                view.committed_mask[page].zero_()
+                view.provisional_mask[page].zero_()
+                view.sink_pages[page] = False
+                view.preview_ready[page] = False
+
+    def copy_pages(self, source: torch.Tensor, destination: torch.Tensor) -> None:
+        """Unintegrated bounded page-copy primitive, NOT engine COW support.
+
+        Destination must be fresh/empty. Coordinated target+draft allocator
+        routing is not implemented; move_kv_cache deliberately rejects it.
+        """
+        src, dst = self._page_ids(source), self._page_ids(destination)
+        if self.capacity.tail_slots == 8 and len(src) > 1:
+            raise ValueError("compact tail8 admission supports at most one COW page per copy")
+        if len(src) != len(dst) or len(set(src) & set(dst)) > 0:
+            raise ValueError("page copy needs equal, disjoint source/destination vectors")
+        plans: dict[int, list[int]] = {}
+        for layer, view in self._views.items():
+            for page in dst:
+                if int(view.valid_lengths[page].item()) != 0 or int(view.page_to_tail_slot[page].item()) >= 0 or bool(view.sink_pages[page].item()):
+                    raise ValueError("page-copy destination must be empty")
+            for page in src:
+                if int(view.valid_lengths[page].item()) == 0 or bool(view.provisional_mask[page].any().item()):
+                    raise ValueError("cannot copy empty or provisional page")
+            need = sum(int(view.page_to_tail_slot[page].item()) >= 0 for page in src)
+            free = [slot for slot in range(self.capacity.tail_slots)
+                    if int(view.tail_to_page[slot].item()) < 0]
+            if need > len(free):
+                raise KVarNCapacityError("page-copy raw slot pressure")
+            plans[layer] = free
+        for layer, view in self._views.items():
+            free_iter = iter(plans[layer])
+            for old, new in zip(src, dst):
+                slot = int(view.page_to_tail_slot[old].item())
+                if slot >= 0:
+                    new_slot = next(free_iter)
+                    view.raw_keys[new_slot].copy_(view.raw_keys[slot])
+                    view.raw_values[new_slot].copy_(view.raw_values[slot])
+                    view.page_to_tail_slot[new] = new_slot
+                    self._owners[layer][new_slot] = new
+                    view.tail_to_page[new_slot] = new
+                else:
+                    view.packed[new].copy_(view.packed[old])
+                view.valid_lengths[new].copy_(view.valid_lengths[old])
+                view.committed_mask[new].copy_(view.committed_mask[old])
+                view.sink_pages[new].copy_(view.sink_pages[old])
+                if bool(view.preview_ready[old].item()):
+                    view.packed[new].copy_(view.packed[old])
+                    view.preview_ready[new] = True
+
+    def move_kv_cache(self, tgt_loc: torch.Tensor, src_loc: torch.Tensor) -> None:
+        """Fail closed on upstream token moves: coordinated pool COW unsupported."""
+        raise NotImplementedError(
+            "KVarN selected linear profile does not support coordinated target+draft "
+            "KV moves/COW; do not route token relocation through local copy_pages"
+        )
+
+    def set_kv_buffer(self, layer: RadixAttention, loc: torch.Tensor,
+                      cache_k: torch.Tensor, cache_v: torch.Tensor,
+                      k_scale: float | None = None, v_scale: float | None = None,
+                      layer_id_override: int | None = None) -> None:
+        if k_scale is not None or v_scale is not None:
+            raise ValueError("external KV scales are incompatible with KVarN")
+        layer_id = layer.layer_id if layer_id_override is None else layer_id_override
+        self.begin_write(layer_id, loc, cache_k, cache_v, provisional=False)
+
+    def set_kv_buffer_prefix_valid(self, layer: RadixAttention, loc_2d: torch.Tensor,
+                      commit_lens: torch.Tensor, cache_k: torch.Tensor, cache_v: torch.Tensor,
+                      k_scale: float | None = None, v_scale: float | None = None,
+                      layer_id_override: int | None = None) -> None:
+        if torch.device(self.device).type == "cuda" and torch.cuda.is_current_stream_capturing():
+            raise NotImplementedError(
+                "KVarN generic prefix-valid setter uses host metadata materialization; "
+                "capture requires the reviewed explicit GPU begin_write/commit_prefix path"
+            )
+        if k_scale is not None or v_scale is not None:
+            raise ValueError("external KV scales are incompatible with KVarN")
+        if loc_2d.ndim != 2 or loc_2d.dtype not in (torch.int32, torch.int64) or commit_lens.shape != (loc_2d.shape[0],):
+            raise ValueError("invalid prefix metadata")
+        if commit_lens.dtype not in (torch.int32, torch.int64):
+            raise ValueError("commit lengths must be integer")
+        if loc_2d.numel() > self.capacity.max_write_tokens:
+            raise KVarNCapacityError("prefix write exceeds bounded workspace")
+        if cache_k.shape != (loc_2d.numel(), self.head_num, self.head_dim) or cache_v.shape != cache_k.shape:
+            raise ValueError("prefix KV shape mismatch")
+        rows: list[int] = []
+        for row in range(loc_2d.shape[0]):
+            length = int(commit_lens[row].item())
+            if not 0 <= length <= loc_2d.shape[1]:
+                raise ValueError("invalid committed prefix length")
+            rows.extend(range(row * loc_2d.shape[1], row * loc_2d.shape[1] + length))
+        if len(rows) == 0:
+            layer_id = layer.layer_id if layer_id_override is None else layer_id_override
+            self.discard_provisional(layer_id)
+            return
+        indices = torch.tensor(rows, dtype=torch.int64, device=cache_k.device)
+        loc_indices = indices.to(loc_2d.device)
+        layer_id = layer.layer_id if layer_id_override is None else layer_id_override
+        # Replaces provisional noise with accepted target hidden-state KV, never
+        # copies padded/rejected rows. begin_write rejects committed overwrites.
+        self.begin_write(layer_id, loc_2d.flatten().index_select(0, loc_indices),
+                         cache_k.index_select(0, indices), cache_v.index_select(0, indices), False)
+        self.discard_provisional(layer_id)
+        # Caller still owns the post-attention barrier; do not seal here.
+
+    def gather_visible(self, layer_id: int, locations: torch.Tensor,
+                       valid_lengths: torch.Tensor, fixedworkspace: KVarNWorkspace) -> tuple[torch.Tensor, torch.Tensor]:
+        if fixedworkspace is not self.workspace:
+            raise ValueError("gather must use the pool-owned, charged workspace")
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.gather import gather_visible_out
+            return gather_visible_out(self.layer_view(layer_id), locations, valid_lengths,
+                                      fixedworkspace, fixedworkspace.native_status)
+        return gather_visible(self.layer_view(layer_id), locations, valid_lengths, fixedworkspace)
+
+    def enable_native_hotpath(self) -> None:
+        """Reject the former unscoped bypass; use strict qualification admission."""
+        raise RuntimeError(
+            "unscoped native activation is disabled; use enable_qualification_mode "
+            "with the reviewed inventory and exact target/draft profile"
+        )
+
+    def enable_qualification_mode(
+        self,
+        *,
+        profile: Literal["target_sm86_bf16", "draft_sm86_bf16"],
+        reviewed_inventory_sha256: str,
+        capture: bool = False,
+    ) -> None:
+        """Admit a reviewed experimental source profile, never runtime approval.
+
+        Integrator must separately enforce TP1/C1/linear block8, prefix caching,
+        shared allocator ownership and status checks before acceptance/publication.
+        This transition is per newly registered pool; target may precede draft.
+        All validation precedes the only state assignment at the end.
+        """
+        if not isinstance(profile, str) or profile not in (
+            "target_sm86_bf16", "draft_sm86_bf16"
+        ):
+            raise ValueError("unknown KVarN qualification profile")
+        if not isinstance(reviewed_inventory_sha256, str) or reviewed_inventory_sha256 != (
+            "e2f2c7311d93d240311fa3280c2c65fafaf93f8b4a3fcf9ac095d28b614291cd"
+        ):
+            raise ValueError("KVarN qualification requires the exact reviewed resource inventory")
+        if type(capture) is not bool:
+            raise ValueError("capture qualification must be an explicit boolean")
+        requested_mode: Literal["native", "capture"] = "capture" if capture else "native"
+        if self._qualification_mode not in ("disabled", requested_mode):
+            raise RuntimeError("qualification mode cannot change after selection")
+        if profile == "target_sm86_bf16":
+            head_dim, kv_heads, query_heads, layer_count, visible = 256, 4, 24, 16, 128
+        else:
+            head_dim, kv_heads, query_heads, layer_count, visible = 128, 8, 32, 5, 2304
+        if (
+            self.layout.head_dim != head_dim
+            or self.layout.kv_heads != kv_heads
+            or self.layout.layer_ids != tuple(range(layer_count))
+            or self.layout.tile_tokens != 128
+            or self.layout.key_bits != 4
+            or self.layout.value_bits != 2
+        ):
+            raise ValueError("pool layout does not match the reviewed qualification profile")
+        if (
+            self.capacity.token_capacity != 246784
+            or self.capacity.tail_slots != 8
+            or self.capacity.max_write_tokens != 128
+            or self.capacity.max_query_tokens != 8
+            or self.capacity.max_visible_tokens != visible
+            or self.capacity.workspace_bytes != 64 * 1024 * 1024
+            or self.size != 246784
+            or self.num_pages != 1929
+            or self.page_size != 128
+        ):
+            raise ValueError("pool capacities differ from the reviewed fixed qualification envelope")
+        if self.dtype != torch.bfloat16:
+            raise ValueError("reviewed qualification kernels require unchanged BF16 raw KV")
+        device = self.workspace.output.device
+        if torch.device(self.device).type != "cuda" or device.type != "cuda":
+            raise ValueError("reviewed qualification requires a CUDA SM86 device")
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("qualification admission must run outside CUDA capture")
+        if torch.cuda.get_device_capability(device) != (8, 6):
+            raise ValueError("reviewed native resource inventory is specific to SM86")
+        if len(self._graph_dummy_pages) != 1:
+            raise ValueError("register exactly one allocator-exclusive graph dummy page before qualification")
+        dummy_page = next(iter(self._graph_dummy_pages))
+        if not 0 < dummy_page < self.num_pages:
+            raise ValueError("registered graph dummy page is outside the pool")
+        ws = self.workspace
+        expected_workspace = (
+            (ws.keys, (visible, kv_heads, head_dim), torch.bfloat16),
+            (ws.values, (visible, kv_heads, head_dim), torch.bfloat16),
+            (ws.output, (8, query_heads, head_dim), torch.bfloat16),
+            (ws.native_partial_output, (8, query_heads, 16, head_dim), torch.float32),
+            (ws.native_partial_lse, (8, query_heads, 16), torch.float32),
+            (ws.native_status, (1,), torch.int32),
+            (ws.native_seal_pages, (8,), torch.int32),
+            (ws.native_rotated_keys, (8, kv_heads, head_dim, 128), torch.float32),
+        )
+        for tensor, shape, dtype in expected_workspace:
+            if tensor.shape != shape or tensor.dtype != dtype or tensor.device != device or not tensor.is_contiguous():
+                raise ValueError("workspace does not match reviewed fixed native storage")
+        if ws.max_write_tokens != 128 or ws.max_visible_tokens != visible or ws.allocation_bytes != 64 * 1024 * 1024:
+            raise ValueError("workspace capacity/accounting differs from the reviewed envelope")
+        self.check_native_status()
+        if bool((ws.native_seal_pages >= 0).any().item()):
+            raise ValueError("qualification requires a clean tile publication plan")
+        for view in self._views.values():
+            expected_storage = (
+                (view.packed, (1929, kv_heads, self.layout.tile_bytes), torch.uint8),
+                (view.raw_keys, (8, 128, kv_heads, head_dim), torch.bfloat16),
+                (view.raw_values, (8, 128, kv_heads, head_dim), torch.bfloat16),
+                (view.page_to_tail_slot, (1929,), torch.int32),
+                (view.valid_lengths, (1929,), torch.int32),
+                (view.committed_mask, (1929, 128), torch.bool),
+                (view.provisional_mask, (1929, 128), torch.bool),
+                (view.sink_pages, (1929,), torch.bool),
+                (view.tail_to_page, (8,), torch.int32),
+                (view.preview_ready, (1929,), torch.bool),
+            )
+            for tensor, shape, dtype in expected_storage:
+                if tensor.shape != shape or tensor.dtype != dtype or tensor.device != device or not tensor.is_contiguous():
+                    raise ValueError("layer storage does not match reviewed native layout")
+            if (
+                bool((view.valid_lengths != 0).any().item())
+                or bool(view.committed_mask.any().item())
+                or bool(view.provisional_mask.any().item())
+                or bool(view.preview_ready.any().item())
+            ):
+                raise ValueError("qualification requires empty KV state, including the dummy page")
+            if int(view.sink_pages.sum().item()) != 1 or not bool(view.sink_pages[dummy_page].item()):
+                raise ValueError("only the registered dummy may own a sink flag before qualification")
+            if bool((view.page_to_tail_slot < -1).any().item()) or bool((view.tail_to_page < -1).any().item()):
+                raise ValueError("invalid raw ownership sentinel")
+            mapped = int((view.page_to_tail_slot >= 0).sum().item())
+            owned = int((view.tail_to_page >= 0).sum().item())
+            if mapped != owned or mapped > 1:
+                raise ValueError("live real-page raw ownership forbids qualification transition")
+            if mapped == 1:
+                slot = int(view.page_to_tail_slot[dummy_page].item())
+                if not 0 <= slot < 8 or int(view.tail_to_page[slot].item()) != dummy_page:
+                    raise ValueError("only the registered empty dummy may retain a raw slot")
+        self._qualification_mode = requested_mode
+
+    def check_native_status(self) -> None:
+        """Mandatory post-replay fail-closed check, OUTSIDE CUDA capture.
+
+        Status is sticky across launches/layers. Never clear an error and continue
+        a request: abort it, release affected pages, then clear/reset the pool.
+        """
+        if torch.device(self.device).type == "cuda" and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("native status check belongs after graph replay")
+        status = int(self.workspace.native_status.item())
+        if status & 4:
+            raise KVarNCapacityError("native raw-slot pressure: abort batch and evict actual radix pages")
+        if status != 0:
+            raise RuntimeError(f"native KVarN transaction failed (status bits={status})")
+
+    def register_graph_dummy_pages(self, pages: torch.Tensor) -> None:
+        """Register allocator-reserved empty pages, never request/radix pages."""
+        ids = self._page_ids(pages)
+        if self.native_enabled and not set(ids).issubset(self._graph_dummy_pages):
+            raise RuntimeError("cannot add graph dummy pages after qualification admission")
+        for view in self._views.values():
+            for page in ids:
+                if int(view.valid_lengths[page].item()) != 0:
+                    raise ValueError("graph dummy registration requires empty reserved pages")
+        self.mark_sink_pages(pages)
+        self._graph_dummy_pages = self._graph_dummy_pages.union(ids)
+
+    def reset_graph_dummy_pages(self, layer_id: int, pages: torch.Tensor) -> None:
+        """Reset allocator-reserved dummy pages only; retains raw owner/sink.
+
+        Caller must prove these pages are exclusive graph scratch, not real KV.
+        Called outside capture, never a layer-global provisional discard.
+        """
+        view = self.layer_view(layer_id)
+        ids = self._page_ids(pages)
+        if not set(ids).issubset(self._graph_dummy_pages):
+            raise ValueError("dummy reset requires allocator-registered exclusive pages")
+        if torch.device(self.device).type == "cuda" and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("dummy reset must run outside capture")
+        for page in ids:
+            if not bool(view.sink_pages[page].item()):
+                raise ValueError("dummy pages must be permanently raw-marked before reset")
+        if self.native_enabled:
+            from sglang.kernels.ops.kvarn.store import _reset_dummy_pages
+            if pages.device != view.packed.device or not pages.is_contiguous():
+                raise ValueError("dummy pages must be contiguous on pool CUDA device")
+            if len(ids) > 0:
+                _reset_dummy_pages[(len(ids),)](pages, view.committed_mask,
+                    view.provisional_mask, view.valid_lengths, view.preview_ready, num_warps=4, num_stages=1)
+            return
+        for page in ids:
+            view.committed_mask[page].zero_()
+            view.provisional_mask[page].zero_()
+            view.valid_lengths[page] = 0
+            view.preview_ready[page] = False
+
+    def get_key_buffer(self, layer_id: int) -> torch.Tensor:
+        raise NotImplementedError("KVarN requires layer_view or bounded gather_visible; dense fallback forbidden")
+
+    def get_value_buffer(self, layer_id: int) -> torch.Tensor:
+        raise NotImplementedError("KVarN requires layer_view or bounded gather_visible; dense fallback forbidden")
+
+    def get_kv_buffer(self, layer_id: int) -> tuple[torch.Tensor, torch.Tensor]:
+        raise NotImplementedError("KVarN cannot expose a whole-pool dense KV buffer")
