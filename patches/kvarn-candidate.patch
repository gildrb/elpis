+from sglang.srt.runtime_context import get_platform
+
+if TYPE_CHECKING:
+    from sglang.srt.server_args import ServerArgs
+
+
+def validate_kvarn_candidate(server_args: ServerArgs) -> None:
+    cfg = resolved_view(server_args)
+    dtype = "kvarn_k4v2_g128"
+    enabled = cfg.kv_cache_dtype == dtype
+    selected_backend = cfg.attention_backend in ("kvarn", "kvarn_draft")
+    selected_draft = cfg.speculative_draft_attention_backend == "kvarn_draft"
+    mode = cfg.kvarn_qualification_mode
+    if mode not in ("portable", "native", "graph"):
+        raise ValueError("Unknown KVarN qualification mode")
+    if not enabled:
+        if mode != "portable":
+            raise ValueError("Experimental KVarN modes require KVarN storage")
+        if selected_backend or selected_draft or cfg.speculative_draft_kv_cache_dtype == dtype:
+            raise ValueError("KVarN backends require KVarN target and draft storage")
+        return
+    platform = get_platform()
+    if not platform.is_cuda or platform.device_sm != 86:
+        raise ValueError("This isolated KVarN candidate is restricted to CUDA SM86")
+    if cfg.attention_backend != "kvarn" or not selected_draft:
+        raise ValueError("KVarN requires target kvarn and draft kvarn_draft backends")
+    if cfg.speculative_draft_kv_cache_dtype not in (None, dtype):
+        raise ValueError("The KVarN prototype requires packed target and draft pools")
+    if cfg.speculative_algorithm != "DFLASH":
+        raise ValueError("The KVarN candidate currently supports DFLASH only")
+    if cfg.tp_size != 1 or cfg.pp_size != 1 or cfg.dp_size != 1 or cfg.attn_cp_size != 1 or cfg.dcp_size != 1:
+        raise ValueError("The KVarN candidate requires single-rank execution")
+    if cfg.max_running_requests != 1 or cfg.page_size != 128:
+        raise ValueError("The KVarN candidate requires C1 and page size 128")
+    if cfg.speculative_dflash_block_size != 8 or cfg.speculative_draft_window_size != 2048:
+        raise ValueError("The KVarN candidate requires block 8 and draft window 2048")
+    if cfg.chunked_prefill_size != 1024:
+        raise ValueError("KVarN workspace sizing requires chunked prefill 1024")
+    if cfg.disable_radix_cache:
+        raise ValueError("KVarN qualification must preserve prefix caching")
+    if cfg.enable_hierarchical_cache or cfg.enable_unified_memory or cfg.enable_page_major_kv_layout:
+        raise ValueError("KVarN does not implement hierarchical or unified layouts")
+    if cfg.disaggregation_mode != "null":
+        raise ValueError("KVarN does not implement distributed KV transfer")
+    if cfg.context_length is None or cfg.context_length <= 0 or cfg.context_length > 245760:
+        raise ValueError("KVarN candidate context must be explicit and at most 245760")
+    if cfg.max_total_tokens is None or cfg.max_total_tokens < cfg.context_length + 1024:
+        raise ValueError("KVarN requires an explicit pool cap with 1024 tokens of headroom")
+    if cfg.max_mamba_cache_size != 8 or cfg.mamba_radix_cache_strategy != "extra_buffer":
+        raise ValueError("KVarN candidate preserves K8 extra_buffer Mamba caching")
+    if cfg.mamba_track_interval < 128 or cfg.mamba_track_interval % 128 != 0:
+        raise ValueError("KVarN page128 requires aligned Mamba checkpoint intervals")
+    graph = cfg.cuda_graph_config
+    if mode == "graph":
+        if (graph.decode.backend != Backend.FULL or graph.decode.bs != [1]
+                or graph.prefill.backend != Backend.DISABLED):
+            raise ValueError("Experimental KVarN graph mode requires decode FULL bs[1] and disabled prefill graphs")
+    elif graph.decode.backend != Backend.DISABLED or graph.prefill.backend != Backend.DISABLED:
+        raise ValueError("Portable/native KVarN qualification requires disabled graphs")
+    if mode != "portable" and (cfg.context_length != 245760 or cfg.max_total_tokens != 246784):
+        raise ValueError("Native KVarN resource evidence requires context245760 and pool246784")
+    if not cfg.disable_overlap_schedule:
+        raise ValueError("Portable KVarN transactions require serialized scheduling")
+    if not cfg.disable_flashinfer_autotune:
+        raise ValueError("KVarN qualification requires --disable-flashinfer-autotune for owned dummy inputs")
