+++ b/python/sglang/srt/mem_cache/kvarn_allocator.py
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Page ownership shared by target and draft KVarN caches."""
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Literal
+
+import torch
+
+from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+from sglang.srt.mem_cache.kvarn.pool import KVarNTokenToKVPool
+from sglang.srt.mem_cache.memory_pool import KVCache
+
+if TYPE_CHECKING:
+    from sglang.srt.mem_cache.base_prefix_cache import BasePrefixCache
+
+
+class KVarNPageAllocator(PagedTokenToKVPoolAllocator):
+    def __init__(self, size: int, page_size: int, dtype: torch.dtype, device: str,
+                 kvcache: KVCache, need_sort: bool):
+        if page_size != 128 or need_sort:
+            raise ValueError("KVarN supports local page128 allocation only")
+        self.kvarn_pools: tuple[KVarNTokenToKVPool, ...] = ()
+        self._graph_dummy_locations: torch.Tensor | None = None
+        super().__init__(size, page_size, dtype, device, kvcache, need_sort)
+
+    def register_pool(self, pool: KVarNTokenToKVPool) -> None:
+        if pool.size != self.size or pool.page_size != self.page_size:
+            raise ValueError("Target and draft must share the physical page namespace")
+        if pool in self.kvarn_pools:
+            raise ValueError("KVarN pool is already registered")
+        if len(self.kvarn_pools) >= 2:
+            raise ValueError("KVarN supports exactly one target and one draft pool")
+        from sglang.srt.mem_cache.kvarn_budget import KVarNMemoryBudget
+
+        combined_bytes = sum(item.allocation_bytes for item in self.kvarn_pools) + pool.allocation_bytes
+        if combined_bytes + 80 * 1024 * 1024 > KVarNMemoryBudget().required_bytes(self.size):
+            raise ValueError("KVarN allocations exceed the profiled memory envelope")
+        if self._graph_dummy_locations is not None:
+            pages = self._graph_dummy_locations[:1] // 128
+            pool.register_graph_dummy_pages(pages)
+        self.kvarn_pools = (*self.kvarn_pools, pool)
+        from sglang.srt.runtime_context import get_exec
+
+        mode = get_exec().kernel.kvarn_qualification_mode
+        if mode not in ("portable", "native", "graph"):
+            raise ValueError("Unknown KVarN qualification mode")
+        if mode != "portable":
+            self.reserve_graph_dummy_page()
+            profile: Literal["target_sm86_bf16", "draft_sm86_bf16"] = (
+                "target_sm86_bf16" if pool.layout.head_dim == 256 else "draft_sm86_bf16"
+            )
+            pool.enable_qualification_mode(
+                profile=profile,
+                reviewed_inventory_sha256="e2f2c7311d93d240311fa3280c2c65fafaf93f8b4a3fcf9ac095d28b614291cd",
+                capture=mode == "graph",
+            )
+
+    def reserve_graph_dummy_page(self) -> torch.Tensor:
+        if self._graph_dummy_locations is not None:
+            return self._graph_dummy_locations
+        locations = self.alloc(128)
+        if locations is None:
+            raise MemoryError("No physical page is available for KVarN graph capture")
+        self._graph_dummy_locations = locations
+        pages = locations[:1] // 128
+        for pool in self.kvarn_pools:
+            pool.register_graph_dummy_pages(pages)
+        return locations
+
+    def _release_page_ids(self, *page_ids: torch.Tensor) -> None:
+        if self._graph_dummy_locations is not None:
+            dummy_page = self._graph_dummy_locations[0] // 128
+            for pages in page_ids:
+                if bool(torch.eq(pages, dummy_page).any().item()):
+                    raise ValueError("KVarN graph dummy page is reserved for the runner lifetime")
+        for pool in self.kvarn_pools:
+            for pages in page_ids:
+                pool.release_pages(pages)
+        super()._release_page_ids(*page_ids)
+
+    def clear(self) -> None:
+        for pool in self.kvarn_pools:
+            pool.clear()
+        super().clear()
+        if self._graph_dummy_locations is not None:
+            dummy_page = self._graph_dummy_locations[0] // 128
+            self.free_pages = self.free_pages[self.free_pages != dummy_page]
+            pages = self._graph_dummy_locations[:1] // 128
+            for pool in self.kvarn_pools:
+                pool.register_graph_dummy_pages(pages)
+
+    def evict_to_free_tokens(self, tree_cache: BasePrefixCache | None, num_tokens: int) -> None:
+        from sglang.srt.mem_cache.base_prefix_cache import EvictParams
+
+        if num_tokens < 0:
+            raise ValueError("Negative token reservation")
+        super().evict_to_free_tokens(tree_cache, num_tokens)
+        if tree_cache is None or len(self.kvarn_pools) == 0:
+            return
+        # Target attention writes at most eight rows; committed draft writes
+        # at most 128. One unaligned write spans at most two physical pages.
+        # Keep two further free slots for sink/COW boundary ownership. Cached
+        # sinks consume raw slots and are reclaimed only by unlocked KV eviction.
+        required = 4
+        while min(pool.available_tail_slots() for pool in self.kvarn_pools) < required:
+            result = tree_cache.evict(EvictParams(num_tokens=128))
+            if result.num_tokens_evicted <= 0:
+                break
+
+    def check_decode_capacity(self, *, num_tokens: int, tree_cache: BasePrefixCache | None) -> bool:
+        self.evict_to_free_tokens(tree_cache, num_tokens)
+        required = 4
+        return self.available_size() >= num_tokens and all(
+            pool.available_tail_slots() >= required for pool in self.kvarn_pools
+        )
