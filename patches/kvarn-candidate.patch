+class KVarNPoolConfigurator(MemoryPoolConfigurator):
+    """Price target and globally indexed draft together, including scratch."""
+
+    def __init__(self, kvc: KVCacheConfigurator):
+        from sglang.srt.mem_cache.kvarn_budget import KVarNMemoryBudget
+
+        if kvc.is_draft_worker:
+            raise ValueError("The KVarN draft must reuse the target capacity plan")
+        if kvc.model_config.head_dim != 256 or kvc.model_config.get_num_kv_heads(1) != 4:
+            raise ValueError("KVarN target memory plan requires D256 and four KV heads")
+        mamba_config = mambaish_config(kvc.model_config)
+        if mamba_config is None or len(mamba_config.full_attention_layer_ids) != 16:
+            raise ValueError("KVarN target memory plan requires sixteen hybrid attention layers")
+        if kvc.spec_aux_config.dflash_draft_num_layers != 5:
+            raise ValueError("KVarN memory plan requires the five-layer draft")
+        self.budget = KVarNMemoryBudget()
+
+    def calculate_pool_sizes(self, available_bytes: int, page_size: int) -> MemoryPoolConfig:
+        if page_size != self.budget.page_size:
+            raise ValueError("KVarN memory accounting requires page128")
+        tokens = self.budget.capacity_for_bytes(available_bytes)
+        return MemoryPoolConfig(max_total_num_tokens=tokens)
+
+    def calculate_pool_sizes_from_max_tokens(self, max_total_num_tokens: int, page_size: int) -> MemoryPoolConfig:
+        if page_size != self.budget.page_size:
+            raise ValueError("KVarN memory accounting requires page128")
+        tokens = max_total_num_tokens // page_size * page_size
+        if tokens <= 0:
+            raise ValueError("No complete KVarN token page fits")
+        return MemoryPoolConfig(max_total_num_tokens=tokens)
+
