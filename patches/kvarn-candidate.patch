+++ b/python/sglang/srt/mem_cache/kvarn/types.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Explicit storage and bounded-workspace contracts. No implicit dense cache."""
+from __future__ import annotations
+from dataclasses import dataclass
+import torch
+
+@dataclass(frozen=True)
+class KVarNLayout:
+    head_dim: int
+    kv_heads: int
+    layer_ids: tuple[int, ...]
+    tile_tokens: int = 128
+    key_bits: int = 4
+    value_bits: int = 2
+
+    def __post_init__(self) -> None:
+        if self.head_dim not in (128, 256) or self.kv_heads <= 0:
+            raise ValueError("KVarN requires D128/D256 and positive KV heads")
+        if self.tile_tokens != 128 or (self.key_bits, self.value_bits) != (4, 2):
+            raise ValueError("Only k4v2_g128 is supported")
+        if len(self.layer_ids) == 0 or len(set(self.layer_ids)) != len(self.layer_ids):
+            raise ValueError("layer_ids must be nonempty and unique")
+        if min(self.layer_ids) < 0:
+            raise ValueError("negative layer id")
+
+    @property
+    def tile_bytes(self) -> int:
+        return self.head_dim * self.tile_tokens * 3 // 4 + 6 * (self.head_dim + self.tile_tokens)
+
+@dataclass(frozen=True)
+class KVarNCapacity:
+    token_capacity: int
+    tail_slots: int
+    max_write_tokens: int
+    max_query_tokens: int
+    max_visible_tokens: int
+    workspace_bytes: int
+
+    def __post_init__(self) -> None:
+        values = (self.token_capacity, self.tail_slots, self.max_write_tokens,
+                  self.max_query_tokens, self.max_visible_tokens, self.workspace_bytes)
+        if min(values) <= 0 or self.token_capacity % 128 != 0:
+            raise ValueError("positive capacities and page-aligned token capacity required")
+        if self.max_write_tokens > 128 or self.max_query_tokens > 8:
+            raise ValueError("KVarN storage is bounded to128 write rows and8 query rows; metadata capacity is separate")
+        if self.token_capacity // 128 + 1 > 2147483647:
+            raise ValueError("physical page IDs must fit signed int32 metadata")
+        if self.tail_slots < 8:
+            raise ValueError("at least8 raw slots required for dummy/sink/tail/write/COW admission")
+
+@dataclass(frozen=True)
+class KVarNLayerView:
+    packed: torch.Tensor
+    raw_keys: torch.Tensor
+    raw_values: torch.Tensor
+    page_to_tail_slot: torch.Tensor
+    valid_lengths: torch.Tensor
+    layout: KVarNLayout
+    committed_mask: torch.Tensor
+    provisional_mask: torch.Tensor
+    sink_pages: torch.Tensor
+    tail_to_page: torch.Tensor
+    preview_ready: torch.Tensor
+
+@dataclass(frozen=True)
+class KVarNWorkspace:
+    """One serialized workspace per pool, never one per layer.
+
+    eager_reserve_bytes charges bounded PyTorch operator temporaries. They are
+    NOT graph-safe arena allocations. This portable implementation is eager only.
+    Gather outputs alias this workspace until its next use.
+    """
+    keys: torch.Tensor
+    values: torch.Tensor
+    output: torch.Tensor
+    max_write_tokens: int
+    max_visible_tokens: int
+    eager_reserve_bytes: int
+    native_partial_output: torch.Tensor
+    native_partial_lse: torch.Tensor
+    native_status: torch.Tensor
+    native_seal_pages: torch.Tensor
+    native_rotated_keys: torch.Tensor
+
+    @property
+    def allocation_bytes(self) -> int:
+        return sum(t.numel() * t.element_size() for t in (self.keys, self.values, self.output, self.native_partial_output, self.native_partial_lse, self.native_status, self.native_seal_pages, self.native_rotated_keys)) + self.eager_reserve_bytes
+
+    @classmethod
+    def create(cls, layout: KVarNLayout, capacity: KVarNCapacity,
+               dtype: torch.dtype, device: str, max_query_heads: int) -> KVarNWorkspace:
+        if max_query_heads < layout.kv_heads or max_query_heads % layout.kv_heads != 0:
+            raise ValueError("query heads must be a positive multiple of KV heads")
+        # The gather bound is TOTAL rows, not rows per batch item.
+        shape = (capacity.max_visible_tokens, layout.kv_heads, layout.head_dim)
+        output_shape = (capacity.max_query_tokens, max_query_heads, layout.head_dim)
+        # One head/tile's Sinkhorn/RTN/rotation and one query's score/accumulator.
+        reserve = (64 * 128 * layout.head_dim * 4
+                   + 32 * max_query_heads * layout.head_dim * 4
+                   + 4 * capacity.max_write_tokens * layout.kv_heads * layout.head_dim * dtype.itemsize)
+        native_bytes = (8 * max_query_heads * 16 * (layout.head_dim + 1) * 4 + 4 + capacity.tail_slots * 4
+                        + capacity.tail_slots * layout.kv_heads * layout.head_dim * 128 * 4)
+        required = (2 * capacity.max_visible_tokens * layout.kv_heads * layout.head_dim
+                    + capacity.max_query_tokens * max_query_heads * layout.head_dim) * dtype.itemsize + reserve + native_bytes
+        if required > capacity.workspace_bytes:
+            raise ValueError(f"workspace budget {capacity.workspace_bytes} < required {required}")
+        return cls(torch.empty(shape, dtype=dtype, device=device),
+                   torch.empty(shape, dtype=dtype, device=device),
+                   torch.empty(output_shape, dtype=dtype, device=device),
+                   capacity.max_write_tokens, capacity.max_visible_tokens,
+                   capacity.workspace_bytes - (required - reserve),
+                   torch.empty((8, max_query_heads, 16, layout.head_dim), dtype=torch.float32, device=device),
+                   torch.empty((8, max_query_heads, 16), dtype=torch.float32, device=device),
+                   torch.zeros((1,), dtype=torch.int32, device=device),
+                   torch.full((capacity.tail_slots,), -1, dtype=torch.int32, device=device),
+                   torch.empty((capacity.tail_slots, layout.kv_heads, layout.head_dim, 128), dtype=torch.float32, device=device))
