@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Conservative, explicit memory envelope for the isolated KVarN candidate."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class KVarNMemoryBudget:
+    """Both packed pools, metadata, raw tails, and two bounded workspaces.
+
+    The fixed reserve includes 189 MiB for 18 raw slots in all 21 layers,
+    two 64 MiB workspace caps, and 99 MiB for FlashInfer plans, null pages,
+    and auxiliary state. Five independent plans retain 72 MiB GPU scratch.
+    This is an upper budget, not a measurement of available device memory.
+    """
+
+    packed_bytes_per_token: int = 17760
+    metadata_bytes_per_token: int = 64
+    fixed_bytes: int = 416 * 1024 * 1024
+    page_size: int = 128
+
+    def capacity_for_bytes(self, available_bytes: int) -> int:
+        if available_bytes <= self.fixed_bytes:
+            raise ValueError("KVarN fixed pools and workspace exceed the available budget")
+        tokens = (available_bytes - self.fixed_bytes) // (
+            self.packed_bytes_per_token + self.metadata_bytes_per_token
+        )
+        return tokens // self.page_size * self.page_size
+
+    def required_bytes(self, token_capacity: int) -> int:
+        if token_capacity <= 0 or token_capacity % self.page_size != 0:
+            raise ValueError("KVarN capacity must be positive and page aligned")
+        return self.fixed_bytes + token_capacity * (
+            self.packed_bytes_per_token + self.metadata_bytes_per_token
+        )
