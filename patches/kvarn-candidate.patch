+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Bounded eager packed attention. Shared-query verify optimization is absent."""
+from math import isfinite
+import torch
+from sglang.srt.mem_cache.kvarn.types import KVarNLayerView, KVarNWorkspace
+from sglang.srt.mem_cache.kvarn.layout import KVarNOffsets
+from .sinkhorn import hadamard
+
+def unpack_rows(data: torch.Tensor, rows: int, columns: int, bits: int) -> torch.Tensor:
+    if bits not in (2, 4) or columns % (8 // bits) != 0:
+        raise ValueError("invalid packed shape")
+    pack = 8 // bits
+    packed = data.reshape(rows, columns // pack)
+    out = torch.empty((rows, columns), dtype=torch.float32, device=data.device)
+    for j in range(pack):
+        out[:, j::pack] = (packed >> (j * bits)) & ((1 << bits) - 1)
+    return out
+
+def decode_head(view: KVarNLayerView, page: int, head: int, *, prefer_preview: bool = False) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return one head/tile in original (unrotated) coordinates."""
+    if page <= 0 or page >= view.packed.shape[0] or not 0 <= head < view.layout.kv_heads:
+        raise ValueError("invalid physical page/head (page zero is reserved)")
+    slot = int(view.page_to_tail_slot[page].item())
+    use_preview = (prefer_preview and bool(view.preview_ready[page].item())
+                   and not bool(view.sink_pages[page].item()))
+    if slot >= 0 and not use_preview:
+        return view.raw_keys[slot, :, head], view.raw_values[slot, :, head]
+    if int(view.valid_lengths[page].item()) != 128:
+        raise ValueError("attempt to read unowned/unsealed page")
+    d = view.layout.head_dim
+    o = KVarNOffsets.from_layout(view.layout)
+    record = view.packed[page, head]
+    kq = unpack_rows(record[o.k_packed:o.k_scale], d, 128, 4)
+    ks = record[o.k_scale:o.k_zero].view(torch.float16).float()
+    kz = record[o.k_zero:o.k_token].view(torch.float16).float()
+    kt = record[o.k_token:o.v_packed].view(torch.float16).float()
+    vq = unpack_rows(record[o.v_packed:o.v_channel], 128, d, 2)
+    vc = record[o.v_channel:o.v_scale].view(torch.float16).float()
+    vs = record[o.v_scale:o.v_zero].view(torch.float16).float()
+    vz = record[o.v_zero:o.end].view(torch.float16).float()
+    kr = ((kq * ks[:, None] + kz[:, None]) * kt[None, :]).T
+    vr = (vq * vs[:, None] + vz[:, None]) * vc[None, :]
+    return hadamard(kr), hadamard(vr)
+
+def packed_attention(Q: torch.Tensor, view: KVarNLayerView,
+                     request_page_table: torch.Tensor, query_request_ids: torch.Tensor,
+                     lower_bounds: torch.Tensor, upper_bounds: torch.Tensor,
+                     scale: float, fixedworkspace: KVarNWorkspace) -> torch.Tensor:
+    """Per-query online softmax; bounds are [lower,upper) logical token indices.
+
+    No context-sized dequantization or score tensor. Empty rows return zero.
+    Bounds must already encode causal/sliding-window/tree visibility.
+    """
+    if Q.ndim != 3 or Q.shape[2] != view.layout.head_dim:
+        raise ValueError("Q must be [queries,query_heads,D]")
+    n, heads, _ = Q.shape
+    if heads % view.layout.kv_heads != 0 or heads <= 0:
+        raise ValueError("invalid grouped query heads")
+    if n > fixedworkspace.output.shape[0] or heads > fixedworkspace.output.shape[1]:
+        raise ValueError("query workspace capacity exceeded")
+    if request_page_table.ndim != 2 or request_page_table.dtype not in (torch.int32, torch.int64):
+        raise ValueError("integer [requests,pages] page table required")
+    for tensor in (query_request_ids, lower_bounds, upper_bounds):
+        if tensor.shape != (n,) or tensor.dtype not in (torch.int32, torch.int64):
+            raise ValueError("integer per-query request ids and bounds required")
+    if not isfinite(scale) or scale <= 0:
+        raise ValueError("attention scale must be positive finite")
+    if Q.device != view.packed.device or Q.device != fixedworkspace.output.device:
+        raise ValueError("Q/cache/workspace device mismatch")
+    if Q.dtype != fixedworkspace.output.dtype:
+        raise ValueError("Q/workspace dtype mismatch")
+    if not bool(torch.isfinite(Q).all().item()):
+        raise ValueError("nonfinite query")
+    output = fixedworkspace.output[:n, :heads]
+    output.zero_()
+    group = heads // view.layout.kv_heads
+    for qi in range(n):
+        request = int(query_request_ids[qi].item())
+        lower, upper = int(lower_bounds[qi].item()), int(upper_bounds[qi].item())
+        if not 0 <= request < request_page_table.shape[0] or not 0 <= lower <= upper <= request_page_table.shape[1] * 128:
+            raise ValueError("query request or visibility bounds out of range")
+        if lower >= upper:
+            continue
+        for head in range(heads):
+            maximum = torch.full((), -torch.inf, device=Q.device)
+            denominator = torch.zeros((), device=Q.device)
+            numerator = torch.zeros(view.layout.head_dim, device=Q.device)
+            query = Q[qi, head].float()
+            for logical_page in range(lower // 128, (upper + 127) // 128):
+                physical = int(request_page_table[request, logical_page].item())
+                start = max(lower - logical_page * 128, 0)
+                end = min(upper - logical_page * 128, 128)
+                if physical <= 0 or physical >= view.packed.shape[0]:
+                    raise ValueError("invalid physical page")
+                visible = view.committed_mask[physical, start:end] | view.provisional_mask[physical, start:end]
+                if not bool(visible.all().item()):
+                    raise ValueError("visibility includes unwritten KV")
+                keys, values = decode_head(view, physical, head // group,
+                                           prefer_preview=upper > (logical_page + 1) * 128)
+                scores = torch.mv(keys[start:end].float(), query) * scale
+                next_max = torch.maximum(maximum, scores.amax())
+                old_weight = torch.exp(maximum - next_max)
+                weights = torch.exp(scores - next_max)
+                numerator = numerator * old_weight + torch.matmul(weights, values[start:end].float())
+                denominator = denominator * old_weight + weights.sum()
+                maximum = next_max
+            output[qi, head].copy_(numerator / denominator.clamp_min(1e-30))
+    return output
+
+
+import triton
+import triton.language as tl
+
+@triton.jit
+def _packed_attention_split(
+    Q, Table, RequestIds, Lower, Upper, Packed, RawK, RawV, PageToSlot,
+    Committed, Provisional, Preview, Sink, Partial, Lse, Status, Scale,
+    Q_STRIDE: tl.constexpr, Q_HEAD_STRIDE: tl.constexpr,
+    TABLE_STRIDE: tl.constexpr, TABLE_WIDTH: tl.constexpr, REQUESTS: tl.constexpr,
+    PARTIAL_Q_STRIDE: tl.constexpr, PARTIAL_H_STRIDE: tl.constexpr,
+    LSE_Q_STRIDE: tl.constexpr, LSE_H_STRIDE: tl.constexpr,
+    D: tl.constexpr, H: tl.constexpr, HQ: tl.constexpr,
+    PAGES: tl.constexpr, SLOTS: tl.constexpr, TILE_BYTES: tl.constexpr,
+    SPLITS: tl.constexpr, BLOCK: tl.constexpr,
+    K_SCALE: tl.constexpr, K_ZERO: tl.constexpr, K_TOKEN: tl.constexpr,
+    V_PACKED: tl.constexpr, V_CHANNEL: tl.constexpr, V_SCALE: tl.constexpr,
+    V_ZERO: tl.constexpr,
+):
+    qi = tl.program_id(0)
+    head = tl.program_id(1)
+    split = tl.program_id(2)
+    kv_head = head // (HQ // H)
+    request = tl.load(RequestIds + qi)
+    lower = tl.load(Lower + qi)
+    upper = tl.load(Upper + qi)
+    metadata_ok = (request >= 0) & (request < REQUESTS) & (lower >= 0) & (upper >= lower) & (upper <= TABLE_WIDTH * 128)
+    tl.atomic_or(Status, tl.where(metadata_ok, 0, 1))
+    lower = tl.where(metadata_ok, lower, 0)
+    upper = tl.where(metadata_ok, upper, 0)
+    d = tl.arange(0, D)
+    q = tl.load(Q + qi * Q_STRIDE + head * Q_HEAD_STRIDE + d).to(tl.float32)
+    query_ok = tl.sum((tl.abs(q) <= 3.402823466e38).to(tl.int32), 0) == D
+    tl.atomic_or(Status, tl.where(query_ok, 0, 1))
+    q = tl.where(query_ok, q, 0.0)
+    rotated_q = q
+    for bit in tl.static_range(0, 8 if D == 256 else 7):
+        step = 1 << bit
+        partner = tl.gather(rotated_q, d ^ step, axis=0)
+        rotated_q = tl.where((d & step) == 0, rotated_q + partner, partner - rotated_q)
+    rotated_q = rotated_q * (D ** -0.5)
+    first_page = lower // 128
+    pages = tl.where(upper > lower, (upper + 127) // 128 - first_page, 0)
+    per_split = (pages + SPLITS - 1) // SPLITS
+    begin = first_page + split * per_split
+    end = tl.minimum(begin + per_split, first_page + pages)
+    maximum = tl.full((), -float("inf"), tl.float32)
+    denominator = tl.full((), 0.0, tl.float32)
+    raw_acc = tl.full((D,), 0.0, tl.float32)
+    rotated_acc = tl.full((D,), 0.0, tl.float32)
+    for logical in range(begin, end):
+        page = tl.load(Table + request * TABLE_STRIDE + logical)
+        in_range = (page > 0) & (page < PAGES)
+        slot = tl.load(PageToSlot + page, mask=in_range, other=-1)
+        page_ok = in_range & (slot < SLOTS)
+        tl.atomic_or(Status, tl.where(page_ok, 0, 1))
+        preview = tl.load(Preview + page, mask=page_ok, other=0)
+        sink = tl.load(Sink + page, mask=page_ok, other=0)
+        use_raw = (slot >= 0) & (sink | ~(preview & (upper > (logical + 1) * 128)))
+        base = (page.to(tl.int64) * H + kv_head) * TILE_BYTES
+        halves = (Packed + base).to(tl.pointer_type(tl.float16))
+        for start in range(0, 128, BLOCK):
+            token = start + tl.arange(0, BLOCK)
+            active = (logical * 128 + token >= lower) & (logical * 128 + token < upper)
+            committed = tl.load(Committed + page * 128 + token, mask=page_ok & active, other=0)
+            provisional = tl.load(Provisional + page * 128 + token, mask=page_ok & active, other=0)
+            valid = page_ok & active & (committed | provisional)
+            missing = tl.sum((active & ~valid).to(tl.int32), 0) > 0
+            tl.atomic_or(Status, tl.where(missing, 1, 0))
+            if use_raw:
+                offset = ((slot.to(tl.int64) * 128 + token[:, None]) * H + kv_head) * D + d[None, :]
+                keys = tl.load(RawK + offset, mask=valid[:, None], other=0.0).to(tl.float32)
+                values = tl.load(RawV + offset, mask=valid[:, None], other=0.0).to(tl.float32)
+                scores = tl.sum(keys * q[None, :], axis=1) * Scale
+            else:
+                ks = tl.load(halves + K_SCALE // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+                kz = tl.load(halves + K_ZERO // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+                kt = tl.load(halves + K_TOKEN // 2 + token, mask=valid, other=0.0).to(tl.float32)
+                kbyte = tl.load(Packed + base + d[None, :] * 64 + token[:, None] // 2,
+                                mask=valid[:, None], other=0).to(tl.int32)
+                keys = (((kbyte >> ((token[:, None] % 2) * 4)) & 15).to(tl.float32) * ks[None, :] + kz[None, :]) * kt[:, None]
+                vc = tl.load(halves + V_CHANNEL // 2 + d, mask=page_ok, other=0.0).to(tl.float32)
+                vs = tl.load(halves + V_SCALE // 2 + token, mask=valid, other=0.0).to(tl.float32)
+                vz = tl.load(halves + V_ZERO // 2 + token, mask=valid, other=0.0).to(tl.float32)
+                vbyte = tl.load(Packed + base + V_PACKED + token[:, None] * (D // 4) + d[None, :] // 4,
+                                mask=valid[:, None], other=0).to(tl.int32)
+                values = (((vbyte >> ((d[None, :] % 4) * 2)) & 3).to(tl.float32) * vs[:, None] + vz[:, None]) * vc[None, :]
+                scores = tl.sum(keys * rotated_q[None, :], axis=1) * Scale
+            scores = tl.where(valid, scores, -float("inf"))
+            new_max = tl.maximum(maximum, tl.max(scores, 0))
+            live = new_max > -float("inf")
+            alpha = tl.where(live, tl.exp(maximum - new_max), 0.0)
+            probability = tl.where(live & valid, tl.exp(scores - new_max), 0.0)
+            raw_acc = raw_acc * alpha
+            rotated_acc = rotated_acc * alpha
+            contribution = tl.sum(probability[:, None] * values, axis=0)
+            if use_raw:
+                raw_acc = raw_acc + contribution
+            else:
+                rotated_acc = rotated_acc + contribution
+            denominator = denominator * alpha + tl.sum(probability, 0)
+            maximum = new_max
+    for bit in tl.static_range(0, 8 if D == 256 else 7):
+        step = 1 << bit
+        partner = tl.gather(rotated_acc, d ^ step, axis=0)
+        rotated_acc = tl.where((d & step) == 0, rotated_acc + partner, partner - rotated_acc)
+    numerator = raw_acc + rotated_acc * (D ** -0.5)
+    nonempty = denominator > 0
+    safe_denominator = tl.where(nonempty, denominator, 1.0)
+    output = numerator / safe_denominator
+    lse = tl.where(nonempty, maximum + tl.log(safe_denominator), -float("inf"))
+    tl.store(Partial + qi * PARTIAL_Q_STRIDE + head * PARTIAL_H_STRIDE + split * D + d, output)
+    tl.store(Lse + qi * LSE_Q_STRIDE + head * LSE_H_STRIDE + split, lse)
+
+
+@triton.jit
+def _packed_attention_reduce(
+    Partial, Lse, Output,
+    PARTIAL_Q_STRIDE: tl.constexpr, PARTIAL_H_STRIDE: tl.constexpr,
+    LSE_Q_STRIDE: tl.constexpr, LSE_H_STRIDE: tl.constexpr,
+    OUTPUT_Q_STRIDE: tl.constexpr, OUTPUT_H_STRIDE: tl.constexpr,
+    D: tl.constexpr, SPLITS: tl.constexpr,
+):
+    qi = tl.program_id(0)
+    head = tl.program_id(1)
+    split = tl.arange(0, SPLITS)
+    d = tl.arange(0, D)
+    lse = tl.load(Lse + qi * LSE_Q_STRIDE + head * LSE_H_STRIDE + split)
+    maximum = tl.max(lse, 0)
+    live = maximum > -float("inf")
+    weights = tl.where(live, tl.exp(lse - maximum), 0.0)
+    partial = tl.load(Partial + qi * PARTIAL_Q_STRIDE + head * PARTIAL_H_STRIDE + split[:, None] * D + d[None, :])
+    denominator = tl.sum(weights, 0)
+    out = tl.sum(weights[:, None] * partial, axis=0) / tl.where(denominator > 0, denominator, 1.0)
+    tl.store(Output + qi * OUTPUT_Q_STRIDE + head * OUTPUT_H_STRIDE + d, out)
+
+
+def packed_attention_out(Q: torch.Tensor, view: KVarNLayerView,
+                         request_page_table: torch.Tensor, query_request_ids: torch.Tensor,
+                         lower_bounds: torch.Tensor, upper_bounds: torch.Tensor,
+                         scale: float, fixedworkspace: KVarNWorkspace) -> torch.Tensor:
+    """Native fixed-capacity, independent-per-query split-KV attention.
+
+    Original-coordinate raw tiles and rotated packed tiles are accumulated
+    separately. Only the packed accumulator is inverse transformed. No
+    context-length scratch and no shared-query speculative verification path.
+    Caller clears/checks workspace.native_status at transaction boundaries.
+    """
+    if Q.ndim != 3 or Q.shape[2] != view.layout.head_dim:
+        raise ValueError("native query shape mismatch")
+    queries, heads, d = Q.shape
+    partial, lse = fixedworkspace.native_partial_output, fixedworkspace.native_partial_lse
+    if queries < 1 or queries > partial.shape[0] or heads < 1 or heads > partial.shape[1] or heads % view.layout.kv_heads != 0:
+        raise ValueError("native attention requires at most eight queries and valid grouped heads")
+    if Q.dtype != fixedworkspace.output.dtype or not isfinite(scale) or scale <= 0:
+        raise ValueError("invalid native query dtype/scale")
+    if request_page_table.ndim != 2 or request_page_table.dtype not in (torch.int32, torch.int64):
+        raise ValueError("native page table must be integer matrix")
+    for tensor in (query_request_ids, lower_bounds, upper_bounds):
+        if tensor.shape != (queries,) or tensor.dtype not in (torch.int32, torch.int64):
+            raise ValueError("native query metadata must be integer per-query vectors")
+    for tensor in (Q, request_page_table, query_request_ids, lower_bounds, upper_bounds):
+        if not tensor.is_cuda or tensor.device != view.packed.device or not tensor.is_contiguous():
+            raise ValueError("native attention inputs must be contiguous on cache CUDA device")
+    o = KVarNOffsets.from_layout(view.layout)
+    _packed_attention_split[(queries, heads, partial.shape[2])](
+        Q, request_page_table, query_request_ids, lower_bounds, upper_bounds,
+        view.packed, view.raw_keys, view.raw_values, view.page_to_tail_slot,
+        view.committed_mask, view.provisional_mask, view.preview_ready, view.sink_pages, partial, lse,
+        fixedworkspace.native_status, scale,
+        Q_STRIDE=Q.stride(0), Q_HEAD_STRIDE=Q.stride(1),
+        TABLE_STRIDE=request_page_table.stride(0), TABLE_WIDTH=request_page_table.shape[1], REQUESTS=request_page_table.shape[0],
+        PARTIAL_Q_STRIDE=partial.stride(0), PARTIAL_H_STRIDE=partial.stride(1),
+        LSE_Q_STRIDE=lse.stride(0), LSE_H_STRIDE=lse.stride(1),
+        D=d, H=view.layout.kv_heads, HQ=heads, PAGES=view.packed.shape[0],
+        SLOTS=view.raw_keys.shape[0], TILE_BYTES=view.layout.tile_bytes,
+        SPLITS=partial.shape[2], BLOCK=32,
+        K_SCALE=o.k_scale, K_ZERO=o.k_zero, K_TOKEN=o.k_token,
+        V_PACKED=o.v_packed, V_CHANNEL=o.v_channel, V_SCALE=o.v_scale,
+        V_ZERO=o.v_zero, num_warps=8, num_stages=1)
+    output = fixedworkspace.output[:queries, :heads]
+    _packed_attention_reduce[(queries, heads)](
+        partial, lse, output, PARTIAL_Q_STRIDE=partial.stride(0), PARTIAL_H_STRIDE=partial.stride(1),
+        LSE_Q_STRIDE=lse.stride(0), LSE_H_STRIDE=lse.stride(1),
+        OUTPUT_Q_STRIDE=output.stride(0), OUTPUT_H_STRIDE=output.stride(1),
+        D=d, SPLITS=partial.shape[2], num_warps=4, num_stages=1)
+    return output
