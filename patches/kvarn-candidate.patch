@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Byte-compatible k4v2_g128 record offsets (no power-of-two slot padding)."""
+from dataclasses import dataclass
+import torch
+from .types import KVarNCapacity, KVarNLayout
+
+@dataclass(frozen=True)
+class KVarNOffsets:
+    k_packed: int
+    k_scale: int
+    k_zero: int
+    k_token: int
+    v_packed: int
+    v_channel: int
+    v_scale: int
+    v_zero: int
+    end: int
+
+    @classmethod
+    def from_layout(cls, layout: KVarNLayout) -> "KVarNOffsets":
+        d, g = layout.head_dim, layout.tile_tokens
+        ks = d * g // 2
+        kz = ks + 2 * d
+        kt = kz + 2 * d
+        vp = kt + 2 * g
+        vc = vp + g * d // 4
+        vs = vc + 2 * d
+        vz = vs + 2 * g
+        return cls(0, ks, kz, kt, vp, vc, vs, vz, vz + 2 * g)
+
+
+def allocated_bytes_estimate(layout: KVarNLayout, capacity: KVarNCapacity,
+                             max_query_heads: int, dtype: torch.dtype) -> int:
+    """Pure pre-allocation ledger, including null page and full scratch budget.
+
+    No tensors are allocated. Mirrors KVarNWorkspace.create shape validation.
+    """
+    if dtype not in (torch.float16, torch.bfloat16):
+        raise ValueError("raw cache requires fp16/bf16")
+    if max_query_heads < layout.kv_heads or max_query_heads % layout.kv_heads != 0:
+        raise ValueError("invalid query-head count")
+    reserve = (64 * 128 * layout.head_dim * 4
+               + 32 * max_query_heads * layout.head_dim * 4
+               + 4 * capacity.max_write_tokens * layout.kv_heads * layout.head_dim * dtype.itemsize)
+    workspace_tensors = (2 * capacity.max_visible_tokens * layout.kv_heads * layout.head_dim
+                         + capacity.max_query_tokens * max_query_heads * layout.head_dim) * dtype.itemsize
+    native_bytes = (8 * max_query_heads * 16 * (layout.head_dim + 1) * 4 + 4 + capacity.tail_slots * 4
+                    + capacity.tail_slots * layout.kv_heads * layout.head_dim * 128 * 4)
+    if workspace_tensors + reserve + native_bytes > capacity.workspace_bytes:
+        raise ValueError("workspace budget below portable operation requirement")
+    pages = capacity.token_capacity // 128 + 1
+    packed = pages * layout.kv_heads * layout.tile_bytes
+    raw = 2 * capacity.tail_slots * 128 * layout.kv_heads * layout.head_dim * dtype.itemsize
+    metadata = pages * (4 + 4 + 128 + 128 + 1 + 1) + capacity.tail_slots * 4
+    return len(layout.layer_ids) * (packed + raw + metadata) + capacity.workspace_bytes
