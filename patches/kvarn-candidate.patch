+++ b/python/sglang/kernels/ops/kvarn/store.py
@@ -0,0 +1,492 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Tile-local k4v2 quantization. Never seal a partially committed tile."""
+import torch
+from sglang.srt.mem_cache.kvarn.types import KVarNLayout
+from sglang.srt.mem_cache.kvarn.layout import KVarNOffsets
+from .sinkhorn import hadamard, variance_normalize
+
+def quantize_rows(tile: torch.Tensor, bits: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    if bits not in (2, 4) or tile.shape[-1] % (8 // bits) != 0:
+        raise ValueError("invalid packing width")
+    balanced, col, row = variance_normalize(tile)
+    lo = balanced.amin(dim=1, keepdim=True)
+    scale = ((balanced.amax(dim=1, keepdim=True) - lo) / ((1 << bits) - 1)).clamp_min(1e-10)
+    q = ((balanced - lo) / scale).round().clamp(0, (1 << bits) - 1).to(torch.uint8)
+    pack = 8 // bits
+    parts = q.reshape(q.shape[0], q.shape[1] // pack, pack)
+    packed = parts[..., 0].clone()
+    for j in range(1, pack):
+        packed.bitwise_or_(parts[..., j] << (j * bits))
+    return packed, (row * scale).flatten().half(), (row * lo).flatten().half(), col.flatten().half()
+
+def store_tile(keys: torch.Tensor, values: torch.Tensor, record: torch.Tensor, layout: KVarNLayout) -> None:
+    expected = (128, layout.kv_heads, layout.head_dim)
+    if tuple(keys.shape) != expected or tuple(values.shape) != expected:
+        raise ValueError("store requires one complete raw tile")
+    if record.shape != (layout.kv_heads, layout.tile_bytes) or record.dtype != torch.uint8:
+        raise ValueError("invalid packed destination")
+    offsets = KVarNOffsets.from_layout(layout)
+    for head in range(layout.kv_heads):
+        kp, ks, kz, kt = quantize_rows(hadamard(keys[:, head]).T, 4)
+        vp, vs, vz, vc = quantize_rows(hadamard(values[:, head]), 2)
+        fields = ((offsets.k_packed, kp), (offsets.k_scale, ks), (offsets.k_zero, kz),
+                  (offsets.k_token, kt), (offsets.v_packed, vp), (offsets.v_channel, vc),
+                  (offsets.v_scale, vs), (offsets.v_zero, vz))
+        for offset, value in fields:
+            if value.is_floating_point() and not bool(torch.isfinite(value).all().item()):
+                raise ValueError("fp16 scale overflow; raw tile retained")
+            data = value.contiguous().view(torch.uint8).flatten()
+            record[head, offset:offset + data.numel()].copy_(data)
+
+
+# Native RTN continuation, same row orientation/scale absorption as reference.
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
+
+@triton.jit
+def _pack_balanced_rows(
+    Balanced, ColScale, RowScale, Packed, PageId, Status,
+    D: tl.constexpr, H: tl.constexpr, TILE_BYTES: tl.constexpr,
+    NUM_PAGES: tl.constexpr, IS_KEY: tl.constexpr,
+    K_SCALE: tl.constexpr, K_ZERO: tl.constexpr, K_TOKEN: tl.constexpr,
+    V_PACKED: tl.constexpr, V_CHANNEL: tl.constexpr,
+    V_SCALE: tl.constexpr, V_ZERO: tl.constexpr,
+):
+    head = tl.program_id(0)
+    row = tl.program_id(1)
+    if IS_KEY:
+        R: tl.constexpr = D
+        C: tl.constexpr = 128
+        BITS: tl.constexpr = 4
+    else:
+        R: tl.constexpr = 128
+        C: tl.constexpr = D
+        BITS: tl.constexpr = 2
+    PACK: tl.constexpr = 8 // BITS
+    cols = tl.arange(0, C)
+    vals = tl.load(Balanced + head * R * C + row * C + cols)
+    lo = tl.min(vals, 0)
+    hi = tl.max(vals, 0)
+    scale = tl.maximum((hi - lo) / ((1 << BITS) - 1), 1e-10)
+    # libdevice.nearbyint supplies ties-to-even like torch.round.
+    q = libdevice.nearbyint((vals - lo) / scale)
+    q = tl.minimum(tl.maximum(q, 0), (1 << BITS) - 1).to(tl.int32)
+    byte_cols = tl.arange(0, C // PACK)
+    byte = tl.full((C // PACK,), 0, tl.int32)
+    for j in tl.static_range(PACK):
+        byte = byte | (tl.gather(q, byte_cols * PACK + j, axis=0) << (j * BITS))
+    row_scale = tl.load(RowScale + head * R + row)
+    absorbed_scale = row_scale * scale
+    absorbed_zero = row_scale * lo
+    cols_scale = tl.load(ColScale + head * C + cols)
+    finite_vals = tl.sum((tl.abs(vals) <= 3.402823466e38).to(tl.int32), 0) == C
+    finite_scales = (tl.abs(absorbed_scale) <= 65504.0) & (tl.abs(absorbed_zero) <= 65504.0)
+    finite_scales = finite_scales & (tl.sum((tl.abs(cols_scale) <= 65504.0).to(tl.int32), 0) == C)
+    page = tl.load(PageId)
+    valid = (page > 0) & (page < NUM_PAGES) & finite_vals & finite_scales
+    tl.atomic_or(Status, tl.where(valid, 0, 1))
+    base = (page.to(tl.int64) * H + head) * TILE_BYTES
+    if IS_KEY:
+        tl.store(Packed + base + row * (C // PACK) + byte_cols, byte.to(tl.uint8), mask=valid)
+        halves = (Packed + base).to(tl.pointer_type(tl.float16))
+        tl.store(halves + K_SCALE // 2 + row, absorbed_scale, mask=valid)
+        tl.store(halves + K_ZERO // 2 + row, absorbed_zero, mask=valid)
+        if row == 0:
+            tl.store(halves + K_TOKEN // 2 + cols, cols_scale, mask=valid)
+    else:
+        tl.store(Packed + base + V_PACKED + row * (C // PACK) + byte_cols, byte.to(tl.uint8), mask=valid)
+        halves = (Packed + base).to(tl.pointer_type(tl.float16))
+        tl.store(halves + V_SCALE // 2 + row, absorbed_scale, mask=valid)
+        tl.store(halves + V_ZERO // 2 + row, absorbed_zero, mask=valid)
+        if row == 0:
+            tl.store(halves + V_CHANNEL // 2 + cols, cols_scale, mask=valid)
+
+
+def store_balanced_out(balanced: torch.Tensor, column_scales: torch.Tensor,
+                       row_scales: torch.Tensor, packed: torch.Tensor,
+                       page_id: torch.Tensor, status: torch.Tensor,
+                       layout: KVarNLayout, *, is_key: bool) -> None:
+    """Fixed-output native RTN, one page. Caller clears status before K+V.
+
+    Status bit 0 reports invalid data/page. Caller MUST keep the page raw until
+    BOTH launches complete without errors. This routine does not publish a seal.
+    It performs no allocations or data-dependent host synchronization.
+    """
+    rows, columns = (layout.head_dim, 128) if is_key else (128, layout.head_dim)
+    if balanced.shape != (layout.kv_heads, rows, columns):
+        raise ValueError("balanced native tile shape mismatch")
+    if column_scales.shape != (layout.kv_heads, columns) or row_scales.shape != (layout.kv_heads, rows):
+        raise ValueError("native tile scale shape mismatch")
+    if packed.ndim != 3 or packed.shape[1:] != (layout.kv_heads, layout.tile_bytes) or packed.dtype != torch.uint8:
+        raise ValueError("invalid native packed cache")
+    for tensor in (balanced, column_scales, row_scales):
+        if tensor.dtype != torch.float32:
+            raise ValueError("native balanced tiles/scales must be fp32")
+    if page_id.numel() != 1 or page_id.dtype not in (torch.int32, torch.int64):
+        raise ValueError("page id must be one device integer")
+    if status.numel() != 1 or status.dtype != torch.int32:
+        raise ValueError("status must be one int32 device word")
+    for tensor in (balanced, column_scales, row_scales, packed, page_id, status):
+        if not tensor.is_cuda or tensor.device != packed.device or not tensor.is_contiguous():
+            raise ValueError("native store requires contiguous tensors on one CUDA device")
+    offsets = KVarNOffsets.from_layout(layout)
+    _pack_balanced_rows[(layout.kv_heads, rows)](
+        balanced, column_scales, row_scales, packed, page_id, status,
+        D=layout.head_dim, H=layout.kv_heads, TILE_BYTES=layout.tile_bytes,
+        NUM_PAGES=packed.shape[0], IS_KEY=is_key,
+        K_SCALE=offsets.k_scale, K_ZERO=offsets.k_zero, K_TOKEN=offsets.k_token,
+        V_PACKED=offsets.v_packed, V_CHANNEL=offsets.v_channel,
+        V_SCALE=offsets.v_scale, V_ZERO=offsets.v_zero, num_warps=4, num_stages=1)
+
+
+@triton.jit(do_not_specialize=["ELEMENTS"])
+def _validate_write_values(K, V, Status, ELEMENTS, BLOCK: tl.constexpr):
+    offset = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    k = tl.load(K + offset, mask=offset < ELEMENTS, other=0.0).to(tl.float32)
+    v = tl.load(V + offset, mask=offset < ELEMENTS, other=0.0).to(tl.float32)
+    bad = tl.sum((~(tl.abs(k) <= 3.402823466e38) | ~(tl.abs(v) <= 3.402823466e38)).to(tl.int32), 0) > 0
+    tl.atomic_or(Status, tl.where(bad, 2, 0))
+
+
+@triton.jit(do_not_specialize=["N"])
+def _prepare_write(Locations, PageToSlot, Owners, Committed, Provisional,
+                   Lengths, Preview, Status, N,
+                   PAGES: tl.constexpr, SLOTS: tl.constexpr,
+                   B: tl.constexpr, S: tl.constexpr, IS_PROVISIONAL: tl.constexpr):
+    i = tl.arange(0, B)
+    live = i < N
+    loc = tl.load(Locations + i, mask=live, other=0)
+    page = loc // 128
+    token = loc % 128
+    valid = live & (page > 0) & (page < PAGES)
+    safe_page = tl.where(valid, page, 0).to(tl.int32)
+    old_slot = tl.load(PageToSlot + page, mask=valid, other=-1)
+    committed = tl.load(Committed + page * 128 + token, mask=valid, other=0)
+    duplicate = tl.sum(((loc[:, None] == loc[None, :]) & live[:, None] & live[None, :]).to(tl.int32), 1) > 1
+    earlier_same_page = tl.sum(((page[:, None] == page[None, :]) & (i[None, :] < i[:, None]) & live[None, :]).to(tl.int32), 1) > 0
+    first_page = valid & ~earlier_same_page
+    page_bound_ok = tl.sum(first_page.to(tl.int32), 0) <= 2
+    needs_slot = first_page & (old_slot < 0)
+    slots = tl.arange(0, S)
+    owners = tl.load(Owners + slots, mask=slots < SLOTS, other=0)
+    available = (slots < SLOTS) & (owners < 0)
+    capacity_ok = tl.sum(needs_slot.to(tl.int32), 0) <= tl.sum(available.to(tl.int32), 0)
+    bad = (tl.sum((live & (~valid | committed | duplicate | (old_slot >= SLOTS))).to(tl.int32), 0) > 0) | ~page_bound_ok
+    tl.atomic_or(Status, tl.where(bad, 1, tl.where(capacity_ok, 0, 4)))
+    status = tl.load(Status)
+    if status == 0:
+        # One control program preflights the entire bounded write before mutation.
+        for index in range(N):
+            this_page = tl.sum(tl.where(i == index, safe_page, 0), 0)
+            allocate = tl.sum(tl.where(i == index, needs_slot.to(tl.int32), 0), 0) > 0
+            if allocate:
+                chosen = tl.min(tl.where((slots < SLOTS) & (owners < 0), slots, SLOTS), 0)
+                owners = tl.where(slots == chosen, this_page, owners)
+                tl.store(PageToSlot + this_page, chosen)
+        tl.store(Owners + slots, owners, mask=slots < SLOTS)
+        tl.store(Committed + loc, not IS_PROVISIONAL, mask=live)
+        tl.store(Provisional + loc, IS_PROVISIONAL, mask=live)
+        tl.atomic_max(Lengths + page, token + 1, mask=live)
+        tl.store(Preview + page, False, mask=live)
+
+
+@triton.jit
+def _scatter_write(Locations, K, V, RawK, RawV, PageToSlot, Status,
+                   H: tl.constexpr, D: tl.constexpr):
+    row = tl.program_id(0)
+    head = tl.program_id(1)
+    status = tl.load(Status)
+    if status == 0:
+        loc = tl.load(Locations + row)
+        page, token = loc // 128, loc % 128
+        slot = tl.load(PageToSlot + page)
+        d = tl.arange(0, D)
+        source = (row * H + head) * D + d
+        destination = ((slot.to(tl.int64) * 128 + token) * H + head) * D + d
+        tl.store(RawK + destination, tl.load(K + source))
+        tl.store(RawV + destination, tl.load(V + source))
+
+
+@triton.jit
+def _commit_prefix(Locations, Accepted, Committed, Provisional, Status,
+                   WIDTH: tl.constexpr, PAGES: tl.constexpr, B: tl.constexpr):
+    # Initial native admission is one request, fixed proposal block <=128.
+    i = tl.arange(0, B)
+    length = tl.load(Accepted)
+    active = i < length
+    loc = tl.load(Locations + i, mask=i < WIDTH, other=0)
+    valid = active & (loc >= 128) & (loc < PAGES * 128)
+    provisional = tl.load(Provisional + loc, mask=valid, other=0)
+    bad = (length < 0) | (length > WIDTH) | (tl.sum((active & (~valid | ~provisional)).to(tl.int32), 0) > 0)
+    tl.atomic_or(Status, tl.where(bad, 1, 0))
+    if tl.load(Status) == 0:
+        tl.store(Committed + loc, True, mask=active)
+        tl.store(Provisional + loc, False, mask=active)
+
+
+@triton.jit
+def _discard_provisional(Owners, PageToSlot, Committed, Provisional,
+                         Lengths, Sink, Preview, Status):
+    slot = tl.program_id(0)
+    page = tl.load(Owners + slot)
+    if (page > 0) & (tl.load(Status) == 0):
+        i = tl.arange(0, 128)
+        committed = tl.load(Committed + page * 128 + i)
+        provisional = tl.load(Provisional + page * 128 + i)
+        rejected = tl.sum(provisional.to(tl.int32), 0) > 0
+        tl.store(Provisional + page * 128 + i, False)
+        if rejected:
+            tl.store(Preview + page, False)
+        length = tl.max(tl.where(committed, i + 1, 0), 0)
+        tl.store(Lengths + page, length)
+        sink = tl.load(Sink + page)
+        if (length == 0) & ~sink:
+            tl.store(PageToSlot + page, -1)
+            tl.store(Owners + slot, -1)
+
+
+@triton.jit
+def _plan_complete_tiles(Owners, Committed, Provisional, Sink, Selected,
+                         Status, SEAL: tl.constexpr):
+    slot = tl.program_id(0)
+    page = tl.load(Owners + slot)
+    selected = -1
+    if (page > 0) & (tl.load(Status) == 0):
+        i = tl.arange(0, 128)
+        committed = tl.load(Committed + page * 128 + i)
+        provisional = tl.load(Provisional + page * 128 + i)
+        sink = tl.load(Sink + page)
+        if SEAL:
+            complete = tl.sum(committed.to(tl.int32), 0) == 128
+            complete = complete & (tl.sum(provisional.to(tl.int32), 0) == 0)
+        else:
+            complete = tl.sum((committed | provisional).to(tl.int32), 0) == 128
+        selected = tl.where(complete & ~sink, page, -1)
+    tl.store(Selected + slot, selected)
+
+
+@triton.jit
+def _publish_complete_tiles(Owners, PageToSlot, Preview, Selected,
+                            Status, SEAL: tl.constexpr):
+    slot = tl.program_id(0)
+    page = tl.load(Selected + slot)
+    if (page > 0) & (tl.load(Status) == 0):
+        if SEAL:
+            tl.store(PageToSlot + page, -1)
+            tl.store(Owners + slot, -1)
+            tl.store(Preview + page, False)
+        else:
+            tl.store(Preview + page, True)
+
+
+@triton.jit
+def _rotate_keys_for_tiles(Raw, Rotated, Selected, Preview, Status,
+                           H: tl.constexpr, D: tl.constexpr):
+    slot = tl.program_id(0)
+    head = tl.program_id(1)
+    token = tl.program_id(2)
+    page = tl.load(Selected + slot)
+    ready = tl.load(Preview + page, mask=page > 0, other=0)
+    if (page > 0) & ~ready & (tl.load(Status) == 0):
+        d = tl.arange(0, D)
+        values = tl.load(Raw + ((slot.to(tl.int64) * 128 + token) * H + head) * D + d).to(tl.float32)
+        for bit in tl.static_range(0, 8 if D == 256 else 7):
+            step = 1 << bit
+            partner = tl.gather(values, d ^ step, axis=0)
+            values = tl.where((d & step) == 0, values + partner, partner - values)
+        tl.store(Rotated + (slot.to(tl.int64) * H + head) * D * 128 + d * 128 + token,
+                 values * (D ** -0.5))
+
+
+@triton.jit
+def _fused_rotate_balance_pack(
+    Raw, RotatedK, Packed, Selected, Preview, Status,
+    D: tl.constexpr, H: tl.constexpr, TILE_BYTES: tl.constexpr,
+    IS_KEY: tl.constexpr, K_SCALE: tl.constexpr, K_ZERO: tl.constexpr,
+    K_TOKEN: tl.constexpr, V_PACKED: tl.constexpr, V_CHANNEL: tl.constexpr,
+    V_SCALE: tl.constexpr, V_ZERO: tl.constexpr,
+):
+    slot = tl.program_id(0)
+    head = tl.program_id(1)
+    page = tl.load(Selected + slot)
+    ready = tl.load(Preview + page, mask=page > 0, other=0)
+    if (page > 0) & ~ready & (tl.load(Status) == 0):
+        tokens = tl.arange(0, 128)
+        channels = tl.arange(0, D)
+        if IS_KEY:
+            R: tl.constexpr = D
+            C: tl.constexpr = 128
+            BITS: tl.constexpr = 4
+            key_offset = (slot.to(tl.int64) * H + head) * D * 128 + channels[:, None] * 128 + tokens[None, :]
+            tile = tl.load(RotatedK + key_offset)
+        else:
+            R: tl.constexpr = 128
+            C: tl.constexpr = D
+            BITS: tl.constexpr = 2
+            raw_offset = ((slot.to(tl.int64) * 128 + tokens[:, None]) * H + head) * D + channels[None, :]
+            tile = tl.load(Raw + raw_offset).to(tl.float32)
+            for bit in tl.static_range(0, 8 if D == 256 else 7):
+                step = 1 << bit
+                partner_index = tl.broadcast_to((channels ^ step)[None, :], (128, D))
+                partner = tl.gather(tile, partner_index, axis=1)
+                tile = tl.where((channels[None, :] & step) == 0, tile + partner, partner - tile)
+            tile = tile * (D ** -0.5)
+        r = tl.arange(0, R)
+        c = tl.arange(0, C)
+        log_col = tl.full((C,), 0.0, tl.float32)
+        log_row = tl.full((R,), 0.0, tl.float32)
+        current = tile
+        col_mean = tl.sum(current, 0) / R
+        row_mean = tl.sum(current, 1) / C
+        col_std = tl.sqrt(tl.maximum((tl.sum(current * current, 0) / R - col_mean * col_mean) * R / (R - 1), 0.0))
+        row_std = tl.sqrt(tl.maximum((tl.sum(current * current, 1) / C - row_mean * row_mean) * C / (C - 1), 0.0))
+        best = tl.max(col_std, 0) / tl.maximum(tl.min(col_std, 0), 1e-8) + tl.max(row_std, 0) / tl.maximum(tl.min(row_std, 0), 1e-8)
+        best_col = tl.full((C,), 1.0, tl.float32)
+        best_row = tl.full((R,), 1.0, tl.float32)
+        for iteration in range(8):
+            mean = tl.sum(current, 0) / R
+            std = tl.sqrt(tl.maximum((tl.sum(current * current, 0) / R - mean * mean) * R / (R - 1), 0.0))
+            log_col = tl.minimum(tl.maximum(log_col + tl.log(tl.minimum(tl.maximum(std, 1e-3), 1e3)), -0.3), 10.0)
+            current = tile / tl.exp(log_col)[None, :] / tl.exp(log_row)[:, None]
+            mean = tl.sum(current, 1) / C
+            std = tl.sqrt(tl.maximum((tl.sum(current * current, 1) / C - mean * mean) * C / (C - 1), 0.0))
+            log_row = tl.minimum(tl.maximum(log_row + tl.log(tl.minimum(tl.maximum(std, 1e-3), 1e3)), -0.3), 10.0)
+            current = tile / tl.exp(log_col)[None, :] / tl.exp(log_row)[:, None]
+            col_mean = tl.sum(current, 0) / R
+            row_mean = tl.sum(current, 1) / C
+            col_std = tl.sqrt(tl.maximum((tl.sum(current * current, 0) / R - col_mean * col_mean) * R / (R - 1), 0.0))
+            row_std = tl.sqrt(tl.maximum((tl.sum(current * current, 1) / C - row_mean * row_mean) * C / (C - 1), 0.0))
+            imbalance = tl.max(col_std, 0) / tl.maximum(tl.min(col_std, 0), 1e-8) + tl.max(row_std, 0) / tl.maximum(tl.min(row_std, 0), 1e-8)
+            better = imbalance <= best
+            best_col = tl.where(better, tl.exp(log_col), best_col)
+            best_row = tl.where(better, tl.exp(log_row), best_row)
+            best = tl.minimum(best, imbalance)
+        balanced = tile / best_col[None, :] / best_row[:, None]
+        lo = tl.min(balanced, 1)
+        hi = tl.max(balanced, 1)
+        scale = tl.maximum((hi - lo) / ((1 << BITS) - 1), 1e-10)
+        quantized = libdevice.nearbyint((balanced - lo[:, None]) / scale[:, None])
+        quantized = tl.minimum(tl.maximum(quantized, 0.0), (1 << BITS) - 1).to(tl.int32)
+        PACK: tl.constexpr = 8 // BITS
+        byte_col = tl.arange(0, C // PACK)
+        packed = tl.full((R, C // PACK), 0, tl.int32)
+        for j in tl.static_range(PACK):
+            index = tl.broadcast_to((byte_col * PACK + j)[None, :], (R, C // PACK))
+            packed = packed | (tl.gather(quantized, index, axis=1) << (j * BITS))
+        absorbed_scale = best_row * scale
+        absorbed_zero = best_row * lo
+        valid = (tl.sum((tl.abs(absorbed_scale) <= 65504.0).to(tl.int32), 0) == R)
+        valid = valid & (tl.sum((tl.abs(absorbed_zero) <= 65504.0).to(tl.int32), 0) == R)
+        valid = valid & (tl.sum((tl.abs(best_col) <= 65504.0).to(tl.int32), 0) == C)
+        tl.atomic_or(Status, tl.where(valid, 0, 2))
+        base = (page.to(tl.int64) * H + head) * TILE_BYTES
+        halves = (Packed + base).to(tl.pointer_type(tl.float16))
+        if IS_KEY:
+            tl.store(Packed + base + r[:, None] * (C // PACK) + byte_col[None, :], packed.to(tl.uint8), mask=valid)
+            tl.store(halves + K_SCALE // 2 + r, absorbed_scale, mask=valid)
+            tl.store(halves + K_ZERO // 2 + r, absorbed_zero, mask=valid)
+            tl.store(halves + K_TOKEN // 2 + c, best_col, mask=valid)
+        else:
+            tl.store(Packed + base + V_PACKED + r[:, None] * (C // PACK) + byte_col[None, :], packed.to(tl.uint8), mask=valid)
+            tl.store(halves + V_SCALE // 2 + r, absorbed_scale, mask=valid)
+            tl.store(halves + V_ZERO // 2 + r, absorbed_zero, mask=valid)
+            tl.store(halves + V_CHANNEL // 2 + c, best_col, mask=valid)
+
+
+@triton.jit
+def _reset_dummy_pages(Pages, Committed, Provisional, Lengths, Preview):
+    page = tl.load(Pages + tl.program_id(0))
+    token = tl.arange(0, 128)
+    tl.store(Committed + page * 128 + token, False)
+    tl.store(Provisional + page * 128 + token, False)
+    tl.store(Lengths + page, 0)
+    tl.store(Preview + page, False)
+
+
+from sglang.srt.mem_cache.kvarn.types import KVarNLayerView, KVarNWorkspace
+
+
+def begin_write_out(view: KVarNLayerView, locations: torch.Tensor,
+                    keys: torch.Tensor, values: torch.Tensor,
+                    provisional: bool, workspace: KVarNWorkspace) -> None:
+    """Bounded GPU preflight/ownership assignment/scatter. No host data reads."""
+    if locations.ndim != 1 or locations.dtype not in (torch.int32, torch.int64):
+        raise ValueError("native write locations must be an integer vector")
+    count = locations.numel()
+    if count < 1 or count > min(128, workspace.max_write_tokens):
+        raise ValueError("native writes require 1..128 rows; chunk larger writes")
+    shape = (count, view.layout.kv_heads, view.layout.head_dim)
+    if keys.shape != shape or values.shape != shape or keys.dtype != view.raw_keys.dtype or values.dtype != view.raw_values.dtype:
+        raise ValueError("native write KV shape/dtype mismatch")
+    for tensor in (locations, keys, values):
+        if not tensor.is_cuda or tensor.device != view.packed.device or not tensor.is_contiguous():
+            raise ValueError("native write inputs must be contiguous on cache CUDA device")
+    status = workspace.native_status
+    elements = keys.numel()
+    _validate_write_values[(triton.cdiv(elements, 256),)](keys, values, status, ELEMENTS=elements, BLOCK=256, num_warps=4, num_stages=1)
+    _prepare_write[(1,)](locations, view.page_to_tail_slot, view.tail_to_page,
+                         view.committed_mask, view.provisional_mask, view.valid_lengths,
+                         view.preview_ready, status, N=count, PAGES=view.packed.shape[0],
+                         SLOTS=view.raw_keys.shape[0], B=128,
+                         S=triton.next_power_of_2(view.raw_keys.shape[0]),
+                         IS_PROVISIONAL=provisional, num_warps=4, num_stages=1)
+    _scatter_write[(count, view.layout.kv_heads)](
+        locations, keys, values, view.raw_keys, view.raw_values,
+        view.page_to_tail_slot, status, H=view.layout.kv_heads,
+        D=view.layout.head_dim, num_warps=4, num_stages=1)
+    complete_tiles_out(view, workspace, seal=False)
+
+
+def complete_tiles_out(view: KVarNLayerView, workspace: KVarNWorkspace, *, seal: bool) -> None:
+    """Prepare provisional preview or publish fully committed post-attention seal."""
+    slots = view.raw_keys.shape[0]
+    selected = workspace.native_seal_pages
+    if selected.shape != (slots,):
+        raise ValueError("native tile plan capacity mismatch")
+    status = workspace.native_status
+    _plan_complete_tiles[(slots,)](view.tail_to_page, view.committed_mask,
+        view.provisional_mask, view.sink_pages, selected, status, SEAL=seal, num_warps=4, num_stages=1)
+    o = KVarNOffsets.from_layout(view.layout)
+    _rotate_keys_for_tiles[(slots, view.layout.kv_heads, 128)](
+        view.raw_keys, workspace.native_rotated_keys, selected, view.preview_ready,
+        status, H=view.layout.kv_heads, D=view.layout.head_dim, num_warps=4, num_stages=1)
+    for raw, is_key in ((view.raw_keys, True), (view.raw_values, False)):
+        _fused_rotate_balance_pack[(slots, view.layout.kv_heads)](
+            raw, workspace.native_rotated_keys, view.packed, selected, view.preview_ready, status,
+            D=view.layout.head_dim, H=view.layout.kv_heads, TILE_BYTES=view.layout.tile_bytes,
+            IS_KEY=is_key, K_SCALE=o.k_scale, K_ZERO=o.k_zero, K_TOKEN=o.k_token,
+            V_PACKED=o.v_packed, V_CHANNEL=o.v_channel, V_SCALE=o.v_scale,
+            V_ZERO=o.v_zero, num_warps=16, num_stages=1)
+    _publish_complete_tiles[(slots,)](view.tail_to_page, view.page_to_tail_slot,
+        view.preview_ready, selected, status, SEAL=seal, num_warps=4, num_stages=1)
+
+
+def discard_provisional_out(view: KVarNLayerView, workspace: KVarNWorkspace) -> None:
+    """Discard unaccepted slots, never release a committed/cached sink owner."""
+    if workspace.native_status.device != view.packed.device:
+        raise ValueError("native transaction status/cache device mismatch")
+    _discard_provisional[(view.raw_keys.shape[0],)](
+        view.tail_to_page, view.page_to_tail_slot, view.committed_mask,
+        view.provisional_mask, view.valid_lengths, view.sink_pages,
+        view.preview_ready, workspace.native_status, num_warps=4, num_stages=1)
+
+
+def commit_prefix_out(view: KVarNLayerView, locations: torch.Tensor,
+                      lengths: torch.Tensor, workspace: KVarNWorkspace) -> None:
+    """Native C1 accepted-prefix transaction. Seals only after caller attention."""
+    if locations.ndim != 2 or locations.shape[0] != 1 or not 1 <= locations.shape[1] <= 128:
+        raise ValueError("native acceptance supports one request and width1..128")
+    if locations.dtype not in (torch.int32, torch.int64) or lengths.shape != (1,) or lengths.dtype not in (torch.int32, torch.int64):
+        raise ValueError("invalid native acceptance metadata")
+    for tensor in (locations, lengths):
+        if not tensor.is_cuda or tensor.device != view.packed.device or not tensor.is_contiguous():
+            raise ValueError("native acceptance requires contiguous CUDA metadata")
+    width = locations.shape[1]
+    _commit_prefix[(1,)](locations, lengths, view.committed_mask, view.provisional_mask,
+        workspace.native_status, WIDTH=width, PAGES=view.packed.shape[0],
+        B=triton.next_power_of_2(width), num_warps=4, num_stages=1)
+    discard_provisional_out(view, workspace)
+    complete_tiles_out(view, workspace, seal=True)
