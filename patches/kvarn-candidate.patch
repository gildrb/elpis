@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from syv-ai KVarN 18349177b7962ef1d699dc154844f9c04317a474.
+"""Bounded visible-window gather, including inverse Hadamard rotation."""
+import torch
+from sglang.srt.mem_cache.kvarn.types import KVarNLayerView, KVarNWorkspace
+from .decode import decode_head
+
+def gather_visible(view: KVarNLayerView, locations: torch.Tensor,
+                   valid_lengths: torch.Tensor, fixedworkspace: KVarNWorkspace) -> tuple[torch.Tensor, torch.Tensor]:
+    if locations.ndim != 2 or locations.dtype not in (torch.int32, torch.int64):
+        raise ValueError("locations must be integer [batch,window]")
+    batch, width = locations.shape
+    if valid_lengths.shape != (batch,) or valid_lengths.dtype not in (torch.int32, torch.int64):
+        raise ValueError("integer valid lengths must match batch")
+    if locations.numel() > fixedworkspace.max_visible_tokens:
+        raise ValueError("bounded gather workspace exceeded; whole-context fallback forbidden")
+    if fixedworkspace.keys.device != view.packed.device:
+        raise ValueError("workspace/cache device mismatch")
+    shape = (batch, width, view.layout.kv_heads, view.layout.head_dim)
+    keys = fixedworkspace.keys[:batch * width].view(shape)
+    values = fixedworkspace.values[:batch * width].view(shape)
+    keys.zero_()
+    values.zero_()
+    for row in range(batch):
+        length = int(valid_lengths[row].item())
+        if not 0 <= length <= width:
+            raise ValueError("invalid visible length")
+        # Consecutive tokens from one physical page are decoded once per head.
+        cursor = 0
+        while cursor < length:
+            loc = int(locations[row, cursor].item())
+            page, offset = divmod(loc, 128)
+            if page <= 0 or page >= view.packed.shape[0]:
+                raise ValueError("invalid physical token")
+            count = 1
+            while cursor + count < length and offset + count < 128:
+                if int(locations[row, cursor + count].item()) != loc + count:
+                    break
+                count += 1
+            valid = view.committed_mask[page, offset:offset + count] | view.provisional_mask[page, offset:offset + count]
+            if not bool(valid.all().item()):
+                raise ValueError("gather includes unwritten token")
+            for head in range(view.layout.kv_heads):
+                k, v = decode_head(view, page, head)
+                keys[row, cursor:cursor + count, head].copy_(k[offset:offset + count])
+                values[row, cursor:cursor + count, head].copy_(v[offset:offset + count])
+            cursor += count
+    return keys, values
+
+
+import triton
+import triton.language as tl
+
+@triton.jit
+def _gather_visible_kernel(
+    Locations, Lengths, Packed, RawK, RawV, PageToSlot, Committed,
+    Provisional, OutK, OutV, Status,
+    WIDTH: tl.constexpr, H: tl.constexpr, D: tl.constexpr,
+    PAGES: tl.constexpr, SLOTS: tl.constexpr, TILE_BYTES: tl.constexpr,
+    K_SCALE: tl.constexpr, K_ZERO: tl.constexpr, K_TOKEN: tl.constexpr,
+    V_PACKED: tl.constexpr, V_CHANNEL: tl.constexpr, V_SCALE: tl.constexpr,
+    V_ZERO: tl.constexpr,
+):
+    row = tl.program_id(0)
+    head = tl.program_id(1)
+    batch = row // WIDTH
+    column = row % WIDTH
+    length = tl.load(Lengths + batch)
+    active = (column < length) & (length >= 0) & (length <= WIDTH)
+    loc = tl.load(Locations + row, mask=active, other=0)
+    page = loc // 128
+    token = loc % 128
+    in_range = active & (page > 0) & (page < PAGES)
+    slot = tl.load(PageToSlot + page, mask=in_range, other=-1)
+    committed = tl.load(Committed + page * 128 + token, mask=in_range, other=0)
+    provisional = tl.load(Provisional + page * 128 + token, mask=in_range, other=0)
+    valid = in_range & (committed | provisional) & (slot < SLOTS)
+    invalid = ((length < 0) | (length > WIDTH)) | (active & ~valid)
+    tl.atomic_or(Status, tl.where(invalid, 1, 0))
+    d = tl.arange(0, D)
+    key = tl.full((D,), 0.0, tl.float32)
+    value = tl.full((D,), 0.0, tl.float32)
+    if valid:
+        if slot >= 0:
+            offset = ((slot.to(tl.int64) * 128 + token) * H + head) * D + d
+            key = tl.load(RawK + offset).to(tl.float32)
+            value = tl.load(RawV + offset).to(tl.float32)
+        else:
+            base = (page.to(tl.int64) * H + head) * TILE_BYTES
+            halves = (Packed + base).to(tl.pointer_type(tl.float16))
+            ks = tl.load(halves + K_SCALE // 2 + d).to(tl.float32)
+            kz = tl.load(halves + K_ZERO // 2 + d).to(tl.float32)
+            kt = tl.load(halves + K_TOKEN // 2 + token).to(tl.float32)
+            kbyte = tl.load(Packed + base + d * 64 + token // 2).to(tl.int32)
+            key = (((kbyte >> ((token % 2) * 4)) & 15).to(tl.float32) * ks + kz) * kt
+            vc = tl.load(halves + V_CHANNEL // 2 + d).to(tl.float32)
+            vs = tl.load(halves + V_SCALE // 2 + token).to(tl.float32)
+            vz = tl.load(halves + V_ZERO // 2 + token).to(tl.float32)
+            vbyte = tl.load(Packed + base + V_PACKED + token * (D // 4) + d // 4).to(tl.int32)
+            value = (((vbyte >> ((d % 4) * 2)) & 3).to(tl.float32) * vs + vz) * vc
+            for bit in tl.static_range(0, 8 if D == 256 else 7):
+                step = 1 << bit
+                partner_k = tl.gather(key, d ^ step, axis=0)
+                partner_v = tl.gather(value, d ^ step, axis=0)
+                key = tl.where((d & step) == 0, key + partner_k, partner_k - key)
+                value = tl.where((d & step) == 0, value + partner_v, partner_v - value)
+            key = key * (D ** -0.5)
+            value = value * (D ** -0.5)
+    out = (row * H + head) * D + d
+    tl.store(OutK + out, key)
+    tl.store(OutV + out, value)
+
+
+def gather_visible_out(view: KVarNLayerView, locations: torch.Tensor,
+                       valid_lengths: torch.Tensor, fixedworkspace: KVarNWorkspace,
+                       status: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fixed-capacity CUDA gather. Status bit0 indicates invalid live metadata.
+
+    Padded rows are zero. Callers must clear/check status outside capture and
+    fail the request on any device-reported error, never consume invalid output.
+    No host reads of runtime metadata and no dynamic tensor allocation.
+    """
+    from sglang.srt.mem_cache.kvarn.layout import KVarNOffsets
+    if locations.ndim != 2 or locations.dtype not in (torch.int32, torch.int64):
+        raise ValueError("locations must be an integer matrix")
+    batch, width = locations.shape
+    if width < 1 or valid_lengths.shape != (batch,) or valid_lengths.dtype not in (torch.int32, torch.int64):
+        raise ValueError("invalid native gather shape")
+    if batch * width > fixedworkspace.max_visible_tokens:
+        raise ValueError("native gather fixed capacity exceeded")
+    if status.shape != (1,) or status.dtype != torch.int32:
+        raise ValueError("status must be an int32 device word")
+    tensors = (locations, valid_lengths, status, fixedworkspace.keys, fixedworkspace.values)
+    for tensor in tensors:
+        if not tensor.is_cuda or tensor.device != view.packed.device or not tensor.is_contiguous():
+            raise ValueError("native gather needs contiguous tensors on cache CUDA device")
+    shape = (batch, width, view.layout.kv_heads, view.layout.head_dim)
+    keys = fixedworkspace.keys[:batch * width].view(shape)
+    values = fixedworkspace.values[:batch * width].view(shape)
+    o = KVarNOffsets.from_layout(view.layout)
+    _gather_visible_kernel[(batch * width, view.layout.kv_heads)](
+        locations, valid_lengths, view.packed, view.raw_keys, view.raw_values,
+        view.page_to_tail_slot, view.committed_mask, view.provisional_mask,
+        keys, values, status, WIDTH=width, H=view.layout.kv_heads,
+        D=view.layout.head_dim, PAGES=view.packed.shape[0], SLOTS=view.raw_keys.shape[0],
+        TILE_BYTES=view.layout.tile_bytes, K_SCALE=o.k_scale, K_ZERO=o.k_zero,
+        K_TOKEN=o.k_token, V_PACKED=o.v_packed, V_CHANNEL=o.v_channel,
+        V_SCALE=o.v_scale, V_ZERO=o.v_zero, num_warps=4, num_stages=1)
+    return keys, values
