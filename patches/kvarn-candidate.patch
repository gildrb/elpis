+++ b/python/sglang/srt/layers/attention/kvarn_draft_backend.py
@@ -0,0 +1,296 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Prefix-preserving, bounded eager FlashInfer adapter for packed draft KV."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import isfinite
+from typing import TYPE_CHECKING
+
+import torch
+from flashinfer import BatchPrefillWithRaggedKVCacheWrapper
+
+from sglang.srt.layers.attention.base_attn_backend import AttentionBackend, SharedReadEnds
+from sglang.srt.layers.radix_attention import AttentionType, RadixAttention
+from sglang.srt.mem_cache.kvarn.pool import KVarNTokenToKVPool
+from sglang.srt.mem_cache.kvarn_allocator import KVarNPageAllocator
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, ForwardMode
+from sglang.srt.runtime_context import get_schedule
+
+if TYPE_CHECKING:
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+
+@dataclass(frozen=True)
+class KVarNDraftPlanKey:
+    query_heads: int
+    kv_heads: int
+    head_dim: int
+    query_dtype: torch.dtype
+    kv_dtype: torch.dtype
+    query_tokens: int
+    kv_tokens: int
+    causal: bool
+    window_left: int
+    logit_cap_hex: str
+    scaling_hex: str
+    backend: str
+
+
+@dataclass(frozen=True)
+class KVarNDraftLayerPlan:
+    wrapper: BatchPrefillWithRaggedKVCacheWrapper
+    visible_mask: torch.Tensor
+    packed_mask: torch.Tensor
+    weighted_bits: torch.Tensor
+
+
+class KVarNDraftAttnBackend(AttentionBackend):
+    """Global packed storage, temporary bounded dequant, separate proposal tail.
+
+    The worker retains global physical indices in its compact request table.
+    Only the visible table rows are gathered; this is not a rolling KV cache.
+    Graph capture is unsupported by the current transactional pool.
+    """
+
+    def __init__(self, model_runner: ModelRunner):
+        super().__init__()
+        from sglang.srt.speculative.dflash_utils import (
+            get_dflash_attention_sliding_window_size, get_dflash_layer_types,
+        )
+
+        config = model_runner.model_config.hf_config
+        layer_types = get_dflash_layer_types(config)
+        if layer_types is None or tuple(layer_types) != ("sliding_attention",) * 5:
+            raise ValueError("KVarN draft requires five sliding-attention layers")
+        if get_dflash_attention_sliding_window_size(config) != 2047:
+            raise ValueError("KVarN draft requires HF window2048 / window_left2047")
+        if getattr(config.get_text_config(), "is_causal", None) is not False:
+            raise ValueError("KVarN draft requires explicit is_causal=False")
+        if not get_schedule().disable_overlap_schedule:
+            raise ValueError("KVarN draft plans require serialized scheduling")
+        pool = model_runner.token_to_kv_pool
+        if not isinstance(pool, KVarNTokenToKVPool):
+            raise TypeError("KVarN draft requires KVarNTokenToKVPool")
+        if pool.layout.head_dim != 128 or pool.layout.kv_heads != 8:
+            raise ValueError("KVarN draft requires D128 and eight KV heads")
+        if pool.workspace.output.shape[0] < 8 or pool.capacity.max_write_tokens < 128:
+            raise ValueError("KVarN draft requires eight query rows and 128 write rows")
+        allocator = model_runner.token_to_kv_pool_allocator
+        if not isinstance(allocator, KVarNPageAllocator):
+            raise TypeError("KVarN attention requires its page-owning allocator")
+        self._allocator = allocator
+        self._dummy_pages: torch.Tensor | None = None
+        self.pool = pool
+        self.req_to_token = model_runner.req_to_token_pool.req_to_token
+        # FlashInfer scratch is separate from the bounded KV gather workspace.
+        self.flashinfer_workspace = torch.empty(
+            32 * 1024 * 1024, dtype=torch.uint8, device=model_runner.device
+        )
+        self._model_runner = model_runner
+        self._width = 2048 + 128 + 8
+        if self.req_to_token.shape[1] < self._width:
+            raise ValueError("KVarN draft request table is smaller than its visible bound")
+        device = model_runner.device
+        self.visible_locations = torch.empty((1, self._width), dtype=self.req_to_token.dtype, device=device)
+        self.visible_lengths = torch.empty(1, dtype=torch.int32, device=device)
+        self._query_positions = torch.empty((8, 1), dtype=torch.int64, device=device)
+        self._query_offsets = torch.arange(8, dtype=torch.int64, device=device).view(8, 1)
+        self._columns = torch.arange(self._width, dtype=torch.int64, device=device).view(1, self._width)
+        self._bit_weights = (2 ** torch.arange(8, dtype=torch.int64, device=device)).to(torch.uint8)
+        self._plans: dict[int, KVarNDraftLayerPlan] = {}
+        self._unique_plans: dict[KVarNDraftPlanKey, KVarNDraftLayerPlan] = {}
+
+    def allocation_report(self) -> dict[str, int]:
+        """Owned steady buffers, excluding the pool's separately charged gather.
+
+        FlashInfer 0.6.18 owns 8 MiB GPU integer and 8 MiB pinned CPU scratch
+        per public wrapper. No opaque plan buffers are shared across wrappers.
+        """
+        tensors = [self.flashinfer_workspace, self.visible_locations,
+                   self.visible_lengths, self._query_positions, self._query_offsets,
+                   self._columns, self._bit_weights]
+        for plan in self._unique_plans.values():
+            tensors.extend((plan.visible_mask, plan.packed_mask, plan.weighted_bits))
+        owned = sum(t.numel() * t.element_size() for t in tensors)
+        count = len(self._unique_plans)
+        # Each wrapper also retains three int32 indptr pairs.
+        return {"distinct_plans": count,
+                "gpu_bytes": owned + count * (8 * 1024 * 1024 + 24),
+                "pinned_cpu_bytes": count * 8 * 1024 * 1024}
+
+    def shared_read_ends(self, fm: ForwardMode) -> SharedReadEnds:
+        return SharedReadEnds.POST_REPLAY
+
+    def init_cuda_graph_state(self, max_bs: int, max_num_tokens: int) -> None:
+        if not self.pool.supports_cuda_graph or not self.pool.native_enabled:
+            raise NotImplementedError("KVarN draft transactional storage is eager-only")
+        if max_bs != 1 or max_num_tokens != 8:
+            raise ValueError("KVarN draft graph geometry is one request and eight tokens")
+
+    def on_after_cuda_graph_warmup(self) -> None:
+        if self.pool.native_enabled:
+            self.pool.check_native_status()
+        pages = self._dummy_pages
+        if pages is None:
+            return
+        # The allocator owns this reservation for the runner lifetime. Never
+        # reset real request/radix pages or layer-global provisional state here.
+        for layer_id in self.pool.layout.layer_ids:
+            self.pool.reset_graph_dummy_pages(layer_id, pages)
+
+    def get_cuda_graph_seq_len_fill_value(self) -> int:
+        return 0
+
+    def init_forward_metadata_out_graph(
+        self, forward_batch: ForwardBatch, in_capture: bool = False
+    ) -> None:
+        if in_capture and (not self.pool.supports_cuda_graph or not self.pool.native_enabled):
+            raise NotImplementedError("KVarN draft does not support graph capture")
+        if in_capture:
+            if (forward_batch.batch_size != 1
+                    or not forward_batch.forward_mode.is_target_verify()
+                    or forward_batch.out_cache_loc.numel() != 8):
+                raise ValueError("KVarN capture requires one eight-token verify request")
+            # Row zero is upstream's reserved graph-padding row. The physical
+            # page is reserved through the allocator, never hardcoded or page zero.
+            locations = self._allocator.reserve_graph_dummy_page()
+            self._dummy_pages = locations[:1].div(128, rounding_mode="floor")
+            self.req_to_token[0, :128].copy_(locations)
+            forward_batch.req_pool_indices.zero_()
+            forward_batch.out_cache_loc.copy_(locations[:8])
+            forward_batch.positions.copy_(torch.arange(
+                8, dtype=forward_batch.positions.dtype, device=locations.device
+            ))
+            forward_batch.seq_lens.zero_()
+            if forward_batch.seq_lens_cpu is not None:
+                forward_batch.seq_lens_cpu.zero_()
+            forward_batch.seq_lens_sum = 0
+            self.pool.mark_sink_pages(self._dummy_pages)
+            for layer_id in self.pool.layout.layer_ids:
+                self.pool.reset_graph_dummy_pages(layer_id, self._dummy_pages)
+        if forward_batch.batch_size != 1:
+            raise ValueError("KVarN draft supports one request, not eight requests")
+        if not forward_batch.forward_mode.is_target_verify():
+            raise NotImplementedError("KVarN draft requires DFlash block forward")
+        if forward_batch.out_cache_loc.numel() != 8:
+            raise ValueError("KVarN draft requires eight proposal tokens")
+        # Planning is host-only, but independent of the current prefix length.
+        # Each layer retains a packed mask pointer; GPU metadata fills it below.
+        if (self._model_runner.token_to_kv_pool is not self.pool
+                or self._model_runner.req_to_token_pool.req_to_token is not self.req_to_token):
+            raise RuntimeError("KVarN draft runtime pool/view identity changed")
+        if len(self._plans) == 0:
+            layers = [module for module in self._model_runner.model.modules()
+                      if isinstance(module, RadixAttention)]
+            if len(layers) != 5 or {layer.layer_id for layer in layers} != set(self.pool.layout.layer_ids):
+                raise ValueError("KVarN draft requires exactly its five owned attention layers")
+            keys: list[KVarNDraftPlanKey] = []
+            for layer in layers:
+                if (layer.is_cross_attention or layer.attn_type != AttentionType.ENCODER_ONLY
+                        or layer.sliding_window_size != 2047):
+                    raise ValueError("KVarN draft requires noncausal window_left2047")
+                if (layer.head_dim != 128 or layer.v_head_dim != 128
+                        or layer.tp_k_head_num != 8 or layer.tp_v_head_num != 8
+                        or layer.tp_q_head_num != 32):
+                    raise ValueError("KVarN draft requires Q32/KV8/D128 in every layer")
+                if (not isfinite(layer.scaling) or layer.scaling <= 0
+                        or not isfinite(layer.logit_cap) or layer.logit_cap < 0):
+                    raise ValueError("KVarN draft requires finite valid attention scales")
+                keys.append(KVarNDraftPlanKey(
+                    layer.tp_q_head_num, layer.tp_k_head_num, layer.head_dim,
+                    self.pool.dtype, self.pool.dtype, 8, self._width, False, 2047,
+                    float(layer.logit_cap).hex(), float(layer.scaling).hex(), "fa2",
+                ))
+            # Validate ALL model-owned views before creating even one wrapper.
+            # Float hex values give exact configured keys without float equality.
+            key = keys[0]
+            if any(candidate != key for candidate in keys[1:]):
+                raise ValueError("KVarN draft requires identical FlashInfer plan keys")
+            layer = layers[0]
+            device = forward_batch.seq_lens.device
+            query_indptr = torch.tensor([0, 8], dtype=torch.int32, device=device)
+            kv_indptr = torch.tensor([0, self._width], dtype=torch.int32, device=device)
+            mask = torch.ones((8, self._width), dtype=torch.bool, device=device)
+            packed_mask = torch.empty(self._width, dtype=torch.uint8, device=device)
+            mask_indptr = torch.empty(2, dtype=torch.int32, device=device)
+            wrapper = BatchPrefillWithRaggedKVCacheWrapper(
+                self.flashinfer_workspace, "NHD", use_cuda_graph=True,
+                qo_indptr_buf=query_indptr, kv_indptr_buf=kv_indptr,
+                custom_mask_buf=packed_mask, mask_indptr_buf=mask_indptr,
+                backend="fa2",
+            )
+            wrapper.plan(
+                query_indptr, kv_indptr, layer.tp_q_head_num, layer.tp_k_head_num,
+                layer.head_dim, custom_mask=mask.flatten(), causal=False,
+                window_left=-1, logits_soft_cap=layer.logit_cap,
+                sm_scale=layer.scaling, q_data_type=self.pool.dtype,
+                kv_data_type=self.pool.dtype,
+            )
+            plan = KVarNDraftLayerPlan(
+                wrapper, mask, packed_mask,
+                torch.empty((self._width, 8), dtype=torch.uint8, device=device),
+            )
+            self._unique_plans[key] = plan
+            self._plans = {layer.layer_id: plan for layer in layers}
+
+    def init_forward_metadata_in_graph(self, forward_batch: ForwardBatch) -> None:
+        torch.index_select(
+            self.req_to_token[:, :self._width], 0, forward_batch.req_pool_indices,
+            out=self.visible_locations,
+        )
+        torch.add(forward_batch.seq_lens, 8, out=self.visible_lengths)
+        torch.add(forward_batch.seq_lens.view(1, 1), self._query_offsets, out=self._query_positions)
+
+    def forward_extend(
+        self, q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+        layer: RadixAttention, forward_batch: ForwardBatch,
+        save_kv_cache: bool = True,
+    ) -> torch.Tensor:
+        if q.shape[0] != 8:
+            raise ValueError("KVarN draft attention requires exactly eight query rows")
+        plan = self._plans.get(layer.layer_id)
+        if plan is None:
+            raise RuntimeError("KVarN draft metadata was not initialized")
+        if layer.is_cross_attention:
+            raise NotImplementedError("KVarN draft cross-attention is unsupported")
+        if layer.k_scale is not None or layer.v_scale is not None:
+            raise ValueError("KVarN does not accept external KV quantization scales")
+        if not save_kv_cache or k is None or v is None:
+            raise NotImplementedError("KVarN draft requires explicit proposal KV")
+        self.pool.discard_provisional(layer.layer_id)
+        self.pool.begin_write(
+            layer.layer_id, forward_batch.out_cache_loc,
+            k.reshape(-1, layer.tp_k_head_num, layer.head_dim).contiguous(),
+            v.reshape(-1, layer.tp_v_head_num, layer.v_head_dim).contiguous(), provisional=True,
+        )
+        keys, values = self.pool.gather_visible(
+            layer.layer_id, self.visible_locations, self.visible_lengths, self.pool.workspace
+        )
+        # Query origins use the compact prefix, not global RoPE positions.
+        torch.lt(self._columns.expand(8, -1), self.visible_lengths.view(1, 1), out=plan.visible_mask)
+        if layer.attn_type != AttentionType.ENCODER_ONLY:
+            plan.visible_mask.logical_and_(self._columns <= self._query_positions)
+        if layer.sliding_window_size >= 0:
+            plan.visible_mask.logical_and_(
+                self._columns >= self._query_positions - layer.sliding_window_size
+            )
+        torch.mul(plan.visible_mask.reshape(self._width, 8), self._bit_weights,
+                  out=plan.weighted_bits)
+        torch.sum(plan.weighted_bits, dim=1, dtype=torch.uint8, out=plan.packed_mask)
+        output = plan.wrapper.run(
+            q.reshape(-1, layer.tp_q_head_num, layer.head_dim),
+            keys.reshape(-1, layer.tp_k_head_num, layer.head_dim),
+            values.reshape(-1, layer.tp_v_head_num, layer.v_head_dim),
+        )
+        # Noise-derived rows must NEVER be promoted by acceptance. The worker
+        # replaces them with projected committed target hidden states instead.
+        self.pool.discard_provisional(layer.layer_id)
+        self.pool.finish_attention(layer.layer_id)
+        return output.reshape(-1, layer.tp_q_head_num * layer.v_head_dim)
+
+    def forward_decode(
+        self, q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+        layer: RadixAttention, forward_batch: ForwardBatch,
+        save_kv_cache: bool = True,
+    ) -> torch.Tensor:
+        raise NotImplementedError("KVarN draft uses eight-token block forwards")
