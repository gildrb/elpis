--- a/python/sglang/srt/layers/quantization/marlin_utils.py
+++ b/python/sglang/srt/layers/quantization/marlin_utils.py
@@ -1005,3 +1005,95 @@ def unified_apply_gptq_marlin_gemm_with_wtype(
         use_fp32_reduce=use_fp32_reduce,
         is_zp_float=is_zp_float,
     )
+
+
+def apply_gptq_marlin_int8_linear(
+    input: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    input_global_scale: torch.Tensor,
+    workspace: torch.Tensor,
+    output_size_per_partition: int,
+    input_size_per_partition: int,
+    bias: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    # Match the W4A16 shape contract, including multidimensional/empty batches.
+    reshaped_x = input.reshape(-1, input.shape[-1])
+    output = unified_apply_gptq_marlin_int8_gemm(
+        reshaped_x, weight, weight_scale, input_global_scale, workspace,
+        output_size_per_partition, input_size_per_partition, bias,
+    )
+    return output.reshape(input.shape[:-1] + (output_size_per_partition,))
+
+
+def fake_unified_apply_gptq_marlin_int8_gemm(
+    input: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    input_global_scale: torch.Tensor,
+    workspace: torch.Tensor,
+    output_size_per_partition: int,
+    input_size_per_partition: int,
+    bias: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    # Native output follows the signed-int16 scale carrier, not INT8 input.
+    return input.new_empty(
+        (input.shape[0], output_size_per_partition), dtype=weight_scale.dtype
+    )
+
+
+@register_custom_op(
+    fake_impl=fake_unified_apply_gptq_marlin_int8_gemm,
+    mutates_args=["workspace"],
+)
+def unified_apply_gptq_marlin_int8_gemm(
+    input: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    input_global_scale: torch.Tensor,
+    workspace: torch.Tensor,
+    output_size_per_partition: int,
+    input_size_per_partition: int,
+    bias: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    # Opaque to Dynamo: Triton quantization and native GEMM form one boundary.
+    # The package is imported at load-time by WNA16, never for the A16 control.
+    import litos_marlin_int8 as marlin_int8
+
+    if input.dtype != weight_scale.dtype:
+        raise ValueError("Marlin W4A8 requires the original FP16/BF16 model dtype")
+    if input.ndim != 2 or input.shape[1] != input_size_per_partition:
+        raise ValueError("Marlin W4A8 input must have shape [M,K]")
+    if input.shape[0] > (2**31 - 1) // max(
+        input_size_per_partition, output_size_per_partition
+    ):
+        raise ValueError("Marlin W4A8 M exceeds native 32-bit indexing bounds")
+    # reshape preserves the control's contract; materialize only when needed by
+    # the actual upstream quantizer's contiguous-input ABI.
+    quantized, token_scales = marlin_int8.per_token_quant_int8(input.contiguous())
+    token_scales.mul_(input_global_scale)
+    # Only workspace is an externally visible mutation. c=None gives a fresh,
+    # non-aliasing output; activation buffers and FP32 reduction scratch are
+    # invocation-owned, or owned by the CUDA graph private pool during capture.
+    # Existing graph warmup must compile the Triton specialization first.
+    return marlin_int8.gptq_marlin_gemm(
+        a=quantized,
+        c=None,
+        b_q_weight=weight,
+        b_bias=bias,
+        b_scales=weight_scale,
+        a_scales=token_scales,
+        global_scale=None,
+        b_zeros=None,
+        g_idx=None,
+        perm=None,
+        workspace=workspace,
+        b_type_id=int(marlin_int8.WeightType.uint4b8),
+        size_m=input.shape[0],
+        size_n=output_size_per_partition,
+        size_k=input_size_per_partition,
+        is_k_full=True,
+        use_atomic_add=False,
+        use_fp32_reduce=True,
+        is_zp_float=False,
+    )
