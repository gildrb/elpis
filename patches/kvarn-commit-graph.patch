+class _KVarNCommitGraphRunner:
+    """Captured post-verify KVarN commit tail for the bs=1 decode step (C1).
+
+    One CUDA graph holds the target-pool commit_prefix loop over all target
+    layers plus the draft-append KVarN branch (hidden projection, per draft
+    layer discard/kv_proj/norm/rope/provisional write/prefix commit), reading
+    only fixed-address buffers that are refreshed before each replay:
+
+      * locations/positions: the worker's persistent draft block buffers;
+      * commit_lens/hidden: the runner's own static buffers (D2D copies).
+
+    Status checks, sink declarations, allocator and radix state stay eager:
+    every captured kernel self-gates on the sticky native status word, so a
+    poisoned status makes replays no-ops and the end-of-step overlapped gate
+    (C2) fails the step closed exactly like the eager path. Warmup runs the
+    region once against the allocator-reserved dummy page with zero commit
+    lengths, which is state-neutral by the same sink/length gates the decode
+    graph runner relies on.
+    """
+
+    def __init__(self, worker: "DFlashWorkerV2") -> None:
+        self._worker = worker
+        self._block = int(worker.block_size)
+        self._device = torch.device(worker.device)
+        self.graph: Optional[torch.cuda.CUDAGraph] = None
+        self.hidden_dim: Optional[int] = None
+        self.hidden_dtype: Optional[torch.dtype] = None
+        self.commit_lens_buf: Optional[torch.Tensor] = None
+        self.hidden_buf: Optional[torch.Tensor] = None
+        self.capture_memory_bytes: Optional[int] = None
+        # Static views into the worker's own persistent planning buffers.
+        self.loc_2d = worker._draft_verify_out_cache_loc_buf[:1]
+        self.loc_1d = self.loc_2d.reshape(-1)
+        self.positions = worker._draft_block_positions_buf[:1].reshape(-1)
+
+    @property
+    def needs_capture(self) -> bool:
+        return self.graph is None
+
+    def matches(self, *, commit_lens: torch.Tensor, hidden: torch.Tensor) -> bool:
+        """True when this step's geometry agrees with the captured graph."""
+        if self.graph is None:
+            return False
+        if hidden.dtype != self.hidden_dtype or int(hidden.shape[-1]) != int(self.hidden_dim):
+            return False
+        return int(commit_lens.numel()) == 1
+
+    def _graph_dummy_pages(self) -> frozenset[int]:
+        pages: set[int] = set()
+        for pool in self._worker._kvarn_pools():
+            pages |= pool.graph_dummy_pages()
+        if len(pages) != 1:
+            raise RuntimeError(
+                "commit-graph capture requires the allocator-reserved dummy page"
+            )
+        return frozenset(pages)
+
+    def _run_region(self) -> None:
+        worker = self._worker
+        with torch.inference_mode():
+            target_pool = worker.model_runner.token_to_kv_pool
+            packed_target = target_pool.full_kv_pool
+            for layer_id in packed_target.layout.layer_ids:
+                packed_target.commit_prefix(layer_id, self.loc_2d, self.commit_lens_buf)
+            ctx_hidden = worker.draft_model.project_target_hidden(self.hidden_buf)
+            worker._write_committed_draft_block(
+                ctx_hidden=ctx_hidden,
+                cache_loc=self.loc_1d,
+                cache_loc_2d=self.loc_2d,
+                positions=self.positions,
+                commit_lens=self.commit_lens_buf,
+            )
+
+    def ensure_capture(self, *, commit_lens: torch.Tensor, hidden: torch.Tensor) -> None:
+        """Warm up and capture the commit tail once, on neutral dummy inputs."""
+        if self.graph is not None:
+            return
+        if self._device.type != "cuda":
+            raise RuntimeError("the KVarN commit graph requires CUDA")
+        self.hidden_dim = int(hidden.shape[-1])
+        self.hidden_dtype = hidden.dtype
+        self.commit_lens_buf = torch.zeros((1,), dtype=torch.int32, device=self._device)
+        self.hidden_buf = torch.zeros(
+            (self._block, self.hidden_dim), dtype=self.hidden_dtype, device=self._device
+        )
+        real_loc = self.loc_2d.clone()
+        real_positions = self.positions.clone()
+        dummy_pages = self._graph_dummy_pages()
+        dummy_page = next(iter(dummy_pages))
+        dummy_locs = torch.arange(
+            dummy_page * 128, dummy_page * 128 + self._block,
+            dtype=torch.int64, device=self._device,
+        )
+        free_before, _total = torch.cuda.mem_get_info(self._device)
+        try:
+            self.loc_2d.copy_(dummy_locs.view(1, self._block))
+            self.positions.copy_(
+                torch.arange(self._block, dtype=self.positions.dtype, device=self._device)
+            )
+            self.commit_lens_buf.zero_()
+            self.hidden_buf.zero_()
+            side = torch.cuda.Stream(device=self._device)
+            side.wait_stream(torch.cuda.current_stream(self._device))
+            with torch.cuda.stream(side):
+                # Two neutral warmup passes: Triton/cuBLAS latching and
+                # workspace allocation must precede stream capture.
+                for _warmup in range(2):
+                    self._run_region()
+            torch.cuda.current_stream(self._device).wait_stream(side)
+            torch.cuda.synchronize(self._device)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                self._run_region()
+            self.graph = graph
+        finally:
+            # Restore the live step's planning values and leave the reserved
+            # dummy page's masks pristine for the decode graph runner.
+            self.loc_2d.copy_(real_loc)
+            self.positions.copy_(real_positions)
+            for pool in self._worker._kvarn_pools():
+                for layer_id in pool.layout.layer_ids:
+                    pool.reset_graph_dummy_pages(
+                        layer_id, torch.tensor(sorted(dummy_pages), dtype=torch.int64, device=self._device)
+                    )
+            torch.cuda.synchronize(self._device)
+        free_after, _total = torch.cuda.mem_get_info(self._device)
+        self.capture_memory_bytes = int(free_before - free_after)
+
+    def replay(self, *, commit_lens: torch.Tensor, hidden: torch.Tensor) -> None:
+        if self.graph is None:
+            raise RuntimeError("commit graph replay before capture")
+        self.commit_lens_buf.copy_(commit_lens.reshape(1))
+        self.hidden_buf.copy_(hidden)
+        self.graph.replay()
+
