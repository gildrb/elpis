diff --git a/python/sglang/srt/mem_cache/kvarn_budget.py b/python/sglang/srt/mem_cache/kvarn_budget.py
index 8f11bc14fd..7275c757dd 100644
--- a/python/sglang/srt/mem_cache/kvarn_budget.py
+++ b/python/sglang/srt/mem_cache/kvarn_budget.py
@@ -5,6 +5,29 @@ from __future__ import annotations
 from dataclasses import dataclass
 
 
+KVAR_N_CONTEXT_RUNGS = (131072, 163840, 196608, 229376, 245760, 262144)
+KVAR_N_POOL_HEADROOM = 1024
+
+
+def qualification_page_count(token_capacity: int, *, capture: bool) -> int:
+    """Validate a native experiment's capacity and include reserved page zero.
+
+    This admits source geometry only. No rung gains GPU resource, capacity or
+    quality evidence by passing this check. Capture stays at its prior envelope.
+    """
+    if type(token_capacity) is not int or type(capture) is not bool:
+        raise ValueError("KVarN qualification requires integer capacity and boolean capture")
+    context = token_capacity - KVAR_N_POOL_HEADROOM
+    if context not in KVAR_N_CONTEXT_RUNGS or token_capacity % 128 != 0:
+        raise ValueError("KVarN native capacity must equal an explicit context rung plus 1024")
+    if capture and context != 245760:
+        raise ValueError("KVarN capture remains restricted to context245760 and pool246784")
+    pages = token_capacity // 128 + 1
+    if pages > 2147483647:
+        raise ValueError("KVarN physical page IDs must fit signed int32 metadata")
+    return pages
+
+
