+        # Optional draft-vocab restriction (syv-ai draft-vocab tuning): a
+        # boolean [vocab] mask; tokens outside it can never be proposed, so
+        # every guaranteed-rejection miss disappears from the walk.
+        self.register_buffer(
+            "draft_vocab_mask",
+            torch.ones(int(vocab_size), dtype=torch.bool),
+            persistent=False,
+        )
+        self.draft_vocab_restricted = False
 
+    def load_draft_vocab(self, ids: torch.Tensor) -> None:
+        """Restrict proposals to the given token ids (counted over the
+        target's own outputs, e.g. syv-ai prepare/draft_vocab_ids.json)."""
+        mask = torch.zeros_like(self.draft_vocab_mask)
+        ids = ids.to(mask.device, torch.long).flatten()
+        keep = (ids >= 0) & (ids < mask.numel())
+        mask[ids[keep]] = True
+        self.draft_vocab_mask.copy_(mask)
+        self.draft_vocab_restricted = bool(mask.any().item())
+
