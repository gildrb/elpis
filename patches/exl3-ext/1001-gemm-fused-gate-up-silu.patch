+// Autotune candidates of the regular kernel: every compatible shape, grid up to one block per
+// SM and at most one block per slice
+static std::vector<CoopAutotuneCandidate> gemm_autotune_candidates
+(
+    int size_m,
+    int size_k,
+    int size_n,
+    int K,
+    bool c_fp32,
+    int cb,
+    int num_sms
+)
+{
+    std::vector<CoopAutotuneCandidate> candidates;
+    for (int candidate_shape_idx = 1; candidate_shape_idx <= EXL3_GEMM_NUM_SHAPES; ++candidate_shape_idx)
+    {
