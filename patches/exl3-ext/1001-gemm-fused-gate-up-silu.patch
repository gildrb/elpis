+bool CoopKernelAutotuner::lookup
+(
+    uint64_t hash,
+    const std::vector<CoopAutotuneCandidate>& candidates,
+    CoopAutotuneLaunch* launch_config
+)
+{
+    uint64_t salted_hash = salt_hash(hash);
+
+    auto cached = launch_cache.find(salted_hash);
+    if (cached != launch_cache.end())
+    {
+        *launch_config = cached->second;
+        return true;
+    }
+
+    if (!launch_from_disk_cache(salted_hash, candidates, launch_config)) return false;
+    launch_cache[salted_hash] = *launch_config;
+    return true;
+}
