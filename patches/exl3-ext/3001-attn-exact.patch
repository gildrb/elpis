+def _qc_centered(raw, BITS: tl.constexpr):
+    """raw - (2^(BITS-1) - 0.5) as fp32, exactly, without an I2F: with the fp32 exponent of 2^22
+    the mantissa ulp is 0.5, so the bit pattern 0x4A800000 | (raw << 1) is the float 2^22 + raw
+    (raw < 2^22), and subtracting the representable 2^22 + mh is exact (Sterbenz: both operands
+    lie in [2^22, 2^23)). The result is the value raw.to(fp32) - mh produces."""
+    MAGIC: tl.constexpr = 0x4A800000
+    BIAS: tl.constexpr = 4194304.0 + ((1 << (BITS - 1)) - 0.5)
+    return ((raw << 1) | MAGIC).to(tl.float32, bitcast = True) - BIAS
