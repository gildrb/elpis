+// ext 2113 (torch.ops.exl3_m16.discard / EXL3_SPLITK_DISCARD, default on): a split-K finish job (row r,
+// 128-column chunk ch of one group) is the only reader of its nc partial slots' 512 B at s0 + c * SLOT
+// (c < nc), 4 x 128 B lines each, slot 0 included (its sum is re-read by the output Hadamard). Once
+// every lane of the warp has made that last read, the lines are dead: the next reader of any slot cell
+// is a finish of a later launch (or a later phase of the same launch, after a grid barrier), and each
+// finish reads only cells that its own launch's contributors wrote before its counter wait or barrier.
+// discard.global.L2 drops the lines from L2 without writing them back to DRAM. Values are unchanged:
+// only the cache state of lines nobody reads again. All 32 lanes call it (warp-uniform job loop);
+// s0 is 512 B aligned (slot bases and chunk offsets are multiples of 512 B on a 128 B aligned ws).
+__device__ __forceinline__ void exl3_m16_discard_slots(const float* s0, int nc, int lane)
+{
+    __syncwarp();
+    for (int i = lane; i < 4 * nc; i += 32)
+    {
+        const float* a = s0 + (size_t) (i >> 2) * EXL3_M16_SLOT_FLOATS + (i & 3) * 32;
+        asm volatile ("discard.global.L2 [%0], 128;\n" :: "l"(a) : "memory");
+    }
+}
