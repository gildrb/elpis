+        blocks = torch.tensor(sorted(order[:n]), dtype = torch.long, device = dev)
+        cols = (blocks[:, None] * block + torch.arange(block, device = dev)).flatten()
+        tiles = (blocks[:, None] * (block // 16) + torch.arange(block // 16, device = dev)).flatten()
+        head = LinearEXL3(
+            config = inner.config,
+            in_features = inner.in_features,
+            out_features = n * block,
+            suh = inner.suh,
+            svh = inner.svh.index_select(0, cols).contiguous(),
+            trellis = inner.trellis.index_select(1, tiles).contiguous(),
+            mcg = inner.mcg_tensor,
+            mul1 = inner.mul1_tensor,
