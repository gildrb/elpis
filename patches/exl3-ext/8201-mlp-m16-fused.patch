+#include <cuda_fp16.h>
+#include <type_traits>
+#include "exl3_mlp_m16.cuh"
+#include "exl3_gemm_m16.cuh"
+
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_mlp_m16_kernel.cuh"
+#include "exl3_devctx.cuh"
+#include <cstdlib>
+#include <mutex>
+
+namespace {
+
+std::mutex g_mtx;
+
+// Per device: the m16 split-K workspace (shared with exl3_gemm_m16, launches are stream-ordered)
+// and one allocation holding the self-resetting counters followed by the schedule tables.
+struct MlpDev
+{
+    float* ws;
+    unsigned int* cnt;
+    const unsigned short* sched;
+};
+MlpDev g_dev[MAX_DEVICES] = {};
+
+constexpr size_t SCHED_WORDS = (size_t) EXL3_MLP_SCHED_G * EXL3_MLP_SCHED_BF + (size_t) EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_PFLD + EXL3_MLP_SCHED_NWAIT;
+constexpr size_t WS1_FLOATS = (size_t) 2 * EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_MC1 * EXL3_M16_SLOT_FLOATS;
+constexpr size_t WS2_FLOATS = (size_t) (EXL3_MLP_SCHED_N2 / EXL3_M16_GW) * EXL3_MLP_SCHED_MC2 * EXL3_M16_SLOT_FLOATS;
+
+MlpDev get_dev(int device, cudaStream_t stream)
+{
+    std::lock_guard<std::mutex> lock(g_mtx);
+    MlpDev& d = g_dev[device];
+    if (!d.ws)
+    {
+        cudaStreamCaptureStatus st;
+        cuda_check(cudaStreamIsCapturing(stream, &st));
+        TORCH_CHECK(st == cudaStreamCaptureStatusNone, "exl3_mlp_m16: first call must not be under graph capture");
+        d.ws = exl3_gemm_m16_ws(device, stream);
+        TORCH_CHECK((WS1_FLOATS + WS2_FLOATS) * sizeof(float) <= exl3_gemm_m16_ws_bytes(), "exl3_mlp_m16: workspace too small");
+        uint8_t* buf;
+        const size_t cnt_bytes = EXL3_MLP_M16_NCNT * sizeof(unsigned int);
+        cuda_check(cudaMalloc(&buf, cnt_bytes + SCHED_WORDS * sizeof(unsigned short)));
+        cuda_check(cudaMemset(buf, 0, cnt_bytes));
+        unsigned short* s = (unsigned short*) (buf + cnt_bytes);
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_block, sizeof(exl3_mlp_sched_block), cudaMemcpyHostToDevice));
+        s += EXL3_MLP_SCHED_G * EXL3_MLP_SCHED_BF;
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_pair, sizeof(exl3_mlp_sched_pair), cudaMemcpyHostToDevice));
+        s += EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_PFLD;
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_wait, sizeof(exl3_mlp_sched_wait), cudaMemcpyHostToDevice));
+        d.cnt = (unsigned int*) buf;
+        d.sched = (const unsigned short*) (buf + cnt_bytes);
+    }
+    return d;
+}
+
+template <int MT, bool d_fp32>
+void* kernel_ptr() { return (void*) exl3_mlp_m16_kernel<MT, d_fp32>; }
+
+struct Launch
+{
+    void* kernel;
+    int smem;
+    int blocks_per_sm;
+};
+
+Launch get_launch(int MT, bool d_fp32, int device)
+{
+    static Launch cache[MAX_DEVICES][2][2] = {};
+    std::lock_guard<std::mutex> lock(g_mtx);
+    Launch& l = cache[device][MT - 1][d_fp32 ? 1 : 0];
+    if (!l.kernel)
+    {
+        void* k = MT == 1 ? (d_fp32 ? kernel_ptr<1, true>() : kernel_ptr<1, false>())
+                          : (d_fp32 ? kernel_ptr<2, true>() : kernel_ptr<2, false>());
+        int sm = MT == 1 ? Exl3M16Cfg<1>::SMEM : Exl3M16Cfg<2>::SMEM;
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, sm));
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributePreferredSharedMemoryCarveout, (int) cudaSharedmemCarveoutMaxShared));
+        int occ = 0;
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, k, EXL3_M16_THREADS, sm));
+        l.kernel = k;
+        l.smem = sm;
+        l.blocks_per_sm = occ < 2 ? occ : 2;
+    }
+    return l;
+}
+
+bool trellis_is(const at::Tensor& t, int k, int n)
+{
+    return t.dim() == 3 && t.scalar_type() == at::kShort && t.size(0) * 16 == k && t.size(1) * 16 == n && t.size(2) == 4 * 16;
+}
+
+}  // namespace
+
+int exl3_mlp_m16_l2pf(int set)
+{
+    // Benchmark knob, read at launch/capture time: EXL3_MLP_M16_L2PF (default 0) or the last set >= 0
+    static int value = []
+    {
+        const char* env = std::getenv("EXL3_MLP_M16_L2PF");
+        return env ? std::atoi(env) : 0;
+    }();
+    if (set >= 0) value = set;
+    return value;
+}
+
+bool exl3_mlp_m16_supported
+(
+    int size_m,
+    const at::Tensor& gate_trellis,
+    const at::Tensor& up_trellis,
+    const at::Tensor& down_trellis
+)
+{
+    static const bool enabled = []
+    {
+        const char* env = std::getenv("EXL3_MLP_M16");
+        return !(env && env[0] == '0');
+    }();
+    if (!enabled || size_m < 1 || size_m > 16) return false;
+    if (!trellis_is(gate_trellis, EXL3_MLP_SCHED_K1, EXL3_MLP_SCHED_N1) ||
+        !trellis_is(up_trellis, EXL3_MLP_SCHED_K1, EXL3_MLP_SCHED_N1) ||
+        !trellis_is(down_trellis, EXL3_MLP_SCHED_K2, EXL3_MLP_SCHED_N2)) return false;
+    int device;
+    cudaGetDevice(&device);
+    Launch l = get_launch(size_m <= 8 ? 1 : 2, true, device);
+    Launch l16 = get_launch(size_m <= 8 ? 1 : 2, false, device);
+    int num_sms = DevCtx::instance().get_num_sms(device);
+    return l.blocks_per_sm == 2 && l16.blocks_per_sm == 2 && num_sms * 2 == EXL3_MLP_SCHED_G;
+}
