+//   torch.ops.exl3_mlp_m16.mlp(x, gate trellis/suh/svh, up ..., down ..., g, u, a, xh_g, xh_u, xh_d, d,
+//                              act_limit, prof?) -> grid size
+//   torch.ops.exl3_mlp_m16.l2pf(set) -> current L2 prefetch depth (set < 0 only reads)
+
+static bool exl3_mlp_m16_supported_op(int64_t m, const at::Tensor& gt, const at::Tensor& ut, const at::Tensor& dt)
+{
+    return exl3_mlp_m16_supported((int) m, gt, ut, dt);
+}
+
+static int64_t exl3_mlp_m16_op
+(
+    const at::Tensor& x,
+    const at::Tensor& gt, const at::Tensor& gsuh, const at::Tensor& gsvh,
+    const at::Tensor& ut, const at::Tensor& usuh, const at::Tensor& usvh,
+    const at::Tensor& dt, const at::Tensor& dsuh, const at::Tensor& dsvh,
+    const at::Tensor& g, const at::Tensor& u, const at::Tensor& a,
+    const at::Tensor& xh_g, const at::Tensor& xh_u, const at::Tensor& xh_d,
+    const at::Tensor& d,
+    double act_limit,
+    const c10::optional<at::Tensor>& prof
+)
+{
+    at::Tensor g_ = g, u_ = u, a_ = a, xg = xh_g, xu = xh_u, xd = xh_d, d_ = d;
+    return exl3_mlp_m16_gr(x, gt, gsuh, gsvh, ut, usuh, usvh, dt, dsuh, dsvh, g_, u_, a_, xg, xu, xd, d_,
+                           (float) act_limit, nullptr, prof);
+}
+
+static int64_t exl3_mlp_m16_l2pf_op(int64_t set)
+{
+    return exl3_mlp_m16_l2pf((int) set);
+}
