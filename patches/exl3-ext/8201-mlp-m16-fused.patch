+#pragma once
+
+// Fused gated MLP for 1..16 token rows (ext 8201): gate+up m16 GEMM, silu(gate) * up and the down
+// m16 GEMM in ONE persistent cooperative launch, with no grid-wide barrier between the two GEMMs.
+// Host side: exl3_mlp_m16.cu. Per-block schedule: exl3_mlp_m16_sched.h, emitted by
+// bend/MLP_M16_SCHED_TABLE.bend (laws bend/mlp_m16_sched_laws.bend); the kernel reads it from device
+// memory and derives no schedule of its own.
+//
+// - Phase 1 is patch 2001 v2's gate+up launch unchanged: same input transform + grid barrier, same
+//   partition (block b owns [s1, s1 + n1) of the 2 * 34 * 320 (group, k-tile) iterations), same
+//   hot loop, fp16 MMA with fp32 fold every FOLD k-tiles and at every group end, same split-K
+//   slots (group, b - first contributor). After flushing group g each warp publishes it with a
+//   fenced add of 1 to counter cnt1[g] (expected 8 * contributors).
+// - The warp-private cp.async weight ring is ONE stream of n1 + n2 tiles: once the phase-1 tiles
+//   are issued the cursor continues with this block's down tiles (weights never depend on
+//   activations), so the down ring is full when phase 1 ends and DRAM keeps streaming through the
+//   finish below. Tile i uses slot i % PF throughout.
+// - Finish (per 512-column pair P = gate group P + up group 34 + P = down k-tiles [32 P, 32 P + 32)):
+//   the schedule names the finisher blocks of P (fin_rank < fin_cnt). A finisher block's thread 0
+//   waits for cnt1[P] and cnt1[34 + P] (for its 8 warps), then its warps run jobs (row, 128-column chunk) exactly as v2's finish (slot
+//   sums in slot order, had_fh_r_128_inner with svh) for gate and up, then act_mul_kernel_h's
+//   silu(g) * u on the same half2 pairs, then v2 down's input transform had_hf_r_128_inner with the
+//   down suh: the same device functions on the same values, through the same g / u / a buffers.
+//   Then it adds 1 to cnt2[P] (expected 8 * fin_cnt).
+// - Phase 2 is v2's down launch with its partition, slots, loop and final grid barrier + finish, except
+//   that the input transform comes from the finish above: thread 0 waits for cnt2[P] of every pair
+//   in the block's slice (schedule wait list) before the first activation chunk is issued.
+//   Waits never busy-spin: one poller per block with exponential __nanosleep backoff while the
+//   rest of the block sleeps at a barrier (the GPU runs power-capped, idle SMs keep clocks up).
+// - Counters self-reset: every waiter adds 1 to the pass counter of what it waited on; the last one
+//   (count from the schedule) zeroes the counter and the pass counter. The next launch is
+//   stream-ordered after this one.
+// - Deadlock-freedom needs all blocks co-resident (cooperative launch, grid = 2 blocks/SM).
+
+#include "exl3_gemm_m16_kernel.cuh"
+#include "exl3_mlp_m16_sched.h"
+
+#define EXL3_MLP_M16_NCNT (5 * EXL3_MLP_SCHED_PAIRS + 1)
+#define EXL3_MLP_M16_PROF_WORDS 16
+
+// counter layout (unsigned int): cnt1[68] | pass1[34] | cnt2[34] | pass2[34] | grid barrier word
+#define EXL3_MLP_CNT1 0
+#define EXL3_MLP_PASS1 (2 * EXL3_MLP_SCHED_PAIRS)
+#define EXL3_MLP_CNT2 (3 * EXL3_MLP_SCHED_PAIRS)
+#define EXL3_MLP_PASS2 (4 * EXL3_MLP_SCHED_PAIRS)
+#define EXL3_MLP_GBAR (5 * EXL3_MLP_SCHED_PAIRS)
+
+struct Exl3MlpM16Args
+{
+    const uint16_t* Bg;
+    const uint16_t* Bu;
+    const uint16_t* Bd;
+    const half* suh_g;
+    const half* suh_u;
+    const half* suh_d;
+    half* xh_g;
+    half* xh_u;
+    half* xh_d;
+    const half* svh_g;
+    const half* svh_u;
+    const half* svh_d;
+    half* a;                         // silu(g) * u (m, N1), the act_mul output / down A
+    float* ws;                       // phase-1 slots at 0, phase-2 slots at ws2
+    float* ws2;
+    unsigned int* cnt;               // EXL3_MLP_M16_NCNT counters, zero between launches
+    const unsigned short* sched;     // block table | pair table | wait list (exl3_mlp_m16_sched.h)
+    unsigned long long* prof;
+    int size_m;
+    float act_limit;
+    int l2pf;                        // down tiles per warp prefetched to L2 across the finish (0 = off)
+};
+
+// act_mul_kernel_h<ACT_SILU>'s _silu(half2) (activation_kernels.cuh), same operations
+__device__ __forceinline__ half2 exl3_mlp_silu_h2(half2 x)
+{
+    half2 one = __float2half2_rn(1.0f);
+    half2 neg_x = __hneg2(x);
+    half2 e = h2exp(neg_x);
+    half2 sum = __hadd2(one, e);
+    half2 r = h2rcp(sum);
+    half2 result = __hmul2(x, r);
+    return result;
+}
+
+// act_mul_kernel_h<ACT_SILU> body for one half2 (x = gate, y = up)
+__device__ __forceinline__ half2 exl3_mlp_act_mul_h2(half2 x2, half2 y2, const float act_limit)
+{
+    x2 = exl3_mlp_silu_h2(x2);
+    if (act_limit != 0.0f)
+    {
+        y2 = __hmax2(y2, __float2half2_rn(-act_limit));
+        y2 = __hmin2(y2, __float2half2_rn(act_limit));
+        x2 = __hmin2(x2, __float2half2_rn(act_limit));
+    }
+    return __hmul2(x2, y2);
+}
+
+__device__ __forceinline__ unsigned int exl3_mlp_ld_acquire(const unsigned int* p)
+{
+    unsigned int v;
+    asm volatile ("ld.global.acquire.gpu.b32 %0, [%1];\n" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+// Wait until *c >= target: one polling thread per block (the rest of the block sleeps at the
+// following barrier), exponential __nanosleep backoff 32 .. 512 ns so a waiting SM draws little
+// power (the board runs at its power cap; SM clock follows total power)
+__device__ __forceinline__ void exl3_mlp_wait(unsigned int* c, unsigned int target)
+{
+    unsigned int ns = 32;
+    while (exl3_mlp_ld_acquire(c) < target)
+    {
+        __nanosleep(ns);
+        if (ns < 512) ns <<= 1;
+    }
+    __threadfence();
+}
+
+// Account `n` passes (the waits of n warps, done by their block's poller); the pass that completes
+// `waiters` zeroes the counter (and, for the gate/up pair, its partner) and the pass counter
+__device__ __forceinline__ void exl3_mlp_pass(unsigned int* pass, unsigned int n, unsigned int waiters, unsigned int* c0, unsigned int* c1)
+{
+    unsigned int old = atomicAdd(pass, n);
+    if (old == waiters - n)
+    {
+        atomicExch(c0, 0u);
+        if (c1) atomicExch(c1, 0u);
+        atomicExch(pass, 0u);
+    }
+}
+
+// Grid barrier (cooperative launch => all blocks co-resident), cooperative_groups' flip protocol
+// (block 0 adds 0x80000000 - (G - 1), the others 1; the top bit flips once per barrier and the word
+// returns to its low bits, so it needs no reset) but polled by thread 0 with exponential backoff
+// instead of CG's tight spin
+__device__ __forceinline__ void exl3_mlp_grid_sync(unsigned int* bar)
+{
+    __syncthreads();
+    if (threadIdx.x == 0)
+    {
+        unsigned int nb = blockIdx.x == 0 ? 0x80000000u - (gridDim.x - 1) : 1u;
+        unsigned int old, cur;
+        asm volatile ("atom.add.release.gpu.u32 %0, [%1], %2;\n" : "=r"(old) : "l"(bar), "r"(nb) : "memory");
+        unsigned int ns = 32;
+        while (true)
+        {
+            asm volatile ("ld.acquire.gpu.u32 %0, [%1];\n" : "=r"(cur) : "l"(bar) : "memory");
+            if ((old ^ cur) & 0x80000000u) break;
+            __nanosleep(ns);
+            if (ns < 512) ns <<= 1;
+        }
+    }
+    __syncthreads();
+}
+
+template <int MT, bool d_fp32>
+__global__ __launch_bounds__(EXL3_M16_THREADS, 2)
+void exl3_mlp_m16_kernel(const half* __restrict__ A, half* Cg, half* Cu, void* D, Exl3MlpM16Args p)
+{
+    using Cfg = Exl3M16Cfg<MT>;
+    constexpr int PF = Cfg::PF;
+    constexpr int XR = Cfg::XR;
+    constexpr int W_STAGE = Cfg::W_STAGE;
+    constexpr int X_ITER = Cfg::X_ITER;
+    constexpr int ROWS = MT * 8;
+    constexpr int GW = EXL3_M16_GW;
+    static_assert(PF == EXL3_MLP_SCHED_PF, "schedule ring depth");
+
+    constexpr int K1 = EXL3_MLP_SCHED_K1;
+    constexpr int N1 = EXL3_MLP_SCHED_N1;
+    constexpr int K2 = EXL3_MLP_SCHED_K2;
+    constexpr int N2 = EXL3_MLP_SCHED_N2;
+    constexpr int NP = EXL3_MLP_SCHED_PAIRS;
+    constexpr int KT1 = K1 / 16;
+    constexpr int NG1 = N1 / GW;
+    constexpr int KT2 = K2 / 16;
+    constexpr int NG2 = N2 / GW;
+    constexpr int T1 = 2 * NG1 * KT1;
+    constexpr int T2 = NG2 * KT2;
+    constexpr size_t ROW1 = (size_t) (N1 / 16) * 128;
+    constexpr size_t ROW2 = (size_t) (N2 / 16) * 128;
+    static_assert(NP == NG1 && K2 == N1 && N2 == K1, "gated MLP shapes");
+
+    extern __shared__ __align__(16) uint8_t sm[];
+
+    const bool prof = p.prof != nullptr;
+    auto stamp = [&] (int i)
+    {
+        if (prof && threadIdx.x == 0)
+            p.prof[(size_t) blockIdx.x * EXL3_MLP_M16_PROF_WORDS + i] = exl3_m16_gtime();
+    };
+    stamp(0);
+
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+    const int size_m = p.size_m;
+    const int G = gridDim.x;
+    const int b = blockIdx.x;
+
+    // Schedule record of this block (exl3_mlp_m16_sched.h field order)
+    const unsigned short* rec = p.sched + b * EXL3_MLP_SCHED_BF;
+    const int s1 = rec[0];
+    const int n1 = rec[1];
+    const int v = rec[2];
+    const int s2 = rec[3];
+    const int n2 = rec[4];
+    const int ring2 = rec[5];
+    const int fin_pair = rec[6];
+    const int fin_rank = rec[7];
+    const int fin_cnt = rec[8];
+    const int wait_off = rec[9];
+    const int wait_cnt = rec[10];
+    const unsigned short* pair_tab = p.sched + EXL3_MLP_SCHED_G * EXL3_MLP_SCHED_BF;
+    const unsigned short* wait_tab = pair_tab + NP * EXL3_MLP_SCHED_PFLD;
+    const int n_tot = n1 + n2;
+
+    uint8_t* ring = sm + warp * PF * W_STAGE;
+    uint8_t* xbuf = sm + Cfg::RING;
+
+    // Weight issue cursor over the ring stream: tiles [0, n1) = phase-1 iterations s1 + i,
+    // tiles [n1, n_tot) = phase-2 iterations s2 + i - n1. iss_rem = tiles left in the current
+    // contiguous run (one group of one phase); this lane's 16 bytes of each 512-byte warp stage.
+    int iss_j = 0;
+    int iss_rem = 0;
+    size_t iss_row = ROW1;
+    const uint8_t* iss_ptr = nullptr;
+    auto iss_seek = [&] ()
+    {
+        if (iss_j < n1)
+        {
+            int it = s1 + iss_j;
+            int g = it / KT1;
+            int kt = it - g * KT1;
+            int mat = g >= NG1 ? 1 : 0;
+            int ng = g - mat * NG1;
+            const uint16_t* B = mat ? p.Bu : p.Bg;
+            iss_ptr = (const uint8_t*) (B + ((size_t) ng * (GW / 16) + warp * EXL3_M16_TILES_W) * 64) + lane * 16 + (size_t) kt * ROW1;
+            iss_rem = min(KT1 - kt, n1 - iss_j);
+            iss_row = ROW1;
+        }
+        else
+        {
+            int it = s2 + (iss_j - n1);
+            int g = it / KT2;
+            int kt = it - g * KT2;
+            iss_ptr = (const uint8_t*) (p.Bd + ((size_t) g * (GW / 16) + warp * EXL3_M16_TILES_W) * 64) + lane * 16 + (size_t) kt * ROW2;
+            iss_rem = min(KT2 - kt, n_tot - iss_j);
+            iss_row = ROW2;
+        }
+    };
+    auto issue_w = [&] (int slot)
+    {
+        cp_async_stream(ring + slot * W_STAGE + lane * 16, iss_ptr);
+        iss_j++;
+        if (--iss_rem == 0)
+        {
+            if (iss_j < n_tot) iss_seek();
+        }
+        else iss_ptr += iss_row;
+    };
+    if (n_tot > 0) iss_seek();
+
+    // Activation chunk c of a phase = phase-relative iterations [c * XR, c * XR + XR) (v2's
+    // issue_x_chunk with the phase's xh); rows past size_m replicate the last row
+    auto issue_x_chunk = [&] (int c, auto ph)
+    {
+        constexpr int PH = decltype(ph)::value;
+        const int s = PH == 1 ? s1 : s2;
+        const int n = PH == 1 ? n1 : n2;
+        uint8_t* dst = xbuf + (c & 1) * XR * X_ITER;
+        for (int q = threadIdx.x; q < XR * 2 * ROWS; q += EXL3_M16_THREADS)
+        {
+            int jj = q / (2 * ROWS);
+            int r = q - jj * (2 * ROWS);
+            int j = c * XR + jj;
+            if (j < n)
+            {
+                int it = s + j;
+                int row = min(r % ROWS, size_m - 1);
+                int kh = r / ROWS;
+                if constexpr (PH == 1)
+                {
+                    int g = it / KT1;
+                    int kt = it - g * KT1;
+                    const half* xh = g >= NG1 ? p.xh_u : p.xh_g;
+                    cp_async(dst + jj * X_ITER + r * 16, xh + (size_t) row * K1 + kt * 16 + kh * 8);
+                }
+                else
+                {
+                    int g = it / KT2;
+                    int kt = it - g * KT2;
+                    cp_async(dst + jj * X_ITER + r * 16, p.xh_d + (size_t) row * K2 + kt * 16 + kh * 8);
+                }
+            }
+        }
+    };
+
+    // Prologue: first PF - 1 ring tiles (independent of the input transform)
+    #pragma unroll
+    for (int d = 0; d < PF - 1; ++d)
+    {
+        if (iss_j < n_tot) issue_w(d);
+        cp_async_fence();
+    }
+
+    // Gate/up input scales and Hadamard transform (v2, num_mats = 2), then the only grid barrier
+    // before the down GEMM's final reduction (same placement as v2's grid.sync, backoff polling)
+    {
+        int per_mat = size_m * K1 / 128;
+        int total_warps = 2 * per_mat;
+        int warps_grid = G * EXL3_M16_WARPS;
+        for (int w = warp + EXL3_M16_WARPS * b; w < total_warps; w += warps_grid)
+        {
+            int mat = w >= per_mat ? 1 : 0;
+            int r = w - mat * per_mat;
+            had_hf_r_128_inner<true, false>
+            (
+                A + r * 128,
+                (mat ? p.xh_u : p.xh_g) + r * 128,
+                (mat ? p.suh_u : p.suh_g) + (r * 128) % K1,
+                0.088388347648f  // 1/sqrt(128)
+            );
+        }
+        exl3_mlp_grid_sync(p.cnt + EXL3_MLP_GBAR);
+    }
+    stamp(1);
+
+    issue_x_chunk(0, std::integral_constant<int, 1>{});
+    cp_async_fence();
+    cp_async_wait<0>();
+    __syncthreads();
+
+    int ldsm_off;
+    {
+        int i = MT == 1 ? (lane >> 3) & 1 : lane >> 3;
+        ldsm_off = ((i & 1) * ROWS + (i >> 1) * 8 + (lane & 7)) * 16;
+    }
+    const uint32_t xbuf_sa = static_cast<uint32_t>(__cvta_generic_to_shared(xbuf)) + ldsm_off;
+
+    FragC_h hacc[EXL3_M16_TILES_W][MT];
+    FragC acc[EXL3_M16_TILES_W][MT];
+    const half2 hzero = __half2half2(__ushort_as_half(0));
+    #pragma unroll
+    for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        {
+            hacc[t][mt][0] = hzero;
+            hacc[t][mt][1] = hzero;
+            #pragma unroll
+            for (int c = 0; c < 4; ++c) acc[t][mt][c] = 0.0f;
+        }
+
+    auto fold = [&] ()
+    {
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+            {
+                acc[t][mt][0] += __low2float(hacc[t][mt][0]);
+                acc[t][mt][1] += __high2float(hacc[t][mt][0]);
+                acc[t][mt][2] += __low2float(hacc[t][mt][1]);
+                acc[t][mt][3] += __high2float(hacc[t][mt][1]);
+                hacc[t][mt][0] = hzero;
+                hacc[t][mt][1] = hzero;
+            }
+    };
+
+    // v2 flush of group g into slot (g, slice - first contributor); phase 1 then publishes it
+    auto flush = [&] (int g, auto ph)
+    {
+        constexpr int PH = decltype(ph)::value;
+        const int cidx = PH == 1 ? b - exl3_m16_owner(g * KT1, T1, G) : v - exl3_m16_owner(g * KT2, T2, G);
+        float* ws = PH == 1 ? p.ws + (size_t) g * EXL3_MLP_SCHED_MC1 * EXL3_M16_SLOT_FLOATS
+                            : p.ws2 + (size_t) g * EXL3_MLP_SCHED_MC2 * EXL3_M16_SLOT_FLOATS;
+        float* slot = ws + (size_t) cidx * EXL3_M16_SLOT_FLOATS + warp * 64 + (lane >> 2);
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+                #pragma unroll
+                for (int c = 0; c < 4; ++c)
+                {
+                    int row = mt * 8 + 2 * (lane & 3) + (c & 1);
+                    if (row < size_m) __stcg(slot + row * GW + t * 16 + (c >> 1) * 8, acc[t][mt][c]);
+                    acc[t][mt][c] = 0.0f;
+                }
+        if constexpr (PH == 1)
+        {
+            __threadfence();
+            __syncwarp();
+            if (lane == 0) atomicAdd(p.cnt + EXL3_MLP_CNT1 + g, 1u);
+        }
+    };
+
+    // v2 main loop (rolled) over one phase's slice; the ring slots continue across phases
+    int cur_slot = 0;
+    int iss_slot = PF - 1;
+    auto run_phase = [&] (auto ph)
+    {
+        constexpr int PH = decltype(ph)::value;
+        constexpr int KT = PH == 1 ? KT1 : KT2;
+        const int s = PH == 1 ? s1 : s2;
+        const int n = PH == 1 ? n1 : n2;
+        const int e = s + n;
+        int j = 0;
+        for (int g_cur = s / KT; j < n; ++g_cur)
+        {
+            const int seg_end = min(e, (g_cur + 1) * KT) - s;
+
+            #pragma unroll 1
+            for (; j < seg_end; ++j)
+            {
+                if ((j & (XR - 1)) == 0)
+                {
+                    if (j > 0) __syncthreads();
+                    issue_x_chunk(j / XR + 1, ph);
+                }
+                if (iss_j < n_tot) issue_w(iss_slot);
+                iss_slot = iss_slot == PF - 1 ? 0 : iss_slot + 1;
+                cp_async_fence();
+                cp_async_wait<PF - 1>();
+                __syncwarp();
+
+                {
+                    const uint8_t* st = ring + cur_slot * W_STAGE;
+                    uint32_t bx[MT][2];
+                    {
+                        uint32_t sa = xbuf_sa + (((j / XR) & 1) * XR + (j & (XR - 1))) * X_ITER;
+                        if constexpr (MT == 2)
+                            asm volatile ("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                                : "=r"(bx[0][0]), "=r"(bx[0][1]), "=r"(bx[1][0]), "=r"(bx[1][1]) : "r"(sa));
+                        else
+                            asm volatile ("ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%0,%1}, [%2];\n"
+                                : "=r"(bx[0][0]), "=r"(bx[0][1]) : "r"(sa));
+                    }
+
+                    #pragma unroll
+                    for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+                    {
+                        FragB f0, f1;
+                        dq8_aligned_4bits<2>((const uint32_t*) (st + t * 128), lane * 8, f0, f1);
+                        FragA a;
+                        a[0] = f0[0];
+                        a[1] = f1[0];
+                        a[2] = f0[1];
+                        a[3] = f1[1];
+                        #pragma unroll
+                        for (int mt = 0; mt < MT; ++mt)
+                        {
+                            FragB bb;
+                            bb[0] = *reinterpret_cast<half2*>(&bx[mt][0]);
+                            bb[1] = *reinterpret_cast<half2*>(&bx[mt][1]);
+                            ptx_mma_m16n8k16(a, bb, hacc[t][mt]);
+                        }
+                    }
+                }
+                __syncwarp();
+                cur_slot = cur_slot == PF - 1 ? 0 : cur_slot + 1;
+
+                if ((j & (Cfg::FOLD - 1)) == Cfg::FOLD - 1) fold();
+            }
+
+            fold();
+            flush(g_cur, ph);
+        }
+    };
+
+    // ---- Phase 1: gate + up
+    run_phase(std::integral_constant<int, 1>{});
+    stamp(2);
+
+    // Optional (p.l2pf > 0, default 0): L2 prefetch of the next l2pf down tiles past the ring, so
+    // DRAM keeps streaming through the finish below; one instruction per 128-byte line (lanes 0, 8,
+    // 16, 24 of the warp's 512-byte stage), outside both hot loops
+    if ((lane & 7) == 0)
+    {
+        for (int t = max(iss_j, n1), t_end = min(iss_j + p.l2pf, n_tot); t < t_end; ++t)
+        {
+            int it = s2 + (t - n1);
+            int g = it / KT2;
+            int kt = it - g * KT2;
+            const uint8_t* ptr = (const uint8_t*) (p.Bd + ((size_t) g * (GW / 16) + warp * EXL3_M16_TILES_W) * 64) + lane * 16 + (size_t) kt * ROW2;
+            asm volatile ("prefetch.global.L2 [%0];\n" :: "l"(ptr));
+        }
+    }
+
+    // ---- Finish of pair fin_pair by this block's warps (finisher warp f of 8 * fin_cnt). Thread 0
+    // polls for the block and accounts the 8 warps' passes; the other warps sleep at the barrier.
+    {
+        const int P = fin_pair;
+        const unsigned short* pr = pair_tab + P * EXL3_MLP_SCHED_PFLD;
+        if (threadIdx.x == 0)
+        {
+            exl3_mlp_wait(p.cnt + EXL3_MLP_CNT1 + P, pr[0]);
+            exl3_mlp_wait(p.cnt + EXL3_MLP_CNT1 + NG1 + P, pr[1]);
+            exl3_mlp_pass(p.cnt + EXL3_MLP_PASS1 + P, EXL3_M16_WARPS, pr[2], p.cnt + EXL3_MLP_CNT1 + P, p.cnt + EXL3_MLP_CNT1 + NG1 + P);
+        }
+        __syncthreads();
+
+        const int F = EXL3_M16_WARPS * fin_cnt;
+        const int nc_g = exl3_m16_owner((P + 1) * KT1 - 1, T1, G) - exl3_m16_owner(P * KT1, T1, G) + 1;
+        const int nc_u = exl3_m16_owner((NG1 + P + 1) * KT1 - 1, T1, G) - exl3_m16_owner((NG1 + P) * KT1, T1, G) + 1;
+        for (int x = fin_rank * EXL3_M16_WARPS + warp; x < 4 * size_m; x += F)
+        {
+            const int r = x >> 2;
+            const int ch = x & 3;
+            const int col0 = P * GW + ch * 128;
+            #pragma unroll
+            for (int mat = 0; mat < 2; ++mat)
+            {
+                // v2 finish of group (mat ? NG1 + P : P), row r, chunk ch
+                const int g = mat * NG1 + P;
+                const int nc = mat ? nc_u : nc_g;
+                float* s0 = p.ws + (size_t) g * EXL3_MLP_SCHED_MC1 * EXL3_M16_SLOT_FLOATS + r * GW + ch * 128;
+                float4 acc4 = __ldcg(((const float4*) s0) + lane);
+                for (int c = 1; c < nc; ++c)
+                {
+                    float4 w4 = __ldcg(((const float4*) (s0 + (size_t) c * EXL3_M16_SLOT_FLOATS)) + lane);
+                    acc4.x += w4.x; acc4.y += w4.y; acc4.z += w4.z; acc4.w += w4.w;
+                }
+                ((float4*) s0)[lane] = acc4;
+                __syncwarp();
+                had_fh_r_128_inner<false, true>
+                (
+                    s0,
+                    (mat ? Cu : Cg) + (size_t) r * N1 + col0,
+                    (mat ? p.svh_u : p.svh_g) + col0,
+                    0.088388347648f  // 1/sqrt(128)
+                );
+            }
+            // act_mul_kernel_h<ACT_SILU> on the half2 pairs this lane's had_fh stored (4 lane .. + 3)
+            {
+                const size_t o = (size_t) r * N1 + col0 + lane * 4;
+                half2* gp = (half2*) (Cg + o);
+                half2* up = (half2*) (Cu + o);
+                half2* ap = (half2*) (p.a + o);
+                ap[0] = exl3_mlp_act_mul_h2(gp[0], up[0], p.act_limit);
+                ap[1] = exl3_mlp_act_mul_h2(gp[1], up[1], p.act_limit);
+            }
+            __syncwarp();
+            // v2 down input transform of row r, 128 columns col0 (A = a, xh = xh_d, suh = down suh)
+            had_hf_r_128_inner<true, false>
+            (
+                p.a + (size_t) r * K2 + col0,
+                p.xh_d + (size_t) r * K2 + col0,
+                p.suh_d + col0,
+                0.088388347648f  // 1/sqrt(128)
+            );
+            __syncwarp();
+        }
+        __threadfence();
+        __syncwarp();
+        if (lane == 0) atomicAdd(p.cnt + EXL3_MLP_CNT2 + P, 1u);
+    }
+    stamp(3);
+
+    // ---- Phase 2: down. Wait for the input transform of every pair of this slice, then v2's
