+FALLBACK_WINDOW = 32
+FALLBACK_TRIGGER = 2
+FALLBACK_HOLD = 128
+PRUNED_ENV = "EXL3_DRAFT_HEAD_PRUNED"
+BLOCKS_ENV = "EXL3_DRAFT_HEAD_BLOCKS"
