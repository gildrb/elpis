+def pruned_mode() -> str:
+    """'off', 'adaptive' or 'static' from EXL3_DRAFT_HEAD_PRUNED"""
+    v = os.environ.get(PRUNED_ENV, "1")
+    modes = {"0": "off", "1": "adaptive", "static": "static"}
+    if v not in modes:
+        raise ValueError(f"{PRUNED_ENV} must be 0, 1 or static, got {v!r}")
+    return modes[v]
+
+
+def kept_blocks(vocab: int) -> list[int] | None:
+    """The kept blocks (ascending) for a target vocabulary, or None: pruning off, or no table for this vocabulary"""
+    if pruned_mode() == "off" or vocab != DRAFT_HEAD_VOCAB:
+        return None
+    raw = os.environ.get(BLOCKS_ENV, str(DRAFT_HEAD_BLOCKS_DEFAULT))
+    if not raw.isdigit() or int(raw) not in DRAFT_HEAD_BLOCKS_ALLOWED:
+        raise ValueError(f"{BLOCKS_ENV} must be one of {DRAFT_HEAD_BLOCKS_ALLOWED}, got {raw!r}")
+    n = int(raw)
+    blocks = sorted(DRAFT_HEAD_BLOCK_ORDER[:n])
+    if len(set(blocks)) != n or blocks[0] < 0 or (blocks[-1] + 1) * DRAFT_HEAD_BLOCK > vocab:
+        raise ValueError("draft head block table is inconsistent")
+    return blocks
+
+
+class PrunedHeadPolicy:
+    """Per-round choice between the pruned and the full head (adaptive mode, see the module docstring)"""
+
+    def __init__(self, blocks: list[int], vocab: int, adaptive: bool):
+        self.kept = bytearray(vocab // DRAFT_HEAD_BLOCK)
+        for b in blocks:
+            self.kept[b] = 1
+        self.adaptive = adaptive
+        self.recent = []            # out-of-subset flags of the last FALLBACK_WINDOW pruned rounds' anchors
+        self.hold = 0               # rounds left on the full head
+        self.use_pruned = True
+        self.rounds_pruned = 0
+        self.rounds_full = 0
+        self.fallbacks = 0
+
+    def reset(self):
+        """Start of a new job (ext 9005c): back to the initial state (empty window, no hold, pruned head), so a
+        hold left by the previous request never carries over. Counters are statistics and are kept"""
+        self.recent = []
+        self.hold = 0
+        self.use_pruned = True
+
+    def observe_anchor(self, token: int):
+        """Called once per draft round with the round's anchor (the last committed token), before proposing. A
+        fallback uses the full head for FALLBACK_HOLD rounds counting the triggering round. Anchors outside
+        [0, vocab) (not token ids) are not evidence and count as in-subset"""
+        if not self.adaptive:
+            self.use_pruned = True
+        elif self.hold > 0:
+            self.hold -= 1
+            self.use_pruned = self.hold == 0
+        else:
+            b = token // DRAFT_HEAD_BLOCK
