+// Shared verify/commit recurrence for replay_verify layers (ext 5101). Every kernel that runs the
+// delta rule of a history-free verify -- the fused front-end kernel, the stand-alone verify kernel
+// and the commit replay -- goes through the SAME device code below: gdn_rule_scalars (g, beta ->
+// the per-token scalars), gdn_rule_l2norm_warp (q/k l2 norm), gdn_rule_dot1 / gdn_rule_update (one
+// token of one thread's (k slice, v column) chain) inside gdn_rule_tokens. So the state a commit of
+// c tokens stores is, instruction for instruction, the verify's in-register state after its first
+// c tokens, and a token verified at row r of one round or at row r - c after a c-token commit sees
+// the same state and produces the same outputs.
+//
+// Arithmetic (unchanged from gated_delta_rule_128_reg, which the old verify and commit ran):
+//   thread (chunk c = t / 128, k slice w = (t % 128) / 32, lane l) owns the 32 state values of k
+//   rows 32w..32w+31 in v column v_start + 32c + l. q/k l2 norm: sum of squares of each 32-element
+//   slice by the xor tree 16..1, then (p0 + p2) + (p1 + p3) -- exactly what the old second xor tree
+//   over [p0, p1, p2, p3, 0, ...] added -- then x * rsqrtf(sum + 1e-6f); one warp per vector here
+//   instead of all four warps per token. Per token: the j-ordered dot1 chain, the SUBK-ordered sum
+//   of the partials, v = v_in - dot1 * g, state = state * g + k * v * beta, the j-ordered v_out
+//   chain, the SUBK-ordered output sum, * scale, __float2bfloat16_rz. The v_out partials of all
+//   tokens are kept and reduced after the loop, so a token needs one barrier instead of four (dot1
+//   partials are double-buffered by token parity).
+
+#define GR_MAX_S 16
+#define GR_K 4
+#define GR_BA_UNROLL 16
+
+// One head's inputs and scratch in shared memory, the same layout in every kernel
+struct GdnRuleSmem
+{
+    float* q;           // [S][128] raw (bf16 widened), then l2-normalized
+    float* k;           // [S][128] raw, then l2-normalized
+    float* v;           // [S][128]
+    float* dot1;        // [2][SUBK][128]
+    float* gexp;        // [S]
+    float* beta;        // [S]
+    float* ba;          // [2][S] b/a sums (front end only)
+    float* dot2;        // [S][SUBK][128] (outputs only)
+    bfloat16* out;      // [S][128] (outputs only)
+    bfloat16* seq;      // [384][K + S] conv windows (front end only)
+};
+
+static inline int gdn_rule_smem_bytes(int S, bool outputs, int front_k)
+{
+    int bytes = 4 * (3 * S * 128 + 2 * SUBK * 128 + 4 * S);
+    if (outputs) bytes += 4 * S * SUBK * 128 + 2 * S * 128;
+    if (front_k) bytes += 2 * 3 * 128 * (front_k + S);
+    return bytes;
+}
+
+__device__ __forceinline__ GdnRuleSmem gdn_rule_smem(float* base, int S, bool outputs)
+{
+    GdnRuleSmem m;
+    m.q = base;
+    m.k = m.q + S * 128;
+    m.v = m.k + S * 128;
+    m.dot1 = m.v + S * 128;
+    m.gexp = m.dot1 + 2 * SUBK * 128;
+    m.beta = m.gexp + S;
+    m.ba = m.beta + S;
+    m.dot2 = m.ba + 2 * S;                                  // 16-byte aligned (4S floats above)
+    m.out = (bfloat16*) (m.dot2 + (outputs ? S * SUBK * 128 : 0));
+    m.seq = m.out + (outputs ? S * 128 : 0);
+    return m;
+}
+
+// Dynamic shared-memory opt-in, once per kernel and device
+static std::set<std::pair<int, const void*>> gdn_rule_smem_set;
+
+static void gdn_rule_smem_optin(const void* fn, int bytes)
+{
+    int device;
+    cudaGetDevice(&device);
+    if (!gdn_rule_smem_set.insert(std::make_pair(device, fn)).second) return;
+    cuda_check(cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, bytes));
+}
+
+struct GdnRuleThread
+{
+    int kslice;
+    int vcol;
+};
+
+__device__ __forceinline__ GdnRuleThread gdn_rule_thread(int v_start)
+{
+    GdnRuleThread th;
+    int chunk = threadIdx.x / 128;
+    th.kslice = (threadIdx.x - chunk * 128) / 32;
+    th.vcol = v_start + chunk * 32 + threadIdx.x % 32;
+    return th;
+}
+
+// head_state = the head's [128, 128] state (row 0 of the slot)
+__device__ __forceinline__ void gdn_rule_load_state(float (&state)[32], const float* head_state, GdnRuleThread th)
+{
+    const float* p = head_state + (size_t) th.kslice * 32 * 128 + th.vcol;
+    #pragma unroll
+    for (int j = 0; j < 32; ++j) state[j] = p[j * 128];
+}
+
+__device__ __forceinline__ void gdn_rule_store_state(const float (&state)[32], float* head_state, GdnRuleThread th)
+{
+    float* p = head_state + (size_t) th.kslice * 32 * 128 + th.vcol;
+    #pragma unroll
+    for (int j = 0; j < 32; ++j) p[j * 128] = state[j];
+}
+
+// Per-token scalars from the stored g (fp32) and beta (bf16)
+__device__ __forceinline__ void gdn_rule_scalars(float g, bfloat16 beta, float& gexp, float& beta_f)
+{
+    gexp = __expf(g);
+    beta_f = __bfloat162float(beta);
+}
+
+// q/k/v of head h (conv output [S, F] bf16, token 0 of the batch row), g/beta [S, H]
+template <int THREADS>
+__device__ __forceinline__ void gdn_rule_load_inputs
+(
+    GdnRuleSmem m,
+    const bfloat16* __restrict__ conv_out,
+    const float* __restrict__ g,
+    const bfloat16* __restrict__ beta,
+    int S, int F, int Nk, int H, int h
+)
+{
+    const int kh = h / (H / Nk);
+    for (int e = threadIdx.x; e < S * 3 * 128; e += THREADS)
+    {
+        int s = e / (3 * 128);
+        int i = e - s * 3 * 128;
+        int part = i / 128;
+        int c = i - part * 128;
+        int ch = part == 0 ? kh * 128 + c : (part == 1 ? (Nk + kh) * 128 + c : 2 * Nk * 128 + h * 128 + c);
+        float* dst = part == 0 ? m.q : (part == 1 ? m.k : m.v);
+        dst[s * 128 + c] = __bfloat162float(conv_out[(size_t) s * F + ch]);
+    }
+    for (int s = threadIdx.x; s < S; s += THREADS)
+        gdn_rule_scalars(g[(size_t) s * H + h], beta[(size_t) s * H + h], m.gexp[s], m.beta[s]);
+}
+
+__device__ __forceinline__ void gdn_rule_l2norm_warp(float* vec, int lane)
+{
+    float x0 = vec[lane];
+    float x1 = vec[32 + lane];
+    float x2 = vec[64 + lane];
+    float x3 = vec[96 + lane];
+    float p0 = x0 * x0;
+    float p1 = x1 * x1;
+    float p2 = x2 * x2;
+    float p3 = x3 * x3;
+    #pragma unroll
+    for (int offset = 16; offset > 0; offset /= 2)
+    {
+        p0 += __shfl_xor_sync(0xffffffff, p0, offset);
+        p1 += __shfl_xor_sync(0xffffffff, p1, offset);
+        p2 += __shfl_xor_sync(0xffffffff, p2, offset);
+        p3 += __shfl_xor_sync(0xffffffff, p3, offset);
+    }
+    float rs = rsqrtf(((p0 + p2) + (p1 + p3)) + 1e-6f);
+    vec[lane] = x0 * rs;
+    vec[32 + lane] = x1 * rs;
+    vec[64 + lane] = x2 * rs;
+    vec[96 + lane] = x3 * rs;
+}
+
+__device__ __forceinline__ float gdn_rule_dot1(const float (&state)[32], const float* k_rd)
+{
+    float sum = 0.0f;
+    #pragma unroll
+    for (int j = 0; j < 32; ++j)
+        sum = sum + k_rd[j] * state[j];
+    return sum;
+}
+
+// dot1_col = this column's SUBK partials, 128 floats apart
+__device__ __forceinline__ float gdn_rule_update
+(
+    float (&state)[32],
+    const float* k_rd,
+    const float* q_rd,
+    const float* dot1_col,
+    float v_in,
+    float g_h,
+    float beta_h
+)
+{
+    float dot1 = 0.0f;
+    #pragma unroll
+    for (int i = 0; i < SUBK; ++i) dot1 += dot1_col[i * 128];
+    float v = v_in - dot1 * g_h;
+    float v_out = 0.0f;
+    #pragma unroll
+    for (int j = 0; j < 32; ++j)
+    {
+        state[j] = state[j] * g_h + k_rd[j] * v * beta_h;
+        v_out = v_out + q_rd[j] * state[j];
+    }
+    return v_out;
+}
+
+// The recurrence over S tokens. Inputs (q/k raw, v, gexp, beta) must be in shared memory and
+// visible (caller's barrier). RULE_VERIFY (GROUPS == 4): bf16 outputs in m.out, visible on
+// return. RULE_COMMIT: state only
+template <int MODE, int GROUPS>
+__device__ __forceinline__ void gdn_rule_tokens(float (&state)[32], GdnRuleSmem m, int S, GdnRuleThread th, float scale)
+{
+    static_assert(MODE == RULE_VERIFY || MODE == RULE_COMMIT, "verify or commit");
+    static_assert(MODE != RULE_VERIFY || GROUPS == 4, "outputs need the whole head in one block");
+    constexpr int THREADS = GROUPS * 128;
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+
+    for (int task = warp; task < 2 * S; task += THREADS / 32)
+        gdn_rule_l2norm_warp((task & 1 ? m.k : m.q) + (task >> 1) * 128, lane);
+    __syncthreads();
+
+    for (int s = 0; s < S; ++s)
+    {
+        const float* k_rd = m.k + s * 128 + th.kslice * 32;
+        const float* q_rd = m.q + s * 128 + th.kslice * 32;
+        float* dot1_buf = m.dot1 + (s & 1) * SUBK * 128;
+        dot1_buf[th.kslice * 128 + th.vcol] = gdn_rule_dot1(state, k_rd);
+        __syncthreads();
+        float v_out = gdn_rule_update(state, k_rd, q_rd, dot1_buf + th.vcol, m.v[s * 128 + th.vcol], m.gexp[s], m.beta[s]);
+        if constexpr (MODE == RULE_VERIFY) m.dot2[(s * SUBK + th.kslice) * 128 + th.vcol] = v_out;
+    }
+
+    if constexpr (MODE == RULE_VERIFY)
+    {
+        __syncthreads();
+        for (int e = threadIdx.x; e < S * 128; e += THREADS)
+        {
+            int s = e / 128;
+            int c = e - s * 128;
+            float v_out = 0.0f;
+            #pragma unroll
+            for (int i = 0; i < SUBK; ++i) v_out += m.dot2[(s * SUBK + i) * 128 + c];
+            m.out[s * 128 + c] = __float2bfloat16_rz(v_out * scale);
+        }
+        __syncthreads();
+    }
+}
+
+// gated_rms_norm_kernel<32> for one 128-wide head row (lane owns elements 4l..4l+3)
+template <typename norm_w_T>
+__device__ __forceinline__ void gdn_rule_norm_prefetch(float4& w4, float4& g4, const norm_w_T* norm_w, const float* gate_row, int lane)
+{
+    if constexpr (std::is_same_v<norm_w_T, bfloat16>) gdn_norm_read_bfloat164(w4, ((const bfloat164*) norm_w) + lane);
+    else                                              gdn_norm_read_float4   (w4, ((const float4*)    norm_w) + lane);
+    gdn_norm_read_float4(g4, ((const float4*) gate_row) + lane);
+}
+
+__device__ __forceinline__ void gdn_rule_norm_row
+(
+    const bfloat16* xrow, float4 w4, float4 g4, half* yrow,
+    float epsilon, float constant_bias, int gate_act, int dim, int lane
+)
+{
+    float sum = 0.0f;
+    {
+        float4 x4;
+        gdn_norm_read_bfloat164(x4, ((const bfloat164*) xrow) + lane);
+        sum = gdn_norm_sum_sq4(sum, x4);
+    }
+    for (int offset = warpSize / 2; offset > 0; offset /= 2) sum += __shfl_xor_sync(0xffffffff, sum, offset);
+
+    float rmf = rsqrtf(sum / (float) dim + epsilon);
+
+    float4 x4;
+    gdn_norm_read_bfloat164(x4, ((const bfloat164*) xrow) + lane);
+
+    if (constant_bias != 0.0f)
+    {
+        w4.x += constant_bias;
+        w4.y += constant_bias;
+        w4.z += constant_bias;
+        w4.w += constant_bias;
+    }
+
+    gdn_norm_apply4(x4, w4, rmf);
+
+    #define _gate_fn(v) (gate_act == 1 ? gdn_norm_sigmoid_f(v) : gdn_norm_silu(v))
+    x4.x *= _gate_fn(g4.x);
+    x4.y *= _gate_fn(g4.y);
+    x4.z *= _gate_fn(g4.z);
+    x4.w *= _gate_fn(g4.w);
+    #undef _gate_fn
+
+    gdn_norm_write_half4(x4, ((half4*) yrow) + lane);
+}
+
+// gdn_conv_ba_kernel<HISTORY = true, a_log_T, K> + the verify recurrence + gated norm, ONE launch.
+// Block (h, b) = v head h of batch row b, 512 threads. Front end, same per-value arithmetic, order
+// and rounding points as gdn_conv_ba_kernel:
+//   b/a GEMV   warp w computes (row b * S + task / 2, output (task & 1) * H + h), task = w, w + 16,
+//              ...: lane l accumulates half2 elements l, l + 32, ... ascending with the same two
+//              fmaf, the same __shfl_down_sync tree, then the bias; beta/g by the same formula,
+//              stored, and turned into the rule's scalars by gdn_rule_scalars from the stored values.
+//   conv       thread t < 384 runs the per-channel conv of q channel t, k channel t - 128 or v
+//              channel t - 256 of this head (k head h / group); the widened bf16 outputs are the
+//              rule's raw q/k/v. The q/k channels of a k head are computed by each of its `group`
+//              v heads (identical values); only the owner (h % group == group - 1, the group's
+//              highest block index) stores them (conv_out, conv_state), v channels by their head.
+//   conv_state q/k windows are read by every block of the group, so the owner writes them last,
+//              after the group's other blocks signalled (conv_sync counter, reset to 0 by the
+//              owner) that their reads are done. All blocks are resident at once (checked at
+//              launch), so the wait always ends.
+// Kernel params 0 (ba x), 1 (conv_state), 2 (slots) and 3 (recurrent_state) are patched when
+// replaying a graph; slots is recorded twice (conv, rule) to keep run_bszN's patch list.
+template <typename a_log_T, typename norm_w_T, int K>
+__global__ __launch_bounds__(512)
+void gdn_conv_rule_norm_kernel
+(
+    const half* __restrict__ ba_x,              // [B * S, k] half
+    bfloat16* __restrict__ conv_state,          // (num_slots, F, state_size)
+    const int* __restrict__ slots,              // (B)
+    float* __restrict__ recurrent_state,        // [num_slots, max_history + 1, H, 128, 128]
+    const float* __restrict__ qkv,              // [B, S, F] float
+    const bfloat16* __restrict__ conv_weight,   // [F, K]
+    const bfloat16* __restrict__ conv_bias,     // [F] or null
+    bfloat16* __restrict__ conv_out,            // [B, S, F]
+    const half* __restrict__ ba_w,              // [2H, k]
+    const half* __restrict__ ba_bias,           // [2H] or null
+    float* __restrict__ ba_out,                 // [B * S, 2H]
+    const bfloat16* __restrict__ dt_bias,       // [H]
+    const a_log_T* __restrict__ a_log,          // [H]
+    bfloat16* __restrict__ out_beta,            // [B * S, H]
+    float* __restrict__ out_g,                  // [B * S, H]
+    const norm_w_T* __restrict__ norm_w,        // [128]
+    const float* __restrict__ gate,             // [B, S, H, 128]
+    half* __restrict__ y,                       // [B, S, H * 128]
+    int* __restrict__ conv_sync,                // [B, Nk], zero on entry and exit
+    const int S,
+    const int F,
+    const int state_size,
+    const int k,
+    const int Nk,
+    const int H,
+    const int history_stride,
+    const float beta_scale,
+    const float scale,
+    const float epsilon,
+    const float constant_bias,
+    const int gate_act,                         // 0 = silu, 1 = sigmoid
+    const int dim                               // 128, a runtime value as in the norm kernel
+)
+{
+    constexpr int HD = 128;
+    constexpr int THREADS = 512;
+    extern __shared__ __align__(16) float gr_smem[];
+
+    const int h = blockIdx.x;
+    const int b = blockIdx.y;
+    const int t = threadIdx.x;
+    const int warp_id = t / 32;
+    const int lane_id = t % 32;
+    const int group = H / Nk;
+    const int kh = h / group;
+    const bool owner = h % group == group - 1;
+    const int slot = slots ? slots[b] : b;
+    const int SEQ = K + S;
+    GdnRuleSmem m = gdn_rule_smem(gr_smem, S, true);
+
+    // Recurrent state (row 0 of the slot, never written here): issued first, consumed by the rule
+    const GdnRuleThread th = gdn_rule_thread(0);
+    const float* head_state = recurrent_state + (size_t) slot * history_stride * H * HD * HD + (size_t) h * HD * HD;
+    float state[32];
+    gdn_rule_load_state(state, head_state, th);
+
+    // Norm operands of token warp_id
+    const size_t row_off = ((size_t) (b * S + warp_id) * H + h) * dim;
+    float4 w4;
+    float4 g4;
+    if (warp_id < S) gdn_rule_norm_prefetch(w4, g4, norm_w, gate + row_off, lane_id);
+
+    // Causal conv1d update of the q/k/v channels of this head
+    if (t < 3 * HD)
+    {
+        const int c = t < HD ? kh * HD + t : (t < 2 * HD ? (Nk + kh) * HD + t - HD : 2 * Nk * HD + h * HD + t - 2 * HD);
+        const bfloat16* state_d = conv_state + ((size_t) slot * F + c) * state_size;
+        const float* x_d = qkv + (size_t) b * S * F + c;
+        bfloat16* seq = m.seq + t * SEQ;
+        float* dst = t < HD ? m.q + t : (t < 2 * HD ? m.k + t - HD : m.v + t - 2 * HD);
+        const bool store = owner || t >= 2 * HD;
+
+        float w[K];
+        #pragma unroll
+        for (int kk = 0; kk < K; ++kk)
+            w[kk] = __bfloat162float(conv_weight[(size_t) c * K + kk]);
+
+        float bias_d = conv_bias ? __bfloat162float(conv_bias[c]) : 0.0f;
+
+        float old_state[K];
+        float win[K];
+        #pragma unroll
+        for (int kk = 0; kk < K; ++kk)
+        {
+            bfloat16 v = state_d[kk];
+            seq[kk] = v;
+            old_state[kk] = __bfloat162float(v);
+        }
+        #pragma unroll
+        for (int kk = 0; kk < K - 1; ++kk)
+            win[kk] = old_state[kk + 1];
+
+        bfloat16 xb[GR_MAX_S];
+        #pragma unroll
+        for (int s = 0; s < GR_MAX_S; ++s)
+            if (s < S) xb[s] = trunc_bf16(x_d[(size_t) s * F]);
+
+        #pragma unroll
+        for (int s = 0; s < GR_MAX_S; ++s)
+        {
+            if (s < S)
+            {
+                seq[K + s] = xb[s];
+                win[K - 1] = __bfloat162float(xb[s]);
+
+                float acc = bias_d;
+                #pragma unroll
+                for (int kk = 0; kk < K; ++kk)
+                    acc = fmaf(w[kk], win[kk], acc);
+
+                acc *= _sigmoid_fast_exp(acc);
+
+                bfloat16 o = __float2bfloat16_rn(acc);
+                if (store) conv_out[((size_t) b * S + s) * F + c] = o;
+                dst[s * HD] = __bfloat162float(o);
+
+                #pragma unroll
+                for (int kk = 0; kk < K - 1; ++kk)
+                    win[kk] = win[kk + 1];
+            }
+        }
+    }
+
+    // b/a GEMV, one (row, output) per warp
+    {
+        const int n = 2 * H;
+        const int k2 = k / 2;
+        for (int task = warp_id; task < 2 * S; task += THREADS / 32)
+        {
+            const int ab = task & 1;
+            const int s = task >> 1;
+            const int o = ab * H + h;
+            const int r = b * S + s;
+            const half2* w2 = (const half2*) (ba_w + (size_t) o * k);
+            const half2* x2 = (const half2*) (ba_x + (size_t) r * k);
+            float sum = 0.0f;
+
+            for (int j0 = lane_id; j0 < k2; j0 += 32 * GR_BA_UNROLL)
+            {
+                half2 wv[GR_BA_UNROLL];
+                half2 xv[GR_BA_UNROLL];
+                #pragma unroll
+                for (int u = 0; u < GR_BA_UNROLL; ++u)
+                {
+                    int j = j0 + u * 32;
+                    if (j < k2)
+                    {
+                        wv[u] = w2[j];
+                        xv[u] = x2[j];
+                    }
+                }
+                #pragma unroll
+                for (int u = 0; u < GR_BA_UNROLL; ++u)
+                {
+                    int j = j0 + u * 32;
+                    if (j < k2)
+                    {
+                        float2 wf = __half22float2(wv[u]);
+                        float2 xf = __half22float2(xv[u]);
+                        sum = fmaf(xf.x, wf.x, sum);
+                        sum = fmaf(xf.y, wf.y, sum);
+                    }
+                }
+            }
+
+            for (int offset = 16; offset > 0; offset >>= 1)
+                sum += __shfl_down_sync(0xffffffff, sum, offset);
+
+            if (lane_id == 0)
+            {
+                float v = sum;
+                if (ba_bias) v += __half2float(ba_bias[o]);
+                ba_out[(size_t) r * n + o] = v;
+                m.ba[ab * S + s] = v;
+            }
+        }
+    }
+    __syncthreads();
+
+    // Every q/k window read of this block is done: let the owner of the k head write them
+    if (!owner && t == 0)
+    {
+        __threadfence();
+        atomicAdd(conv_sync + b * Nk + kh, 1);
+    }
+
+    // Window write-back (history layout: the rewindable tail of the buffer), v channels now
+    const int write_size = state_size < SEQ ? state_size : SEQ;
+    const int dst_start = state_size - write_size;
+    const int src_start = SEQ - write_size;
+    {
+        bfloat16* state_v = conv_state + ((size_t) slot * F + 2 * Nk * HD + h * HD) * state_size;
+        for (int e = t; e < HD * write_size; e += THREADS)
+        {
+            int c = e / write_size;
+            int j = e - c * write_size;
+            state_v[(size_t) c * state_size + dst_start + j] = m.seq[(2 * HD + c) * SEQ + src_start + j];
+        }
+    }
+
+    // beta/g, stored, and the rule's scalars from the stored values
+    if (t < S)
+    {
+        float bv = m.ba[t];
+        float av = m.ba[S + t];
+        float beta = _sigmoid_fast_exp(bv) * beta_scale;
+        float dtb = as_float(dt_bias[h]);
+        float gv = -softplus(av + dtb) * __expf(as_float(a_log[h]));
+
+        const size_t r = (size_t) b * S + t;
+        bfloat16 beta_b = trunc_bf16(beta);
+        out_beta[r * H + h] = beta_b;
+        out_g[r * H + h] = gv;
+        gdn_rule_scalars(gv, beta_b, m.gexp[t], m.beta[t]);
+    }
+
+    gdn_rule_tokens<RULE_VERIFY, 4>(state, m, S, th, scale);
+
+    // Gated RMS norm, warp s = token s
+    if (warp_id < S)
+        gdn_rule_norm_row(m.out + warp_id * HD, w4, g4, y + row_off, epsilon, constant_bias, gate_act, dim, lane_id);
+
+    // q/k windows: the owner writes them once the group's other blocks have read them
+    if (owner)
+    {
+        if (group > 1)
+        {
+            if (t == 0)
+            {
+                volatile int* ctr = conv_sync + b * Nk + kh;
+                // One poller per block (the other warps wait at the barrier), backing off so a
+                // waiting SM draws no issue power from the working ones
+                unsigned ns = 32;
+                while (*ctr < group - 1)
+                {
+                    __nanosleep(ns);
+                    ns = ns < 1024 ? ns * 2 : 1024;
+                }
+                *ctr = 0;
+                __threadfence();
+            }
+            __syncthreads();
+        }
+        for (int e = t; e < 2 * HD * write_size; e += THREADS)
+        {
+            int c = e / write_size;
+            int j = e - c * write_size;
+            int ch = c < HD ? kh * HD + c : (Nk + kh) * HD + c - HD;
+            conv_state[((size_t) slot * F + ch) * state_size + dst_start + j] = m.seq[c * SEQ + src_start + j];
+        }
+    }
+}
+
+// Verify recurrence (+ gated norm when NORM) reading the conv output / g / beta written by the
+// conv front end (the replay_verify path when the fused kernel does not cover the shape). Block
+// (h, b), 512 threads; recurrent_state is param 3, slots param 4
+template <bool NORM, typename norm_w_T>
+__global__ __launch_bounds__(512)
+void gdn_rule_verify_kernel
+(
+    const bfloat16* __restrict__ conv_out,      // [B, S, F]
+    const float* __restrict__ g,                // [B, S, H]
+    const bfloat16* __restrict__ beta,          // [B, S, H]
+    float* __restrict__ recurrent_state,        // [num_slots, max_history + 1, H, 128, 128]
+    const int* __restrict__ slots,              // (B)
+    bfloat16* __restrict__ core_attn_out,       // [B, S, H, 128] (!NORM)
+    const norm_w_T* __restrict__ norm_w,        // [128] (NORM)
+    const float* __restrict__ gate,             // [B, S, H, 128] (NORM)
+    half* __restrict__ y,                       // [B, S, H * 128] (NORM)
+    const int S,
+    const int Nk,
+    const int H,
+    const int history_stride,
+    const float scale,
+    const float epsilon,
+    const float constant_bias,
+    const int gate_act,
+    const int dim
+)
+{
+    constexpr int HD = 128;
+    extern __shared__ __align__(16) float gr_smem[];
+    const int h = blockIdx.x;
+    const int b = blockIdx.y;
+    const int warp_id = threadIdx.x / 32;
+    const int lane_id = threadIdx.x % 32;
+    const int F = 2 * Nk * HD + H * HD;
+    const int slot = slots ? slots[b] : b;
+    GdnRuleSmem m = gdn_rule_smem(gr_smem, S, true);
+
+    const GdnRuleThread th = gdn_rule_thread(0);
+    const float* head_state = recurrent_state + (size_t) slot * history_stride * H * HD * HD + (size_t) h * HD * HD;
+    float state[32];
+    gdn_rule_load_state(state, head_state, th);
+
+    const size_t row_off = ((size_t) (b * S + warp_id) * H + h) * dim;
+    float4 w4;
+    float4 g4;
+    if (NORM && warp_id < S) gdn_rule_norm_prefetch(w4, g4, norm_w, gate + row_off, lane_id);
+
+    gdn_rule_load_inputs<512>(m, conv_out + (size_t) b * S * F, g + (size_t) b * S * H, beta + (size_t) b * S * H, S, F, Nk, H, h);
+    __syncthreads();
+
+    gdn_rule_tokens<RULE_VERIFY, 4>(state, m, S, th, scale);
+
+    if constexpr (NORM)
+    {
+        if (warp_id < S)
+            gdn_rule_norm_row(m.out + warp_id * HD, w4, g4, y + row_off, epsilon, constant_bias, gate_act, dim, lane_id);
+    }
+    else
+    {
+        for (int e = threadIdx.x; e < S * HD; e += 512)
+        {
+            int s = e / HD;
+            int c = e - s * HD;
+            core_attn_out[((size_t) (b * S + s) * H + h) * HD + c] = m.out[s * HD + c];
+        }
+    }
+}
+
+bool gdn_conv_rule_norm_gr
+(
+    const at::Tensor& x,
+    const at::Tensor& ba_w,
+    const c10::optional<at::Tensor>& ba_bias,
+    at::Tensor& ba,
+    const at::Tensor& qkv,
+    const at::Tensor& dt_bias,
+    const at::Tensor& a_log,
+    at::Tensor& beta,
+    at::Tensor& g,
+    const float beta_scale,
+    at::Tensor& conv_state,
+    const at::Tensor& slots,
+    const at::Tensor& conv_weight,
+    const c10::optional<at::Tensor>& conv_bias,
+    at::Tensor& conv_out,
+    at::Tensor& recurrent_state,
+    int num_k_heads,
+    int num_v_heads,
+    int k_head_dim,
+    int v_head_dim,
+    const at::Tensor& norm_w,
+    const at::Tensor& gate,
+    at::Tensor& y,
+    float epsilon,
+    float constant_bias,
+    int gate_act,
+    at::Tensor& conv_sync,
+    Graph* graph
+)
+{
+    int B = qkv.size(0);
+    int S = qkv.size(1);
+    int F = qkv.size(2);
+    int H = num_v_heads;
+    bool norm_w_fp32 = norm_w.dtype() == at::kFloat;
+    bool norm_w_bf16 = norm_w.dtype() == at::kBFloat16;
+    bool a_log_fp32 = a_log.dtype() == at::kFloat;
+    bool a_log_bf16 = a_log.dtype() == at::kBFloat16;
+
+    // Shapes the fused kernel covers; anything else runs the front end and gdn_rule_verify_gr
+    if (conv_weight.dim() != 2 || conv_weight.size(1) != GR_K || S < 1 || S > GR_MAX_S ||
+        k_head_dim != 128 || v_head_dim != 128 || num_k_heads < 1 || H % num_k_heads != 0 ||
+        F != 2 * num_k_heads * 128 + H * 128 || g.dim() != 3 ||
+        (!a_log_fp32 && !a_log_bf16) || (!norm_w_fp32 && !norm_w_bf16) ||
+        norm_w.numel() != 128 || !norm_w.is_contiguous() ||
+        gate.dtype() != at::kFloat || y.dtype() != at::kHalf ||
+        gate.numel() != (int64_t) B * S * H * 128 || y.numel() != gate.numel() ||
+        !gate.is_contiguous() || !y.is_contiguous() || gate.size(-1) != 128 ||
+        conv_sync.dtype() != at::kInt || conv_sync.numel() < (int64_t) B * num_k_heads ||
+        !conv_sync.is_contiguous() || conv_sync.device() != qkv.device())
+        return false;
+
+    const at::cuda::OptionalCUDAGuard device_guard(x.device());
+    cudaStream_t stream = graph ? graph->capture_stream : at::cuda::getCurrentCUDAStream().stream();
+
+    TORCH_CHECK_DTYPE(x, kHalf);
+    TORCH_CHECK_DTYPE(ba_w, kHalf);
+    TORCH_CHECK_DTYPE_OPT(ba_bias, kHalf);
+    TORCH_CHECK_DTYPE(ba, kFloat);
+    TORCH_CHECK_DTYPE(qkv, kFloat);
+    TORCH_CHECK_DTYPE(dt_bias, kBFloat16);
+    TORCH_CHECK_DTYPE(beta, kBFloat16);
+    TORCH_CHECK_DTYPE(g, kFloat);
+    TORCH_CHECK_DTYPE(conv_state, kBFloat16);
+    TORCH_CHECK_DTYPE(slots, kInt);
+    TORCH_CHECK_DTYPE(conv_weight, kBFloat16);
+    TORCH_CHECK_DTYPE_OPT(conv_bias, kBFloat16);
+    TORCH_CHECK_DTYPE(conv_out, kBFloat16);
+    TORCH_CHECK_DTYPE(recurrent_state, kFloat);
+
+    int R = B * S;
+    int k = x.size(-1);
+    int state_size = conv_state.size(2);
+
+    TORCH_CHECK(x.numel() == (int64_t) R * k && k % 2 == 0, "gdn_conv_rule_norm: x must be [B, S, k], k even");
+    TORCH_CHECK(ba_w.dim() == 2 && ba_w.size(0) == 2 * H && ba_w.size(1) == k, "gdn_conv_rule_norm: ba_w must be [2H, k]");
+    TORCH_CHECK(!ba_bias.has_value() || ba_bias.value().numel() == 2 * H, "gdn_conv_rule_norm: ba_bias must be [2H]");
+    TORCH_CHECK(ba.numel() == (int64_t) R * 2 * H, "gdn_conv_rule_norm: ba must be [B, S, 2H]");
+    TORCH_CHECK(g.size(0) == B && g.size(1) == S && g.size(2) == H, "gdn_conv_rule_norm: g must be [B, S, H]");
+    TORCH_CHECK(beta.dim() == 3 && beta.size(0) == B && beta.size(1) == S && beta.size(2) == H,
+                "gdn_conv_rule_norm: beta must be [B, S, H]");
+    TORCH_CHECK(dt_bias.numel() == H && a_log.numel() == H, "gdn_conv_rule_norm: dt_bias/a_log must be [H]");
+    TORCH_CHECK(state_size >= GR_K, "conv_state must have at least K entries");
+    TORCH_CHECK(conv_state.dim() == 3 && conv_state.size(1) == F, "conv_state must be (num_slots, F, state_size)");
+    TORCH_CHECK(conv_weight.size(0) == F, "conv_weight must be (F, K)");
+    TORCH_CHECK(!conv_bias.has_value() || conv_bias.value().numel() == F, "conv_bias must be (F)");
+    TORCH_CHECK(conv_out.numel() == (int64_t) R * F, "conv_out must be (B, S, F)");
+    TORCH_CHECK(recurrent_state.dim() == 5 &&
+                recurrent_state.size(1) >= S &&
+                recurrent_state.size(2) == H &&
+                recurrent_state.size(3) == 128 &&
+                recurrent_state.size(4) == 128,
+                "recurrent_state must be [num_slots, max_history + 1, num_v_heads, k_head_dim, v_head_dim]");
+    TORCH_CHECK(slots.dim() == 1 && slots.size(0) == B, "slots must be (bsz)");
+    TORCH_CHECK(slots.device() == qkv.device(), "slots must be on the same device as qkv");
+    TORCH_CHECK(x.is_contiguous() && ba_w.is_contiguous() && ba.is_contiguous() && qkv.is_contiguous() &&
+                beta.is_contiguous() && g.is_contiguous() && conv_state.is_contiguous() &&
+                conv_weight.is_contiguous() && conv_out.is_contiguous() && recurrent_state.is_contiguous(),
+                "gdn_conv_rule_norm: tensors must be contiguous");
+
+    int smem = gdn_rule_smem_bytes(S, true, GR_K);
+    int smem_max = gdn_rule_smem_bytes(GR_MAX_S, true, GR_K);
+    int history_stride = recurrent_state.size(1);
+    float scale = 1.0f / sqrtf(k_head_dim);
+
+    #define ARGS(a_log_T, norm_w_T)                     \
+        (const half*) x.data_ptr(),                     \
+        (bfloat16*) conv_state.data_ptr(),              \
+        (const int*) slots.data_ptr(),                  \
+        (float*) recurrent_state.data_ptr(),            \
+        (const float*) qkv.data_ptr(),                  \
+        (const bfloat16*) conv_weight.data_ptr(),       \
+        (const bfloat16*) OPTPTR(conv_bias),            \
+        (bfloat16*) conv_out.data_ptr(),                \
+        (const half*) ba_w.data_ptr(),                  \
+        (const half*) OPTPTR(ba_bias),                  \
+        (float*) ba.data_ptr(),                         \
+        (const bfloat16*) dt_bias.data_ptr(),           \
+        (const a_log_T*) a_log.data_ptr(),              \
+        (bfloat16*) beta.data_ptr(),                    \
+        (float*) g.data_ptr(),                          \
+        (const norm_w_T*) norm_w.data_ptr(),            \
+        (const float*) gate.data_ptr(),                 \
+        (half*) y.data_ptr(),                           \
+        (int*) conv_sync.data_ptr(),                    \
+        S, F, state_size, k, num_k_heads, H, history_stride, \
+        beta_scale, scale, epsilon, constant_bias, gate_act, 128
+
+    // Every block must be resident at once (q/k window owners wait on their group), otherwise
+    // decline before launching anything
+    #define LAUNCH(a_log_T, norm_w_T)                                                     \
+    {                                                                                     \
+        auto kernel = &gdn_conv_rule_norm_kernel<a_log_T, norm_w_T, GR_K>;                \
+        gdn_max_shared_carveout((const void*) kernel);                                    \
+        gdn_rule_smem_optin((const void*) kernel, smem_max);                              \
+        int per_sm = 0;                                                                   \
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, kernel, 512, smem)); \
+        int sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;           \
+        if ((int64_t) per_sm * sms < (int64_t) B * H) return false;                       \
+        kernel<<<dim3(H, B), 512, smem, stream>>>(ARGS(a_log_T, norm_w_T));               \
+        if (graph)                                                                        \
+        {                                                                                 \
+            graph->record_param((void*) kernel, GP_gdn_ba_x, 0);                          \
+            graph->record_param((void*) kernel, GP_conv1d_state, 1);                      \
+            graph->record_param((void*) kernel, GP_conv1d_slots, 2);                      \
+            graph->record_param((void*) kernel, GP_gdn_rule_state, 3);                    \
+            graph->record_param((void*) kernel, GP_gdn_rule_slots, 2);                    \
+            graph->record_param((void*) kernel, GP_end, 0);                               \
+        }                                                                                 \
+    }
+
+    if (a_log_fp32)
+    {
+        if (norm_w_fp32) LAUNCH(float, float)
+        else             LAUNCH(float, bfloat16)
+    }
+    else
+    {
+        if (norm_w_fp32) LAUNCH(bfloat16, float)
+        else             LAUNCH(bfloat16, bfloat16)
+    }
+
+    #undef LAUNCH
+    #undef ARGS
+
+    cuda_check(cudaPeekAtLastError());
+    return true;
+}
+
+void gdn_rule_verify_gr
+(
+    const at::Tensor& conv_out,
+    const at::Tensor& g,
+    const at::Tensor& beta,
+    at::Tensor& recurrent_state,
+    int num_k_heads,
+    int num_v_heads,
+    const at::Tensor& slots,
+    bool norm,
+    const at::Tensor& norm_w,
+    const at::Tensor& gate,
+    at::Tensor& y,
+    at::Tensor& core_attn_out,
+    float epsilon,
+    float constant_bias,
+    int gate_act,
+    Graph* graph
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(conv_out.device());
+    cudaStream_t stream = graph ? graph->capture_stream : at::cuda::getCurrentCUDAStream().stream();
+
+    int B = conv_out.size(0);
+    int S = conv_out.size(1);
+    int H = num_v_heads;
+    int F = 2 * num_k_heads * 128 + H * 128;
+
+    TORCH_CHECK(S >= 1 && S <= GR_MAX_S, "gdn_rule_verify: seqlen out of range");
+    TORCH_CHECK(num_k_heads >= 1 && H % num_k_heads == 0, "gdn_rule_verify: bad head counts");
+    TORCH_CHECK_DTYPE(conv_out, kBFloat16);
+    TORCH_CHECK_DTYPE(g, kFloat);
+    TORCH_CHECK_DTYPE(beta, kBFloat16);
+    TORCH_CHECK_DTYPE(recurrent_state, kFloat);
+    TORCH_CHECK_DTYPE(slots, kInt);
+    TORCH_CHECK(conv_out.dim() == 3 && conv_out.size(2) == F, "gdn_rule_verify: conv_out must be [B, S, F]");
+    TORCH_CHECK(g.numel() == (int64_t) B * S * H && beta.numel() == (int64_t) B * S * H, "gdn_rule_verify: g/beta must be [B, S, H]");
+    TORCH_CHECK(recurrent_state.dim() == 5 && recurrent_state.size(1) >= S && recurrent_state.size(2) == H &&
+                recurrent_state.size(3) == 128 && recurrent_state.size(4) == 128,
