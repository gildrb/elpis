+// Copies of norm.cu's gated_rms_norm_kernel element helpers (same source, same TU flags)
+__device__ inline void gdn_norm_read_bfloat164(float4& f4, const bfloat164* addr)
+{
+    bfloat164 h4;
+    READ64(h4, addr);
+    f4.x = __bfloat162float(__low2bfloat16(h4.x));
+    f4.y = __bfloat162float(__high2bfloat16(h4.x));
+    f4.z = __bfloat162float(__low2bfloat16(h4.y));
+    f4.w = __bfloat162float(__high2bfloat16(h4.y));
+}
+
+__device__ inline void gdn_norm_read_float4(float4& f4, const float4* addr)
+{
+    READ128(f4, addr);
+}
+
+__device__ inline void gdn_norm_write_half4(const float4& f4, half4* addr)
+{
+    half4 h4
+    (
+        __halves2half2(__float2half_rn(f4.x), __float2half_rn(f4.y)),
+        __halves2half2(__float2half_rn(f4.z), __float2half_rn(f4.w))
+    );
+    WRITE64(addr, h4);
+}
+
+__device__ inline float gdn_norm_sum_sq4(float lsum, const float4& f4)
+{
+    lsum = fma(f4.x, f4.x, lsum);
+    lsum = fma(f4.y, f4.y, lsum);
+    lsum = fma(f4.z, f4.z, lsum);
+    lsum = fma(f4.w, f4.w, lsum);
+    return lsum;
+}
+
+__device__ inline void gdn_norm_apply4(float4& x4, const float4& w4, const float rmf)
+{
+    x4.x = x4.x * w4.x * rmf;
+    x4.y = x4.y * w4.y * rmf;
+    x4.z = x4.z * w4.z * rmf;
+    x4.w = x4.w * w4.w * rmf;
+}
+
+__device__ __forceinline__ float gdn_norm_silu(float x)
+{
+    float e     = __expf(-x);
+    float recip = __fdividef(1.0f, 1.0f + e);
+    return x * recip;
+}
+
+__device__ __forceinline__ float gdn_norm_sigmoid_f(float x)
+{
+    return __fdividef(1.0f, 1.0f + __expf(-x));
+}
