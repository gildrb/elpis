+                        #pragma unroll
+                        for (int i = 0; i < CONV_BA_ROWS; ++i)
+                        {
+                            float2 xf = __half22float2(xv[i][u]);
+                            sum[i] = fmaf(xf.x, wf.x, sum[i]);
+                            sum[i] = fmaf(xf.y, wf.y, sum[i]);
+                        }
+                    }
+                }
+            }
+
+            #pragma unroll
+            for (int i = 0; i < CONV_BA_ROWS; ++i)
+                for (int offset = 16; offset > 0; offset >>= 1)
+                    sum[i] += __shfl_down_sync(0xffffffff, sum[i], offset);
+
+            if (lane == 0)
+            {
+                #pragma unroll
+                for (int i = 0; i < CONV_BA_ROWS; ++i)
+                {
+                    if (r0 + i < R)
+                    {
+                        float v = sum[i];
+                        if (ba_bias) v += __half2float(ba_bias[o]);
+                        ba_out[(size_t) (r0 + i) * n + o] = v;
+                        sh_ba[ab][r0 + i] = v;
+                    }
+                }
+            }
+        }
+        __syncthreads();
+
+        for (int row = threadIdx.x; row < R; row += CONV_BA_THREADS)
+        {
+            float bv = sh_ba[0][row];
+            float av = sh_ba[1][row];
+            float beta = _sigmoid_fast_exp(bv) * beta_scale;
+            float dtb = as_float(dt_bias[h]);
+            float gv = -softplus(av + dtb) * __expf(as_float(a_log[h]));
+
+            out_beta[(size_t) row * H + h] = trunc_bf16(beta);
+            out_g[(size_t) row * H + h] = gv;
+        }
+        return;
+    }
+
+    __shared__ bfloat16 sh_seq[CONV_BA_THREADS][CONV_BA_SEQ];
+    const int conv_bpb = CEIL_DIVIDE(F, CONV_BA_THREADS);
+    const int cb = blockIdx.x - H;
+    const int b = cb / conv_bpb;
+    const int d0 = (cb - b * conv_bpb) * CONV_BA_THREADS;
+    const int d = d0 + threadIdx.x;
+    const int slot = slots ? slots[b] : b;
+    bfloat16* state_c = conv_state + ((size_t) slot * F + d0) * state_size;
+
+    if (d < F)
+    {
+        const bfloat16* state_d = state_c + (size_t) threadIdx.x * state_size;
+        const float* x_d = qkv + (size_t) b * S * F + d;
+        bfloat16* seq = sh_seq[threadIdx.x];
+
+        float w[K];
+        #pragma unroll
+        for (int kk = 0; kk < K; ++kk)
+            w[kk] = __bfloat162float(conv_weight[(size_t) d * K + kk]);
+
+        float bias_d = conv_bias ? __bfloat162float(conv_bias[d]) : 0.0f;
+
+        // Previous window; win[K-1] slot is filled with the current input each step
+        float old_state[K];
+        float win[K];
+        #pragma unroll
+        for (int kk = 0; kk < K; ++kk)
+        {
+            bfloat16 v = state_d[kk];
+            seq[kk] = v;
+            old_state[kk] = __bfloat162float(v);
+        }
+        #pragma unroll
+        for (int kk = 0; kk < K - 1; ++kk)
+            win[kk] = old_state[kk + 1];
+
+        // All inputs of the sequence up front: mixed_qkv[b, d, s] as fused_op_3 stored it
+        bfloat16 xb[CONV_BA_MAX_S];
+        #pragma unroll
+        for (int s = 0; s < CONV_BA_MAX_S; ++s)
+            if (s < S) xb[s] = trunc_bf16(x_d[(size_t) s * F]);
+
+        #pragma unroll
+        for (int s = 0; s < CONV_BA_MAX_S; ++s)
+        {
+            if (s < S)
+            {
+                seq[K + s] = xb[s];
+                win[K - 1] = __bfloat162float(xb[s]);
+
+                float acc = bias_d;
+                #pragma unroll
+                for (int kk = 0; kk < K; ++kk)
+                    acc = fmaf(w[kk], win[kk], acc);
+
+                acc *= _sigmoid_fast_exp(acc);
+
+                conv_out[((size_t) b * S + s) * F + d] = __float2bfloat16_rn(acc);
+
+                #pragma unroll
+                for (int kk = 0; kk < K - 1; ++kk)
+                    win[kk] = win[kk + 1];
+            }
+        }
+    }
+    __syncthreads();
+
+    // Window write-back, channel-contiguous: the last write_size inputs of each channel (history:
+    // the rewindable tail of the buffer; otherwise the K-wide head). Every read of this block's
+    // state rows happened before the barrier, no other block touches them
+    const int total = K + S;
+    const int write_size = HISTORY ? (state_size < total ? state_size : total) : K;
+    const int dst_start = HISTORY ? state_size - write_size : 0;
+    const int src_start = total - write_size;
+    const int channels = min(CONV_BA_THREADS, F - d0);
+    for (int e = threadIdx.x; e < channels * write_size; e += CONV_BA_THREADS)
+    {
+        int c = e / write_size;
+        int j = e - c * write_size;
+        state_c[(size_t) c * state_size + dst_start + j] = sh_seq[c][src_start + j];
+    }
+}
+
+bool gdn_conv_ba_gr
+(
+    const at::Tensor& x,
+    const at::Tensor& ba_w,
+    const c10::optional<at::Tensor>& ba_bias,
+    at::Tensor& ba,
+    const at::Tensor& qkv,
+    const at::Tensor& dt_bias,
+    const at::Tensor& a_log,
+    at::Tensor& beta,
+    at::Tensor& g,
+    const float beta_scale,
+    at::Tensor& conv_state,
+    const c10::optional<at::Tensor>& slots,
+    const at::Tensor& conv_weight,
+    const c10::optional<at::Tensor>& conv_bias,
+    at::Tensor& conv_out,
+    bool history,
+    Graph* graph
+)
+{
+    // Conv widths the kernel is instantiated for; others run the three separate launches
+    int K = conv_weight.size(1);
+    if (K < 1 || K > CONV_BA_MAX_K) return false;
+
+    const at::cuda::OptionalCUDAGuard device_guard(x.device());
+    cudaStream_t stream = graph ? graph->capture_stream : at::cuda::getCurrentCUDAStream().stream();
+    TORCH_CHECK(!graph || slots.has_value(), "gdn_conv_ba: graph capture requires slots");
+
+    TORCH_CHECK_DTYPE(x, kHalf);
+    TORCH_CHECK_DTYPE(ba_w, kHalf);
+    TORCH_CHECK_DTYPE_OPT(ba_bias, kHalf);
+    TORCH_CHECK_DTYPE(ba, kFloat);
+    TORCH_CHECK_DTYPE(qkv, kFloat);
+    TORCH_CHECK_DTYPE(dt_bias, kBFloat16);
+    TORCH_CHECK_DTYPE(beta, kBFloat16);
+    TORCH_CHECK_DTYPE(g, kFloat);
+    TORCH_CHECK_DTYPE(conv_state, kBFloat16);
+    TORCH_CHECK_DTYPE_OPT(slots, kInt);
+    TORCH_CHECK_DTYPE(conv_weight, kBFloat16);
+    TORCH_CHECK_DTYPE_OPT(conv_bias, kBFloat16);
+    TORCH_CHECK_DTYPE(conv_out, kBFloat16);
+
+    int B = qkv.size(0);
+    int S = qkv.size(1);
+    int F = qkv.size(2);
+    int R = B * S;
+    int k = x.size(-1);
+    int H = beta.size(-1);
+    int state_size = conv_state.size(2);
+
+    TORCH_CHECK(S <= CONV_BA_MAX_S && R <= CONV_BA_MAX_R, "gdn_conv_ba: too many rows");
+    TORCH_CHECK(x.numel() == (int64_t) R * k && k % 2 == 0, "gdn_conv_ba: x must be [B, S, k], k even");
+    TORCH_CHECK(ba_w.dim() == 2 && ba_w.size(0) == 2 * H && ba_w.size(1) == k, "gdn_conv_ba: ba_w must be [2H, k]");
+    TORCH_CHECK(!ba_bias.has_value() || ba_bias.value().numel() == 2 * H, "gdn_conv_ba: ba_bias must be [2H]");
+    TORCH_CHECK(ba.numel() == (int64_t) R * 2 * H, "gdn_conv_ba: ba must be [B, S, 2H]");
+    TORCH_CHECK(beta.numel() == (int64_t) R * H && g.numel() == (int64_t) R * H, "gdn_conv_ba: beta/g must be [B, S, H]");
+    TORCH_CHECK(state_size >= K, "conv_state must have at least K entries");
+    TORCH_CHECK(conv_state.dim() == 3 && conv_state.size(1) == F, "conv_state must be (num_slots, F, state_size)");
+    TORCH_CHECK(conv_weight.dim() == 2 && conv_weight.size(0) == F, "conv_weight must be (F, K)");
+    TORCH_CHECK(conv_out.numel() == (int64_t) R * F, "conv_out must be (B, S, F)");
+    TORCH_CHECK(x.is_contiguous() && ba_w.is_contiguous() && ba.is_contiguous() && qkv.is_contiguous() &&
+                beta.is_contiguous() && g.is_contiguous() && conv_state.is_contiguous() &&
+                conv_weight.is_contiguous() && conv_out.is_contiguous(),
+                "gdn_conv_ba: tensors must be contiguous");
+
+    const int* slots_ptr = (const int*) OPTPTR(slots);
+    if (slots_ptr)
+    {
+        TORCH_CHECK(slots.value().dim() == 1 && slots.value().size(0) == B, "slots must be (bsz)");
+    }
+    else
+    {
+        TORCH_CHECK(conv_state.size(0) >= B, "conv_state too small for batch without slots");
+    }
+
+    int blocks = H + CEIL_DIVIDE(F, CONV_BA_THREADS) * B;
+
+    #define ARGS(a_log_T)                               \
+        (const half*) x.data_ptr(),                     \
+        (bfloat16*) conv_state.data_ptr(),              \
+        slots_ptr,                                      \
+        (const float*) qkv.data_ptr(),                  \
+        (const bfloat16*) conv_weight.data_ptr(),       \
+        (const bfloat16*) OPTPTR(conv_bias),            \
+        (bfloat16*) conv_out.data_ptr(),                \
+        (const half*) ba_w.data_ptr(),                  \
+        (const half*) OPTPTR(ba_bias),                  \
+        (float*) ba.data_ptr(),                         \
+        (const bfloat16*) dt_bias.data_ptr(),           \
+        (const a_log_T*) a_log.data_ptr(),              \
+        (bfloat16*) beta.data_ptr(),                    \
+        (float*) g.data_ptr(),                          \
+        B, S, F, state_size, k, H, beta_scale
+
+    // x is param 0, conv_state param 1 and slots param 2: the order gdn_ba_gemv_kernel and
+    // conv1d_update_kernel recorded them, so run_bszN's patch list is unchanged
+    #define LAUNCH(hist, a_log_T, kc)                                                     \
+    {                                                                                     \
+        auto kernel = &gdn_conv_ba_kernel<hist, a_log_T, kc>;                             \
+        gdn_max_shared_carveout((const void*) kernel);                                    \
+        kernel<<<blocks, CONV_BA_THREADS, 0, stream>>>(ARGS(a_log_T));                    \
+        if (graph)                                                                        \
+        {                                                                                 \
+            graph->record_param((void*) kernel, GP_gdn_ba_x, 0);                          \
+            graph->record_param((void*) kernel, GP_conv1d_state, 1);                      \
+            graph->record_param((void*) kernel, GP_conv1d_slots, 2);                      \
+            graph->record_param((void*) kernel, GP_end, 0);                               \
+        }                                                                                 \
+    }
+
+    #define LAUNCH_K(hist, a_log_T)                                                       \
+    {                                                                                     \
+        switch (K)                                                                        \
+        {                                                                                 \
+            case 1: LAUNCH(hist, a_log_T, 1) break;                                       \
+            case 2: LAUNCH(hist, a_log_T, 2) break;                                       \
+            case 3: LAUNCH(hist, a_log_T, 3) break;                                       \
+            default: LAUNCH(hist, a_log_T, 4) break;                                      \
+        }                                                                                 \
+    }
+
+    if (a_log.dtype() == at::kFloat)
+    {
+        if (history) LAUNCH_K(true, float)
+        else         LAUNCH_K(false, float)
+    }
+    else if (a_log.dtype() == at::kBFloat16)
+    {
+        if (history) LAUNCH_K(true, bfloat16)
+        else         LAUNCH_K(false, bfloat16)
+    }
+    else TORCH_CHECK(false, "gdn_conv_ba: unsupported a_log dtype");
+
+    #undef LAUNCH_K
+    #undef LAUNCH
+    #undef ARGS
+
+    cuda_check(cudaPeekAtLastError());
+    return true;
+}
