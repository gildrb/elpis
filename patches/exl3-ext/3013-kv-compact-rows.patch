@@ -0,0 +1,139 @@
+#include <cuda_fp16.h>
+#include "kv_compact.cuh"
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "util.h"
+#include "util.cuh"
+
+// ext 3013: see kv_compact.cuh. The layer jobs are flattened to row sets (one per cache tensor
+// of each layer) copied in 16-byte units; one block row per set, one thread per unit of a token
+// row. A thread owns the same unit of every source and destination row, and distinct token rows
+// never share bytes, so reading all sources into registers before writing any destination makes
+// the copy hazard-free with no synchronization.
+
+#define KV_COMPACT_THREADS 64
+
+struct KvCompactRowSet
+{
+    uint4* base;            // token row t starts at base + t * units
+    int64_t units;          // 16-byte units per token row
+};
+
+struct KvCompactBatch
+{
+    KvCompactRowSet sets[KV_COMPACT_MAX_JOBS * 4];
+    int64_t src[KV_COMPACT_MAX_MOVES];
+    int64_t dst[KV_COMPACT_MAX_MOVES];
+    int num_sets;
+    int num_moves;
+};
+static_assert(sizeof(KvCompactBatch) <= 4096, "KvCompactBatch exceeds the kernel parameter limit");
+
+__global__ __launch_bounds__(KV_COMPACT_THREADS)
+void kv_compact_rows_kernel(KvCompactBatch batch)
+{
+    const KvCompactRowSet set = batch.sets[blockIdx.y];
+    const int64_t u = (int64_t) blockIdx.x * KV_COMPACT_THREADS + threadIdx.x;
+    if (u >= set.units) return;
+
+    uint4 row[KV_COMPACT_MAX_MOVES];
+    #pragma unroll
+    for (int i = 0; i < KV_COMPACT_MAX_MOVES; ++i)
+        if (i < batch.num_moves) row[i] = set.base[batch.src[i] * set.units + u];
+    #pragma unroll
+    for (int i = 0; i < KV_COMPACT_MAX_MOVES; ++i)
+        if (i < batch.num_moves) set.base[batch.dst[i] * set.units + u] = row[i];
+}
+
+static int row_units(const at::Tensor& t, int elem_bytes, const char* name)
+{
+    TORCH_CHECK(t.is_cuda(), "KvCompactJob: ", name, " is not a CUDA tensor");
+    TORCH_CHECK(t.dim() == 3, "KvCompactJob: ", name, " must be [pages, page_size, row]");
+    TORCH_CHECK(t.is_contiguous(), "KvCompactJob: ", name, " is not contiguous");
+    TORCH_CHECK(t.element_size() == elem_bytes, "KvCompactJob: ", name, " has the wrong element size");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(t.data_ptr()) % 16 == 0, "KvCompactJob: ", name, " is not 16-byte aligned");
+    const int64_t row_bytes = t.size(2) * elem_bytes;
+    TORCH_CHECK(row_bytes > 0 && row_bytes % 16 == 0, "KvCompactJob: ", name, " row is not a multiple of 16 bytes");
+    return (int) t.size(2);
+}
+
+KvCompactJob::KvCompactJob(const at::Tensor& qk, const at::Tensor& qv, const at::Tensor& sk, const at::Tensor& sv)
+{
+    TORCH_CHECK(qk.dtype() == at::kInt && qv.dtype() == at::kInt, "KvCompactJob: qk/qv must be int32");
+    TORCH_CHECK(sk.dtype() == at::kHalf && sv.dtype() == at::kHalf, "KvCompactJob: sk/sv must be float16");
+    words_k = row_units(qk, 4, "qk");
+    words_v = row_units(qv, 4, "qv");
+    scales_k = row_units(sk, 2, "sk");
+    scales_v = row_units(sv, 2, "sv");
+    for (const at::Tensor* t : {&qv, &sk, &sv})
+    {
+        TORCH_CHECK(t->device() == qk.device(), "KvCompactJob: tensors on different devices");
+        TORCH_CHECK(t->size(0) == qk.size(0) && t->size(1) == qk.size(1), "KvCompactJob: page geometry differs between tensors");
+    }
+    k = reinterpret_cast<uintptr_t>(qk.data_ptr());
+    v = reinterpret_cast<uintptr_t>(qv.data_ptr());
+    k_scales = reinterpret_cast<uintptr_t>(sk.data_ptr());
+    v_scales = reinterpret_cast<uintptr_t>(sv.data_ptr());
+    num_tokens = qk.size(0) * qk.size(1);
+    device = qk.get_device();
+}
+
+void kv_compact_rows
+(
+    std::vector<KvCompactJob> const& layer_jobs,
+    std::vector<std::tuple<int64_t, int64_t>> const& moves,
+    int device_index
+)
+{
+    TORCH_CHECK(!layer_jobs.empty(), "kv_compact_rows: no layer jobs");
+    const int n = (int) moves.size();
+    TORCH_CHECK(n >= 1 && n <= KV_COMPACT_MAX_MOVES, "kv_compact_rows: need 1..", KV_COMPACT_MAX_MOVES, " moves, got ", n);
+    int64_t num_tokens = layer_jobs[0].num_tokens;
+    for (auto const& j : layer_jobs)
+    {
+        TORCH_CHECK(j.device == device_index, "kv_compact_rows: layer job on device ", j.device, ", expected ", device_index);
+        num_tokens = MIN(num_tokens, j.num_tokens);
+    }
+
+    KvCompactBatch batch;
+    batch.num_moves = n;
+    for (int i = 0; i < n; ++i)
+    {
+        const int64_t s = std::get<0>(moves[i]);
+        const int64_t d = std::get<1>(moves[i]);
+        TORCH_CHECK(s >= 0 && s < num_tokens && d >= 0 && d < num_tokens, "kv_compact_rows: move ", i, " (", s, ", ", d, ") outside [0, ", num_tokens, ")");
+        TORCH_CHECK(s != d, "kv_compact_rows: move ", i, " copies token ", s, " onto itself");
+        for (int k = 0; k < i; ++k)
+        {
+            TORCH_CHECK(batch.dst[k] != d, "kv_compact_rows: moves ", k, " and ", i, " share destination ", d);
+            TORCH_CHECK(batch.dst[k] != s, "kv_compact_rows: move ", i, " reads token ", s, ", the destination of earlier move ", k);
+        }
+        batch.src[i] = s;
+        batch.dst[i] = d;
+    }
+    for (int i = n; i < KV_COMPACT_MAX_MOVES; ++i) batch.src[i] = batch.dst[i] = 0;
+
+    c10::cuda::CUDAGuard device_guard((c10::DeviceIndex) device_index);
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    for (size_t base = 0; base < layer_jobs.size(); base += KV_COMPACT_MAX_JOBS)
+    {
+        const int jobs = (int) MIN(layer_jobs.size() - base, (size_t) KV_COMPACT_MAX_JOBS);
+        int64_t max_units = 0;
+        batch.num_sets = 0;
+        for (int i = 0; i < jobs; ++i)
+        {
+            KvCompactJob const& j = layer_jobs[base + i];
+            const uintptr_t ptrs[4] = {j.k, j.v, j.k_scales, j.v_scales};
+            const int64_t units[4] = {j.words_k / 4, j.words_v / 4, j.scales_k / 8, j.scales_v / 8};
+            for (int t = 0; t < 4; ++t)
+            {
+                batch.sets[batch.num_sets++] = {reinterpret_cast<uint4*>(ptrs[t]), units[t]};
+                max_units = MAX(max_units, units[t]);
+            }
+        }
+        dim3 blocks((unsigned) CEIL_DIVIDE(max_units, (int64_t) KV_COMPACT_THREADS), (unsigned) batch.num_sets);
+        kv_compact_rows_kernel<<<blocks, KV_COMPACT_THREADS, 0, stream>>>(batch);
+        cuda_check(cudaPeekAtLastError());
+    }
+}
