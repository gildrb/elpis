+#pragma once
+
+#include <ATen/Tensor.h>
+#include <cstdint>
+#include <tuple>
+#include <vector>
+
+// ext 3013: tree-verify commit of a paged quantized K/V cache (CacheLayer_quant). A tree verify
+// writes row r at slot base+r; the accepted path P keeps rows P[0..count) and must end up at
+// slots base+0..base+count-1, as a chain verify of P writes them. Each token row is quantized
+// on its own (words + fp16 group scales, RoPE applied before quantization at base+depth), so the
+// commit is a byte copy of whole token rows.
+
+#define KV_COMPACT_MAX_MOVES 7
+#define KV_COMPACT_MAX_JOBS 32      // layers per launch: 4 row sets each, within the 4 KB parameter limit
+
+// One attention layer's quantized cache: qk/qv int32 [pages, PAGE_SIZE, words], sk/sv fp16
+// [pages, PAGE_SIZE, scales], contiguous. Built from the tensors, which it checks; the tensors
+// must outlive the job (the cache allocates them once per model load).
+struct KvCompactJob
+{
+    uintptr_t k;
+    uintptr_t v;
+    uintptr_t k_scales;
+    uintptr_t v_scales;
+    int words_k;            // int32 words per token row
+    int words_v;
+    int scales_k;           // fp16 scales per token row
+    int scales_v;
+    int64_t num_tokens;     // physical token rows (pages * PAGE_SIZE)
+    int device;
+
+    KvCompactJob() = default;
+    KvCompactJob(const at::Tensor& qk, const at::Tensor& qv, const at::Tensor& sk, const at::Tensor& sv);
+};
+
+// moves: 1..KV_COMPACT_MAX_MOVES (src, dst) physical token indices, in ascending logical
+// destination order. Checked before launch: every index in [0, num_tokens) of every job,
+// src != dst, destinations distinct, and no source is an earlier move's destination (the
+// ascending in-place rule). One launch per KV_COMPACT_MAX_JOBS layers on the current stream;
+// every 16-byte unit is read at all sources before any destination is written, which equals
+// the sequential ascending copy.
+void kv_compact_rows
+(
+    std::vector<KvCompactJob> const& layer_jobs,
+    std::vector<std::tuple<int64_t, int64_t>> const& moves,
+    int device_index
+);
