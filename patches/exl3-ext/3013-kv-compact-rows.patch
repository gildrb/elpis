+"""
+Tree-verify commit of the target's quantized K/V cache (ext 3013).
+
+A tree verify writes row r of the verify window at logical slot base+r. The accepted path
+P = path[last][0..count) (P[0] = 0, strictly increasing) must leave slots base..base+count-1
+holding rows P[0..count), the bytes a chain verify of P writes there: each token row is RoPE'd
+at its own position base+depth and quantized on its own, so the commit is a byte copy of token
+rows. kv_moves derives the copies from P and the job's page list; KvCompactor applies them to
+every attention layer of the cache in one launch.
+"""
+
+from __future__ import annotations
+from typing import Sequence
+from ..constants import PAGE_SIZE
+from .cache import Cache
+from .quant import CacheLayer_quant
+from exllamav3.ext import exllamav3_ext as ext
+
+# Rows of a phase-1 tree verify window and the most copies one commit needs (rows 1..7)
+KV_COMPACT_ROWS = 8
+KV_COMPACT_MAX_MOVES = KV_COMPACT_ROWS - 1
+
+
+def _is_int(value: object) -> bool:
+    return type(value) is int
+
+
+def kv_moves(rows: Sequence[int], base: int, page_indices: Sequence[int]) -> list[tuple[int, int]]:
+    """
+    Physical (src, dst) token copies that turn a tree verify's cache into a chain verify's of P.
+
+    :param rows:
+        The accepted path P = path[last][0..count) as row indices: P[0] == 0, strictly
+        increasing, every row < 8. Hence P[j] >= j, and P[j] > j for every j after the first move.
+
+    :param base:
+        The job's kv_position before the verify (slot of row 0).
+
+    :param page_indices:
+        page_indices[i] is the physical page of logical page i (pos // PAGE_SIZE); it must cover
+        every slot the verify wrote.
+
+    :return:
+        [(phys(base+P[j]), phys(base+j)) for j = 1..count-1 with P[j] != j], in ascending j, with
+        phys(pos) = page_indices[pos // PAGE_SIZE] * PAGE_SIZE + pos % PAGE_SIZE. Empty for an
+        identity path (nothing to move, no draft refresh gather). Applied in ascending j, no
+        source is an earlier destination: base+P[j'] > base+P[j] >= base+j for j' > j.
+    """
+    count = len(rows)
+    if not 1 <= count <= KV_COMPACT_ROWS:
+        raise ValueError(f"kv_moves: path length {count} outside 1..{KV_COMPACT_ROWS}")
+    if not all(_is_int(r) for r in rows):
+        raise ValueError("kv_moves: path rows must be ints")
+    if rows[0] != 0:
+        raise ValueError("kv_moves: path must start at row 0")
+    if any(rows[j] <= rows[j - 1] for j in range(1, count)):
+        raise ValueError("kv_moves: path rows must be strictly increasing")
+    if rows[-1] >= KV_COMPACT_ROWS:
+        raise ValueError(f"kv_moves: path row {rows[-1]} outside the {KV_COMPACT_ROWS}-row window")
+    if not _is_int(base) or base < 0:
+        raise ValueError("kv_moves: base must be a non-negative int")
+    last_page = (base + KV_COMPACT_ROWS - 1) // PAGE_SIZE
+    if len(page_indices) <= last_page:
+        raise ValueError(f"kv_moves: {len(page_indices)} pages do not cover slot {base + KV_COMPACT_ROWS - 1}")
+    pages = page_indices[: last_page + 1]
+    if not all(_is_int(p) and p >= 0 for p in pages):
+        raise ValueError("kv_moves: page indices must be non-negative ints")
+    if len(set(pages)) != len(pages):
+        raise ValueError("kv_moves: page indices repeat")
+
+    def phys(pos: int) -> int:
+        return pages[pos // PAGE_SIZE] * PAGE_SIZE + pos % PAGE_SIZE
+
+    return [(phys(base + rows[j]), phys(base + j)) for j in range(1, count) if rows[j] != j]
+
+
+class KvCompactor:
+    """
+    Prebuilt kv_compact_rows jobs for every attention layer of a quantized target cache.
+    """
+
+    def __init__(self, model, cache: Cache):
+        if cache.model is not model:
+            raise ValueError("KvCompactor: cache is not attached to this model")
+        if model.loaded_tp:
+            raise ValueError("KvCompactor: tensor-parallel caches are not supported")
+        if not cache.layers:
+            raise ValueError("KvCompactor: cache has no attention layers")
+        self.layers = []
+        self.tensors = []
+        self.jobs = []
+        devices = set()
+        for key in sorted(cache.layers):
+            layer = cache.layers[key]
+            # Exact type: subclasses (QSA planes) carry per-token state this copy would miss
+            if type(layer) is not CacheLayer_quant:
+                raise ValueError(f"KvCompactor: layer {key} is {type(layer).__name__}, not CacheLayer_quant")
+            if layer.qk is None:
+                raise ValueError(f"KvCompactor: layer {key} is not allocated")
+            tensors = (layer.qk, layer.qv, layer.sk, layer.sv)
+            self.layers.append(layer)
+            self.tensors.append(tensors)
+            self.jobs.append(ext.KvCompactJob(*tensors))
+            devices.add(layer.qk.device)
+        if len(devices) != 1:
+            raise ValueError("KvCompactor: attention layers span several devices")
+        device = devices.pop()
+        if device.type != "cuda" or device.index is None:
+            raise ValueError(f"KvCompactor: cache device {device} is not an indexed CUDA device")
+        self.device_index = device.index
+
+    def compact(self, moves: list[tuple[int, int]]):
+        """
+        Apply kv_moves output (1..7 physical (src, dst) pairs) to every attention layer on the current
+        stream. The extension checks bounds, src != dst, distinct destinations and that no source
+        is an earlier destination, and raises before launching otherwise.
+        """
+        for layer, tensors in zip(self.layers, self.tensors):
+            if any(now is not built for now, built in zip((layer.qk, layer.qv, layer.sk, layer.sv), tensors)):
+                raise RuntimeError("KvCompactor: cache tensors were reallocated since the jobs were built")
+        if not 1 <= len(moves) <= KV_COMPACT_MAX_MOVES:
+            raise ValueError(f"KvCompactor: {len(moves)} moves outside 1..{KV_COMPACT_MAX_MOVES}")
+        if not all(type(m) is tuple and len(m) == 2 and _is_int(m[0]) and _is_int(m[1]) for m in moves):
+            raise ValueError("KvCompactor: moves must be (src, dst) int pairs")
+        ext.kv_compact_rows(self.jobs, moves, self.device_index)
