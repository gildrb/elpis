+@triton.jit
+def _gqa_row_split(q_abs, MIN_SPLIT: tl.constexpr, SPLITS: tl.constexpr, BLOCK_N: tl.constexpr):
+    """Split length of a causal query row at absolute position q_abs (q_abs + 1 keys), a function
+    of the row alone: s(n) = max(MIN_SPLIT, BLOCK_N * cdiv(n, SPLITS * BLOCK_N)). cdiv(n, s(n)) <=
+    SPLITS, and s(n) is a multiple of BLOCK_N, so the row's splits k * s(n) are BLOCK_N-aligned
+    absolute boundaries that fit the SPLITS programs whatever round the row is verified in."""
+    STEP: tl.constexpr = SPLITS * BLOCK_N
+    return tl.maximum(MIN_SPLIT, ((q_abs + STEP) // STEP) * BLOCK_N)
+
+
+@triton.jit
+def _gqa_live_split(total_k_len, q_len: tl.constexpr, WINDOW_LEFT: tl.constexpr,
+                    SPLITS: tl.constexpr, MIN_SPLIT: tl.constexpr, BLOCK_N: tl.constexpr):
+    """3002's round-relative sizing (window start lo, split length from the live span), kept for
+    sliding-window / non-causal launches: (lo, s_len)."""
+    lo = total_k_len * 0
+    if WINDOW_LEFT >= 0:
+        lo = (tl.maximum(0, total_k_len - q_len - WINDOW_LEFT) // BLOCK_N) * BLOCK_N
+    span = total_k_len - lo
+    live = tl.maximum(1, tl.minimum(SPLITS, tl.cdiv(span, MIN_SPLIT)))
+    return lo, tl.cdiv(tl.cdiv(span, live), BLOCK_N) * BLOCK_N
+
