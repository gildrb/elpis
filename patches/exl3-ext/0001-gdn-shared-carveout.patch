 #define FUSED_OP_2_THREADS 512
 #define FUSED_OP_3_THREADS 256
 
+// Match the tensor-core GEMMs' shared-memory carveout (see exl3_gemv_int8.cu): the small GDN
+// kernels interleave with them in every layer, and a smaller preferred carveout makes the GPU
+// drain and reconfigure the SMs on each transition. A launch-configuration hint only (numerics
+// are unaffected), set once per kernel and device before its first launch
+static std::set<std::pair<int, const void*>> gdn_carveout_set;
+
+static void gdn_max_shared_carveout(const void* fn)
+{
+    int device;
+    cudaGetDevice(&device);
+    if (!gdn_carveout_set.insert(std::make_pair(device, fn)).second) return;
+    cudaFuncSetAttribute(fn, cudaFuncAttributePreferredSharedMemoryCarveout, cudaSharedmemCarveoutMaxShared);
+    cuda_check(cudaPeekAtLastError());
+}
