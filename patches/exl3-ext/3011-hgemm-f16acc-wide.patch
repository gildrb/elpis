+// Ampere wide-warp tiles for the prefill reconstruct GEMMs (sm86 only: measured on the RTX 3090 at its
+// 350 W cap, -21.6 % per 2048-row chunk of 408 linears, reconstruct included). Every output element
+// gets exactly gemm_kernel's sequence (per 32-wide K slice, in order: two fp16-accumulator k16 MMAs
+// from +0, then one fp32 add), so the result is bit-identical; only the tiling differs: 128x128x32
+// blocks of 4 warps with 64x64 warp tiles, 3 swizzled cp.async stages, 2 blocks per SM.
+// Route: exactly the served (K, N, output dtype) shapes of Qwen3.8-27B + its DFlash2 draft, M >= 1024,
+// unbatched; everything else keeps the untuned layout. Kill switch EXL3_HGEMM_F16ACC_WIDE: unset or
+// "1" = on, "0" = off, anything else is an error (read per call, so one process can A/B it).
+//                                  BM   BN  BK WM WN ST  G MINB
+using Wide = f16acc_wide::Cfg<128, 128, 32, 2, 2, 3,  8, 2>;
+
+struct WideShape { int K, N; bool out_f32; };
+static constexpr WideShape wide_shapes[] = {
+    {  5120,  1024, false },    // attention k/v proj, draft k/v proj
+    {  5120,  6144, true  },    // GDN in_proj_z
+    {  5120, 10240, true  },    // GDN in_proj_qkv
+    {  5120, 12288, false },    // attention q_proj (q|gate)
+    {  5120, 17408, false },    // MLP gate/up
+    {  6144,  5120, true  },    // GDN out_proj, attention o_proj
+    { 17408,  5120, true  },    // MLP down
+    { 25600,  5120, false },    // draft fc
+};
+
+static bool wide_enabled()
+{
+    const char* env = std::getenv("EXL3_HGEMM_F16ACC_WIDE");
+    if (!env || std::strcmp(env, "1") == 0) return true;
+    TORCH_CHECK(std::strcmp(env, "0") == 0, "EXL3_HGEMM_F16ACC_WIDE must be 0 or 1");
+    return false;
+}
+
+// true = launch the wide kernel for this GEMM
+static bool wide_route(const at::Tensor& a, const at::Tensor& b, const at::Tensor& c)
+{
+    if (!wide_enabled()) return false;
+    const auto* props = at::cuda::getDeviceProperties(a.device().index());
+    if (props->major != 8 || props->minor != 6) return false;
+    if (a.dim() == 3 && a.size(0) != 1) return false;
+    const int64_t M = a.size(-2), K = a.size(-1), N = b.size(-1);
+    if (M < 1024) return false;
+    const bool out_f32 = c.dtype() == at::kFloat;
+    for (const WideShape& s : wide_shapes)
+        if (s.K == K && s.N == N && s.out_f32 == out_f32) return true;
+    return false;
+}
+static_assert(Wide::BN == 128 && Wide::BK == 32, "every wide_shapes N is a multiple of BN and K of BK");
+
+template <bool OUT_F32>
+static void launch_wide(const at::Tensor& a, const at::Tensor& b, const at::Tensor& c, cudaStream_t stream)
+{
+    auto kern = f16acc_wide::gemm_wide_kernel<OUT_F32, Wide>;
+    static std::once_flag attr_set[MAX_DEVICES];
+    int device = a.device().index();
+    TORCH_CHECK(device >= 0 && device < MAX_DEVICES, "hgemm_f16acc: device index");
+    std::call_once(attr_set[device], [&]()
+    {
+        cuda_check(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) Wide::SMEM_BYTES));
+    });
+    int M = a.size(-2), K = a.size(-1), N = b.size(-1);
+    dim3 grid(N / Wide::BN, (M + Wide::BM - 1) / Wide::BM, 1);
+    kern<<<grid, Wide::THREADS, Wide::SMEM_BYTES, stream>>>(
+        (const half*) a.data_ptr(), (const half*) b.data_ptr(), c.data_ptr(), M, N, K, (int) c.stride(-2));
+    cuda_check(cudaPeekAtLastError());
+}
+
 template <bool OUT_F32>
 static void launch(const at::Tensor& a, const at::Tensor& b, const at::Tensor& c, cudaStream_t stream)
 {
-    if (!tuned_device(a.device().index())) launch_config<OUT_F32, 128, false>(a, b, c, stream);
+    if (!tuned_device(a.device().index()))
+    {
+        if (wide_route(a, b, c)) launch_wide<OUT_F32>(a, b, c, stream);
+        else launch_config<OUT_F32, 128, false>(a, b, c, stream);
+    }
     else if (narrow_tile(a, b)) launch_config<OUT_F32, 64, true>(a, b, c, stream);
     else launch_config<OUT_F32, 128, true>(a, b, c, stream);
 }
