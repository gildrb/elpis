@@ -0,0 +1,14 @@
+#include <torch/library.h>
+
+int exl3_lmhead_shape(int set);   // exl3_gemm.cu (ext 2110)
+
+// torch.ops.exl3_lmhead.shape(set) -> forced lm_head GEMM shape (0 = auto, 2, 3); set < 0 only reads
+static int64_t exl3_lmhead_shape_op(int64_t set)
+{
+    return exl3_lmhead_shape((int) set);
+}
