+int exl3_lmhead_shape(int set)
+{
+    static int value = []
+    {
+        const char* env = std::getenv("EXL3_LMHEAD_SHAPE");
+        if (!env || !env[0] || !strcmp(env, "auto")) return 0;
+        TORCH_CHECK(!strcmp(env, "2") || !strcmp(env, "3"), "exl3_gemm: EXL3_LMHEAD_SHAPE must be auto, 2 or 3, got '", env, "'");
+        return env[0] - '0';
+    }();
+    TORCH_CHECK(set < 0 || set == 0 || set == 2 || set == 3, "exl3_lmhead_shape: set must be 0 (auto), 2, 3 or < 0 (read)");
+    if (set >= 0) value = set;
+    return value;
+}
