+static void* split_fn(int bits)
+{
+    TORCH_CHECK(bits == 3 || bits == 4, "attn_verify: no split kernel for this bitrate");
+    return bits == 3 ? (void*) attn_verify_split_k3v3 : (void*) attn_verify_split_k4v4;
+}
+
+void attn_verify_prepare(int bits)
+{
+    cuda_check(cudaFuncSetAttribute(split_fn(bits), cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                    av_smem_bytes(bits, bits)));
+}
