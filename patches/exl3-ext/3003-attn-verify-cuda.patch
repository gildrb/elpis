+    const uint32_t* v_ptr = (const uint32_t*) cache_v.data_ptr();
+    const half* ks_ptr = (const half*) cache_k_scales.data_ptr();
+    const half* vs_ptr = (const half*) cache_v_scales.data_ptr();
+    const half* h32_ptr = (const half*) h32.data_ptr();
+    const int* bt_ptr = (const int*) block_table.data_ptr();
+    const int* sl_ptr = (const int*) cache_seqlens.data_ptr();
+    float* po_ptr = (float*) partial_o.data_ptr();
+    float* pml_ptr = (float*) partial_ml.data_ptr();
+    half* out_ptr = (half*) out.data_ptr();
+    int num_pages = (int) block_table.size(1);
+    TORCH_CHECK(chunk > 0 && chunk % AV_T == 0, "attn_verify: chunk must be a positive multiple of 64");
