--- /dev/null
+++ b/exllamav3_ext/attn_verify.cuh
@@ -0,0 +1,80 @@
+#pragma once
+
+// Target-model verify attention over the CQ (2..7-bit) paged cache, head_dim 256, up to 6 query
+// heads per kv head x up to 8 query positions (48 MMA rows per kv head).
+//
+// Split kernel: gridDim.x CTAs per (kv head, batch). The kv positions are cut into fixed absolute
+// chunks of `chunk` tokens (a multiple of AV_T, fixed per slot): chunk c covers [c * chunk,
+// (c + 1) * chunk) of every sequence, whatever the round's live length L, and CTA x processes the
+// live chunks x, x + gridDim.x, ... (one partial per chunk). Every K/V tile is dequantized once per
+// CTA straight into mma.m16n8k16 fragments (fp16 x fp16 -> fp32) and serves all 48 rows.
+// Combine kernel: exact log-sum-exp merge of the live chunks in chunk order, H32 back-rotation.
+// A verify row's result depends only on its absolute position and the cache contents: its chunk
+// boundaries, tile starts, visible positions and combine order do not depend on the round's start
+// or row count (bend/attn_split_laws.bend: row_invariant, store_in_bounds).
+
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+#include <stdint.h>
+
+#define AV_HD 256          // head dim
+#define AV_ROWS 48         // 6 heads x 8 query positions
+#define AV_QPOS 8          // query positions per head block (row = head_local * 8 + q_pos)
+#define AV_NW 8            // warps per split CTA
+#define AV_T 64            // kv tokens per tile (divides the 256-token page)
+#define AV_STAGES 3
+#define AV_PAGE 256
+
+// Live chunks (modelled in bend/attn_split.bend): ceil(L / chunk); chunks at or above it hold no
+// position of the round
+__host__ __device__ inline int av_live_chunks(int L, int chunk)
+{
+    return (L + chunk - 1) / chunk;
+}
+
+// Dynamic shared memory of the split kernel for (k_bits, v_bits)
+__host__ __device__ inline int av_smem_bytes(int kb, int vb)
+{
+    int q = AV_ROWS * (AV_HD + 8) * 2;
+    int p = AV_ROWS * (AV_T + 8) * 2;
+    int red = 2 * AV_NW * AV_ROWS * 4;
+    int stage = AV_T * ((8 * kb + 4) + (8 * vb + 4)) * 4;
+    return q + p + red + AV_STAGES * stage;
+}
+
+#define AV_SPLIT_ARGS \
+    const half* __restrict__ q, \
+    const uint32_t* __restrict__ k_cache, \
+    const uint32_t* __restrict__ v_cache, \
+    const half* __restrict__ k_scales, \
+    const half* __restrict__ v_scales, \
+    const half* __restrict__ h32, \
+    const int* __restrict__ block_table, \
+    const int* __restrict__ cache_seqlens, \
+    float* __restrict__ partial_o, \
+    float* __restrict__ partial_ml, \
+    int num_pages_per_seq, \
+    int q_len, \
+    int n_q_heads, \
+    int n_kv_heads, \
+    float scale_log2, \
+    int chunk, \
+    int max_chunks
+
+#define AV_COMBINE_ARGS \
+    const float* __restrict__ partial_o, \
+    const float* __restrict__ partial_ml, \
+    const half* __restrict__ h32, \
+    const int* __restrict__ cache_seqlens, \
+    half* __restrict__ out, \
+    int max_chunks, \
+    int q_len, \
+    int n_q_heads, \
+    int n_kv_heads, \
+    int chunk
+
+#ifdef __CUDACC__
+extern "C" __global__ void attn_verify_split_k3v3(AV_SPLIT_ARGS);
+extern "C" __global__ void attn_verify_split_k4v4(AV_SPLIT_ARGS);
+extern "C" __global__ void attn_verify_combine(AV_COMBINE_ARGS);
+#endif
