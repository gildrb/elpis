+// Combine: one CTA per (row, kv head, batch), thread = output dim. The live chunks are merged in
+// chunk order 0 .. live - 1 with the exact log-sum-exp weights; chunks holding no position the row
+// sees (m = -inf: past the row's absolute position) are skipped, so the merged set is the row's
+// chunks 0 .. q_abs / chunk whatever the round. Then fp16(o) is H32-rotated back (fp32 FMA, fp16 out)
+extern "C" __global__ void __launch_bounds__(AV_HD) attn_verify_combine(AV_COMBINE_ARGS)
+{
+    __shared__ half oh[AV_HD];
+    const int r = blockIdx.x;
+    const int kvh = blockIdx.y;
+    const int b = blockIdx.z;
+    const int d = threadIdx.x;
+    const int group = n_q_heads / n_kv_heads;
+    const int q_pos = r % AV_QPOS;
+    const int hl = r / AV_QPOS;
+    if (q_pos >= q_len || hl >= group) return;
