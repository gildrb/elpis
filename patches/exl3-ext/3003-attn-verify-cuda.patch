+        &num_pages, &q_len, &n_q_heads, &n_kv_heads, &scale_log2, &chunk, &max_chunks
+    };
+    cuda_check(cudaLaunchKernel(fn, dim3(splits, n_kv_heads, bsz), dim3(AV_NW * 32), split_args,
+                                av_smem_bytes(bits, bits), stream));
