+    #pragma unroll
+    for (int r = 0; r < 2; ++r)
+    {
+        l[r] += __shfl_xor_sync(0xffffffffu, l[r], 1);
+        l[r] += __shfl_xor_sync(0xffffffffu, l[r], 2);
+        l[r] = l[r] == 0.f ? 0.f : 1.f / l[r];
+    }
+    #pragma unroll
+    for (int r = 0; r < 2; ++r)
+    {
+        int pos = p0 + gid + 8 * r;
+        if (pos >= q_len) continue;
+        half* orow = out + (((size_t) b * q_len + pos) * n_q_heads + hq) * PA_HD;
+        #pragma unroll
+        for (int j = 0; j < 32; ++j)
+            *reinterpret_cast<uint32_t*>(orow + 8 * j + 2 * t) = pack_h2(acc[j][2 * r] * l[r], acc[j][2 * r + 1] * l[r]);
+    }
+}
+
+// ---- stage pass: int8 K + fp16 V window (the int8 counterpart of dequant_cache_paged_window)
+
+// q_cache_kernels.cuh had_4_inreg / had_8_subgroup / dequant_block_x4 (compand 0), same arithmetic, so V is
+// staged bit-identically to dequant_cache_paged_window
+__device__ __forceinline__ void ps_had4(float& v0, float& v1, float& v2, float& v3)
+{
+    float s0 = v0 + v1;
+    float d0 = v0 - v1;
+    float s1 = v2 + v3;
+    float d1 = v2 - v3;
+    v0 = s0 + s1;
+    v1 = d0 + d1;
+    v2 = s0 - s1;
+    v3 = d0 - d1;
+}
+
+__device__ __forceinline__ void ps_had8(float& v0, float& v1, float& v2, float& v3, int lane)
+{
+    #pragma unroll
+    for (int i = 1; i < 8; i <<= 1)
+    {
+        uint64_t p01 = ((uint64_t) __float_as_uint(v0)) | (((uint64_t) __float_as_uint(v1)) << 32);
+        uint64_t p23 = ((uint64_t) __float_as_uint(v2)) | (((uint64_t) __float_as_uint(v3)) << 32);
+        p01 = __shfl_xor_sync(0xffffffff, p01, i);
+        p23 = __shfl_xor_sync(0xffffffff, p23, i);
+        uint32_t sfm = (uint32_t) (-(int32_t)(lane & i) >> 31) & 0x80000000u;
+        v0 = __uint_as_float(__float_as_uint(v0) ^ sfm) + __uint_as_float((uint32_t) p01);
+        v1 = __uint_as_float(__float_as_uint(v1) ^ sfm) + __uint_as_float((uint32_t) (p01 >> 32));
+        v2 = __uint_as_float(__float_as_uint(v2) ^ sfm) + __uint_as_float((uint32_t) p23);
+        v3 = __uint_as_float(__float_as_uint(v3) ^ sfm) + __uint_as_float((uint32_t) (p23 >> 32));
+    }
+}
+
+template <int num_bits>
+__device__ __forceinline__ void ps_dequant_x4(const uint32_t* __restrict__ in, const half* __restrict__ in_scales,
+                                              half* __restrict__ out)
+{
+    constexpr int m = 1 << (num_bits - 1);
+    constexpr float inv_mf = 1.0f / (float) (1 << (num_bits - 1));
+    const int lane = threadIdx.x & 31;
+    const int sg = lane >> 3;
+    const int sl = lane & 7;
+    const uint32_t* gw = in + sg * num_bits;
+    uint32_t q0 = 0, q1 = 0, q2 = 0, q3 = 0;
+    {
+        auto unpack_plane = [&] (int w, int word_base)
+        {
+            int off = sl * 4 * w;
+            uint32_t word = gw[word_base + (off >> 5)] >> (off & 31);
+            uint32_t mask = (1u << w) - 1;
+            q0 = (q0 << w) | (word & mask);
+            q1 = (q1 << w) | ((word >> w) & mask);
+            q2 = (q2 << w) | ((word >> (2 * w)) & mask);
+            q3 = (q3 << w) | ((word >> (3 * w)) & mask);
+        };
+        int wb = 0;
+        if constexpr (num_bits & 8) { unpack_plane(8, wb); wb += 8; }
+        if constexpr (num_bits & 4) { unpack_plane(4, wb); wb += 4; }
+        if constexpr (num_bits & 2) { unpack_plane(2, wb); wb += 2; }
+        if constexpr (num_bits & 1) { unpack_plane(1, wb);          }
+    }
+    float s = __half2float(in_scales[sg]);
+    constexpr float r32 = 0.17677669529663688110f;
+    s *= r32;
+    constexpr float mh = (float) m - 0.5f;
+    float v0 = ((float) (int) q0 - mh);
+    float v1 = ((float) (int) q1 - mh);
+    float v2 = ((float) (int) q2 - mh);
+    float v3 = ((float) (int) q3 - mh);
+    float sm = s * inv_mf;
+    v0 *= sm; v1 *= sm; v2 *= sm; v3 *= sm;
+    ps_had4(v0, v1, v2, v3);
+    ps_had8(v0, v1, v2, v3, lane);
+    ((half2*) out)[lane * 2] = __floats2half2_rn(v0, v1);
+    ((half2*) out)[lane * 2 + 1] = __floats2half2_rn(v2, v3);
+}
+
+// One warp task per (token, kv head) for K (3-bit codes -> int8 row + fp32 scale) and per 4 groups for V.
+// Token t < cache_seqlens[b] + bonus_len of batch row b; page p lands at scratch page b * pages_per_seq + p.
+template <int v_bits>
+__global__ void __launch_bounds__(PS_THREADS) pattn_stage_int8k_kernel(
+    const uint32_t* __restrict__ k_in,      // (pages, 256, n_kvh * 8 * 3)
+    const half* __restrict__ k_in_scales,   // (pages, 256, n_kvh * 8)
+    int8_t* __restrict__ k_out,             // (scratch pages, 256, n_kvh, 256)
+    float* __restrict__ k_out_scales,       // (scratch pages, n_kvh, 256)
+    const uint32_t* __restrict__ v_in,
+    const half* __restrict__ v_in_scales,
+    half* __restrict__ v_out,               // (scratch pages, 256, n_kvh, 256)
+    const int* __restrict__ cache_seqlens,
+    const int* __restrict__ block_table,
+    int pages_per_seq, int n_kvh, int bonus_len)
+{
+    constexpr float kscale = 0.17677669529663688110f / 144.0f;   // r32 / 8 / 18
+    const int b = blockIdx.y;
+    const int max_tok = cache_seqlens[b] + bonus_len;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int gpt = n_kvh * 8;
+    const int tasks = n_kvh * 3;
+    for (int task = warp; task < PS_TOK * tasks; task += PS_THREADS / 32)
+    {
+        const int tok = blockIdx.x * PS_TOK + task / tasks, r = task % tasks;
+        if (tok >= max_tok) continue;
+        const int page = tok / PA_PAGE;
+        const int src = block_table[(size_t) b * pages_per_seq + page] * PA_PAGE + tok % PA_PAGE;
+        const size_t dstp = (size_t) b * pages_per_seq + page;
+        const size_t dst = dstp * PA_PAGE + tok % PA_PAGE;
+        if (r < n_kvh)
+        {
+            const int kvh = r, g = lane >> 2, mq = lane & 3;
+            const size_t gi = (size_t) src * gpt + kvh * 8 + g;
+            const uint32_t* w = k_in + gi * 3;
+            const uint32_t hi = w[mq >> 1] >> (16 * (mq & 1));
+            const uint32_t lo = w[2] >> (8 * mq);
+            const float s = __half2float(k_in_scales[gi]);
+            float smax = s;
+            #pragma unroll
+            for (int x = 4; x < 32; x <<= 1) smax = fmaxf(smax, __shfl_xor_sync(0xffffffffu, smax, x));
+            const float f = smax > 0.f ? __fdiv_rn(__fmul_rn(18.f, s), smax) : 0.f;
+            int kq[8];
+            #pragma unroll
+            for (int i = 0; i < 8; ++i)
+            {
+                int code = 2 * (int) ((((hi >> (2 * i)) & 3) << 1) | ((lo >> i) & 1)) - 7;
+                kq[i] = __float2int_rn(__fmul_rn((float) code, f));
+            }
+            *reinterpret_cast<uint2*>(k_out + (dst * n_kvh + kvh) * PA_HD + lane * 8) =
+                make_uint2(pack_s8x4(kq[0], kq[1], kq[2], kq[3]), pack_s8x4(kq[4], kq[5], kq[6], kq[7]));
+            if (lane == 0) k_out_scales[(dstp * n_kvh + kvh) * PA_PAGE + tok % PA_PAGE] = __fmul_rn(smax, kscale);
+        }
+        else
+        {
+            const int g0 = (r - n_kvh) * 4;
+            ps_dequant_x4<v_bits>(v_in + ((size_t) src * gpt + g0) * v_bits, v_in_scales + (size_t) src * gpt + g0,
+                                  v_out + (dst * gpt + g0) * 32);
+        }
+    }
+}
