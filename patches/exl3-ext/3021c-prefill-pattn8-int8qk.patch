+    float acc[32][4];
+    #pragma unroll
+    for (int j = 0; j < 32; ++j)
+        #pragma unroll
+        for (int e = 0; e < 4; ++e) acc[j][e] = 0.f;
+    float m[2] = {-INFINITY, -INFINITY}, l[2] = {0.f, 0.f};
+    const int qrow = warp * PA_BQ;
+    const int q_abs_r0 = q_abs0 + gid, q_abs_r1 = q_abs0 + gid + 8;
+    uint32_t pa[2][4];
+    float sc[4][4];
+
+    __syncthreads();                                  // q rows, row factors visible
+    const float rs0 = qsc[qrow + gid], rs1 = qsc[qrow + gid + 8];
+
+    // S = Q K^T in the log2 domain for tile it (stage st) -> sc
+    auto qk = [&] (int st)
+    {
+        const unsigned char* ks = smem + P8I_ST_OFF + st * P8I_STAGE;
+        const float* kss = (const float*) (ks + P8I_KS_REL);
+        int ai[4][4];
+        #pragma unroll
+        for (int nt = 0; nt < 4; ++nt)
+            #pragma unroll
+            for (int e = 0; e < 4; ++e) ai[nt][e] = 0;
+        #pragma unroll
+        for (int g = 0; g < 8; ++g)
+        {
+            uint32_t a[4];
+            ldsm_x4(a, qs + swz8(qrow + (lane & 15), 2 * g + (lane >> 4)));
+            #pragma unroll
+            for (int pp = 0; pp < 2; ++pp)
+            {
+                uint32_t bk[4];
+                const int mi = lane >> 3;
+                ldsm_x4(bk, ks + swz8(16 * pp + 8 * (mi >> 1) + (lane & 7), 2 * g + (mi & 1)));
+                imma(ai[2 * pp], a, bk[0], bk[1]);
+                imma(ai[2 * pp + 1], a, bk[2], bk[3]);
+            }
+        }
+        #pragma unroll
+        for (int nt = 0; nt < 4; ++nt)
+        {
+            float2 sk = *reinterpret_cast<const float2*>(kss + 8 * nt + 2 * t);
+            sc[nt][0] = __fmul_rn(i2f_exact(ai[nt][0]), __fmul_rn(rs0, sk.x));
+            sc[nt][1] = __fmul_rn(i2f_exact(ai[nt][1]), __fmul_rn(rs0, sk.y));
+            sc[nt][2] = __fmul_rn(i2f_exact(ai[nt][2]), __fmul_rn(rs1, sk.x));
+            sc[nt][3] = __fmul_rn(i2f_exact(ai[nt][3]), __fmul_rn(rs1, sk.y));
+        }
+    };
+
+    // pattn8's mask, online softmax, rescale and P pack for tile it
+    auto softmax = [&] (int it)
+    {
+        const int n0 = it * PA_BN;
+        if (n0 + PA_BN - 1 > q_abs0)
+        {
+            #pragma unroll
+            for (int nt = 0; nt < 4; ++nt)
+                #pragma unroll
+                for (int e = 0; e < 4; ++e)
+                {
+                    int key = n0 + 8 * nt + 2 * t + (e & 1);
+                    int qa = (e & 2) ? q_abs_r1 : q_abs_r0;
+                    if (key > qa || key >= total) sc[nt][e] = -INFINITY;
+                }
+        }
+        float alpha[2];
+        #pragma unroll
+        for (int r = 0; r < 2; ++r)
+        {
+            float mx = -INFINITY;
+            #pragma unroll
+            for (int nt = 0; nt < 4; ++nt) mx = fmaxf(mx, fmaxf(sc[nt][2 * r], sc[nt][2 * r + 1]));
+            mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 1));
+            mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 2));
+            float m_new = fmaxf(m[r], mx);
+            float m_use = m_new == -INFINITY ? 0.f : m_new;
+            alpha[r] = m[r] == -INFINITY ? 0.f : ex2(m[r] - m_use);
+            float sum = 0.f;
+            #pragma unroll
+            for (int nt = 0; nt < 4; ++nt)
+                #pragma unroll
+                for (int e = 0; e < 2; ++e)
+                {
+                    float p = ex2(sc[nt][2 * r + e] - m_use);
+                    sc[nt][2 * r + e] = p;
+                    sum += p;
+                }
+            l[r] = l[r] * alpha[r] + sum;
+            m[r] = m_new;
+        }
+        if (__any_sync(0xffffffffu, alpha[0] != 1.f || alpha[1] != 1.f))
+        {
+            #pragma unroll
+            for (int j = 0; j < 32; ++j)
+            {
+                acc[j][0] *= alpha[0]; acc[j][1] *= alpha[0];
+                acc[j][2] *= alpha[1]; acc[j][3] *= alpha[1];
+            }
+        }
+        #pragma unroll
+        for (int kk = 0; kk < 2; ++kk)
+        {
+            pa[kk][0] = pack_h2(sc[2 * kk][0], sc[2 * kk][1]);
+            pa[kk][1] = pack_h2(sc[2 * kk][2], sc[2 * kk][3]);
+            pa[kk][2] = pack_h2(sc[2 * kk + 1][0], sc[2 * kk + 1][1]);
+            pa[kk][3] = pack_h2(sc[2 * kk + 1][2], sc[2 * kk + 1][3]);
+        }
+    };
+
+    // O += P V (pattn8 f16 spans) from stage st
+    auto pv = [&] (int st)
+    {
+        const half* vs = (const half*) (smem + P8I_ST_OFF + st * P8I_STAGE + P8I_V_REL);
+        #pragma unroll
+        for (int dn = 0; dn < 16; ++dn)
+        {
+            uint32_t bv[2][4];
+            #pragma unroll
+            for (int kk = 0; kk < 2; ++kk)
+                ldsm_x4_t(bv[kk], vs + swz(16 * kk + (lane & 7) + ((lane >> 3) & 1) * 8, 16 * dn + (lane >> 4) * 8));
+            #pragma unroll
+            for (int hn = 0; hn < 2; ++hn)
+            {
+                float* o = acc[2 * dn + hn];
+                uint32_t d[2] = {0u, 0u};
+                mma_f16(d, pa[0], bv[0][2 * hn], bv[0][2 * hn + 1]);
+                mma_f16(d, pa[1], bv[1][2 * hn], bv[1][2 * hn + 1]);
+                float2 f0 = __half22float2(*reinterpret_cast<half2*>(&d[0]));
+                float2 f1 = __half22float2(*reinterpret_cast<half2*>(&d[1]));
