+            }
+        }
+    };
+
+    #pragma unroll 1
+    for (int it = 0; it < ntiles_cta; ++it)
+    {
+        asm volatile("cp.async.wait_group 1;\n" ::);   // K(it) landed (V(it) may be in flight)
+        __syncthreads();                              // (A) K(it) visible
+        const bool act = it < ntiles;
+        if (act) { qk(0); softmax(it); }
+        cp_wait0();
+        __syncthreads();                              // (B) V(it) visible; every warp done with K(it)
+        if (it + 1 < ntiles_cta) issue_k(it + 1, 0, tid, P8_THREADS);
+        cp_commit();
+        if (act) pv(0);
+        asm volatile("cp.async.wait_group 1;\n" ::);
+        __syncthreads();                              // (C) every warp done with V(it)
+        if (it + 1 < ntiles_cta) issue_v(it + 1, 0, tid, P8_THREADS);
