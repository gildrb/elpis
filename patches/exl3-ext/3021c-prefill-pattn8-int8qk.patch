+//
+// K: the CQ cache stores each 32-dim group of K as H32-rotated codes q in [0, 7] (3 bits) with one fp16 scale
+// s_g: in the H32 basis K is exactly (2q - 7) * s_g * r32 / 8. The stage pass (pattn_stage_int8k_kernel,
+// replacing the fp16 K half of dequant_cache_paged_window) requantises each key to one int8 row over all 256
+// dims: k8 = round((2q - 7) * 18 * s_g / s_max), exactly 18 * (2q - 7) on the key's largest-scale group,
+// |k8| <= 126, with one fp32 scale per key skk = s_max * r32 / 144. V is staged to fp16 exactly as
+// dequant_cache_paged_window stages it.
+// Q: each row is rotated into the same basis (unnormalised H32 per 32-group, fp32 butterflies) and quantised
+// to int8 with one scale per row (absmax / 127); the row factor rs = absmax / 127 * scale_log2 is kept.
+// S = int32 dot over 256 dims (8 chained IMMA, |acc| <= 256 * 127 * 126 < 2^22, converted exactly with the
+// 1.5 * 2^23 magic) * (rs * skk): scores in the log2 domain, then pattn8's softmax.
+#include "pattn8_kernel.cuh"
+
+#define P8I_Q_OFF 0                                             // [128][256] int8, swizzled 16-B chunks
+#define P8I_QS_OFF (P8I_Q_OFF + P8_NW * PA_BQ * PA_HD)          // [128] fp32 row factors rs
+#define P8I_ST_OFF (P8I_QS_OFF + P8_NW * PA_BQ * 4)             // K / V stages
+#define P8I_KS_REL (PA_BN * PA_HD)                              // stage: [32][256] int8 K, [32] fp32 skk,
+#define P8I_V_REL (P8I_KS_REL + PA_BN * 4)                      //        [32][256] fp16 V (pattn swizzle)
+#define P8I_STAGE (P8I_V_REL + PA_BN * PA_HD * 2)
