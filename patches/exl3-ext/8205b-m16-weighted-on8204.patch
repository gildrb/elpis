+#pragma once
+
+// ext 8205: schedule tables of the fused MLP (8201) and the layer tail (8202) for the shared slot-weighted
+// v2 partition (M16gEff's wpart.py formula; reference generator gen_sched.py, whose output at uniform
+// weights is byte-identical to bend/MLP_M16_SCHED_TABLE.bend / TAIL_M16_SCHED_TABLE.bend). Host-only, no
+// CUDA / torch: the launchers upload the result once per weight set.
+//
+// Partition of a phase with T iterations over G = 2 * NSM blocks and weights (w0, w1):
+//   W(b) = w0 min(b, NSM) + w1 max(b - NSM, 0),  start(b) = T W(b) / W(G)   (integer division, int64)
+//   owner(x) = the largest b with start(b) <= x (closed form below). (w, w) = v2's b T / G.
+// Flat uint16 layout (the device buffer; gen_sched.flat() is the same):
+//   header[8] = mc0, mc1, mc2, nwait, kind, 0, 0, 0
+//   8201 block[G * 11] | pair[NP * 5] | wait[nwait]              (exl3_mlp_m16_sched.h's three tables)
+//   grp: fc1[2 NG1] nc1[2 NG1] fc2[NG2] nc2[NG2]                  (first contributor / contributors per group)
+//   kind 1 (tail) only: tail block[G * 4] | grp0: fc0[NG0] nc0[NG0]
+// Validity (else an error and no table): w0, w1 >= 1 in every phase, every slice nonempty, every down pair
+// has a finisher block, every value fits 16 bits.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace exl3_wsched {
+
+constexpr int G = 164, NSM = 82, PF = 8, GW = 512, PKT = 32;
+constexpr int K0 = 6144, N0 = 5120, K1 = 5120, N1 = 17408, K2 = 17408, N2 = 5120;
+constexpr int KT0 = K0 / 16, NG0 = N0 / GW, KT1 = K1 / 16, NG1 = N1 / GW, KT2 = K2 / 16, NG2 = N2 / GW;
+constexpr int T0 = NG0 * KT0, T1 = 2 * NG1 * KT1, T2 = NG2 * KT2, NP = NG1;
+constexpr int HDR = 8, BF = 11, PFLD = 5, TBF = 4;
+// offsets inside grp (relative to its start)
+constexpr int FC1 = 0, NC1 = 2 * NG1, FC2 = 4 * NG1, NC2 = 4 * NG1 + NG2, GRP_WORDS = 4 * NG1 + 2 * NG2;
+
+inline int64_t wsum(int64_t b, int64_t w0, int64_t w1)
+{
+    return w0 * (b < NSM ? b : NSM) + w1 * (b > NSM ? b - NSM : 0);
+}
+
+inline int wstart(int b, int total, int w0, int w1)
+{
+    return (int) ((int64_t) total * wsum(b, w0, w1) / wsum(G, w0, w1));
+}
+
+// Closed-form owner (wpart.owner_closed): P = ((x + 1) W(G) + T - 1) / T - 1 is the largest weight prefix
+// with start <= x; map it back to a block through the two segments of W.
+inline int wowner(int x, int total, int w0, int w1)
+{
+    const int64_t WG = wsum(G, w0, w1);
+    const int64_t P = (((int64_t) x + 1) * WG + total - 1) / total - 1;
+    if (P < (int64_t) w0 * NSM) return (int) (P / w0);
+    return (int) (NSM + (P - (int64_t) w0 * NSM) / w1);
+}
+
+// w = {p0 w0, p0 w1, p1 w0, p1 w1, p2 w0, p2 w1}; kind 0 = 8201 MLP (phase 0 ignored), 1 = tail
+inline bool build(int kind, const int* w, std::vector<uint16_t>& out, std::string& err)
+{
+    out.clear();
+    const int tot[3] = { T0, T1, T2 };
+    for (int ph = (kind ? 0 : 1); ph < 3; ++ph)
+    {
+        const int w0 = w[2 * ph], w1 = w[2 * ph + 1];
+        if (w0 < 1 || w1 < 1 || w0 > 1000000 || w1 > 1000000) { err = "weights must be in 1..1000000"; return false; }
+        for (int b = 0; b < G; ++b)
+            if (wstart(b + 1, tot[ph], w0, w1) <= wstart(b, tot[ph], w0, w1))
+            {
+                err = "phase " + std::to_string(ph) + ": weights give an empty slice";
+                return false;
+            }
+    }
+    const int a1 = w[2], b1 = w[3], a2 = w[4], b2 = w[5];
+    std::vector<int> s1(G + 1), s2(G + 1);
+    for (int b = 0; b <= G; ++b) { s1[b] = wstart(b, T1, a1, b1); s2[b] = wstart(b, T2, a2, b2); }
+    std::vector<int> fin_pair(G), fin_rank(G), fin_count(NP, 0);
+    std::vector<std::vector<int>> waits(G);
+    for (int b = 0; b < G; ++b)
+    {
+        fin_pair[b] = (s2[b] % KT2) / PKT;
+        fin_rank[b] = fin_count[fin_pair[b]]++;
+        for (int it = s2[b]; it < s2[b + 1]; ++it)
+        {
+            const int p = (it % KT2) / PKT;
+            bool seen = false;
+            for (int q : waits[b]) seen = seen || q == p;
+            if (!seen) waits[b].push_back(p);
+        }
+    }
+    for (int p = 0; p < NP; ++p)
+        if (fin_count[p] < 1) { err = "down pair " + std::to_string(p) + " has no finisher block"; return false; }
+    auto groups = [] (int ng, int kt, int total, int w0, int w1, std::vector<int>& fc, std::vector<int>& nc)
+    {
+        fc.resize(ng);
+        nc.resize(ng);
+        for (int g = 0; g < ng; ++g)
+        {
+            fc[g] = wowner(g * kt, total, w0, w1);
+            nc[g] = wowner((g + 1) * kt - 1, total, w0, w1) - fc[g] + 1;
+        }
+    };
+    std::vector<int> fc0, nc0, fc1, nc1, fc2, nc2;
+    groups(2 * NG1, KT1, T1, a1, b1, fc1, nc1);
+    groups(NG2, KT2, T2, a2, b2, fc2, nc2);
+    if (kind) groups(NG0, KT0, T0, w[0], w[1], fc0, nc0);
+    auto vmax = [] (const std::vector<int>& v) { int m = 0; for (int x : v) m = x > m ? x : m; return m; };
+    int nwait = 0;
+    for (int b = 0; b < G; ++b) nwait += (int) waits[b].size();
+    std::vector<int> o = { kind ? vmax(nc0) : 0, vmax(nc1), vmax(nc2), nwait, kind, 0, 0, 0 };
+    int off = 0;
+    for (int b = 0; b < G; ++b)
+    {
+        const int n1 = s1[b + 1] - s1[b];
+        const int row[BF] = { s1[b], n1, b, s2[b], s2[b + 1] - s2[b], n1 % PF, fin_pair[b], fin_rank[b],
+                              fin_count[fin_pair[b]], off, (int) waits[b].size() };
+        o.insert(o.end(), row, row + BF);
+        off += (int) waits[b].size();
+    }
+    for (int p = 0; p < NP; ++p)
+    {
+        int w2 = 0;
+        for (int b = 0; b < G; ++b)
+            for (int q : waits[b]) w2 += q == p;
+        const int row[PFLD] = { 8 * nc1[p], 8 * nc1[NP + p], 8 * fin_count[p], 8 * fin_count[p], w2 };
+        o.insert(o.end(), row, row + PFLD);
+    }
+    for (int b = 0; b < G; ++b) o.insert(o.end(), waits[b].begin(), waits[b].end());
+    o.insert(o.end(), fc1.begin(), fc1.end());
+    o.insert(o.end(), nc1.begin(), nc1.end());
+    o.insert(o.end(), fc2.begin(), fc2.end());
+    o.insert(o.end(), nc2.begin(), nc2.end());
+    if (kind)
+    {
+        for (int b = 0; b < G; ++b)
+        {
+            const int s0 = wstart(b, T0, w[0], w[1]);
+            const int n0 = wstart(b + 1, T0, w[0], w[1]) - s0;
+            const int n1 = s1[b + 1] - s1[b];
+            const int row[TBF] = { s0, n0, n0 % PF, (n0 + n1) % PF };
+            o.insert(o.end(), row, row + TBF);
+        }
+        o.insert(o.end(), fc0.begin(), fc0.end());
+        o.insert(o.end(), nc0.begin(), nc0.end());
+    }
+    for (int x : o)
+        if (x < 0 || x > 0xFFFF) { err = "table value outside 16 bits"; return false; }
+    out.assign(o.begin(), o.end());
+    return true;
+}
+
+// Offsets into a built table
+inline int block_off() { return HDR; }
+inline int wait_count(const std::vector<uint16_t>& t) { return t[3]; }
+inline int grp_off(const std::vector<uint16_t>& t) { return HDR + G * BF + NP * PFLD + t[3]; }
+inline int tblock_off(const std::vector<uint16_t>& t) { return grp_off(t) + GRP_WORDS; }
+inline int grp0_off(const std::vector<uint16_t>& t) { return tblock_off(t) + G * TBF; }
+
+}  // namespace exl3_wsched
