+    const bool weighted = !(off && !strcmp(off, "0"));
+    const std::array<int, 6> uni = { 1, 1, 1, 1, 1, 1 };
+    g_weights[0] = weighted ? parse_weights("EXL3_M16_WEIGHTS_MLP", std::getenv("EXL3_M16_WEIGHTS_MLP"), { 1, 1, 1000, EXL3_M16_W_MLP_P1, 1000, EXL3_M16_W_MLP_P2 }) : uni;
+    g_weights[1] = weighted ? parse_weights("EXL3_M16_WEIGHTS_TAIL", std::getenv("EXL3_M16_WEIGHTS_TAIL"),
+                                            { 1000, EXL3_M16_W_TAIL_P0, 1000, EXL3_M16_W_TAIL_P1, 1000, EXL3_M16_W_TAIL_P2 }) : uni;
+    g_weights_init = true;
 }
 
