+// Fail closed: exactly 6 comma-separated base-10 integers, each in 1..1000000 (no empty field, no trailing
+// junk, no overflow); anything else is an error, never coerced
+std::array<int, 6> parse_weights(const char* name, const char* env, std::array<int, 6> def)
+{
+    if (!env) return def;
+    std::array<int, 6> w = {};
+    int n = 0;
+    const char* c = env;
+    while (true)
+    {
+        TORCH_CHECK(n < 6, "exl3_m16: ", name, "='", env, "' must have exactly 6 comma-separated integers");
+        char* e;
+        errno = 0;
+        long long v = strtoll(c, &e, 10);
+        TORCH_CHECK(e != c && (*c >= '0' && *c <= '9'), "exl3_m16: ", name, "='", env, "': field ", n, " is not a base-10 integer");
+        TORCH_CHECK(errno != ERANGE && v >= 1 && v <= 1000000, "exl3_m16: ", name, "='", env, "': field ", n, " outside 1..1000000");
+        w[n++] = (int) v;
+        if (*e == '\0') break;
+        TORCH_CHECK(*e == ',', "exl3_m16: ", name, "='", env, "': trailing characters after field ", n - 1);
+        c = e + 1;
+    }
+    TORCH_CHECK(n == 6, "exl3_m16: ", name, "='", env, "' must have exactly 6 comma-separated integers");
+    return w;
+}
