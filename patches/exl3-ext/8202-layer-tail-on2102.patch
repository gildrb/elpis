+
+}  // namespace
+
+int exl3_tail_m16_l2pf(int set)
+{
+    static int value = []
+    {
+        const char* env = std::getenv("EXL3_TAIL_M16_L2PF");
+        return env ? std::atoi(env) : 0;
+    }();
+    if (set >= 0) value = set;
+    return value;
+}
+
+bool exl3_tail_m16_supported
+(
+    int size_m,
+    const at::Tensor& o_trellis,
+    const at::Tensor& gate_trellis,
+    const at::Tensor& up_trellis,
+    const at::Tensor& down_trellis
