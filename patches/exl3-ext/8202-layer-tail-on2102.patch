+    c10::cuda::CUDAGuard device_guard(x.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    Graph& g = *graph_tail[num_tokens - 1];
+
+    if (g.disabled || (!g.ready && !g.ready_to_record))
+    {
