+        args.emplace_back(GP_gemm_A, (void*) ao.data_ptr());
+        args.emplace_back(GP_tail_resid, (void*) x.data_ptr());
+        args.emplace_back(GP_gemm_C, (void*) d.data_ptr());
+        g.launch(args, stream);
+    }
