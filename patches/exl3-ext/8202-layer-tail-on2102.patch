+        uint8_t* buf;
+        const size_t cnt_bytes = EXL3_MLP_M16_NCNT * sizeof(unsigned int);
+        const size_t ssq_bytes = SSQ_FLOATS * sizeof(float);
+        cuda_check(cudaMalloc(&buf, cnt_bytes + ssq_bytes + (SCHED_WORDS + TSCHED_WORDS) * sizeof(unsigned short)));
+        cuda_check(cudaMemset(buf, 0, cnt_bytes + ssq_bytes));
+        unsigned short* s = (unsigned short*) (buf + cnt_bytes + ssq_bytes);
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_block, sizeof(exl3_mlp_sched_block), cudaMemcpyHostToDevice));
+        s += EXL3_MLP_SCHED_G * EXL3_MLP_SCHED_BF;
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_pair, sizeof(exl3_mlp_sched_pair), cudaMemcpyHostToDevice));
+        s += EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_PFLD;
+        cuda_check(cudaMemcpy(s, exl3_mlp_sched_wait, sizeof(exl3_mlp_sched_wait), cudaMemcpyHostToDevice));
