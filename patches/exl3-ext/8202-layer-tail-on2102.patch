+    buf(yo, at::kFloat, (int64_t) size_m * N0, "yo");
+    buf(d, at::kFloat, (int64_t) size_m * N0, "d");
+    buf(xn, at::kHalf, (int64_t) size_m * N0, "xn");
+    buf(xh_o, at::kHalf, (int64_t) size_m * K0, "xh_o");
