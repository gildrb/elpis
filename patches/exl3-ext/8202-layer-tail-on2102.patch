+        cuda_check(cudaMemcpy(s, exl3_tail_sched_block, sizeof(exl3_tail_sched_block), cudaMemcpyHostToDevice));
+        d.cnt = (unsigned int*) buf;
+        d.ssq = (float*) (buf + cnt_bytes);
+        d.sched = (const unsigned short*) (buf + cnt_bytes + ssq_bytes);
+        d.tsched = d.sched + SCHED_WORDS;
+        d.ws = ws;
+    }
+    return d;
+}
+
+struct Launch
+{
+    void* kernel;
+    int smem;
+    int blocks_per_sm;
+};
+
+Launch get_launch(int device)
+{
+    static Launch cache[MAX_DEVICES] = {};
+    std::lock_guard<std::mutex> lock(g_mtx);
+    Launch& l = cache[device];
+    if (!l.kernel)
+    {
+        void* k = (void*) exl3_tail_m16_kernel<0>;
+        int sm = Exl3M16Cfg<1>::SMEM;
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, sm));
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributePreferredSharedMemoryCarveout, (int) cudaSharedmemCarveoutMaxShared));
+        int occ = 0;
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, k, EXL3_M16_THREADS, sm));
+        l.kernel = k;
+        l.smem = sm;
+        l.blocks_per_sm = occ < 2 ? occ : 2;
+    }
+    return l;
+}
+
+bool trellis_is(const at::Tensor& t, int k, int n)
+{
+    return t.dim() == 3 && t.scalar_type() == at::kShort && t.size(0) * 16 == k && t.size(1) * 16 == n && t.size(2) == 4 * 16;
