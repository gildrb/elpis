+struct TailDev
+{
+    float* ws;
+    unsigned int* cnt;
+    float* ssq;
+    const unsigned short* sched;     // 8201 block | pair | wait tables
+    const unsigned short* tsched;    // tail block table
+};
+TailDev g_dev[MAX_DEVICES] = {};
+
+constexpr size_t SCHED_WORDS = (size_t) EXL3_MLP_SCHED_G * EXL3_MLP_SCHED_BF + (size_t) EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_PFLD + EXL3_MLP_SCHED_NWAIT;
+constexpr size_t TSCHED_WORDS = (size_t) EXL3_TAIL_SCHED_G * EXL3_TAIL_SCHED_BF;
+constexpr size_t WS1_FLOATS = (size_t) 2 * EXL3_MLP_SCHED_PAIRS * EXL3_MLP_SCHED_MC1 * EXL3_M16_SLOT_FLOATS;
+constexpr size_t WS2_FLOATS = (size_t) (EXL3_MLP_SCHED_N2 / EXL3_M16_GW) * EXL3_MLP_SCHED_MC2 * EXL3_M16_SLOT_FLOATS;
+constexpr size_t WS0_FLOATS = (size_t) EXL3_TAIL_SCHED_NG0 * EXL3_TAIL_SCHED_MC0 * EXL3_M16_SLOT_FLOATS;
+constexpr size_t SSQ_FLOATS = (size_t) EXL3_TAIL_M16_ROWS * EXL3_TAIL_SCHED_NCH;
+
+TailDev get_dev(int device, cudaStream_t stream)
+{
+    std::lock_guard<std::mutex> lock(g_mtx);
+    TailDev& d = g_dev[device];
+    if (!d.ws)
