+bool BC_GatedMLP::set_tail
+(
+    std::shared_ptr<BC_LinearEXL3> o_proj,
+    at::Tensor norm_w,
+    float norm_eps,
+    float norm_bias,
+    float norm_scale,
+    at::Tensor yo,
+    at::Tensor xn,
+    at::Tensor xh_o
+)
+{
+    // Relinking drops the captured tail graphs (they bake the linked weights and statics)
+    tail_o.reset();
+    for (auto& gt : graph_tail) gt.reset();
+
+    // The 8201 fused-MLP conditions (run_bszN_gr), an o_proj without bias, and statics shaped
+    // (MAX_BSZN, width) for the hidden and o input widths
+    if (gu_ptrs_trellis || !gate || !up || !down || !o_proj) return false;
+    if (!act_silu || gate->bias || up->bias || down->bias || o_proj->bias) return false;
+    if (!gate->mul1 || gate->mcg || !up->mul1 || up->mcg || !down->mul1 || down->mcg || !o_proj->mul1 || o_proj->mcg) return false;
+    if (!exl3_tail_m16_supported(1, o_proj->trellis, gate->trellis, up->trellis, down->trellis)) return false;
+    const int64_t hidden = down->trellis.size(1) * 16;
+    const int64_t o_in = o_proj->trellis.size(0) * 16;
+    if (!(norm_w.scalar_type() == at::kHalf || norm_w.scalar_type() == at::kBFloat16) || !norm_w.is_contiguous() || norm_w.numel() != hidden) return false;
+    if (yo.scalar_type() != at::kFloat || !yo.is_contiguous() || yo.numel() != MAX_BSZN * hidden) return false;
+    if (xn.scalar_type() != at::kHalf || !xn.is_contiguous() || xn.numel() != MAX_BSZN * hidden) return false;
+    if (xh_o.scalar_type() != at::kHalf || !xh_o.is_contiguous() || xh_o.numel() != MAX_BSZN * o_in) return false;
+
+    tail_o = o_proj;
+    tail_norm_w = norm_w;
+    tail_eps = norm_eps;
+    tail_bias = norm_bias;
+    tail_scale = norm_scale;
+    tail_yo = yo.view({MAX_BSZN, hidden});
+    tail_xn = xn.view({MAX_BSZN, hidden});
+    tail_xh_o = xh_o.view({MAX_BSZN, o_in});
+    for (auto& gt : graph_tail) gt = std::make_unique<Graph>();
+    return true;
+}
+
+bool BC_GatedMLP::tail_supported(int num_tokens)
+{
+    return tail_o && exl3_gemm_m16_enabled() &&
+        exl3_tail_m16_supported(num_tokens, tail_o->trellis, gate->trellis, up->trellis, down->trellis);
+}
+
+void BC_GatedMLP::run_tail_gr
+(
+    const at::Tensor& ao,
+    at::Tensor& x,
+    at::Tensor& d,
+    int num_tokens,
+    Graph* graph
+)
+{
+    // Same g / u / a / xh buffers as the 8201 path of run_bszN_gr
+    at::Tensor& guh_n_ref = guh_cache[num_tokens - 1];
+    if (!guh_n_ref.defined())
+        guh_n_ref = at::empty({2, num_tokens, guh.size(2)}, guh.options());
+    at::Tensor& gu_n_ref = gu_cache[num_tokens - 1];
+    if (!gu_n_ref.defined())
+        gu_n_ref = at::empty({2, num_tokens, gu.size(2)}, gu.options());
+    at::Tensor g2 = gu_n_ref.select(0, 0);
+    at::Tensor u2 = gu_n_ref.select(0, 1);
+    at::Tensor gate_xh = guh_n_ref.select(0, 0);
+    at::Tensor up_xh = guh_n_ref.select(0, 1);
+    at::Tensor a_n = a.slice(1, 0, num_tokens);
+    at::Tensor down_xh_n = down_xh.slice(1, 0, num_tokens);
+    at::Tensor yo_n = tail_yo.narrow(0, 0, num_tokens);
+    at::Tensor xn_n = tail_xn.narrow(0, 0, num_tokens);
+    at::Tensor xh_o_n = tail_xh_o.narrow(0, 0, num_tokens);
+
