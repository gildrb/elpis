+    int size_m,
+    const at::Tensor& o_trellis,
+    const at::Tensor& gate_trellis,
+    const at::Tensor& up_trellis,
+    const at::Tensor& down_trellis
+);
+
+// yo = o_proj(a) (fp32); x += yo (fp32, in place); xn = half(RMSNorm(x) * (norm_w + norm_bias) *
+// norm_scale); then exactly ext 8201's MLP on xn: g, u, a2 = silu(g) * u, the three input transforms
+// xh_g / xh_u / xh_d and d = down(a2) (fp32). xh_o receives the o input transform.
+// Graph sites: GP_gemm_A (a), GP_tail_resid (x), GP_gemm_C (d). Returns the grid size.
+int exl3_tail_m16_gr
+(
+    const at::Tensor& a,
+    const at::Tensor& o_trellis, const at::Tensor& o_suh, const at::Tensor& o_svh,
+    at::Tensor& x,
+    const at::Tensor& norm_w, float norm_eps, float norm_bias, float norm_scale,
