+#include <torch/library.h>
+#include <ATen/Tensor.h>
+#include "exl3_tail_m16.cuh"
+
+// Eager entry points of the layer tail (exl3_tail_m16.cu) for isolated A/B and benchmarking, as
+// torch ops so bindings.cpp stays untouched. Same launcher as BC_GatedMLP::run_tail, no graph sites.
+//   torch.ops.exl3_tail_m16.supported(m, o_trellis, gate_trellis, up_trellis, down_trellis) -> bool
+//   torch.ops.exl3_tail_m16.tail(a, o trellis/suh/svh, x, norm_w, eps, bias, scale, yo, xn, xh_o,
+//                                gate trellis/suh/svh, up ..., down ..., g, u, a2, xh_g, xh_u, xh_d, d,
+//                                act_limit, prof?) -> grid size
+//   torch.ops.exl3_tail_m16.l2pf(set) -> current o -> gate/up L2 prefetch depth (set < 0 only reads)
+
+static bool exl3_tail_m16_supported_op(int64_t m, const at::Tensor& ot, const at::Tensor& gt, const at::Tensor& ut, const at::Tensor& dt)
+{
+    return exl3_tail_m16_supported((int) m, ot, gt, ut, dt);
+}
+
+static int64_t exl3_tail_m16_op
+(
+    const at::Tensor& a,
+    const at::Tensor& ot, const at::Tensor& osuh, const at::Tensor& osvh,
+    const at::Tensor& x,
+    const at::Tensor& norm_w, double eps, double bias, double scale,
+    const at::Tensor& yo, const at::Tensor& xn, const at::Tensor& xh_o,
+    const at::Tensor& gt, const at::Tensor& gsuh, const at::Tensor& gsvh,
+    const at::Tensor& ut, const at::Tensor& usuh, const at::Tensor& usvh,
+    const at::Tensor& dt, const at::Tensor& dsuh, const at::Tensor& dsvh,
+    const at::Tensor& g, const at::Tensor& u, const at::Tensor& a2,
+    const at::Tensor& xh_g, const at::Tensor& xh_u, const at::Tensor& xh_d,
+    const at::Tensor& d,
+    double act_limit,
+    const c10::optional<at::Tensor>& prof
+)
+{
+    at::Tensor x_ = x, yo_ = yo, xn_ = xn, xo_ = xh_o, g_ = g, u_ = u, a2_ = a2, xg = xh_g, xu = xh_u, xd = xh_d, d_ = d;
+    return exl3_tail_m16_gr(a, ot, osuh, osvh, x_, norm_w, (float) eps, (float) bias, (float) scale, yo_, xn_, xo_,
+                            gt, gsuh, gsvh, ut, usuh, usvh, dt, dsuh, dsvh, g_, u_, a2_, xg, xu, xd, d_,
+                            (float) act_limit, nullptr, prof);
+}
+
+static int64_t exl3_tail_m16_l2pf_op(int64_t set)
+{
+    return exl3_tail_m16_l2pf((int) set);
+}
+
+TORCH_LIBRARY(exl3_tail_m16, m)
+{
+    m.def("l2pf", &exl3_tail_m16_l2pf_op);
+    m.def("supported", &exl3_tail_m16_supported_op);
+    m.def("tail", &exl3_tail_m16_op);
+}
