+    static const bool enabled = []
+    {
+        const char* env = std::getenv("EXL3_LAYER_TAIL");
+        return !(env && env[0] == '0');
+    }();
+    if (!enabled || size_m < 1 || size_m > EXL3_TAIL_M16_ROWS) return false;
+    if (!trellis_is(o_trellis, EXL3_TAIL_SCHED_K0, EXL3_TAIL_SCHED_N0) ||
+        !trellis_is(gate_trellis, EXL3_MLP_SCHED_K1, EXL3_MLP_SCHED_N1) ||
+        !trellis_is(up_trellis, EXL3_MLP_SCHED_K1, EXL3_MLP_SCHED_N1) ||
+        !trellis_is(down_trellis, EXL3_MLP_SCHED_K2, EXL3_MLP_SCHED_N2)) return false;
