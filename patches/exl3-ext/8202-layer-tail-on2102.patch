+    m.suh_u = (const half*) up_suh.data_ptr();
+    m.suh_d = (const half*) down_suh.data_ptr();
+    m.xh_g = (half*) xh_g.data_ptr();
+    m.xh_u = (half*) xh_u.data_ptr();
+    m.xh_d = (half*) xh_d.data_ptr();
