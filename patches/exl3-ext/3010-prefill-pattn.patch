+#include "pattn.cuh"
+#include "pattn_kernel.cuh"
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "util.h"
+#include "util.cuh"
+
+void pattn_prefill
+(
+    const at::Tensor& q,
+    const at::Tensor& k16,
+    const at::Tensor& v16,
+    const at::Tensor& block_table,
+    const at::Tensor& cache_seqlens,
+    const at::Tensor& out,
+    int kv_append_len,
+    float scale_log2,
+    int mode
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(q.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    TORCH_CHECK(q.dim() == 4 && q.size(3) == PA_HD && q.dtype() == at::kHalf && q.is_contiguous(), "pattn: q must be contiguous fp16 (bsz, q_len, heads, 256)");
+    TORCH_CHECK(out.sizes() == q.sizes() && out.dtype() == at::kHalf && out.is_contiguous(), "pattn: out must be contiguous and shaped like q");
+    TORCH_CHECK(k16.dim() == 4 && k16.size(1) == PA_PAGE && k16.size(3) == PA_HD && k16.dtype() == at::kHalf && k16.is_contiguous() &&
+                v16.sizes() == k16.sizes() && v16.dtype() == at::kHalf && v16.is_contiguous(), "pattn: k16 / v16 must be contiguous fp16 (pages, 256, kv_heads, 256)");
+    TORCH_CHECK(block_table.dtype() == at::kInt && block_table.dim() == 2 && block_table.is_contiguous() && block_table.size(0) == q.size(0), "pattn: bad block_table");
+    TORCH_CHECK(cache_seqlens.dtype() == at::kInt && cache_seqlens.numel() == q.size(0) && cache_seqlens.is_cuda(), "pattn: bad cache_seqlens");
+    TORCH_CHECK(mode == 0 || mode == 1, "pattn: mode must be 0 or 1");
+    int bsz = (int) q.size(0), q_len = (int) q.size(1), n_q_heads = (int) q.size(2), n_kv_heads = (int) k16.size(2);
+    TORCH_CHECK(n_q_heads == PA_G * n_kv_heads, "pattn: needs 6 q heads per kv head");
+    static bool init = false;
+    if (!init)
+    {
+        cuda_check(cudaFuncSetAttribute(pattn_detail::pattn_kernel<true>, cudaFuncAttributeMaxDynamicSharedMemorySize, PA_SMEM));
+        cuda_check(cudaFuncSetAttribute(pattn_detail::pattn_kernel<false>, cudaFuncAttributeMaxDynamicSharedMemorySize, PA_SMEM));
+        init = true;
+    }
+    dim3 grid((q_len + PA_BQ - 1) / PA_BQ, n_kv_heads, bsz);
+    if (mode == 1)
+        pattn_detail::pattn_kernel<true><<<grid, PA_THREADS, PA_SMEM, stream>>>(
+            (const half*) q.data_ptr(), (const half*) k16.data_ptr(), (const half*) v16.data_ptr(),
+            (const int*) block_table.data_ptr(), (const int*) cache_seqlens.data_ptr(), (half*) out.data_ptr(),
+            (int) block_table.size(1), q_len, kv_append_len, n_q_heads, n_kv_heads, scale_log2);
+    else
+        pattn_detail::pattn_kernel<false><<<grid, PA_THREADS, PA_SMEM, stream>>>(
+            (const half*) q.data_ptr(), (const half*) k16.data_ptr(), (const half*) v16.data_ptr(),
+            (const int*) block_table.data_ptr(), (const int*) cache_seqlens.data_ptr(), (half*) out.data_ptr(),
+            (int) block_table.size(1), q_len, kv_append_len, n_q_heads, n_kv_heads, scale_log2);
+    cuda_check(cudaPeekAtLastError());
+}
