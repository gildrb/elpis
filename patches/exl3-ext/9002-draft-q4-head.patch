+"""
+Draft-only int4 LM head for DFlash2 at M <= 8 token rows (ext dflash2_head.cu).
+
+Q4DraftHead is an int4 (group 128, symmetric, fp16 scale) copy of the attached target's EXL3 LM head,
+derived once at attach time, whose GEMM fuses the selector's top-16 (no logits tensor, no separate top-k).
+Weights live in the head's input-rotated basis: W' = W_inner H_128 diag(svh) per 128-column block and
+x' = (x * suh) H_128, so x' W' = x W. Only the draft's proposals use it; the target's own head (greedy
+verification) is untouched.
+
+Weights are repacked into per-lane mma.m16n8k16 A-fragment order (see dflash2_head.cu). The packing
+functions are pure torch and run on any device, so the layout is checked on the CPU against the
+kernel's own index expressions (fragment_rows_cols, unpack_q4).
+"""
+
+from __future__ import annotations
+import math
+import torch
+
+from ...ext import exllamav3_ext as ext
+
+Q4_GROUP = 128
+Q4_SCALE_SEARCH = (1.0, 0.95, 0.9, 0.85)   # absmax clipping at most 15%
+HEAD_SLICE_N = 2048                         # vocab columns reconstructed per step at attach
+HEAD_TOP_K = 16                             # the kernel's fused top-k
+HEAD_K_MULTIPLE = 512                       # K % (64 * HEAD_DEPTH), dflash2_q4_head_topk host check
+
+
+def fragment_rows_cols(device = "cpu") -> tuple[torch.Tensor, torch.Tensor]:
+    """(rows, cols) [32 lanes, 4 pairs, 2 halves] of the m16n8k16 A fragment: lane = 4 g + q;
+    pair p covers row g + 8 (p & 1), columns 2 q + 8 (p >> 1) + {0, 1}"""
+    lane = torch.arange(32, device = device).view(32, 1, 1)
+    p = torch.arange(4, device = device).view(1, 4, 1)
+    h = torch.arange(2, device = device).view(1, 1, 2)
+    g, q = lane // 4, lane % 4
+    rows = (g + 8 * (p & 1)).expand(32, 4, 2)
+    cols = (2 * q + 8 * (p >> 1) + h).expand(32, 4, 2)
+    return rows.contiguous(), cols.contiguous()
+
+
+def _tile_fragments(wt: torch.Tensor) -> torch.Tensor:
+    """wt [n_tiles * 16, K] (rows = output features) -> [n_tiles, K / 16, 32, 4, 2] fragment elements"""
+    n, K = wt.shape
+    rows, cols = fragment_rows_cols(wt.device)
+    t = wt.view(n // 16, 16, K // 16, 16).permute(0, 2, 1, 3)               # [tiles, k16, 16 r, 16 c]
+    flat = (rows * 16 + cols).view(-1)                                      # [32 * 4 * 2]
+    return t.reshape(n // 16, K // 16, 256)[:, :, flat].view(n // 16, K // 16, 32, 4, 2)
+
+
+def pack_q4(wt: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """wt [n, K] fp32 rows = vocab ids (n <= padded to 16) -> (wq int32 [tiles, K/64, 32, 4],
+    scales fp16 [tiles, K/128, 8, 2]). Symmetric int4, level q in [-8, 7], group 128 along K; per group
+    the scale minimizing squared error over Q4_SCALE_SEARCH * absmax / 7 (fp16-rounded before rounding q)"""
+    n, K = wt.shape
+    if K % Q4_GROUP:
+        raise ValueError("pack_q4: K must be a multiple of 128")
+    pad = (-n) % 16
+    if pad:
+        wt = torch.cat([wt, wt.new_zeros(pad, K)], 0)
+    n_p = wt.shape[0]
+    G = K // Q4_GROUP
+    wg = wt.float().view(n_p, G, Q4_GROUP)
+    amax = wg.abs().amax(-1, keepdim = True)
+    def candidate(f: float) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        s = (amax * (f / 7.0)).half().float()
+        s = torch.where(s > 0, s, torch.ones_like(s))
+        qv = torch.clamp(torch.round(wg / s), -8, 7)
+        return ((qv * s - wg) ** 2).sum(-1, keepdim = True), s, qv
+    best_err, best_s, best_q = candidate(Q4_SCALE_SEARCH[0])
+    for f in Q4_SCALE_SEARCH[1:]:
+        err, s, qv = candidate(f)
+        take = err < best_err
+        best_err = torch.where(take, err, best_err)
+        best_s = torch.where(take, s, best_s)
+        best_q = torch.where(take, qv, best_q)
+    q = (best_q + 8).to(torch.int32).view(n_p, K)                           # biased nibble 0..15
+    tiles = n_p // 16
+    fr = _tile_fragments(q)                                                 # [tiles, K/16, 32, 4, 2]
+    fr = fr.view(tiles, K // 64, 4, 32, 4, 2).permute(0, 1, 3, 2, 4, 5)    # [tiles, c, lane, j, p, h]
+    shift = (4 * torch.arange(4, device = wt.device)).view(4, 1) + torch.tensor([0, 16], device = wt.device).view(1, 2)
+    words = (fr.to(torch.int64) << shift).sum((-1, -2))                     # [tiles, c, lane, j]
+    wq = torch.where(words >= 2 ** 31, words - 2 ** 32, words).to(torch.int32).contiguous()
+    s = best_s.view(tiles, 16, G).permute(0, 2, 1)                          # [tiles, G, 16 rows]
+    scales = torch.stack([s[:, :, 0:8], s[:, :, 8:16]], -1).half().contiguous()   # [tiles, G, 8, 2]
+    return wq, scales
+
+
+def unpack_q4(wq: torch.Tensor, scales: torch.Tensor, K: int) -> torch.Tensor:
+    """Inverse of pack_q4 through the kernel's own decode: nibble p / p + 4 of word j of (tile, chunk c,
+    lane) is pair p of k16 step 4 c + j; value = (nibble - 8) * scale[tile, k / 128, row % 8, row // 8]"""
+    tiles = wq.shape[0]
+    w = wq.to(torch.int64) & 0xffffffff
+    shift = (4 * torch.arange(4, device = wq.device)).view(4, 1) + torch.tensor([0, 16], device = wq.device).view(1, 2)
+    nib = (w.unsqueeze(-1).unsqueeze(-1) >> shift) & 0xf                    # [tiles, c, lane, j, p, h]
+    rows, cols = fragment_rows_cols(wq.device)
+    out = torch.empty(tiles, 16, K, dtype = torch.float, device = wq.device)
+    c = torch.arange(K // 64, device = wq.device).view(-1, 1, 1, 1, 1)
+    j = torch.arange(4, device = wq.device).view(1, 1, 4, 1, 1)
+    kk = 64 * c + 16 * j + cols.view(1, 32, 1, 4, 2)                        # [c, lane, j, p, h]
+    rr = rows.view(1, 32, 1, 4, 2).expand_as(kk)
+    sc = scales.float()                                                     # [tiles, G, 8, 2]
+    s = sc[:, kk // Q4_GROUP, rr % 8, rr // 8]                              # [tiles, c, lane, j, p, h]
+    out[:, rr, kk] = (nib.float() - 8.0) * s
+    return out.view(tiles * 16, K)
+
+
+class Q4DraftHead:
+    """int4 copy of an EXL3 LM head with fused top-16 (draft proposals only)"""
+
+    @staticmethod
+    def supported(lm_inner, vocab: int, top_k: int, scale: float, softcap: float) -> bool:
+        """The head qualifies: an unbiased CUDA EXL3 head whose dims the kernel takes (K % 512 == 0,
+        1024 <= K <= 6144 for the 16 B/element activation staging in shared memory), a selector top-k of 16
+        and an order-preserving output transform (scale > 0, softcap >= 0)"""
+        from ...modules.quant.exl3 import LinearEXL3
+        if not isinstance(lm_inner, LinearEXL3) or lm_inner.bias is not None or not lm_inner.trellis.is_cuda:
+            return False
+        K, N = lm_inner.in_features, lm_inner.out_features
+        return (top_k == HEAD_TOP_K and K % HEAD_K_MULTIPLE == 0 and 1024 <= K <= 6144 and N % 128 == 0
+                and HEAD_TOP_K <= vocab <= N and scale > 0.0 and softcap >= 0.0)
+
+    def __init__(self, lm_inner, vocab: int, top_k: int, scale: float, softcap: float):
+        from ...modules.quant.exl3_lib.quantize import get_hadamard_dt
+        if not Q4DraftHead.supported(lm_inner, vocab, top_k, scale, softcap):
+            raise ValueError("Q4DraftHead: unsupported LM head (see Q4DraftHead.supported)")
+        K = lm_inner.in_features
+        self.scale = scale
+        self.softcap = softcap
+        dev = lm_inner.trellis.device
+        self.device = dev
+        self.K = K
+        self.vocab = vocab
+        self.suh = lm_inner.suh
+        had = get_hadamard_dt(128, dev, torch.float, 1 / math.sqrt(128))
+        n_used = (vocab + 127) // 128 * 128
+        tiles = (vocab + 15) // 16
+        self.wq = torch.empty((tiles, K // 64, 32, 4), dtype = torch.int32, device = dev)
+        self.scales = torch.empty((tiles, K // 128, 8, 2), dtype = torch.half, device = dev)
+        w = torch.empty((K, HEAD_SLICE_N), dtype = torch.half, device = dev)
+        for n0 in range(0, n_used, HEAD_SLICE_N):
+            n1 = min(n0 + HEAD_SLICE_N, n_used)
+            ws = w[:, : n1 - n0]
+            ext.reconstruct_slice(ws, lm_inner.trellis, lm_inner.K, lm_inner.mcg, lm_inner.mul1, n0)
+            wr = (ws.float().view(K, -1, 128) @ had).view(K, n1 - n0) * lm_inner.svh[n0:n1].float()
+            v1 = min(n1, vocab)
+            wq, sc = pack_q4(wr[:, : v1 - n0].T.contiguous())
+            t0 = n0 // 16
+            self.wq[t0 : t0 + wq.shape[0]] = wq
+            self.scales[t0 : t0 + sc.shape[0]] = sc
+            del wr, wq, sc
+        del w
+        sms = torch.cuda.get_device_properties(dev).multi_processor_count
+        grid = min(sms, tiles)
+        self.part_v = torch.empty((grid * 8 * 16,), dtype = torch.float, device = dev)
+        self.part_ix = torch.empty((grid * 8 * 16,), dtype = torch.int, device = dev)
+        self.counter = torch.zeros((1,), dtype = torch.int, device = dev)
+        torch.cuda.synchronize(dev)
+
+    def vram_bytes(self) -> int:
+        return self.wq.numel() * 4 + self.scales.numel() * 2 + self.part_v.numel() * 8 + 4
+
+    def topk(self, state: torch.Tensor, row0: int) -> tuple[torch.Tensor, torch.Tensor]:
+        """state [1, m, K] -> (unary fp32 [1, m - row0, 16], cands int64 [1, m - row0, 16]): per row the 16
+        best of softcap(scale * logit), descending by value, then lower id, rows row0.. of the block"""
+        if state.dim() != 3 or state.shape[0] != 1 or not row0 < state.shape[1] <= 8:
+            raise ValueError("Q4DraftHead.topk: needs one sequence of <= 8 rows")
+        x = state[0].to(self.device).half().contiguous()
+        xr = torch.empty_like(x)
+        ext.had_r_128(x, xr, self.suh, None, 1.0)
+        rows = x.shape[0] - row0
+        values = torch.empty((rows, HEAD_TOP_K), dtype = torch.float, device = self.device)
+        indices = torch.empty((rows, HEAD_TOP_K), dtype = torch.long, device = self.device)
+        ext.dflash2_q4_head_topk(xr, self.wq, self.scales, self.vocab, row0, self.scale, self.softcap,
+                                 self.part_v, self.part_ix, self.counter, values, indices)
+        return values.unsqueeze(0), indices.unsqueeze(0)
