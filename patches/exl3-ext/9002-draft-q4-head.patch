+        (const half*) x.data_ptr(), m, K,
+        (const uint4*) wq.data_ptr(), (const uint32_t*) scales.data_ptr(),
+        n_tiles, (int) vocab, (int) row0, rows_out, (float) scale, (float) softcap,
+        (float*) part_v.data_ptr(), (int*) part_ix.data_ptr(), (int*) counter.data_ptr(),
+        (float*) values.data_ptr(), (int64_t*) indices.data_ptr()
+    );
