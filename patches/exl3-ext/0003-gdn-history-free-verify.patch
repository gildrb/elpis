+// Commit of history-free verifies (RULE_VERIFY), one job per recurrent layer and slot: replays
+// the first `steps` verified tokens of batch row `row` through gated_delta_rule_128_reg from
+// the pre-verify state in row 0, reading the verify's own conv output / g / beta, and writes the
+// result back to row 0 -- bit-identical to the row-`steps` state a RULE_HISTORY verify stores,
+// which batched_state_rewind would have copied into row 0
+struct StateReplayJobBatch { StateReplayJob jobs[REWIND_MAX_JOBS]; int num_jobs; };
+static_assert(sizeof(StateReplayJobBatch) <= 4096, "StateReplayJobBatch exceeds the kernel parameter limit");
+
+__global__ __launch_bounds__(32 * SUBK)
+void batched_state_replay_kernel(StateReplayJobBatch batch)
+{
+    int job_idx = blockIdx.z;
+    if (job_idx >= batch.num_jobs) return;
+    StateReplayJob j = batch.jobs[job_idx];
+    if ((int) blockIdx.y >= j.num_v_heads) return;
+
+    constexpr int HEAD_DIM = 128;
+    size_t F = 2 * HEAD_DIM * j.num_k_heads + HEAD_DIM * j.num_v_heads;
+    size_t row_tokens = (size_t) j.row * j.seqlen;
+    gated_delta_rule_128_reg<RULE_COMMIT>
+    (
+        (const bfloat16*) j.mixed_qkv + row_tokens * F,
+        (const float*) j.g + row_tokens * j.num_v_heads,
+        (const bfloat16*) j.beta + row_tokens * j.num_v_heads,
+        (float*) j.state,
+        nullptr,
+        j.steps,
+        j.num_k_heads,
+        j.num_v_heads,
+        0.0f,
+        (size_t) j.num_v_heads * HEAD_DIM * HEAD_DIM,
+        blockIdx.y,
+        blockIdx.x
+    );
+}
+
+void batched_state_replay(std::vector<StateReplayJob> const& jobs, int device_index)
+{
+    if (jobs.empty()) return;
+    c10::cuda::CUDAGuard device_guard((c10::DeviceIndex) device_index);
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    for (size_t base = 0; base < jobs.size(); base += REWIND_MAX_JOBS)
+    {
+        int n = (int) MIN(jobs.size() - base, (size_t) REWIND_MAX_JOBS);
+        StateReplayJobBatch batch;
+        batch.num_jobs = n;
+        int max_heads = 0;
+        for (int i = 0; i < n; ++i)
+        {
+            const StateReplayJob& j = jobs[base + i];
+            TORCH_CHECK(j.mixed_qkv && j.g && j.beta && j.state, "batched_state_replay: null pointer");
+            TORCH_CHECK(1 <= j.steps && j.steps <= j.seqlen && 0 <= j.row,
+                        "batched_state_replay: steps must be in 1..seqlen");
+            TORCH_CHECK(j.num_k_heads >= 1 && j.num_v_heads % j.num_k_heads == 0 && j.num_v_heads <= 65535,
+                        "batched_state_replay: bad head counts");
+            batch.jobs[i] = j;
+            max_heads = MAX(max_heads, j.num_v_heads);
+        }
+
+        gdn_max_shared_carveout((const void*) &batched_state_replay_kernel);
+        dim3 blocks(128 / 32, max_heads, n);
+        batched_state_replay_kernel<<<blocks, 32 * SUBK, 0, stream>>>(batch);
+        cuda_check(cudaPeekAtLastError());
+    }
+}
