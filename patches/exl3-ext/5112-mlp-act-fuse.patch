+#pragma once
+
+// Ext 5112: up-projection GEMM with the SiLU-gate product in its epilogue (prefill MLP, see hgemm_act.cu).
+
+#include <ATen/Tensor.h>
+
+// c = silu(gate) * (a @ b), fp16, exactly as hgemm_recon(a, b, c) followed by silu_mul(gate, c, c, act_limit)
+void hgemm_recon_silu_mul(at::Tensor a, at::Tensor b, at::Tensor c, at::Tensor gate, float act_limit);
