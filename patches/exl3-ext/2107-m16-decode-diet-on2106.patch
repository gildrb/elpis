+#pragma once
+
+// ext 2107 (diet mode 2 of torch.ops.exl3_m16.diet / EXL3_M16_DIET): bit-identical decode diet of the m16 hot
+// loops (layer tail, 8201 MLP, m16g). Same weight words, same trellis windows, same codebook (decode_3inst_2),
+// same fragment order and MMA sequence as dq8_aligned_4bits; only how the words are addressed and the windows
+// extracted changes:
+// - the two words of a lane (word lane - 1 and word lane of each 128-byte tile) are read with ld.shared at a
+//   per-lane shared address computed once per kernel plus the ring-slot offset (+ t * 128 as an immediate),
+//   instead of re-deriving the generic address per tile;
+// - the eight 16-bit windows at bit offsets 0, 4, ..., 28 of {a:b}: the byte-aligned ones (0, 8, 16 of b and
+//   of u = {a:b} >> 4, 8 of s = {a:b} >> 20) are each one byte permute with zero fill, window 24 is one funnel
+//   shift + mask (whatif/extract_check.cpp: identical windows on 5e7 word pairs);
+// - the weight cp.async uses an L2 evict-first policy created once per kernel (the same policy
+//   dq/cp_async_stream creates per call).
+
+__device__ __forceinline__ uint64_t m16_stream_policy()
+{
+    uint64_t p;
+    asm volatile ("createpolicy.fractional.L2::evict_first.b64 %0, 1.0;\n" : "=l"(p));
+    return p;
+}
+
+__device__ __forceinline__ void cp_async_stream_pol(void* smem_ptr, const void* glob_ptr, uint64_t pol)
+{
+    uint32_t smem = static_cast<uint32_t>(__cvta_generic_to_shared(smem_ptr));
+    asm volatile ("cp.async.cg.shared.global.L2::cache_hint [%0], [%1], 16, %2;\n" :: "r"(smem), "l"(glob_ptr), "l"(pol));
+}
+
+template <int OFF>
+__device__ __forceinline__ uint32_t m16_lds(uint32_t addr)
+{
+    uint32_t v;
+    asm volatile ("ld.shared.u32 %0, [%1+%2];\n" : "=r"(v) : "r"(addr), "n"(OFF));
+    return v;
+}
+
+template <int cb>
+__device__ __forceinline__ void dq8_m16_regs(uint32_t a, uint32_t b, FragB& frag0, FragB& frag1)
+{
+    const uint32_t u = __funnelshift_r(b, a, 4);
+    const uint32_t s = __funnelshift_r(b, a, 20);
+    const uint32_t t = __funnelshift_r(b, a, 24);
+    const uint32_t w7 = __byte_perm(b, 0, 0x4410);
+    const uint32_t w5 = __byte_perm(b, 0, 0x4421);
+    const uint32_t w3 = __byte_perm(b, 0, 0x4432);
+    const uint32_t w6 = __byte_perm(u, 0, 0x4410);
+    const uint32_t w4 = __byte_perm(u, 0, 0x4421);
+    const uint32_t w2 = __byte_perm(u, 0, 0x4432);
+    const uint32_t w1 = t & 0xffff;
+    const uint32_t w0 = __byte_perm(s, 0, 0x4421);
+    frag0[0] = decode_3inst_2<cb>(w0, w1);
+    frag0[1] = decode_3inst_2<cb>(w2, w3);
+    frag1[0] = decode_3inst_2<cb>(w4, w5);
+    frag1[1] = decode_3inst_2<cb>(w6, w7);
+}
+
+// The m16 tile step of the diet: ldmatrix of the activation piece at sa, the 4 weight tiles of the ring slot
+// at byte offset off (words at w0 + off + t * 128 and w1 + off + t * 128), decode, MMA into hacc -- the same
+// operations in the same order as the loops' mma_tile with dq8_aligned_4bits
+template <int MT, int cb, typename Acc>
+__device__ __forceinline__ void m16_tile_diet(uint32_t sa, uint32_t w0, uint32_t w1, Acc& hacc)
+{
+    static_assert(EXL3_M16_TILES_W == 4, "4 weight tiles per warp");
+    uint32_t bx[MT][2];
+    if constexpr (MT == 2)
+        asm volatile ("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+            : "=r"(bx[0][0]), "=r"(bx[0][1]), "=r"(bx[1][0]), "=r"(bx[1][1]) : "r"(sa));
+    else
+        asm volatile ("ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%0,%1}, [%2];\n"
+            : "=r"(bx[0][0]), "=r"(bx[0][1]) : "r"(sa));
+    uint32_t wa[4], wb[4];
+    wa[0] = m16_lds<0>(w0);   wb[0] = m16_lds<0>(w1);
+    wa[1] = m16_lds<128>(w0); wb[1] = m16_lds<128>(w1);
+    wa[2] = m16_lds<256>(w0); wb[2] = m16_lds<256>(w1);
+    wa[3] = m16_lds<384>(w0); wb[3] = m16_lds<384>(w1);
+    #pragma unroll
+    for (int t = 0; t < 4; ++t)
+    {
+        FragB f0, f1;
+        dq8_m16_regs<cb>(wa[t], wb[t], f0, f1);
+        FragA a;
+        a[0] = f0[0];
+        a[1] = f1[0];
+        a[2] = f0[1];
+        a[3] = f1[1];
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        {
+            FragB bb;
+            bb[0] = *reinterpret_cast<half2*>(&bx[mt][0]);
+            bb[1] = *reinterpret_cast<half2*>(&bx[mt][1]);
+            ptx_mma_m16n8k16(a, bb, hacc[t][mt]);
+        }
+    }
+}
