+    // capture; the exec keeps its pending node updates for the next direct launch
+    cudaStreamCaptureStatus status;
+    cudaGraph_t outer_graph;
+    const cudaGraphNode_t* deps;
+    size_t num_deps;
+    cuda_check(cudaStreamGetCaptureInfo(stream, &status, nullptr, &outer_graph, &deps, nullptr, &num_deps));
+    TORCH_CHECK(status == cudaStreamCaptureStatusActive, "Graph: outer capture mode but the stream is not capturing");
+
+    cudaGraphNode_t child;
+    cuda_check(cudaGraphAddChildGraphNode(&child, outer_graph, deps, num_deps, graph));
+    cuda_check(cudaStreamUpdateCaptureDependencies(stream, &child, nullptr, 1, cudaStreamSetCaptureDependencies));
