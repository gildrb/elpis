+class _DraftGraph:
+    """
+    One captured draft forward (every module after the input layer) for one batch shape and block-table width.
+    The graph reads the block, block table and cache lengths from its static buffers and writes the final
+    state into a static output that the next replay overwrites.
+    """
+    __slots__ = ("graph", "x", "block_table", "cache_seqlens", "out")
+
+    def replay(self, x: torch.Tensor, block_table: torch.Tensor, cache_seqlens: torch.Tensor) -> torch.Tensor:
+        self.x.copy_(x, non_blocking = x.is_pinned())
+        self.block_table.copy_(block_table, non_blocking = block_table.is_pinned())
+        self.cache_seqlens.copy_(cache_seqlens, non_blocking = cache_seqlens.is_pinned())
+        self.graph.replay()
+        return self.out
+
+
+class _DraftGraphs:
+    """
+    The DFlash2 draft forward, blocks through the final norm, replayed as one CUDA graph instead of a few hundred
+    Python-issued launches. The draft always runs a fixed block per sequence, so a graph serves every round of
+    its (batch shape, block-table width): the block table and cache lengths are the only per-round inputs, read
+    from static device buffers the replay fills. The table width stays a graph key because the attention graph
+    derives its split configuration from it.
+
+    The attention and MLP modules replay graphs of their own. Under capture they are embedded as child graphs
+    with their parameters patched exactly as their own launch would (ext.set_graph_outer_capture), so the
+    captured forward runs the same kernels with the same arguments as the eager one. Those module graphs exist
+    only after two eager forwards of the shape; capturing waits for them. A capture that fails (anything in the
+    forward that the stream capture rejects) permanently leaves that key eager.
+    """
+
+    WARMUP = 2
+    MAX_GRAPHS = 4
+
+    def __init__(self):
+        self.enabled = os.environ.get("EXL3_DRAFT_GRAPH", "1") != "0"
+        self.graphs = {}
+        self.eager_runs = {}
+        self.failed = set()
+
+
+    def clear(self):
+        self.graphs.clear()
+        self.eager_runs.clear()
+        self.failed.clear()
+
+
+    @staticmethod
+    def key(model: Model, x: torch.Tensor, params: dict) -> tuple | None:
+        """
+        Graph key of a draft forward, or None when the forward depends on per-round host values the graph would
+        freeze or runs outside a single CUDA device
+        """
+        block_table = params.get("block_table")
+        cache_seqlens = params.get("cache_seqlens")
+        positions = params.get("positions")
+        if (
+            params.get("attn_mode") != "flash_attn" or
+            not isinstance(block_table, torch.Tensor) or
+            not isinstance(cache_seqlens, torch.Tensor) or
+            params.get("position", 0) != 0 or
+            (positions is not None and positions is not cache_seqlens) or
+            params.get("position_ids") is not None or
+            params.get("inv_freq") is not None or
+            params.get("indexed_embeddings") or
+            getattr(model.config, "moe_cpu_hosts", None)
+        ):
+            return None
+        devices = {torch.device(module.device) for module, _, _ in model.fwd_modules[1:]}
+        if len(devices) != 1:
+            return None
+        device = devices.pop()
+        if device.type != "cuda":
+            return None
+        return (
+            device, tuple(x.shape), x.dtype,
+            tuple(block_table.shape), block_table.dtype, tuple(cache_seqlens.shape), cache_seqlens.dtype,
+            params.get("positions") is not None, params.get("causal", True), id(params.get("cache")),
+        )
+
+
+    def forward(self, model: Model, x: torch.Tensor, params: dict) -> torch.Tensor:
+        """
+        The forward of every module after the input layer, x the input layer's output
+        """
+        key = self.key(model, x, params) if self.enabled else None
+        if key is None or key in self.failed:
+            return model.forward_blocks(x, params)
+        entry = self.graphs.get(key)
+        if entry is None:
+            warm_key = key[:3]
+            runs = self.eager_runs.get(warm_key, 0)
+            if runs < self.WARMUP:
+                self.eager_runs[warm_key] = runs + 1
+                return model.forward_blocks(x, params)
+            entry = self.capture(model, key, x, params)
+            if entry is None:
+                self.failed.add(key)
+                return model.forward_blocks(x, params)
+        return entry.replay(x, params["block_table"], params["cache_seqlens"])
+
+
+    def capture(self, model: Model, key: tuple, x: torch.Tensor, params: dict) -> _DraftGraph | None:
+        device = key[0]
+        block_table = params["block_table"]
+        cache_seqlens = params["cache_seqlens"]
+        entry = _DraftGraph()
+        entry.x = torch.empty(x.shape, dtype = x.dtype, device = device)
+        entry.block_table = torch.empty(block_table.shape, dtype = block_table.dtype, device = device)
+        entry.cache_seqlens = torch.empty(cache_seqlens.shape, dtype = cache_seqlens.dtype, device = device)
+
+        # The captured forward sees only the static buffers; positions alias the cache lengths as in the eager
+        # forward's params
+        static_params = {k: v for k, v in params.items() if k != "dev_cache"}
+        static_params["block_table"] = entry.block_table
+        static_params["cache_seqlens"] = entry.cache_seqlens
+        if params.get("positions") is not None:
+            static_params["positions"] = entry.cache_seqlens
+
+        if len(self.graphs) >= self.MAX_GRAPHS:
+            del self.graphs[next(iter(self.graphs))]
+        entry.graph = torch.cuda.CUDAGraph()
+        ext.set_graph_outer_capture(True)
+        try:
+            with torch.cuda.device(device), torch.cuda.graph(entry.graph, capture_error_mode = "thread_local"):
+                entry.out = model.forward_blocks(entry.x, static_params)
+        except Exception:
+            return None
+        finally:
+            ext.set_graph_outer_capture(False)
+        self.graphs[key] = entry
+        return entry
+
