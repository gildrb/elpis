+def dense_partial_blocks(bsz: int, n_kv_heads: int, splits: int, nsub: int) -> int:
+    """Partial row blocks (BLOCK_ROWS x HD_PAD fp32 in partial_o, BLOCK_ROWS x 2 in partial_ml)
+    to allocate for a dense slot: the GQA split kernel (3002) stores NSUB blocks per (batch,
+    kv_head, split) over SPLITS splits; the pristine kernel one block per (program, split) over
+    splits_cap splits (nsub = h_blocks, splits = splits_cap)."""
+    return bsz * n_kv_heads * splits * nsub
+
+
+def dense_partial_extent(use_gqa: bool, programs: int, grid_y: int, splits: int, nsub: int) -> int:
+    """One past the largest partial block index the launched (programs, grid_y) split grid
+    stores and the (programs,) combine grid reads, in each kernel's own index arithmetic.
+      GQA: program (pid, y) -> bh = pid // NSUB, split = (pid % NSUB) * GRID_Y + y (returns when
+        split >= SPLITS), stores idx = (bh * SPLITS + split) * NSUB + sub for sub < NSUB; the
+        combine program pid reads (bh * SPLITS + s) * NSUB + pid % NSUB for s < SPLITS.
+      pristine: split program (pid, split) stores pid * num_splits + split for split <
+        num_splits <= grid_y; the combine reads the same."""
+    if use_gqa:
+        bh_max = (programs - 1) // nsub
+        split_max = min(splits, nsub * grid_y) - 1
+        return (bh_max * splits + split_max) * nsub + (nsub - 1) + 1
+    return (programs - 1) * grid_y + (grid_y - 1) + 1
+
