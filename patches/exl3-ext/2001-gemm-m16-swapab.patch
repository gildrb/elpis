+    FragC acc[4][MT];
+    #pragma unroll
+    for (int t = 0; t < 4; ++t)
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+            #pragma unroll
+            for (int c = 0; c < 4; ++c) acc[t][mt][c] = 0.0f;
