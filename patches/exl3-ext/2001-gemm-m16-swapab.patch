+++ b/exllamav3_ext/quant/exl3_gemm_m16_kernel.cuh
@@ -0,0 +1,392 @@
+#pragma once
+
+// EXL3 trellis GEMM for 1..16 token rows, swap-AB (exl3_gemm_m16.cu has the host side).
+//
+// - The weight tile is the m16 x k16 A operand of mma.m16n8k16, decoded straight into registers:
+//   dq8_aligned_4bits yields the two k16 x n8 B fragments (f0 = tile cols 0-7, f1 = cols 8-15) of
+//   the regular kernels, and {f0[0], f1[0], f0[1], f1[1]} is exactly the row-major A fragment of
+//   the transposed tile. The activations (input-Hadamard domain) are the k16 x n8 B operand, one n8
+//   token tile for m <= 8 (MT = 1), two for m <= 16 (MT = 2). No padded MMA rows; fp32 accumulate.
+// - Weights and activation slices stream through a warp-private cp.async ring (PF stages of 512 B
+//   of weights + MT * 256 B of activations), so the main loop has no block barrier. The first
+//   PF - 1 weight stages are issued before the input Hadamard phase and its grid.sync.
+// - Work partition: iterations are (group, k-tile) with group = (matrix, 128 output columns), in
+//   group-major order; block b owns the contiguous range [b * I / G, (b + 1) * I / G). In a block,
+//   warp w covers the 64-column half (w & 1) and every 4th k-tile of the range (phase w >> 1).
+// - Deterministic reduction: at each group boundary the 4 k-phase warps of each half are summed
+//   in a fixed tree ((p0 + p2) + (p1 + p3)) in shared memory. A group computed by one block is
+//   finished in place; otherwise every contributing block writes its partial to a fixed slot
+//   (contributor index = block - first contributing block) and the last block to arrive sums
+//   the slots in slot order. Summation order therefore depends only on the grid size.
+// - Epilogue: the fp32 128-column row is output-Hadamard transformed with svh post-scaling
+//   (had_fh_r_128_inner for fp16 C, had_ff_r_128_inner for fp32 C), same scale as the other paths.
+
+#include <cooperative_groups.h>
+#include "../ptx.cuh"
+#include "exl3_dq.cuh"
+#include "hadamard_inner.cuh"
+
+#define EXL3_M16_THREADS 256
+#define EXL3_M16_WARPS 8
+#define EXL3_M16_PHASES 4
+#define EXL3_M16_MAX_MATS 2
+#define EXL3_M16_SLOT_FLOATS (16 * 128)
+
+struct Exl3M16Args
+{
+    const uint16_t* B[EXL3_M16_MAX_MATS];
+    const half* suh[EXL3_M16_MAX_MATS];
+    half* xh[EXL3_M16_MAX_MATS];
+    const half* svh[EXL3_M16_MAX_MATS];
+    float* ws;
+    int* counters;
+    int size_m;
+    int size_k;
+    int size_n;
+    int num_mats;
+    int max_contrib;
+};
+
+template <int MT>
+struct Exl3M16Cfg
+{
+    static constexpr int PF = MT == 1 ? 6 : 4;                  // ring stages per warp
+    static constexpr int W_BYTES = 512;                         // 4 tiles x 128 B (4 bpw)
+    static constexpr int X_BYTES = MT * 256;                    // 2 k-halves x MT*8 rows x 16 B
+    static constexpr int STAGE = W_BYTES + X_BYTES;
+    static constexpr int RING = EXL3_M16_WARPS * PF * STAGE;
+    static constexpr int ACC = 4 * MT * 4;                      // floats per lane
+    static constexpr int RED = 2 * 2 * ACC * 32 * 4;            // 2 slots x 2 halves x ACC x 32 lanes
+    static constexpr int SMEM = RING + RED;
+    static_assert(RED >= MT * 8 * 128 * 4, "reduction area must hold the output tile");
+};
+
+// Block owning iteration x, for the partition start(b) = floor(b * total / G)
+__device__ __forceinline__ int exl3_m16_owner(int x, int total, int G)
+{
+    return (int) ((((int64_t) x + 1) * G + total - 1) / total) - 1;
+}
+
+template <int MT, bool c_fp32, int cb>
+__global__ __launch_bounds__(EXL3_M16_THREADS, 2)
+void exl3_gemm_m16_kernel(const half* __restrict__ A, void* C0, void* C1, Exl3M16Args p)
+{
+    using Cfg = Exl3M16Cfg<MT>;
+    constexpr int PF = Cfg::PF;
+    constexpr int STAGE = Cfg::STAGE;
+    constexpr int ROWS = MT * 8;
+
+    extern __shared__ __align__(16) uint8_t sm[];
+    __shared__ int s_last;
+
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+    const int nh = warp & 1;
+    const int kp = warp >> 1;
+
+    const int size_m = p.size_m;
+    const int size_k = p.size_k;
+    const int size_n = p.size_n;
+    const int KT = size_k >> 4;
+    const int NT = size_n >> 4;
+    const int NG = size_n >> 7;
+    const int total = p.num_mats * NG * KT;
+    const int G = gridDim.x;
+    const int b = blockIdx.x;
+    const int s_b = (int) (((int64_t) b * total) / G);
+    const int e_b = (int) (((int64_t) (b + 1) * total) / G);
+
+    uint8_t* ring = sm + warp * PF * STAGE;
+    float* red = (float*) (sm + Cfg::RING);
+
+    // This warp's iterations: s_b + kp + 4 * j, j < nj
+    const int nj = e_b - s_b > kp ? (e_b - s_b - kp + 3) / 4 : 0;
+
+    // Activation copy role: lane < 2 * ROWS copies 16 B of token (lane % ROWS), k-half (lane / ROWS);
+    // tokens past size_m replicate the last row (finite values, results discarded)
+    const bool x_lane = lane < 2 * ROWS;
+    const int x_tok = min(lane % ROWS, size_m - 1);
+    const int x_off = x_tok * size_k + (lane / ROWS) * 8;
+
+    auto issue_w = [&] (int g, int kt, int slot)
+    {
+        int mat = g >= NG ? 1 : 0;
+        int ng = g - mat * NG;
+        const uint16_t* src = (mat ? p.B[1] : p.B[0]) + ((size_t) kt * NT + ng * 8 + nh * 4) * 64 + lane * 8;
+        cp_async_stream(ring + slot * STAGE + lane * 16, src);
+    };
+    auto issue_x = [&] (int g, int kt, int slot)
+    {
+        int mat = g >= NG ? 1 : 0;
+        if (x_lane)
+            cp_async(ring + slot * STAGE + Cfg::W_BYTES + lane * 16, (mat ? p.xh[1] : p.xh[0]) + x_off + kt * 16);
+    };
+
+    // Prologue: first PF - 1 weight stages (independent of the input transform)
+    #pragma unroll
+    for (int j = 0; j < PF - 1; ++j)
+    {
+        if (j < nj)
+        {
+            int it = s_b + kp + 4 * j;
+            int g = it / KT;
+            issue_w(g, it - g * KT, j);
+        }
+        cp_async_fence();
+    }
+
+    // Input scales and Hadamard transform, one warp per 128 elements (same call as exl3_gemm_kernel)
+    {
+        int per_mat = size_m * size_k / 128;
+        int total_warps = p.num_mats * per_mat;
