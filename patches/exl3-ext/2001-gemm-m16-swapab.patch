+#include <cuda_fp16.h>
+#include "exl3_gemm_m16.cuh"
+
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_gemm_m16_kernel.cuh"
+#include "exl3_devctx.cuh"
+#include <mutex>
+
+// Fixed-size per-device scratch, allocated once and never resized: captured graphs keep the
+// pointers. Partial slots are EXL3_M16_SLOT_FLOATS floats each; counters are self-resetting.
+#define EXL3_M16_WS_BYTES (16ull * 1024 * 1024)
+#define EXL3_M16_MAX_GROUPS 8192
+
+namespace {
+
+struct M16Scratch
+{
+    float* ws = nullptr;
+    int* counters = nullptr;
+};
+
+M16Scratch g_scratch[MAX_DEVICES];
+std::mutex g_scratch_mtx;
+
+M16Scratch& get_scratch(int device, cudaStream_t stream)
+{
+    std::lock_guard<std::mutex> lock(g_scratch_mtx);
+    M16Scratch& s = g_scratch[device];
+    if (!s.ws)
+    {
+        cudaStreamCaptureStatus st;
+        cuda_check(cudaStreamIsCapturing(stream, &st));
+        TORCH_CHECK(st == cudaStreamCaptureStatusNone, "exl3_gemm_m16: first call must not be under graph capture");
+        cuda_check(cudaMalloc(&s.ws, EXL3_M16_WS_BYTES));
+        cuda_check(cudaMalloc(&s.counters, EXL3_M16_MAX_GROUPS * sizeof(int)));
+        cuda_check(cudaMemset(s.counters, 0, EXL3_M16_MAX_GROUPS * sizeof(int)));
+        cuda_check(cudaDeviceSynchronize());
+    }
+    return s;
+}
+
+template <int MT, bool c_fp32>
+struct M16Kernel
+{
+    static void* ptr() { return (void*) exl3_gemm_m16_kernel<MT, c_fp32, 2>; }
+    static int smem() { return Exl3M16Cfg<MT>::SMEM; }
+};
+
+struct M16Launch
+{
+    void* kernel;
+    int smem;
+    int blocks_per_sm;
+};
+
+M16Launch get_launch(int MT, bool c_fp32, int device)
+{
+    static M16Launch cache[MAX_DEVICES][2][2] = {};
+    std::lock_guard<std::mutex> lock(g_scratch_mtx);
+    M16Launch& l = cache[device][MT - 1][c_fp32 ? 1 : 0];
+    if (!l.kernel)
+    {
+        void* k; int sm;
+        if (MT == 1) { if (c_fp32) { k = M16Kernel<1, true>::ptr(); sm = M16Kernel<1, true>::smem(); }
+                       else        { k = M16Kernel<1, false>::ptr(); sm = M16Kernel<1, false>::smem(); } }
+        else         { if (c_fp32) { k = M16Kernel<2, true>::ptr(); sm = M16Kernel<2, true>::smem(); }
+                       else        { k = M16Kernel<2, false>::ptr(); sm = M16Kernel<2, false>::smem(); } }
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, sm));
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributePreferredSharedMemoryCarveout, (int) cudaSharedmemCarveoutMaxShared));
+        int occ = 0;
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, k, EXL3_M16_THREADS, sm));
+        TORCH_CHECK(occ >= 1, "exl3_gemm_m16: kernel does not fit on an SM");
+        l.kernel = k;
+        l.smem = sm;
+        l.blocks_per_sm = occ < 2 ? occ : 2;
+    }
+    return l;
+}
+
+int owner(int x, int total, int G)
+{
+    return (int) ((((int64_t) x + 1) * G + total - 1) / total) - 1;
+}
+
+}  // namespace
+
+bool exl3_gemm_m16_enabled()
+{
+    static const bool enabled = []
+    {
+        const char* env = std::getenv("EXL3_GEMM_M16");
+        return !(env && env[0] == '0');
+    }();
+    return enabled;
+}
+
+bool exl3_gemm_m16_supported(int size_m, int size_k, int size_n, int K, bool mcg, bool mul1)
+{
+    return size_m >= 1 && size_m <= 16 && K == 4 && mul1 && !mcg &&
+           size_k >= 128 && size_k % 128 == 0 && size_n >= 128 && size_n % 128 == 0;
+}
+
+void exl3_gemm_m16_gr
+(
+    const at::Tensor& A,
+    const at::Tensor& B0,
+    at::Tensor& C0,
+    const at::Tensor& suh0,
+    at::Tensor& xh0,
+    const at::Tensor& svh0,
+    const c10::optional<at::Tensor>& B1,
+    const c10::optional<at::Tensor>& C1,
+    const c10::optional<at::Tensor>& suh1,
+    const c10::optional<at::Tensor>& xh1,
+    const c10::optional<at::Tensor>& svh1,
+    Graph* graph
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(A.device());
+    cudaStream_t stream = graph ? graph->capture_stream : at::cuda::getCurrentCUDAStream().stream();
+
+    const int num_mats = B1 ? 2 : 1;
+    TORCH_CHECK(!!C1 == (num_mats == 2) && !!suh1 == (num_mats == 2) && !!xh1 == (num_mats == 2) && !!svh1 == (num_mats == 2),
+        "exl3_gemm_m16: second matrix needs B1, C1, suh1, xh1 and svh1 together");
+
+    TORCH_CHECK_DTYPE(A, kHalf);
+    TORCH_CHECK(A.is_contiguous(), "exl3_gemm_m16: A must be contiguous");
+    int size_m = 1;
+    for (int d = 0; d < A.dim() - 1; ++d) size_m *= A.size(d);
+    const int size_k = A.size(-1);
+    const bool c_fp32 = C0.dtype() == at::kFloat;
+    if (!c_fp32) TORCH_CHECK_DTYPE(C0, kHalf);
+
+    const at::Tensor* Bs[2]   = { &B0, B1 ? &B1.value() : nullptr };
+    const at::Tensor* Cs[2]   = { &C0, C1 ? &C1.value() : nullptr };
+    const at::Tensor* suhs[2] = { &suh0, suh1 ? &suh1.value() : nullptr };
+    const at::Tensor* xhs[2]  = { &xh0, xh1 ? &xh1.value() : nullptr };
+    const at::Tensor* svhs[2] = { &svh0, svh1 ? &svh1.value() : nullptr };
+
+    int size_n = B0.size(1) * 16;
+    const int K = B0.size(2) / 16;
+    Exl3M16Args args = {};
+    for (int i = 0; i < num_mats; ++i)
+    {
+        const at::Tensor& B = *Bs[i];
+        TORCH_CHECK_DTYPE(B, kShort);
+        TORCH_CHECK(B.dim() == 3 && B.is_contiguous(), "exl3_gemm_m16: B must be a contiguous 3D trellis");
+        TORCH_CHECK(B.size(0) * 16 == size_k && B.size(1) * 16 == size_n && B.size(2) / 16 == K,
+            "exl3_gemm_m16: matrices must share k, n and K");
+        TORCH_CHECK(Cs[i]->dtype() == C0.dtype() && Cs[i]->is_contiguous() && Cs[i]->numel() == (int64_t) size_m * size_n,
+            "exl3_gemm_m16: C must be contiguous (m, n) of one dtype");
+        TORCH_CHECK_DTYPE(*suhs[i], kHalf);
+        TORCH_CHECK_DTYPE(*svhs[i], kHalf);
+        TORCH_CHECK_DTYPE(*xhs[i], kHalf);
+        TORCH_CHECK(suhs[i]->numel() == size_k && svhs[i]->numel() == size_n, "exl3_gemm_m16: suh/svh size mismatch");
+        TORCH_CHECK(xhs[i]->is_contiguous() && xhs[i]->numel() >= (int64_t) size_m * size_k, "exl3_gemm_m16: xh too small");
+        TORCH_CHECK(xhs[i]->data_ptr() != A.data_ptr(), "exl3_gemm_m16: xh must not alias A");
+        args.B[i] = (const uint16_t*) B.data_ptr();
+        args.suh[i] = (const half*) suhs[i]->data_ptr();
+        args.xh[i] = (half*) xhs[i]->data_ptr();
+        args.svh[i] = (const half*) svhs[i]->data_ptr();
+    }
+    if (num_mats == 2)
+        TORCH_CHECK(xhs[0]->data_ptr() != xhs[1]->data_ptr(), "exl3_gemm_m16: xh buffers must not alias");
+    TORCH_CHECK(exl3_gemm_m16_supported(size_m, size_k, size_n, K, false, true),
+        "exl3_gemm_m16: unsupported shape (m ", size_m, ", k ", size_k, ", n ", size_n, ", K ", K, ")");
+
+    int device;
+    cudaGetDevice(&device);
+    int num_sms = DevCtx::instance().get_num_sms(device);
+    M16Scratch& scratch = get_scratch(device, stream);
+
+    const int MT = size_m <= 8 ? 1 : 2;
+    M16Launch l = get_launch(MT, c_fp32, device);
+    const int G = num_sms * l.blocks_per_sm;
+
+    // Partial slots per group: largest contributor count over all groups
+    const int KT = size_k / 16;
+    const int groups = num_mats * (size_n / 128);
+    const int total = groups * KT;
+    TORCH_CHECK(total >= G, "exl3_gemm_m16: matrix too small for the grid");
+    TORCH_CHECK(groups <= EXL3_M16_MAX_GROUPS, "exl3_gemm_m16: too many output groups");
+    int max_contrib = 1;
+    for (int g = 0; g < groups; ++g)
+    {
+        int nc = owner((g + 1) * KT - 1, total, G) - owner(g * KT, total, G) + 1;
+        if (nc > max_contrib) max_contrib = nc;
+    }
+    TORCH_CHECK((uint64_t) groups * max_contrib * EXL3_M16_SLOT_FLOATS * sizeof(float) <= EXL3_M16_WS_BYTES,
+        "exl3_gemm_m16: workspace too small");
+
+    args.ws = scratch.ws;
+    args.counters = scratch.counters;
+    args.size_m = size_m;
+    args.size_k = size_k;
+    args.size_n = size_n;
+    args.num_mats = num_mats;
+    args.max_contrib = max_contrib;
+
+    const half* A_ptr = (const half*) A.data_ptr();
+    void* C0_ptr = C0.data_ptr();
+    void* C1_ptr = num_mats == 2 ? Cs[1]->data_ptr() : nullptr;
+    void* kernel_args[] = { (void*) &A_ptr, (void*) &C0_ptr, (void*) &C1_ptr, (void*) &args };
+
+    cuda_check(cudaLaunchCooperativeKernel(l.kernel, dim3(G), dim3(EXL3_M16_THREADS), kernel_args, l.smem, stream));
+
+    if (graph)
+    {
+        graph->record_param(l.kernel, GP_gemm_A, 0);
+        graph->record_param(l.kernel, GP_gemm_C, 1);
+        if (num_mats == 2)
+        {
+            graph->record_param(l.kernel, GP_gemm_A, 0);
+            graph->record_param(l.kernel, GP_gemm_C, 2);
+        }
+        graph->record_param(l.kernel, GP_end, 0);
+    }
+    cuda_check(cudaPeekAtLastError());
+}
