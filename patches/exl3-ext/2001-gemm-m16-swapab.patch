+)
+{
+    at::Tensor C0_ = C0;
+    at::Tensor xh0_ = xh0;
+    exl3_gemm_m16_gr(A, B0, C0_, suh0, xh0_, svh0, B1, C1, suh1, xh1, svh1, nullptr);
+}
