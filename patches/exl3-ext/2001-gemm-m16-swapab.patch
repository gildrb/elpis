+#pragma once
+
+#include <ATen/Tensor.h>
+#include "../graph.cuh"
+
+// Swap-AB EXL3 GEMM for 1..16 rows (exl3_gemm_m16_kernel.cuh). Supported: 4 bpw, mul1 codebook,
+// k and n multiples of 128. Callers select it explicitly with exl3_gemm_m16_supported; the launcher
+// raises on anything else.
+
+bool exl3_gemm_m16_enabled();
+
+bool exl3_gemm_m16_supported(int size_m, int size_k, int size_n, int K, bool mcg, bool mul1);
+
+// C_i = had_out(had_in(A * suh_i) @ W_i) * svh_i for one matrix (B1 empty) or two matrices sharing A
+// (gate and up). xh_i receive the input transform (same role as A_had in exl3_gemm_gr). Graph sites:
+// GP_gemm_A (A), GP_gemm_C (C0), and for two matrices GP_gemm_A (A) and GP_gemm_C (C1) again, in the
+// order the separate exl3_gemm_gr calls would record them.
+void exl3_gemm_m16_gr
+(
+    const at::Tensor& A,
+    const at::Tensor& B0,
+    at::Tensor& C0,
+    const at::Tensor& suh0,
+    at::Tensor& xh0,
+    const at::Tensor& svh0,
+    const c10::optional<at::Tensor>& B1,
+    const c10::optional<at::Tensor>& C1,
+    const c10::optional<at::Tensor>& suh1,
+    const c10::optional<at::Tensor>& xh1,
+    const c10::optional<at::Tensor>& svh1,
+    Graph* graph
+);
