+        for (; it < seg_hi; it += 4, ++j)
+        {
+            if (iss_j < nj)
+            {
+                issue_w(iss_g, iss_kt, iss_slot);
+                issue_x(iss_g, iss_kt, iss_slot);
+                iss_kt += 4;
+                if (iss_kt >= KT) { iss_kt -= KT; iss_g++; }
