+
+    // Activation slices of the prologue stages, one group
+    #pragma unroll
+    for (int j = 0; j < PF - 1; ++j)
+    {
+        if (j < nj)
+        {
+            int it = s_b + kp + 4 * j;
+            int g = it / KT;
+            issue_x(g, it - g * KT, j);
+        }
+    }
+    cp_async_fence();
+
+    // Issue cursor at j = PF - 1
+    int iss_j = PF - 1;
+    int iss_g, iss_kt;
+    {
+        int it = s_b + kp + 4 * iss_j;
+        iss_g = it / KT;
+        iss_kt = it - iss_g * KT;
+    }
+    int iss_slot = PF - 1;
+    int cur_slot = 0;
+
+    // ldmatrix row address for this lane: matrix i = (token tile, k-half), row r
+    int ldsm_off;
+    {
+        int i = MT == 1 ? (lane >> 3) & 1 : lane >> 3;
+        int r = lane & 7;
+        ldsm_off = Cfg::W_BYTES + (i & 1) * ROWS * 16 + ((i >> 1) * 8 + r) * 16;
+    }
