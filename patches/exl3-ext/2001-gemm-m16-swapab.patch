+            int r = w - mat * per_mat;
+            had_hf_r_128_inner<true, false>
+            (
+                A + r * 128,
+                (mat ? p.xh[1] : p.xh[0]) + r * 128,
+                (mat ? p.suh[1] : p.suh[0]) + (r * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
