+                }
+            }
+            __syncwarp();
+            cur_slot = cur_slot == PF - 1 ? 0 : cur_slot + 1;
+        }
+
+        // Group boundary: fixed-order block reduction of the four k-phases of each half
+        {
+            constexpr int ACC = Cfg::ACC;
+            float* slot0 = red + (0 * 2 + nh) * ACC * 32;
+            float* slot1 = red + (1 * 2 + nh) * ACC * 32;
+            auto put = [&] (float* s)
+            {
+                #pragma unroll
+                for (int t = 0; t < 4; ++t)
+                    #pragma unroll
+                    for (int mt = 0; mt < MT; ++mt)
+                        #pragma unroll
+                        for (int c = 0; c < 4; ++c)
+                            s[((t * MT + mt) * 4 + c) * 32 + lane] = acc[t][mt][c];
+            };
+            auto add = [&] (const float* s)
+            {
+                #pragma unroll
+                for (int t = 0; t < 4; ++t)
+                    #pragma unroll
+                    for (int mt = 0; mt < MT; ++mt)
+                        #pragma unroll
+                        for (int c = 0; c < 4; ++c)
+                            acc[t][mt][c] += s[((t * MT + mt) * 4 + c) * 32 + lane];
+            };
+
+            if (kp == 2) put(slot0);
+            if (kp == 3) put(slot1);
+            __syncthreads();
+            if (kp == 0) add(slot0);
+            if (kp == 1) add(slot1);
+            __syncthreads();
+            if (kp == 1) put(slot0);
+            __syncthreads();
+            if (kp == 0) add(slot0);
+            __syncthreads();
+
+            // Logical fp32 tile [row][128] in the reduction area. Lane holds output columns
+            // t * 16 + (lane >> 2) (+ 8 for c >= 2), tokens mt * 8 + 2 * (lane & 3) (+ 1 for odd c)
+            float* tile = red;
+            if (kp == 0)
+            {
+                #pragma unroll
+                for (int t = 0; t < 4; ++t)
+                    #pragma unroll
+                    for (int mt = 0; mt < MT; ++mt)
+                        #pragma unroll
+                        for (int c = 0; c < 4; ++c)
+                        {
+                            int row = mt * 8 + 2 * (lane & 3) + (c & 1);
+                            int col = nh * 64 + t * 16 + (lane >> 2) + (c >> 1) * 8;
+                            tile[row * 128 + col] = acc[t][mt][c];
+                        }
+            }
+            #pragma unroll
+            for (int t = 0; t < 4; ++t)
+                #pragma unroll
+                for (int mt = 0; mt < MT; ++mt)
+                    #pragma unroll
+                    for (int c = 0; c < 4; ++c) acc[t][mt][c] = 0.0f;
+            __syncthreads();
+
+            // Contributors of group g: blocks owning its first and last iteration
+            const int b_lo = exl3_m16_owner(g * KT, total, G);
+            const int b_hi = exl3_m16_owner((g + 1) * KT - 1, total, G);
+            const int nc = b_hi - b_lo + 1;
+            bool finish = true;
+
+            if (nc > 1)
+            {
+                float4* dst = (float4*) (p.ws + ((size_t) g * p.max_contrib + (b - b_lo)) * EXL3_M16_SLOT_FLOATS);
+                const float4* src = (const float4*) tile;
+                for (int i = threadIdx.x; i < size_m * 32; i += EXL3_M16_THREADS)
+                    __stcg(dst + i, src[i]);
+                __threadfence();
+                __syncthreads();
+                if (threadIdx.x == 0)
+                {
+                    int old = atomicAdd(p.counters + g, 1);
+                    s_last = old == nc - 1;
+                }
+                __syncthreads();
+                finish = s_last;
+                if (finish)
+                {
+                    __threadfence();
+                    const float4* base = (const float4*) (p.ws + (size_t) g * p.max_contrib * EXL3_M16_SLOT_FLOATS);
+                    float4* t4 = (float4*) tile;
+                    for (int i = threadIdx.x; i < size_m * 32; i += EXL3_M16_THREADS)
+                    {
+                        float4 v = __ldcg(base + i);
+                        for (int c = 1; c < nc; ++c)
+                        {
+                            float4 w = __ldcg(base + c * (EXL3_M16_SLOT_FLOATS / 4) + i);
+                            v.x += w.x; v.y += w.y; v.z += w.z; v.w += w.w;
+                        }
+                        t4[i] = v;
+                    }
+                    if (threadIdx.x == 0) p.counters[g] = 0;
+                    __syncthreads();
+                }
+            }
+
+            if (finish)
+            {
+                const int mat = g >= NG ? 1 : 0;
+                const int col0 = (g - mat * NG) * 128;
+                const half* svh = (mat ? p.svh[1] : p.svh[0]) + col0;
+                void* C = mat ? C1 : C0;
+                for (int r = warp; r < size_m; r += EXL3_M16_WARPS)
+                {
+                    if constexpr (c_fp32)
+                        had_ff_r_128_inner<false, true>
+                        (
+                            tile + r * 128,
+                            ((float*) C) + (size_t) r * size_n + col0,
+                            svh,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                    else
+                        had_fh_r_128_inner<false, true>
+                        (
+                            tile + r * 128,
+                            ((half*) C) + (size_t) r * size_n + col0,
+                            svh,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                }
+            }
+            __syncthreads();
+        }
+    }
+
+    cp_async_wait<0>();
