+++ b/exllamav3_ext/quant/exl3_gemm_m16_kernel.cuh
@@ -0,0 +1,412 @@
+#pragma once
+
+// EXL3 trellis GEMM for 1..16 token rows, swap-AB (exl3_gemm_m16.cu has the host side).
+//
+// - The weight tile is the m16 x k16 A operand of mma.m16n8k16, decoded straight into registers:
+//   dq8_aligned_4bits yields the two k16 x n8 B fragments (f0 = tile cols 0-7, f1 = cols 8-15) of
+//   the regular kernels, and {f0[0], f1[0], f0[1], f1[1]} is exactly the row-major A fragment of
+//   the transposed tile. The activations (input-Hadamard domain) are the k16 x n8 B operand, one n8
+//   token tile for m <= 8 (MT = 1), two for m <= 16 (MT = 2). No padded MMA rows.
+// - fp16 MMA accumulation (full-rate tensor path on GA10x), folded into fp32 every FOLD k-tiles
+//   and at every group boundary.
+// - Work partition: block iterations are (group, k-tile) with group = (matrix, 512 output
+//   columns), in group-major order; block b owns the contiguous range [b * I / G, (b + 1) * I / G).
+//   All 8 warps of a block walk the same k-tiles; warp w owns columns w * 64 .. + 63 of the group
+//   (4 n-tiles, 512 contiguous bytes), so a block streams 4 KB contiguous per k-tile row and no
+//   in-block reduction exists.
+// - Weights stream through a warp-private cp.async ring of PF stages; the first PF - 1 stages are
+//   issued before the input Hadamard phase and its grid.sync. Activations for XR k-tiles at a time
+//   are staged once per block in a double buffer (one block barrier per XR k-tiles).
+// - Deterministic split-K: at a group boundary each warp writes its fp32 partial to the fixed slot
+//   (group, block - first contributing block). After a grid.sync every group row is finished by
+//   one warp: slots summed in slot order, then output Hadamard with svh post-scaling
+//   (had_fh_r_128_inner for fp16 C, had_ff_r_128_inner for fp32 C). Summation order depends only
+//   on the grid size.
+// - DBG (benchmark-only instances): 1 = weight streaming only (no decode/MMA), 2 = decode/MMA only
+//   (no weight loads in the main loop). Outputs are meaningless in DBG modes.
+// - Optional per-block phase timestamps when p.prof is set (EXL3_M16_PROF_WORDS words per block).
+
+#include <cooperative_groups.h>
+#include "../ptx.cuh"
+#include "exl3_dq.cuh"
+#include "hadamard_inner.cuh"
+
+#define EXL3_M16_THREADS 256
+#define EXL3_M16_WARPS 8
+#define EXL3_M16_TILES_W 4
+#define EXL3_M16_GW (EXL3_M16_WARPS * EXL3_M16_TILES_W * 16)
+#define EXL3_M16_MAX_MATS 2
+#define EXL3_M16_SLOT_FLOATS (16 * EXL3_M16_GW)
+#define EXL3_M16_PROF_WORDS 16
+
+struct Exl3M16Args
+{
+    const uint16_t* B[EXL3_M16_MAX_MATS];
+    const half* suh[EXL3_M16_MAX_MATS];
+    half* xh[EXL3_M16_MAX_MATS];
+    const half* svh[EXL3_M16_MAX_MATS];
+    float* ws;
+    unsigned long long* prof;
+    int size_m;
+    int size_k;
+    int size_n;
+    int num_mats;
+    int max_contrib;
+};
+
+template <int MT>
+struct Exl3M16Cfg
+{
+    static constexpr int PF = 8;                                // weight ring stages per warp
+    static constexpr int FOLD = 4;                              // fp16 -> fp32 fold cadence (k-tiles)
+    static constexpr int XR = 16;                               // k-tiles per activation chunk
+    static constexpr int W_STAGE = EXL3_M16_TILES_W * 128;      // 4 bpw tiles, 128 B each
+    static constexpr int X_ITER = MT * 256;                     // 2 k-halves x MT*8 rows x 16 B
+    static constexpr int RING = EXL3_M16_WARPS * PF * W_STAGE;
+    static constexpr int XBUF = 2 * XR * X_ITER;
+    static constexpr int SMEM = RING + XBUF;
+    static_assert(XR % PF == 0 && PF % FOLD == 0, "cadences must nest");
+};
+
+// Block owning iteration x, for the partition start(b) = floor(b * total / G)
+__device__ __forceinline__ int exl3_m16_owner(int x, int total, int G)
+{
+    return (int) ((((int64_t) x + 1) * G + total - 1) / total) - 1;
+}
+
+__device__ __forceinline__ unsigned long long exl3_m16_gtime()
+{
+    unsigned long long t;
+    asm volatile ("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+template <int MT, bool c_fp32, int cb, int DBG>
+__global__ __launch_bounds__(EXL3_M16_THREADS, 2)
+void exl3_gemm_m16_kernel(const half* __restrict__ A, void* C0, void* C1, Exl3M16Args p)
+{
+    using Cfg = Exl3M16Cfg<MT>;
+    constexpr int PF = Cfg::PF;
+    constexpr int XR = Cfg::XR;
+    constexpr int W_STAGE = Cfg::W_STAGE;
+    constexpr int X_ITER = Cfg::X_ITER;
+    constexpr int ROWS = MT * 8;
+    constexpr int GW = EXL3_M16_GW;
+
+    extern __shared__ __align__(16) uint8_t sm[];
+
+    const bool prof = p.prof != nullptr;
+    unsigned int flush_clk = 0, bar_clk = 0;
+    auto stamp = [&] (int i)
+    {
+        if (prof && threadIdx.x == 0)
+        {
+            unsigned long long* o = p.prof + (size_t) blockIdx.x * EXL3_M16_PROF_WORDS;
+            o[i] = exl3_m16_gtime();
+            o[6 + i] = clock64();
+        }
+    };
+    stamp(0);
+
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+
+    const int size_m = p.size_m;
+    const int size_k = p.size_k;
+    const int size_n = p.size_n;
+    const int KT = size_k >> 4;
+    const int NT = size_n >> 4;
+    const int NG = size_n / GW;
+    const int groups = p.num_mats * NG;
+    const int total = groups * KT;
+    const int G = gridDim.x;
+    const int b = blockIdx.x;
+    const int s_b = (int) (((int64_t) b * total) / G);
+    const int e_b = (int) (((int64_t) (b + 1) * total) / G);
+    const int n_iter = e_b - s_b;
+
+    uint8_t* ring = sm + warp * PF * W_STAGE;
+    uint8_t* xbuf = sm + Cfg::RING;
+
+    // Weight issue cursor (block-relative iteration iss_j), this lane's 16 bytes
+    const size_t row_bytes = (size_t) NT * 128;
+    auto w_src = [&] (int g) -> const uint8_t*
+    {
+        int mat = g >= NG ? 1 : 0;
+        int ng = g - mat * NG;
+        const uint16_t* B = mat ? p.B[1] : p.B[0];
+        return (const uint8_t*) (B + ((size_t) ng * (GW / 16) + warp * EXL3_M16_TILES_W) * 64) + lane * 16;
+    };
+    int iss_j = 0;
+    int iss_g = s_b / KT;
+    int iss_kt = s_b - iss_g * KT;
+    const uint8_t* iss_ptr = w_src(iss_g) + (size_t) iss_kt * row_bytes;
+    auto issue_w = [&] (int slot)
+    {
+        cp_async_stream(ring + slot * W_STAGE + lane * 16, iss_ptr);
+        iss_j++;
+        if (++iss_kt == KT)
+        {
+            iss_kt = 0;
+            iss_g++;
+            if (iss_j < n_iter) iss_ptr = w_src(iss_g);
+        }
+        else iss_ptr += row_bytes;
+    };
+
+    // Activation chunk c = block-relative iterations [c * XR, c * XR + XR), one 16 B piece per
+    // (iteration, k-half, row); rows past size_m replicate the last row (results discarded)
+    auto issue_x_chunk = [&] (int c)
+    {
+        uint8_t* dst = xbuf + (c & 1) * XR * X_ITER;
+        for (int q = threadIdx.x; q < XR * 2 * ROWS; q += EXL3_M16_THREADS)
+        {
+            int jj = q / (2 * ROWS);
+            int r = q - jj * (2 * ROWS);
+            int j = c * XR + jj;
+            if (j < n_iter)
+            {
+                int it = s_b + j;
+                int g = it / KT;
+                int kt = it - g * KT;
+                const half* xh = g >= NG ? p.xh[1] : p.xh[0];
+                int row = min(r % ROWS, size_m - 1);
+                int kh = r / ROWS;
+                cp_async(dst + jj * X_ITER + r * 16, xh + (size_t) row * size_k + kt * 16 + kh * 8);
+            }
+        }
+    };
+
+    // Prologue: first PF - 1 weight stages (independent of the input transform)
+    #pragma unroll
+    for (int d = 0; d < PF - 1; ++d)
+    {
+        if (iss_j < n_iter) issue_w(d);
+        cp_async_fence();
+    }
+
+    // Input scales and Hadamard transform, one warp per 128 elements (same call as exl3_gemm_kernel)
+    auto grid = cooperative_groups::this_grid();
+    {
+        int per_mat = size_m * size_k / 128;
+        int total_warps = p.num_mats * per_mat;
+        int warps_grid = gridDim.x * EXL3_M16_WARPS;
+        for (int w = warp + EXL3_M16_WARPS * blockIdx.x; w < total_warps; w += warps_grid)
+        {
+            int mat = w >= per_mat ? 1 : 0;
+            int r = w - mat * per_mat;
+            had_hf_r_128_inner<true, false>
+            (
+                A + r * 128,
+                (mat ? p.xh[1] : p.xh[0]) + r * 128,
+                (mat ? p.suh[1] : p.suh[0]) + (r * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
+            );
+        }
+        grid.sync();
+    }
+    stamp(1);
+
+    issue_x_chunk(0);
+    cp_async_fence();
+    cp_async_wait<0>();
+    __syncthreads();
+    stamp(2);
+
+    // ldmatrix row address: matrix i = (token tile, k-half), row lane % 8
+    int ldsm_off;
+    {
+        int i = MT == 1 ? (lane >> 3) & 1 : lane >> 3;
+        ldsm_off = ((i & 1) * ROWS + (i >> 1) * 8 + (lane & 7)) * 16;
+    }
+    const uint32_t xbuf_sa = static_cast<uint32_t>(__cvta_generic_to_shared(xbuf)) + ldsm_off;
+
+    FragC_h hacc[EXL3_M16_TILES_W][MT];
+    FragC acc[EXL3_M16_TILES_W][MT];
+    const half2 hzero = __half2half2(__ushort_as_half(0));
+    #pragma unroll
+    for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        {
+            hacc[t][mt][0] = hzero;
+            hacc[t][mt][1] = hzero;
+            #pragma unroll
+            for (int c = 0; c < 4; ++c) acc[t][mt][c] = 0.0f;
+        }
+
+    auto fold = [&] ()
+    {
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+            {
+                acc[t][mt][0] += __low2float(hacc[t][mt][0]);
+                acc[t][mt][1] += __high2float(hacc[t][mt][0]);
+                acc[t][mt][2] += __low2float(hacc[t][mt][1]);
+                acc[t][mt][3] += __high2float(hacc[t][mt][1]);
+                hacc[t][mt][0] = hzero;
+                hacc[t][mt][1] = hzero;
+            }
+    };
+
+    // Partial of group g: lane holds output columns t * 16 + (lane >> 2) (+ 8 for c >= 2) of this
+    // warp's 64, tokens mt * 8 + 2 * (lane & 3) (+ 1 for odd c)
+    auto flush = [&] (int g)
+    {
+        int cidx = b - exl3_m16_owner(g * KT, total, G);
+        float* slot = p.ws + ((size_t) g * p.max_contrib + cidx) * EXL3_M16_SLOT_FLOATS + warp * 64 + (lane >> 2);
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+                #pragma unroll
+                for (int c = 0; c < 4; ++c)
+                {
+                    int row = mt * 8 + 2 * (lane & 3) + (c & 1);
+                    if (row < size_m) __stcg(slot + row * GW + t * 16 + (c >> 1) * 8, acc[t][mt][c]);
+                    acc[t][mt][c] = 0.0f;
+                }
+    };
+
+    // Main loop, rolled (one copy of the body keeps the hot loop inside the instruction cache):
+    // one segment per group touched by this block, one k-tile per iteration, runtime ring slots
+    int cur_slot = 0;
+    int iss_slot = PF - 1;
+    int j = 0;
+    for (int g_cur = s_b / KT; j < n_iter; ++g_cur)
+    {
+        const int seg_end = min(e_b, (g_cur + 1) * KT) - s_b;
+
+        #pragma unroll 1
+        for (; j < seg_end; ++j)
+        {
+            if ((j & (XR - 1)) == 0)
+            {
+                if (j > 0)
+                {
+                    unsigned int c0 = prof ? (unsigned int) clock() : 0u;
+                    __syncthreads();
+                    if (prof) bar_clk += (unsigned int) clock() - c0;
+                }
+                issue_x_chunk(j / XR + 1);
+            }
+            if constexpr (DBG != 2)
+                if (iss_j < n_iter) issue_w(iss_slot);
+            iss_slot = iss_slot == PF - 1 ? 0 : iss_slot + 1;
+            cp_async_fence();
+            cp_async_wait<PF - 1>();
+            __syncwarp();
+
+            if constexpr (DBG != 1)
+            {
+                const uint8_t* st = ring + cur_slot * W_STAGE;
+                uint32_t bx[MT][2];
+                {
+                    uint32_t sa = xbuf_sa + (((j / XR) & 1) * XR + (j & (XR - 1))) * X_ITER;
+                    if constexpr (MT == 2)
+                        asm volatile ("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                            : "=r"(bx[0][0]), "=r"(bx[0][1]), "=r"(bx[1][0]), "=r"(bx[1][1]) : "r"(sa));
+                    else
+                        asm volatile ("ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%0,%1}, [%2];\n"
+                            : "=r"(bx[0][0]), "=r"(bx[0][1]) : "r"(sa));
+                }
+
+                #pragma unroll
+                for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+                {
+                    FragB f0, f1;
+                    dq8_aligned_4bits<cb>((const uint32_t*) (st + t * 128), lane * 8, f0, f1);
+                    FragA a;
+                    a[0] = f0[0];
+                    a[1] = f1[0];
+                    a[2] = f0[1];
+                    a[3] = f1[1];
+                    #pragma unroll
+                    for (int mt = 0; mt < MT; ++mt)
+                    {
+                        FragB bb;
+                        bb[0] = *reinterpret_cast<half2*>(&bx[mt][0]);
+                        bb[1] = *reinterpret_cast<half2*>(&bx[mt][1]);
+                        ptx_mma_m16n8k16(a, bb, hacc[t][mt]);
+                    }
+                }
+            }
+            __syncwarp();
+            cur_slot = cur_slot == PF - 1 ? 0 : cur_slot + 1;
+
+            if ((j & (Cfg::FOLD - 1)) == Cfg::FOLD - 1) fold();
+        }
+
+        unsigned int c0 = prof ? (unsigned int) clock() : 0u;
+        fold();
+        flush(g_cur);
+        if (prof) flush_clk += (unsigned int) clock() - c0;
+    }
+    cp_async_wait<0>();
+    stamp(3);
+
+    grid.sync();
+    stamp(4);
+
+    // Finish: one warp per (group, row, 128 columns); slots summed in slot order, then the output
+    // Hadamard reads the sum back from slot 0 (same lane wrote it)
+    {
+        constexpr int CH = GW / 128;
+        const int jobs = groups * size_m * CH;
+        for (int w = warp + EXL3_M16_WARPS * b; w < jobs; w += EXL3_M16_WARPS * G)
+        {
+            int g = w / (size_m * CH);
+            int rem = w - g * size_m * CH;
+            int r = rem / CH;
+            int ch = rem - r * CH;
+            int nc = exl3_m16_owner((g + 1) * KT - 1, total, G) - exl3_m16_owner(g * KT, total, G) + 1;
+            float* s0 = p.ws + (size_t) g * p.max_contrib * EXL3_M16_SLOT_FLOATS + r * GW + ch * 128;
+            float4 v = __ldcg(((const float4*) s0) + lane);
+            for (int c = 1; c < nc; ++c)
+            {
+                float4 u = __ldcg(((const float4*) (s0 + (size_t) c * EXL3_M16_SLOT_FLOATS)) + lane);
+                v.x += u.x; v.y += u.y; v.z += u.z; v.w += u.w;
+            }
+            ((float4*) s0)[lane] = v;
+            __syncwarp();
+
+            const int mat = g >= NG ? 1 : 0;
+            const int col0 = (g - mat * NG) * GW + ch * 128;
+            const half* svh = (mat ? p.svh[1] : p.svh[0]) + col0;
+            void* C = mat ? C1 : C0;
+            if constexpr (c_fp32)
+                had_ff_r_128_inner<false, true>
+                (
+                    s0,
+                    ((float*) C) + (size_t) r * size_n + col0,
+                    svh,
+                    0.088388347648f  // 1/sqrt(128)
+                );
+            else
+                had_fh_r_128_inner<false, true>
+                (
+                    s0,
+                    ((half*) C) + (size_t) r * size_n + col0,
+                    svh,
+                    0.088388347648f  // 1/sqrt(128)
+                );
+        }
+    }
+
+    stamp(5);
+    if (prof)
+    {
+        if (threadIdx.x == 0)
+        {
+            unsigned long long* o = p.prof + (size_t) b * EXL3_M16_PROF_WORDS;
+            o[12] = flush_clk;
+            o[13] = bar_clk;
+            o[14] = (unsigned long long) n_iter;
+            unsigned int smid;
+            asm volatile ("mov.u32 %0, %%smid;" : "=r"(smid));
+            o[15] = smid;
+        }
+    }
