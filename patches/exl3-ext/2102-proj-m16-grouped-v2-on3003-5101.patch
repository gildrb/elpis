+#pragma once
+
+#include <ATen/Tensor.h>
+#include <vector>
+#include "../graph.cuh"
+
+// Grouped swap-AB EXL3 GEMM for 1..16 rows (exl3_gemm_m16g_kernel.cuh): 1..4 matrices of equal k
+// and widths that are multiples of 512, sharing the input A, in one cooperative launch with 2001's
+// core loop and finish. Same numerics class as exl3_gemm_m16 (2001): fp16 MMA accumulation folded
+// into fp32, deterministic split-K whose split points depend on the launch's total work and grid
+// (not bitwise equal to 2001 or to per-matrix launches; run-to-run deterministic).
+
+// Projection bundles with a measured routing table (exl3_gemm_m16g.cu, filled from bench_proj.py
+// on the target model): a call site leaves its old path only when its (k, widths, m) matches a
+// row. out_proj / o_proj have no site: a single matrix is 2001's own launch
+enum Exl3M16GSite
+{
+    M16G_GDN_QKVZ = 0,   // GatedDeltaNet in_proj_qkv + in_proj_z
+    M16G_ATTN_QKV = 1,   // attention q_proj + k_proj + v_proj
+    M16G_NUM_SITES
+};
+
+enum Exl3M16GPath
+{
