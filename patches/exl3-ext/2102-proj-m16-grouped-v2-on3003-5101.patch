+    FragC acc[EXL3_M16_TILES_W][MT];
+    const half2 hzero = __half2half2(__ushort_as_half(0));
+    #pragma unroll
+    for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+        #pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+        {
+            hacc[t][mt][0] = hzero;
+            hacc[t][mt][1] = hzero;
+            #pragma unroll
+            for (int c = 0; c < 4; ++c) acc[t][mt][c] = 0.0f;
+        }
+
+    auto fold = [&] ()
+    {
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+            {
+                acc[t][mt][0] += __low2float(hacc[t][mt][0]);
+                acc[t][mt][1] += __high2float(hacc[t][mt][0]);
+                acc[t][mt][2] += __low2float(hacc[t][mt][1]);
+                acc[t][mt][3] += __high2float(hacc[t][mt][1]);
+                hacc[t][mt][0] = hzero;
+                hacc[t][mt][1] = hzero;
+            }
+    };
+
+    // Partial of group g: lane holds output columns t * 16 + (lane >> 2) (+ 8 for c >= 2) of this
+    // warp's 64, tokens mt * 8 + 2 * (lane & 3) (+ 1 for odd c)
+    auto flush = [&] (int g)
+    {
+        int cidx = b - exl3_m16_owner(g * KT, total, G);
+        float* slot = p.ws + ((size_t) g * p.max_contrib + cidx) * EXL3_M16_SLOT_FLOATS + warp * 64 + (lane >> 2);
+        #pragma unroll
+        for (int t = 0; t < EXL3_M16_TILES_W; ++t)
+            #pragma unroll
+            for (int mt = 0; mt < MT; ++mt)
+                #pragma unroll
+                for (int c = 0; c < 4; ++c)
+                {
+                    int row = mt * 8 + 2 * (lane & 3) + (c & 1);
+                    if (row < size_m) __stcg(slot + row * GW + t * 16 + (c >> 1) * 8, acc[t][mt][c]);
+                    acc[t][mt][c] = 0.0f;
+                }
+    };
+
+    // Main loop, rolled (2001's body): one segment per group touched by this block, one k-tile per
+    // iteration, runtime ring slots
+    int cur_slot = 0;
+    int iss_slot = PF - 1;
+    int j = 0;
+    for (int g_cur = s_b / KT; j < n_iter; ++g_cur)
+    {
+        const int seg_end = min(e_b, (g_cur + 1) * KT) - s_b;
+
+        #pragma unroll 1
+        for (; j < seg_end; ++j)
+        {
+            if ((j & (XR - 1)) == 0)
+            {
+                if (j > 0) __syncthreads();
+                issue_x_chunk(j / XR + 1);
+            }
+            if (iss_j < n_iter) issue_w(iss_slot);
+            iss_slot = iss_slot == PF - 1 ? 0 : iss_slot + 1;
+            cp_async_fence();
+            cp_async_wait<PF - 1>();
+            __syncwarp();
+
+            {
+                const uint8_t* st = ring + cur_slot * W_STAGE;
+                uint32_t bx[MT][2];
+                {
+                    uint32_t sa = xbuf_sa + (((j / XR) & 1) * XR + (j & (XR - 1))) * X_ITER;
+                    if constexpr (MT == 2)
+                        asm volatile ("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
