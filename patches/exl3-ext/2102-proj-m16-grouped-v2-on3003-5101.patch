+#pragma once
+
+// Grouped swap-AB EXL3 GEMM for 1..16 token rows (exl3_gemm_m16g.cu has the host side). Up to
+// EXL3_M16G_MAX_MATS matrices of equal k and arbitrary widths (multiples of EXL3_M16_GW) share one
+// input and run as one cooperative persistent launch. Everything but the column map is
+// exl3_gemm_m16_kernel's (2001 v2; its constants, configuration and owner helper are reused):
+// - Column map: matrix i owns groups [gbase[i], gbase[i + 1]) of the launch's group sequence
+//   (prefix sum of n_i / GW); weight/output row strides, pointers, suh/svh and the input-transform
+//   scratch come from that lookup.
+// - Work partition: block iterations are (group, k-tile) in group-major order over all matrices;
+//   block b owns [b * total / G, (b + 1) * total / G), total = groups * KT.
+// - Prologue: the first PF - 1 weight stages, then the input scales and 128-point Hadamard of
+//   every matrix into its xh scratch (one warp per 128 elements, spread over the grid), grid.sync.
+// - fp16 MMA accumulation folded into fp32 every FOLD k-tiles and at every group boundary; the
+//   partial of group g goes to slot (g, block - first contributing block).
+// - grid.sync, then every warp of the grid finishes (group, row, 128 columns) jobs: slots summed in
+//   slot order, output Hadamard with svh post-scaling. Summation order depends only on the shapes
+//   and the grid size (deterministic).
+// bend/gemm_m16_group.bend models this map (iteration ownership, slot injectivity across
+// matrices, finish order).
+
+#include <cooperative_groups.h>
+#include "exl3_gemm_m16_kernel.cuh"
+
+#define EXL3_M16G_MAX_MATS 4
+
+struct Exl3M16GArgs
+{
+    const uint16_t* B[EXL3_M16G_MAX_MATS];
+    const half* suh[EXL3_M16G_MAX_MATS];
+    const half* svh[EXL3_M16G_MAX_MATS];
+    half* xh[EXL3_M16G_MAX_MATS];         // input-transform scratch, size_m x size_k each
+    void* C[EXL3_M16G_MAX_MATS];          // C[0] unused: matrix 0's output is the patchable kernel arg
+    int gbase[EXL3_M16G_MAX_MATS + 1];    // group prefix sums, gbase[num_mats..] = groups
+    float* ws;
+    int size_m;
+    int size_k;
+    int num_mats;
+    int max_contrib;
+};
+
+// Kernel-parameter arrays indexed through unrolled selects (constant-bank loads, no local copy)
+template <typename T>
+__device__ __forceinline__ T exl3_m16g_sel(const T (&a)[EXL3_M16G_MAX_MATS], int i)
+{
+    T r = a[0];
+    #pragma unroll
+    for (int k = 1; k < EXL3_M16G_MAX_MATS; ++k)
+        if (i == k) r = a[k];
+    return r;
+}
+
+__device__ __forceinline__ int exl3_m16g_gbase(const Exl3M16GArgs& p, int i)
+{
+    int r = p.gbase[0];
+    #pragma unroll
+    for (int k = 1; k <= EXL3_M16G_MAX_MATS; ++k)
+        if (i == k) r = p.gbase[k];
+    return r;
+}
+
+// Matrix owning group g: the last i with gbase[i] <= g (gbase[i] = groups for i >= num_mats)
+__device__ __forceinline__ int exl3_m16g_mat(const Exl3M16GArgs& p, int g)
+{
+    int mat = 0;
+    #pragma unroll
+    for (int i = 1; i < EXL3_M16G_MAX_MATS; ++i)
+        if (g >= p.gbase[i]) mat = i;
+    return mat;
+}
+
+template <int MT, bool c_fp32, int cb>
+__global__ __launch_bounds__(EXL3_M16_THREADS, 2)
+void exl3_gemm_m16g_kernel(const half* __restrict__ A, void* C0, Exl3M16GArgs p)
+{
+    using Cfg = Exl3M16Cfg<MT>;
+    constexpr int PF = Cfg::PF;
+    constexpr int XR = Cfg::XR;
+    constexpr int W_STAGE = Cfg::W_STAGE;
+    constexpr int X_ITER = Cfg::X_ITER;
+    constexpr int ROWS = MT * 8;
+    constexpr int GW = EXL3_M16_GW;
+
+    extern __shared__ __align__(16) uint8_t sm[];
+
+    // warp / lane (and below ring + lane * 16, xbuf_sa) through opaque moves: without them ptxas
+    // rematerializes the ring base and lane offsets from threadIdx inside the k-tile loop (238 vs
+    // 2001's 226 instructions per steady-state k-tile at MT 1; 228 with the pins)
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    asm volatile ("" : "+r"(warp), "+r"(lane));
+
+    const int size_m = p.size_m;
+    const int size_k = p.size_k;
+    const int KT = size_k >> 4;
+    const int groups = exl3_m16g_gbase(p, EXL3_M16G_MAX_MATS);
+    const int total = groups * KT;
+    const int G = gridDim.x;
+    const int b = blockIdx.x;
+    const int s_b = (int) (((int64_t) b * total) / G);
+    const int e_b = (int) (((int64_t) (b + 1) * total) / G);
+    const int n_iter = e_b - s_b;
+
+    uint8_t* ring = sm + warp * PF * W_STAGE;
+    uint8_t* xbuf = sm + Cfg::RING;
+
+    // Weight issue cursor (block-relative iteration iss_j), this lane's 16 bytes. Row stride is
+    // the owning matrix's width: n / 16 tiles of 128 bytes
+    size_t row_bytes = 0;
+    auto w_src = [&] (int g) -> const uint8_t*
+    {
+        int mat = exl3_m16g_mat(p, g);
+        int gb = exl3_m16g_gbase(p, mat);
+        row_bytes = (size_t) (exl3_m16g_gbase(p, mat + 1) - gb) * (GW / 16) * 128;
+        return (const uint8_t*) (exl3_m16g_sel(p.B, mat) + ((size_t) (g - gb) * (GW / 16) + warp * EXL3_M16_TILES_W) * 64) + lane * 16;
+    };
+    int iss_j = 0;
+    int iss_g = s_b / KT;
+    int iss_kt = s_b - iss_g * KT;
+    const uint8_t* iss_ptr = w_src(iss_g);
+    iss_ptr += (size_t) iss_kt * row_bytes;
+    uint8_t* ring_lane = ring + lane * 16;
+    asm volatile ("" : "+l"(ring_lane));
+    auto issue_w = [&] (int slot)
+    {
+        cp_async_stream(ring_lane + slot * W_STAGE, iss_ptr);
+        iss_j++;
+        if (++iss_kt == KT)
+        {
+            iss_kt = 0;
+            iss_g++;
+            if (iss_j < n_iter) iss_ptr = w_src(iss_g);
+        }
+        else iss_ptr += row_bytes;
+    };
+
+    // Activation chunk c = block-relative iterations [c * XR, c * XR + XR), one 16 B piece per
+    // (iteration, k-half, row) of the owning matrix's xh; rows past size_m replicate the last row
+    // (results discarded)
+    auto issue_x_chunk = [&] (int c)
+    {
+        uint8_t* dst = xbuf + (c & 1) * XR * X_ITER;
+        for (int q = threadIdx.x; q < XR * 2 * ROWS; q += EXL3_M16_THREADS)
+        {
+            int jj = q / (2 * ROWS);
+            int r = q - jj * (2 * ROWS);
+            int j = c * XR + jj;
+            if (j < n_iter)
+            {
+                int it = s_b + j;
+                int g = it / KT;
+                int kt = it - g * KT;
+                const half* xh = exl3_m16g_sel(p.xh, exl3_m16g_mat(p, g));
+                int row = min(r % ROWS, size_m - 1);
+                int kh = r / ROWS;
+                cp_async(dst + jj * X_ITER + r * 16, xh + (size_t) row * size_k + kt * 16 + kh * 8);
+            }
+        }
+    };
+
+    // Prologue: first PF - 1 weight stages (independent of the input transform)
+    #pragma unroll
+    for (int d = 0; d < PF - 1; ++d)
+    {
+        if (iss_j < n_iter) issue_w(d);
+        cp_async_fence();
+    }
+
+    // Input scales and Hadamard transform of every matrix, one warp per 128 elements (same call as
+    // exl3_gemm_kernel and 2001)
+    auto grid = cooperative_groups::this_grid();
+    {
+        const int per_mat = size_m * size_k / 128;
+        const int total_warps = p.num_mats * per_mat;
+        const int warps_grid = G * EXL3_M16_WARPS;
+        for (int w = warp + EXL3_M16_WARPS * b; w < total_warps; w += warps_grid)
+        {
+            const int mat = w / per_mat;
+            const int r = w - mat * per_mat;
+            had_hf_r_128_inner<true, false>
+            (
+                A + r * 128,
+                exl3_m16g_sel(p.xh, mat) + r * 128,
+                exl3_m16g_sel(p.suh, mat) + (r * 128) % size_k,
