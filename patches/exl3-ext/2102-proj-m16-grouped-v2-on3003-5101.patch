+                    FragA a;
+                    a[0] = f0[0];
+                    a[1] = f1[0];
+                    a[2] = f0[1];
+                    a[3] = f1[1];
+                    #pragma unroll
+                    for (int mt = 0; mt < MT; ++mt)
+                    {
