+#include <torch/library.h>
+#include <ATen/Tensor.h>
+#include "exl3_gemm_m16g.cuh"
+
+// Eager entry points for isolated A/B and benchmarking (bench_proj.py), added to 2001's exl3_m16
+// op namespace so bindings.cpp stays untouched. Same launcher as the routed call sites, no graph.
+//   torch.ops.exl3_m16.gemm_grouped(A, B[], C[], suh[], svh[])
+//   torch.ops.exl3_m16.gemm_grouped_route(site, m, k, ns[]) -> int (the call sites' Exl3M16GPath:
+//   0 old, 1 grouped, 2 2001 singles; site 0 GDN qkv+z, 1 attention q+k+v)
+
+static void exl3_gemm_m16g_op
+(
+    const at::Tensor& A,
+    at::TensorList B,
+    at::TensorList C,
+    at::TensorList suh,
+    at::TensorList svh
+)
+{
+    exl3_gemm_m16g_gr(A, B.vec(), C.vec(), suh.vec(), svh.vec(), nullptr, GP_gemm_A);
+}
+
+static int64_t exl3_gemm_m16g_route_op(int64_t site, int64_t m, int64_t k, std::vector<int64_t> ns)
+{
+    std::vector<int> n(ns.begin(), ns.end());
+    return exl3_gemm_m16g_route((int) site, (int) m, (int) k, n, 4, false, true);
+}
+
+TORCH_LIBRARY_FRAGMENT(exl3_m16, m)
+{
+    m.def("gemm_grouped", &exl3_gemm_m16g_op);
+    m.def("gemm_grouped_route", &exl3_gemm_m16g_route_op);
+}
