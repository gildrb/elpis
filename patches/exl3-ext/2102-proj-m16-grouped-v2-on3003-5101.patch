+#include <cuda_fp16.h>
+#include "exl3_gemm_m16g.cuh"
+
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_gemm_m16g_kernel.cuh"
+#include "exl3_gemm_m16.cuh"
+#include "exl3_devctx.cuh"
+#include <cstdlib>
+#include <mutex>
+
+// Fixed-size per-device scratch, allocated on the first (eager) call and never resized: captured
+// graphs keep the pointer. EXL3_M16G_SLOT_BYTES of split-K partial slots (32 KB each; the routed
+// shapes need groups x max_contrib = 32 x 6 = 6.0 MB for qkv+z, 28 x 7 = 6.1 MB for q+k+v at the
+// 164-block grid), then one size_m x size_k fp16 input-transform buffer per matrix. The route
+// predicate rejects anything that does not fit
+#define EXL3_M16G_SLOT_BYTES (8ull * 1024 * 1024)
+#define EXL3_M16G_XH_BYTES (1ull * 1024 * 1024)
+#define EXL3_M16G_ALLOC_BYTES (EXL3_M16G_SLOT_BYTES + EXL3_M16G_XH_BYTES)
+
+namespace {
+
+float* g_ws[MAX_DEVICES] = {};
+std::mutex g_mtx;
+
+float* get_ws(int device, cudaStream_t stream)
+{
+    std::lock_guard<std::mutex> lock(g_mtx);
+    if (!g_ws[device])
+    {
+        cudaStreamCaptureStatus st;
+        cuda_check(cudaStreamIsCapturing(stream, &st));
+        TORCH_CHECK(st == cudaStreamCaptureStatusNone, "exl3_gemm_m16g: first call must not be under graph capture");
+        cuda_check(cudaMalloc(&g_ws[device], EXL3_M16G_ALLOC_BYTES));
+    }
+    return g_ws[device];
+}
+
+struct M16GLaunch
+{
+    void* kernel;
+    int smem;
+    int blocks_per_sm;
+};
+
+template <int MT, bool c_fp32>
+void* kernel_ptr() { return (void*) exl3_gemm_m16g_kernel<MT, c_fp32, 2>; }
+
+M16GLaunch get_launch(int MT, bool c_fp32, int device)
+{
+    static M16GLaunch cache[MAX_DEVICES][2][2] = {};
+    std::lock_guard<std::mutex> lock(g_mtx);
+    M16GLaunch& l = cache[device][MT - 1][c_fp32 ? 1 : 0];
+    if (!l.kernel)
+    {
+        void* k = MT == 1 ? (c_fp32 ? kernel_ptr<1, true>() : kernel_ptr<1, false>())
+                          : (c_fp32 ? kernel_ptr<2, true>() : kernel_ptr<2, false>());
+        int sm = MT == 1 ? Exl3M16Cfg<1>::SMEM : Exl3M16Cfg<2>::SMEM;
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, sm));
+        cuda_check(cudaFuncSetAttribute(k, cudaFuncAttributePreferredSharedMemoryCarveout, (int) cudaSharedmemCarveoutMaxShared));
+        int occ = 0;
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, k, EXL3_M16_THREADS, sm));
+        TORCH_CHECK(occ >= 1, "exl3_gemm_m16g: kernel does not fit on an SM");
+        l.kernel = k;
+        l.smem = sm;
+        l.blocks_per_sm = occ < 2 ? occ : 2;
+    }
+    return l;
+}
+
+// Block owning iteration x for the partition start(b) = floor(b * total / G) (2001's)
+int owner(int x, int total, int G)
+{
+    return (int) ((((int64_t) x + 1) * G + total - 1) / total) - 1;
+}
+
+// Largest number of blocks contributing to one group (partial slots per group)
+int max_contrib(int groups, int KT, int G)
+{
+    const int total = groups * KT;
+    int mc = 1;
+    for (int g = 0; g < groups; ++g)
+    {
+        int nc = owner((g + 1) * KT - 1, total, G) - owner(g * KT, total, G) + 1;
+        if (nc > mc) mc = nc;
+    }
+    return mc;
+}
+
+int grid_size(int size_m, bool c_fp32, int device)
+{
+    const int MT = size_m <= 8 ? 1 : 2;
+    return DevCtx::instance().get_num_sms(device) * get_launch(MT, c_fp32, device).blocks_per_sm;
+}
+
+bool shape_ok(int size_m, int size_k, const std::vector<int>& ns, int K, bool mcg, bool mul1)
+{
+    if (ns.empty() || (int) ns.size() > EXL3_M16G_MAX_MATS) return false;
+    if (!(size_m >= 1 && size_m <= 16 && K == 4 && mul1 && !mcg && size_k >= 128 && size_k % 128 == 0)) return false;
+    for (int n : ns)
+        if (n < EXL3_M16_GW || n % EXL3_M16_GW) return false;
+    return (uint64_t) ns.size() * size_m * size_k * sizeof(half) <= EXL3_M16G_XH_BYTES;
+}
+
+// Workspace and grid fit of a launch: slots for every (group, contributor) and at least one
+// iteration per block (the cooperative grid never idles a block past its grid.syncs)
+bool launch_fits(int groups, int KT, int G)
+{
+    return groups * KT >= G &&
+           (uint64_t) groups * max_contrib(groups, KT, G) * EXL3_M16_SLOT_FLOATS * sizeof(float) <= EXL3_M16G_SLOT_BYTES;
+}
+
+// Routing table: (site, k, widths, m range) -> the path bench_proj.py measured ahead of the site's
+// sliced exl3_mgemm (g7r, RTX 3090, graph-timed). Qwen3.8-27B EXL3 4 bpw shapes. m 2..8 covers
+// the M = 8 verify forward; m 1 and m 9..16 stay on the mgemm (m 16: mgemm 94-95 us vs 2101
+// grouped 97-111, 2001 singles 108-115)
+struct RouteRow
+{
+    int site;
+    int k;
+    int ns[EXL3_M16G_MAX_MATS];   // 0-terminated
+    int m_lo;
+    int m_hi;
+    Exl3M16GPath path;
+};
+
+const RouteRow g_routes[] =
+{
+    // m 8: mgemm 87.6 us, 2001 singles 84.9, 2101 (counter finish) 88.8; 2102 pending bench
+    { M16G_GDN_QKVZ, 5120, { 10240, 6144 },        2, 8, M16G_GROUPED },
+    // m 8: mgemm 89.5 us, 2101 75.5 (2001 singles 93.5, 2001 q + kv pair 79.4); 2102 pending bench
+    { M16G_ATTN_QKV, 5120, { 12288, 1024, 1024 },  2, 8, M16G_GROUPED },
+};
+
+unsigned site_mask()
+{
+    static const unsigned mask = []
+    {
+        const char* env = std::getenv("EXL3_GEMM_M16G");
+        if (!env || !env[0]) return ~0u;
+        return (unsigned) std::strtoul(env, nullptr, 16);
+    }();
+    return mask;
+}
+
+}  // namespace
+
+Exl3M16GPath exl3_gemm_m16g_route(int site, int size_m, int size_k, const std::vector<int>& ns, int K, bool mcg, bool mul1)
+{
+    if (site < 0 || site >= M16G_NUM_SITES || !((site_mask() >> site) & 1u)) return M16G_OLD;
+    if (!shape_ok(size_m, size_k, ns, K, mcg, mul1)) return M16G_OLD;
+    const RouteRow* hit = nullptr;
+    for (const RouteRow& r : g_routes)
+    {
+        if (r.site != site || r.k != size_k || size_m < r.m_lo || size_m > r.m_hi) continue;
+        int i = 0;
+        while (i < (int) ns.size() && i < EXL3_M16G_MAX_MATS && r.ns[i] == ns[i]) ++i;
+        if (i == (int) ns.size() && (i == EXL3_M16G_MAX_MATS || r.ns[i] == 0)) { hit = &r; break; }
+    }
+    if (!hit) return M16G_OLD;
+
+    // 2001 singles: same shape class as shape_ok, plus 2001's own kill switch
+    if (hit->path == M16G_SINGLES) return exl3_gemm_m16_enabled() ? M16G_SINGLES : M16G_OLD;
+
+    // Grouped: workspace and grid fit at this device's grid (fp16 and fp32 C share the grid size)
+    int device;
+    cuda_check(cudaGetDevice(&device));
+    int groups = 0;
+    for (int n : ns) groups += n / EXL3_M16_GW;
+    return launch_fits(groups, size_k / 16, grid_size(size_m, false, device)) ? M16G_GROUPED : M16G_OLD;
+}
+
+void exl3_gemm_m16g_gr
+(
+    const at::Tensor& A,
+    const std::vector<at::Tensor>& B,
+    const std::vector<at::Tensor>& C,
+    const std::vector<at::Tensor>& suh,
+    const std::vector<at::Tensor>& svh,
+    Graph* graph,
+    int a_site
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(A.device());
+    cudaStream_t stream = graph ? graph->capture_stream : at::cuda::getCurrentCUDAStream().stream();
+
+    const int num_mats = (int) B.size();
+    TORCH_CHECK(num_mats >= 1 && num_mats <= EXL3_M16G_MAX_MATS, "exl3_gemm_m16g: 1..", EXL3_M16G_MAX_MATS, " matrices");
+    TORCH_CHECK((int) C.size() == num_mats && (int) suh.size() == num_mats && (int) svh.size() == num_mats,
+        "exl3_gemm_m16g: B, C, suh and svh lists must have equal length");
+
+    TORCH_CHECK_DTYPE(A, kHalf);
+    TORCH_CHECK(A.is_contiguous(), "exl3_gemm_m16g: A must be contiguous");
+    int size_m = 1;
+    for (int d = 0; d < A.dim() - 1; ++d) size_m *= A.size(d);
+    const int size_k = A.size(-1);
+    const bool c_fp32 = C[0].dtype() == at::kFloat;
+    if (!c_fp32) TORCH_CHECK_DTYPE(C[0], kHalf);
+    const int K = B[0].size(2) / 16;
+
+    Exl3M16GArgs args = {};
+    std::vector<int> ns(num_mats);
+    int groups = 0;
+    for (int i = 0; i < num_mats; ++i)
+    {
+        const at::Tensor& Bi = B[i];
+        TORCH_CHECK_DTYPE(Bi, kShort);
+        TORCH_CHECK(Bi.dim() == 3 && Bi.is_contiguous(), "exl3_gemm_m16g: B must be a contiguous 3D trellis");
+        TORCH_CHECK(Bi.size(0) * 16 == size_k && Bi.size(2) / 16 == K, "exl3_gemm_m16g: matrices must share k and K with A");
+        const int n = Bi.size(1) * 16;
+        ns[i] = n;
+        TORCH_CHECK(C[i].dtype() == C[0].dtype() && C[i].is_contiguous() && C[i].numel() == (int64_t) size_m * n,
+            "exl3_gemm_m16g: C must be contiguous (m, n) of one dtype");
+        TORCH_CHECK_DTYPE(suh[i], kHalf);
+        TORCH_CHECK_DTYPE(svh[i], kHalf);
+        TORCH_CHECK(suh[i].numel() == size_k && svh[i].numel() == n, "exl3_gemm_m16g: suh/svh size mismatch");
+        TORCH_CHECK(C[i].data_ptr() != A.data_ptr(), "exl3_gemm_m16g: C must not alias A");
+        args.B[i] = (const uint16_t*) Bi.data_ptr();
+        args.suh[i] = (const half*) suh[i].data_ptr();
+        args.svh[i] = (const half*) svh[i].data_ptr();
+        args.C[i] = i ? C[i].data_ptr() : nullptr;
+        args.gbase[i] = groups;
+        groups += n / EXL3_M16_GW;
+    }
+    for (int i = num_mats; i <= EXL3_M16G_MAX_MATS; ++i) args.gbase[i] = groups;
+    TORCH_CHECK(shape_ok(size_m, size_k, ns, K, false, true),
+        "exl3_gemm_m16g: unsupported shape (m ", size_m, ", k ", size_k, ", K ", K, ")");
+
+    int device;
+    cuda_check(cudaGetDevice(&device));
+    float* ws = get_ws(device, stream);
+
+    const int MT = size_m <= 8 ? 1 : 2;
+    M16GLaunch l = get_launch(MT, c_fp32, device);
+    const int G = DevCtx::instance().get_num_sms(device) * l.blocks_per_sm;
+
+    const int KT = size_k / 16;
+    TORCH_CHECK(launch_fits(groups, KT, G), "exl3_gemm_m16g: workspace too small or matrices too small for the grid");
+
+    half* xh = (half*) (((char*) ws) + EXL3_M16G_SLOT_BYTES);
+    for (int i = 0; i < num_mats; ++i) args.xh[i] = xh + (size_t) i * size_m * size_k;
+    args.ws = ws;
+    args.size_m = size_m;
+    args.size_k = size_k;
+    args.num_mats = num_mats;
+    args.max_contrib = max_contrib(groups, KT, G);
+
+    const half* A_ptr = (const half*) A.data_ptr();
+    void* C0_ptr = C[0].data_ptr();
+    void* kernel_args[] = { (void*) &A_ptr, (void*) &C0_ptr, (void*) &args };
+
+    cuda_check(cudaLaunchCooperativeKernel(l.kernel, dim3(G), dim3(EXL3_M16_THREADS), kernel_args, l.smem, stream));
+
+    if (graph)
+    {
+        graph->record_param(l.kernel, a_site, 0);
+        if (num_mats == 1) graph->record_param(l.kernel, GP_gemm_C, 1);
+        graph->record_param(l.kernel, GP_end, 0);
+    }
+    cuda_check(cudaPeekAtLastError());
+}
