+        fold();
+        flush(g_cur);
+    }
+    cp_async_wait<0>();
+
+    grid.sync();
+
+    // Finish: one warp per (group, row, 128 columns) over the whole grid; slots summed in slot
+    // order, then the output Hadamard reads the sum back from slot 0 (same lane wrote it)
+    {
+        constexpr int CH = GW / 128;
+        const int jobs = groups * size_m * CH;
+        for (int w = warp + EXL3_M16_WARPS * b; w < jobs; w += EXL3_M16_WARPS * G)
+        {
+            int g = w / (size_m * CH);
+            int rem = w - g * size_m * CH;
+            int r = rem / CH;
+            int ch = rem - r * CH;
+            int nc = exl3_m16_owner((g + 1) * KT - 1, total, G) - exl3_m16_owner(g * KT, total, G) + 1;
+            float* s0 = p.ws + (size_t) g * p.max_contrib * EXL3_M16_SLOT_FLOATS + r * GW + ch * 128;
+            float4 v = __ldcg(((const float4*) s0) + lane);
+            for (int c = 1; c < nc; ++c)
+            {
+                float4 u = __ldcg(((const float4*) (s0 + (size_t) c * EXL3_M16_SLOT_FLOATS)) + lane);
+                v.x += u.x; v.y += u.y; v.z += u.z; v.w += u.w;
+            }
+            ((float4*) s0)[lane] = v;
+            __syncwarp();
+
+            const int mat = exl3_m16g_mat(p, g);
+            const int gb = exl3_m16g_gbase(p, mat);
+            const int n_mat = (exl3_m16g_gbase(p, mat + 1) - gb) * GW;
+            const int col0 = (g - gb) * GW + ch * 128;
+            const half* svh = exl3_m16g_sel(p.svh, mat) + col0;
+            void* C = mat ? exl3_m16g_sel(p.C, mat) : C0;
+            if constexpr (c_fp32)
+                had_ff_r_128_inner<false, true>
+                (
+                    s0,
+                    ((float*) C) + (size_t) r * n_mat + col0,
+                    svh,
+                    0.088388347648f  // 1/sqrt(128)
+                );
+            else
+                had_fh_r_128_inner<false, true>
+                (
+                    s0,
+                    ((half*) C) + (size_t) r * n_mat + col0,
+                    svh,
+                    0.088388347648f  // 1/sqrt(128)
+                );
+        }
+    }
