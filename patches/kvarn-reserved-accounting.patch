+    def reserved_size(self) -> int:
+        """Tokens permanently removed from the free list and owned by the
+        allocator itself for its whole lifetime -- never by a session or a
+        cache entry. Idle memory-conservation checks count them as their own
+        component instead of reporting them as leaked. Default: none.
+        """
