diff --git a/python/sglang/srt/mem_cache/kvarn_bend_plan.py b/python/sglang/srt/mem_cache/kvarn_bend_plan.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/mem_cache/kvarn_bend_plan.py
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Startup-only Bend 2 plan consumer; not a proof of Python or CUDA.
+
+The deployment adapter verifies source/compiler/C/binary/proof identity before
+launch. Here the engine independently checks its allocation ABI and retains only
+immutable typed values. No environment override or missing-file fallback exists.
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from functools import cache
+from itertools import pairwise
+from pathlib import Path
+
+
+_OFFSET_NAMES = (
+    "k_packed", "k_scale", "k_zero", "k_token", "v_packed", "v_channel",
+    "v_scale", "v_zero", "end",
+)
+_FIELDS = (
+    "context", "headroom", "pool", "page_size", "pages", "tail_slots",
+    "write_tokens", "query_tokens", "commit_tokens", "write_span_pages",
+    "admission_free_slots", "target_visible", "draft_window", "draft_visible",
+    "target_dim", "target_kv_heads", "target_layers", "draft_dim",
+    "draft_kv_heads", "draft_layers",
+) + tuple(f"{role}_{name}" for role in ("target", "draft") for name in _OFFSET_NAMES)
+
+
+@dataclass(frozen=True, slots=True)
+class BendPoolLayout:
+    head_dim: int
+    kv_heads: int
+    layers: int
+    visible_tokens: int
+    offsets: tuple[int, ...]
+
+    @property
+    def tile_bytes(self) -> int:
+        return self.offsets[-1]
+
+
+@dataclass(frozen=True, slots=True)
+class KVarNBendPlan:
+    context: int
+    headroom: int
+    pool: int
+    page_size: int
+    pages: int
+    tail_slots: int
+    write_tokens: int
+    query_tokens: int
+    commit_tokens: int
+    write_span_pages: int
+    admission_free_slots: int
+    draft_window: int
+    target: BendPoolLayout
+    draft: BendPoolLayout
+    free_pages: tuple[int, ...]
+
+    def require_request(self, context: int, pool: int, page_size: int) -> None:
+        if any(type(value) is not int for value in (context, pool, page_size)):
+            raise ValueError("KVarN native request geometry must contain exact integers")
+        if (context, pool, page_size) != (self.context, self.pool, self.page_size):
+            raise ValueError("KVarN native request differs from the compiled Bend plan")
+
+
+def _unique_object(items: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in items:
+        if key in result:
+            raise ValueError(f"Duplicate KVarN Bend plan key: {key}")
+        result[key] = value
+    return result
+
+
+def _integer(value: object, name: str) -> int:
+    if type(value) is not int or not 0 <= value <= 2147483647:
+        raise ValueError(f"KVarN Bend plan field must be a nonnegative int32: {name}")
+    return value
+
+
+@cache
+def native_bend_plan() -> KVarNBendPlan:
+    """Read once per worker, before allocation/capture; never on a token path."""
+    with Path("/opt/qwen/bend/plan.json").open("rb") as stream:
+        raw = stream.read(65537)
+    if len(raw) > 65536:
+        raise ValueError("KVarN Bend plan exceeds the startup artifact size limit")
+    decoded: object = json.loads(raw, object_pairs_hook=_unique_object)
+    if not isinstance(decoded, dict) or set(decoded) != {*_FIELDS, "schema", "free_pages"}:
+        raise ValueError("KVarN Bend plan has missing or unexpected fields")
+    if _integer(decoded["schema"], "schema") != 2:
+        raise ValueError("KVarN requires the Bend 2 schema2 allocation plan")
+    values = {name: _integer(decoded[name], name) for name in _FIELDS}
+    if (values["context"], values["headroom"], values["page_size"]) != (262144, 1024, 128):
+        raise ValueError("KVarN Bend plan is not the native262144 deployment")
+    pool, page_size, pages = values["pool"], values["page_size"], values["pages"]
+    if (pool != values["context"] + values["headroom"]
+            or pool % page_size or pages != pool // page_size + 1):
+        raise ValueError("KVarN Bend plan violates reserved-zero page geometry")
+    # IDs include the reserved zero page: last physical token is 263295,
+    # NOT pool-1 (263167). Kernels encode physical addresses in signed int32.
+    if pages * page_size - 1 > 2147483647:
+        raise ValueError("KVarN Bend physical token addresses exceed int32")
+    page_list: object = decoded["free_pages"]
+    if not isinstance(page_list, list) or len(page_list) != pages - 1:
+        raise ValueError("KVarN Bend free pages must contain every nonzero page exactly in order")
+    free_pages = tuple(_integer(page, "free_pages") for page in page_list)
+    if any(page != index for index, page in enumerate(free_pages, 1)):
+        raise ValueError("KVarN Bend free pages must contain every nonzero page exactly in order")
+    if (values["tail_slots"], values["write_tokens"], values["query_tokens"],
+            values["commit_tokens"]) != (8, 128, 32, 8):
+        raise ValueError("KVarN Bend plan changes the bounded native workspace")
+    if (values["write_span_pages"] != 2
+            or values["admission_free_slots"] != values["write_span_pages"] + 2):
+        raise ValueError("KVarN Bend plan changes write/sink/COW admission bounds")
+    if (values["target_visible"] != page_size
+            or values["draft_window"] != 2048 + page_size + values["commit_tokens"]
+            or values["draft_visible"] != -(-values["draft_window"] // page_size) * page_size):
+        raise ValueError("KVarN Bend plan changes target or draft visible bounds")
+    layouts: list[BendPoolLayout] = []
+    for role, dim, heads, layers in (("target", 256, 4, 16), ("draft", 128, 8, 5)):
+        if (values[f"{role}_dim"], values[f"{role}_kv_heads"],
+                values[f"{role}_layers"]) != (dim, heads, layers):
+            raise ValueError(f"KVarN Bend plan changes reviewed {role} model geometry")
+        offsets = tuple(values[f"{role}_{name}"] for name in _OFFSET_NAMES)
+        sizes = (dim * page_size // 2, 2 * dim, 2 * dim, 2 * page_size,
+                 dim * page_size // 4, 2 * dim, 2 * page_size, 2 * page_size)
+        if (offsets[0] != 0
+                or tuple(b - a for a, b in pairwise(offsets)) != sizes
+                or offsets[-1] != dim * page_size * 3 // 4 + 6 * (dim + page_size)):
+            raise ValueError(f"KVarN Bend plan changes the packed {role} byte layout")
+        layouts.append(BendPoolLayout(
+            values[f"{role}_dim"], values[f"{role}_kv_heads"],
+            values[f"{role}_layers"], values[f"{role}_visible"], offsets,
+        ))
+    return KVarNBendPlan(
+        context=values["context"], headroom=values["headroom"], pool=pool,
+        page_size=page_size, pages=pages, tail_slots=values["tail_slots"],
+        write_tokens=values["write_tokens"], query_tokens=values["query_tokens"],
+        commit_tokens=values["commit_tokens"], write_span_pages=values["write_span_pages"],
+        admission_free_slots=values["admission_free_slots"], draft_window=values["draft_window"],
+        target=layouts[0], draft=layouts[1], free_pages=free_pages,
+    )
