+from __future__ import annotations
+
+from copy import copy
+
+import torch
+
+from sglang.srt.sampling.penaltylib import (
+    BatchedFrequencyPenalizer,
+    BatchedMinNewTokensPenalizer,
+    BatchedPresencePenalizer,
+    BatchedRepetitionPenalizer,
+)
+from sglang.srt.sampling.penaltylib.orchestrator import _BatchedPenalizer
+
+
+def snapshot_verify_penalties(
+    penalizers: tuple[_BatchedPenalizer, ...],
+) -> tuple[_BatchedPenalizer, ...]:
+    """Own mutable tensors without copying requests or their history.
+
+    The detached objects only use cumulate_output_tokens/apply, neither of
+    which reads the weak orchestrator reference in these four stock classes.
+    """
+    snapshots: list[_BatchedPenalizer] = []
+    for penalty in penalizers:
+        if not penalty.is_prepared():
+            continue
+        detached = copy(penalty)
+        if isinstance(detached, BatchedFrequencyPenalizer):
