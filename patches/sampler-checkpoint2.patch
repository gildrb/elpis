+        # ties from the original row is necessary to match FlashInfer's pivot
+        # law even if the cutoff tie extends beyond the selected k indices.
+        count = top_k if use_sparse_topk else vocab_size
+        values = torch.topk(probabilities, k=count, sorted=True).values
+        cutoff_k = values[top_k - 1]
+        if sequential_min_p:
