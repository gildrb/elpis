+def _filter_dflash_probability_row(
+    probabilities: torch.Tensor,
+    *,
+    top_k: int,
+    top_p: float,
+    min_p: float,
+    sampling_backend: str,
+    sequential_min_p: bool,
+    use_sparse_topk: bool,
+) -> torch.Tensor:
+    """Filter one original-softmax row without changing verify logits.
+
+    FlashInfer joint sampling includes the entire equal-probability cutoff
+    group: its predicate counts/sums strictly greater probabilities. PyTorch
+    instead keeps sorted ranks and uses its inclusive cumulative boundary.
+    Only one vocabulary row of sort scratch is live, even at TOP_K_ALL.
+    """
