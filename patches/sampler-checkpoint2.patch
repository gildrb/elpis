+    if sampling_backend == "flashinfer" and sequential_min_p and probabilities.is_cuda:
+        # Match AR's min-p branch, including its intermediate renormalizations.
+        row = probabilities.unsqueeze(0)
+        ks = torch.tensor([top_k], dtype=torch.int32, device=row.device)
+        ps = torch.tensor([top_p], dtype=torch.float32, device=row.device)
+        row = _dflash_top_k_renorm_prob(row, ks)
+        row = _dflash_top_p_renorm_prob(row, ps)
+        row.masked_fill_(row < row.amax(dim=-1, keepdim=True) * min_p, 0.0)
