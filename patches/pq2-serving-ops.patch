+    # ids; a host-side scan would put a synchronization on the decode hot path.
+    gathered = torch.index_select(qweight, 0, flat)
+    z = pq2_decode_rows(gathered, logical_width, dtype)
+    restored = restore_latent_rows(z)
+    return restored.reshape(*ids.shape, logical_width)
