diff --git a/python/sglang/srt/layers/quantization/pq2_ops.py b/python/sglang/srt/layers/quantization/pq2_ops.py
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/python/sglang/srt/layers/quantization/pq2_ops.py
@@ -0,0 +1,404 @@
+# SPDX-License-Identifier: Apache-2.0
+"""PQ2_0 (PrismML ternary, serialized GGML type 142) serving ops.
+
+Serving contract for the Ternary-Bonsai-2-27B GGUF target. The packed
+weights stay GPU-resident for their whole lifetime; activations are
+transformed per matmul and tiles are decoded inside the kernel. No full
+dense reconstruction of any weight matrix happens on any serving path.
+
+Format contract (pinned to PrismML-Eng/llama.cpp release prism-b10683-d8f26ee):
+
+- ``block_pq2_0`` is 34 bytes per 128 weights: a little-endian fp16 scale
+  ``d`` first (bytes 0-1), then 32 bytes of 2-bit codes. Weight ``j`` of a
+  block reads ``q = (qs[j // 4] >> (2 * (j % 4))) & 3`` and decodes to
+  ``(q - 1) * d``; the reference quantizer emits codes 0..2 only.
+- ``prism.hadamard.*`` metadata folds an orthogonal transform into every
+  listed matmul weight along its input dimension. At runtime each folded
+  matmul consumes ``x' = H @ (D \u2299 x)`` where ``H`` is the normalized
+  natural-order Walsh-Hadamard matrix of ``prism.hadamard.block_size``
+  (``H[i][j] = (-1)^popcount(i & j) / sqrt(block_size)``) and ``D`` is the
+  per-width explicit sign vector. Tables consumed by row lookup (here only
+  ``token_embd.weight``) store latent rows and are restored at lookup with
+  the inverse order ``x = D \u2299 (H @ z)``.
+- The GDN ``ssm_out`` input permutation the fork applies converts its
+  internal tiling to the row order the packed weight already uses; SGLang's
+  native v-head grouping matches that order directly, so no permutation is
+  needed here (verified by the fixture in tests and by fork logits parity).
+"""
+
+from __future__ import annotations
+
+import struct
+from typing import Callable, Dict, List
+
+import torch
+
+_HADAMARD_VERSION = 1
+_SUPPORTED_TRANSFORM = "normalized-sylvester-walsh-hadamard"
+_SUPPORTED_AXIS = "input-last-dimension"
+_SUPPORTED_SIGN_MODES = ("identity", "explicit")
+_INVERSE_ROW_LOOKUP_TABLES = {"token_embd.weight"}
+
+_contract: "PQ2Contract | None" = None
+_hadamard_cache: Dict[tuple[int, int, int], torch.Tensor] = {}
+
+
+class PQ2ContractError(ValueError):
+    """Raised when the artifact violates the pinned PQ2_0 contract."""
+
+
+class PQ2ContractNotInitialized(RuntimeError):
+    """Raised when a PQ2_0 op runs before the artifact contract is loaded."""
+
+
+class PQ2Contract:
+    """Immutable runtime view of the artifact's prism.hadamard metadata."""
+
+    def __init__(
+        self,
+        gguf_path: str,
+        block_size: int,
+        signs_by_width: Dict[int, torch.Tensor],
+        folded_gguf_names: frozenset[str],
+        inverse_gguf_names: frozenset[str],
+    ) -> None:
+        self.gguf_path = gguf_path
+        self.block_size = block_size
+        self.signs_by_width = signs_by_width
+        self.folded_gguf_names = folded_gguf_names
+        self.inverse_gguf_names = inverse_gguf_names
+        self._device_signs: Dict[tuple[int, torch.device], torch.Tensor] = {}
+
+    def signs_for(self, width: int, device: torch.device, dtype: torch.dtype) -> torch.Tensor:
+        """Per-device cached sign vector for an activation width."""
+        key = (width, device)
+        signs = self._device_signs.get(key)
+        if signs is None or signs.dtype != dtype:
+            source = self.signs_by_width.get(width)
+            if source is None:
+                raise PQ2ContractError(f"no prism.hadamard sign vector for width {width}")
+            signs = source.to(device=device, dtype=dtype)
+            self._device_signs[key] = signs
+        return signs
+
+
+def _read_gguf_metadata_and_tensors(gguf_path: str) -> tuple[dict[str, object], list[tuple[str, list[int], int]]]:
+    """Strict GGUF v3 metadata + tensor-info read.
+
+    Tensor payload offsets are relative to the 32-byte-aligned data section;
+    this returns logical tensor infos only (name, ne dims, ggml type id).
+    """
+    with open(gguf_path, "rb") as f:
+        magic = f.read(4)
+        if magic != b"GGUF":
+            raise PQ2ContractError(f"{gguf_path}: bad magic {magic!r}")
+        (version,) = struct.unpack("<I", f.read(4))
+        if version != 3:
+            raise PQ2ContractError(f"{gguf_path}: unsupported GGUF version {version}")
+        tensor_count, kv_count = struct.unpack("<QQ", f.read(16))
+
+        def read_str() -> str:
+            (n,) = struct.unpack("<Q", f.read(8))
+            raw = f.read(n)
+            if len(raw) != n:
+                raise PQ2ContractError(f"{gguf_path}: truncated string")
+            return raw.decode("utf-8")
+
+        def read_value(vtype: int) -> object:
+            fmt = {
+                0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i",
+                6: "<f", 10: "<Q", 11: "<q", 12: "<d",
+            }.get(vtype)
+            if fmt is not None:
+                size = struct.calcsize(fmt)
+                raw = f.read(size)
+                if len(raw) != size:
+                    raise PQ2ContractError(f"{gguf_path}: truncated scalar")
+                return struct.unpack(fmt, raw)[0]
+            if vtype == 7:
+                raw = f.read(1)
+                if len(raw) != 1:
+                    raise PQ2ContractError(f"{gguf_path}: truncated bool")
+                return bool(raw[0])
+            if vtype == 8:
+                return read_str()
+            if vtype == 9:
+                (etype,) = struct.unpack("<I", f.read(4))
+                (count,) = struct.unpack("<Q", f.read(8))
+                return [read_value(etype) for _ in range(count)]
+            raise PQ2ContractError(f"{gguf_path}: unsupported metadata type {vtype}")
+
+        metadata: dict[str, object] = {}
+        for _ in range(kv_count):
+            key = read_str()
+            (vtype,) = struct.unpack("<I", f.read(4))
+            metadata[key] = read_value(vtype)
+
+        tensors: list[tuple[str, list[int], int]] = []
+        for _ in range(tensor_count):
+            name = read_str()
+            (n_dims,) = struct.unpack("<I", f.read(4))
+            dims = [struct.unpack("<Q", f.read(8))[0] for _ in range(n_dims)]
+            ttype, _offset = struct.unpack("<IQ", f.read(12))
+            tensors.append((name, dims, ttype))
+    return metadata, tensors
+
+
+def _pq2_type_id() -> int:
+    """Serialized id of PQ2_0 from the (build-time extended) gguf package."""
+    from gguf import GGMLQuantizationType
+    return int(GGMLQuantizationType.PQ2_0)
+
+
+_PQ2_TYPE_ID = 142
+
+
+def _require(condition: object, message: str) -> None:
+    if not condition:
+        raise PQ2ContractError(message)
+
+
+def _parse_hadamard_metadata(metadata: dict[str, object]) -> tuple[int, Dict[int, torch.Tensor], frozenset[str], frozenset[str]]:
+    _require("prism.hadamard.version" in metadata, "prism.hadamard.version missing")
+    version = metadata["prism.hadamard.version"]
+    _require(version == _HADAMARD_VERSION, f"unsupported prism.hadamard.version {version}")
+
+    block_size = metadata["prism.hadamard.block_size"]
+    _require(isinstance(block_size, int) and block_size > 0 and block_size & (block_size - 1) == 0,
+             f"invalid prism.hadamard.block_size {block_size}")
+    _require(metadata.get("prism.hadamard.transform") == _SUPPORTED_TRANSFORM,
+             f"unsupported prism.hadamard.transform {metadata.get('prism.hadamard.transform')!r}")
+    _require(metadata.get("prism.hadamard.axis") == _SUPPORTED_AXIS,
+             f"unsupported prism.hadamard.axis {metadata.get('prism.hadamard.axis')!r}")
+    sign_mode = metadata.get("prism.hadamard.sign_mode")
+    _require(sign_mode in _SUPPORTED_SIGN_MODES, f"unsupported prism.hadamard.sign_mode {sign_mode!r}")
+
+    weight_names = metadata.get("prism.hadamard.weight_names")
+    _require(isinstance(weight_names, list) and weight_names, "prism.hadamard.weight_names missing or empty")
+
+    signs_by_width: Dict[int, torch.Tensor] = {}
+    if sign_mode == "explicit":
+        sign_widths = metadata.get("prism.hadamard.sign_widths")
+        sign_values = metadata.get("prism.hadamard.sign_values")
+        _require(isinstance(sign_widths, list) and sign_widths,
+                 "prism.hadamard.sign_mode is explicit but sign_widths is empty")
+        _require(isinstance(sign_values, list) and sign_values,
+                 "prism.hadamard.sign_values missing")
+        offset = 0
+        for width in sign_widths:
+            _require(isinstance(width, int) and width > 0 and width % block_size == 0,
+                     f"invalid prism.hadamard sign width {width}")
+            _require(offset + width <= len(sign_values),
+                     "prism.hadamard.sign_values shorter than sign_widths require")
+            segment = sign_values[offset:offset + width]
+            bad = [v for v in segment if v not in (1, -1)]
+            _require(not bad, f"prism.hadamard sign values must be +/-1, found {bad[:3]}")
+            signs_by_width[width] = torch.tensor(segment, dtype=torch.float32)
+            offset += width
+        _require(offset == len(sign_values), "prism.hadamard.sign_values length mismatch")
+
+    inverse_names_raw = metadata.get("prism.hadamard.inverse_weight_names", [])
+    _require(isinstance(inverse_names_raw, list), "prism.hadamard.inverse_weight_names must be an array")
+    inverse_names = frozenset(str(n) for n in inverse_names_raw)
+    unexpected = inverse_names - _INVERSE_ROW_LOOKUP_TABLES
+    _require(not unexpected,
+             f"prism.hadamard: unverified inverse-after-lookup tables {sorted(unexpected)}")
+
+    for name in weight_names:
+        _require(isinstance(name, str) and name, "prism.hadamard weight name must be a non-empty string")
+    return int(block_size), signs_by_width, frozenset(str(n) for n in weight_names), inverse_names
+
+
+def init_pq2_contract(gguf_path: str, gguf_to_hf_name_map: Dict[str, str]) -> None:
+    """Read the artifact contract and validate it against the load map.
+
+    Called once by GGUFModelLoader before weight loading. A GGUF without
+    PQ2_0 tensors and without prism.hadamard metadata is left untouched
+    (upstream behavior). Any PQ2_0 tensor or any prism.hadamard key arms
+    the full contract: every check below is then mandatory and fails loud,
+    so serving never starts on a misunderstood artifact.
+    """
+    global _contract, _hadamard_cache
+    metadata, tensors = _read_gguf_metadata_and_tensors(gguf_path)
+    pq2_tensors = {name: dims for name, dims, ttype in tensors if ttype == _pq2_type_id()}
+    has_hadamard = "prism.hadamard.version" in metadata
+    if not pq2_tensors and not has_hadamard:
+        return
+
+    block_size, signs_by_width, folded, inverse = _parse_hadamard_metadata(metadata)
+
+    token_embd = "token_embd.weight"
+    _require(token_embd in pq2_tensors, f"{gguf_path}: {token_embd} must be PQ2_0")
+    _require(set(inverse) == {token_embd} and token_embd not in folded,
+             f"{gguf_path}: inverse set must be exactly the latent row table {token_embd}")
+
+    expected_folded = set(pq2_tensors) - {token_embd}
+    _require(folded == expected_folded,
+             f"{gguf_path}: fold metadata covers {len(folded)} weights but "
+             f"{len(expected_folded)} PQ2 matmul tensors exist")
+
+    # Every folded tensor's input width (ne[0]) must have a sign vector and
+    # must be a multiple of the Hadamard block size.
+    for name in sorted(folded):
+        dims = pq2_tensors[name]
+        input_width = dims[0]
+        _require(input_width % block_size == 0,
+                 f"{name}: input width {input_width} not a multiple of block size {block_size}")
+        _require(input_width in signs_by_width,
+                 f"{name}: no prism.hadamard sign vector for width {input_width}")
+
+    # The load map must route every folded tensor and the latent table.
+    mapped = set(gguf_to_hf_name_map)
+    missing_routes = (folded | {token_embd}) - mapped
+    _require(not missing_routes,
+             f"{gguf_path}: PQ2 tensors without an HF routing rule: {sorted(missing_routes)}")
+
+    _hadamard_cache = {}
+    _contract = PQ2Contract(
+        gguf_path=gguf_path,
+        block_size=block_size,
+        signs_by_width=signs_by_width,
+        folded_gguf_names=folded,
+        inverse_gguf_names=inverse,
+    )
+
+
+def require_pq2_contract() -> PQ2Contract:
+    if _contract is None:
+        raise PQ2ContractNotInitialized(
+            "PQ2_0 op ran before init_pq2_contract(); the artifact contract must "
+            "be loaded by GGUFModelLoader before any weight is applied")
+    return _contract
+
+
+def _hadamard_matrix(block_size: int, device: torch.device, dtype: torch.dtype) -> torch.Tensor:
+    key = (block_size, device.type, device.index if device.type == "cuda" else -1)
+    matrix = _hadamard_cache.get((key[0], key[1], key[2], str(dtype)))
+    if matrix is None or matrix.device != device or matrix.dtype != dtype:
+        index = torch.arange(block_size, device=device, dtype=torch.int64)
+        parity = torch.zeros((block_size, block_size), device=device, dtype=torch.int64)
+        for bit in range(block_size.bit_length() - 1):
+            parity ^= ((index[:, None] >> bit) & 1) & ((index[None, :] >> bit) & 1)
+        matrix = torch.where(parity == 1, -1.0, 1.0).to(dtype) / (block_size ** 0.5)
+        _hadamard_cache[(key[0], key[1], key[2], str(dtype))] = matrix
+    return matrix
+
+
+def transform_activation(x: torch.Tensor) -> torch.Tensor:
+    """Runtime fold-side transform: x' = H @ (D . x) per block, last dim.
+
+    H is symmetric so the row-vector form is ``x' = x @ H`` after applying
+    the signs; both orders are pinned by tests against the fork reference.
+    """
+    contract = require_pq2_contract()
+    width = x.shape[-1]
+    block_size = contract.block_size
+    if width % block_size != 0:
+        raise PQ2ContractError(f"activation width {width} not a multiple of block size {block_size}")
+    signs = contract.signs_for(width, x.device, x.dtype)
+    signed = x * signs
+    blocks = signed.reshape(-1, block_size)
+    matrix = _hadamard_matrix(block_size, x.device, x.dtype)
+    return (blocks @ matrix.t()).reshape(x.shape)
+
+
+def restore_latent_rows(z: torch.Tensor) -> torch.Tensor:
+    """Lookup-side inverse: x = D . (H @ z) per block, last dim."""
+    contract = require_pq2_contract()
+    width = z.shape[-1]
+    block_size = contract.block_size
+    blocks = z.reshape(-1, block_size)
+    matrix = _hadamard_matrix(block_size, z.device, z.dtype)
+    restored = (blocks @ matrix.t()).reshape(z.shape)
+    signs = contract.signs_for(width, z.device, z.dtype)
+    return restored * signs
+
+
+def decode_pq2_rows(qweight: torch.Tensor, logical_width: int, dtype: torch.dtype) -> torch.Tensor:
+    """Decode packed PQ2 rows [rows, packed] to a dense [rows, logical_width] tile.
+
+    Qualification/reference helper: bounded to the rows of one call, never
+    used to materialize a whole weight matrix on a serving path.
+    """
+    from sglang.srt.layers.quantization.pq2_triton import pq2_decode_rows
+    return pq2_decode_rows(qweight, logical_width, dtype)
+
+
+_BLOCKED_CACHE: dict[tuple[int, int, int], torch.Tensor] = {}
+
+
+def _blocked_for(qweight: torch.Tensor, logical_width: int) -> torch.Tensor:
+    """Cached blocked-layout view twin of a packed PQ2 parameter.
+
+    Keyed on the parameter's data pointer plus shape: serving passes stable
+    row-slice views of the same loaded parameters every step, so one repack
+    per tensor is amortized over the whole serving lifetime. The cache holds
+    a permutation copy of the packed bytes (+2.125 bit/weight) and never
+    densifies.
+    """
+    key = (qweight.data_ptr(), qweight.shape[0], qweight.shape[1])
+    blocked = _BLOCKED_CACHE.get(key)
+    if blocked is None:
+        from sglang.srt.layers.quantization.pq2_triton import repack_blocked
+        blocked = repack_blocked(qweight, logical_width)
+        _BLOCKED_CACHE[key] = blocked
+    return blocked
+
+
+def transform_activation_fp16(x: torch.Tensor) -> torch.Tensor:
+    """x' = H @ (D . x) per 1024 block, computed in fp32, stored fp16.
+
+    Replaces the sign elementwise pass + dense 1024x1024 bf16 matmul + the
+    separate fp16 conversion with one kernel. Values differ from the bf16
+    matmul path only by its intermediate bf16 rounding (this path is more
+    precise).
+    """
+    from sglang.srt.layers.quantization.pq2_triton import _h32, _pq2_fwht_kernel
+    contract = require_pq2_contract()
+    if contract.block_size != 1024:
+        raise PQ2ContractError(
+            f"fwht kernel pins block 1024, artifact uses {contract.block_size}")
+    width = x.shape[-1]
+    if width % 1024 != 0:
+        raise PQ2ContractError(f"activation width {width} not a multiple of 1024")
+    x2 = x.reshape(-1, width)
+    signs = contract.signs_for(width, x.device, x.dtype)
+    h32 = _h32(x.device)
+    out = torch.empty(x2.shape, dtype=torch.float16, device=x.device)
+    grid = (x2.shape[0] * (width // 1024),)
+    _pq2_fwht_kernel[grid](x2, signs, h32, out, width, x2.shape[0], num_warps=4)
+    return out.reshape(*x.shape[:-1], width)
+
+
+
+
+def linear_forward(x: torch.Tensor, qweight: torch.Tensor) -> torch.Tensor:
+    """y = W' @ x' for a folded PQ2_0 weight (packed, GPU-resident)."""
+    from sglang.srt.layers.quantization.pq2_triton import pq2_matmul_blocked
+    logical_width = qweight.shape[1] // 34 * 128
+    if x.shape[-1] != logical_width:
+        raise PQ2ContractError(
+            f"PQ2 matmul width mismatch: activation {x.shape[-1]} vs weight {logical_width}")
+    x16_in = transform_activation_fp16(x)
+    if not qweight.is_contiguous():
+        # Mixed-width shard padding would make the slice a fresh copy every
+        # call; repack without caching rather than poisoning the cache.
+        from sglang.srt.layers.quantization.pq2_triton import repack_blocked
+        blocked = repack_blocked(qweight, logical_width)
+    else:
+        blocked = _blocked_for(qweight, logical_width)
+    y = pq2_matmul_blocked(x16_in.reshape(-1, logical_width), blocked, logical_width)
+    return y.reshape(*x.shape[:-1], y.shape[-1])
+
+
+def embedding_forward(ids: torch.Tensor, qweight: torch.Tensor, dtype: torch.dtype) -> torch.Tensor:
+    """Row lookup on the latent table + inverse restore. Rows stay packed."""
+    from sglang.srt.layers.quantization.pq2_triton import pq2_decode_rows
+    logical_width = qweight.shape[1] // 34 * 128
+    flat = ids.reshape(-1)
