# Emits the ext 8202 layer-tail schedule header (exl3_tail_m16_sched.h) from the Nat model
# bend/tail_m16_sched.bend at the served instance (Impl.grid(), Impl.kin(), Impl.hidden(),
# Impl.inter()); bend/tail_m16_sched_diff.py compares it byte for byte with the header that
# patches/exl3-ext/8202-layer-tail-on2102.patch adds. Rows: exl3_tail_sched_block[b] = s0, n0,
# ring1, ring2.
import Base
import ./tail_m16_sched.bend as Impl

def g() -> Nat:
  Impl.grid()

def a() -> Nat:
  Impl.kin()

def h() -> Nat:
  Impl.hidden()

def i() -> Nat:
  Impl.inter()

def cells(xs: List<&2, Nat>) -> String:
  match xs:
    case Nil{}:
      ""
    case x <> rest:
      Nat.show(x) ++ "," ++ cells(rest)

def block_rows(left: Nat, +b: Nat) -> String:
  match left:
    case 0n:
      ""
    case 1n+rest:
      cells([Impl.s0(g(), a(), h(), b), Impl.n0(g(), a(), h(), b), Impl.ring1(g(), a(), h(), b),
        Impl.ring2(g(), a(), h(), i(), b)]) ++ "\n" ++ block_rows(rest, 1n+b)

def define(name: String, v: Nat) -> String:
  "#define EXL3_TAIL_SCHED_" ++ name ++ " " ++ Nat.show(v) ++ "\n"

def header() -> String:
  +G = Impl.grid()
  "// Generated by bend/TAIL_M16_SCHED_TABLE.bend (ext 8202 layer tail schedule); do not edit.\n" ++
    define("G", G) ++ define("PF", Impl.pf()) ++
    define("K0", a()) ++ define("N0", h()) ++
    define("NG0", Impl.ng0(h())) ++ define("KT0", Impl.kt0(a())) ++
    define("T0", Impl.total0(a(), h())) ++ define("MC0", Impl.mc0(G, a(), h())) ++
    define("NCH", Impl.nch(h())) ++ define("BF", 4n) ++
    "static const unsigned short exl3_tail_sched_block[" ++ Nat.show(G) ++ " * 4] = {\n" ++
    block_rows(G, 0n) ++ "};"

def main() -> IO(Unit):
  IO.print(header())
