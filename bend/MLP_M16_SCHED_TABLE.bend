# Emits the ext 8201 fused-MLP schedule header (exl3_mlp_m16_sched.h) from the Nat model
# bend/mlp_m16_sched.bend at the served instance (Impl.grid(), Impl.hidden(), Impl.inter());
# bend/mlp_m16_sched_diff.py compares it byte for byte with the independent Python reference.
# Rows: exl3_mlp_sched_block[b] = s1, n1, v, s2, n2, ring2, fin_pair, fin_rank, fin_cnt,
# wait_off, wait_cnt; exl3_mlp_sched_pair[p] = exp_gate, exp_up, wait1, exp2, wait2;
# exl3_mlp_sched_wait = the blocks' wait lists, concatenated.
import Base
import ./mlp_m16_sched.bend as Impl

def g() -> Nat:
  Impl.grid()

def h() -> Nat:
  Impl.hidden()

def i() -> Nat:
  Impl.inter()

def cells(xs: List<&2, Nat>) -> String:
  match xs:
    case Nil{}:
      ""
    case x <> rest:
      Nat.show(x) ++ "," ++ cells(rest)

def block_row(+b: Nat, +off: Nat) -> String:
  cells([Impl.s1(g(), h(), i(), b), Impl.n1(g(), h(), i(), b), Impl.slice(b),
    Impl.s2(g(), h(), i(), b), Impl.n2(g(), h(), i(), b), Impl.ring2(g(), h(), i(), b),
    Impl.fin_pair(g(), h(), i(), b), Impl.fin_rank(g(), h(), i(), b),
    Impl.fin_cnt(g(), h(), i(), b), off, Impl.wait_cnt(g(), h(), i(), b)]) ++ "\n"

# Rows of blocks b .. b + left - 1; off is wait_off(b), carried instead of recomputed.
def block_rows(left: Nat, +b: Nat, +off: Nat) -> String:
  match left:
    case 0n:
      ""
    case 1n+rest:
      block_row(b, off) ++ block_rows(rest, 1n+b, Nat.add(off, Impl.wait_cnt(g(), h(), i(), b)))

def pair_rows(left: Nat, +p: Nat) -> String:
  match left:
    case 0n:
      ""
    case 1n+rest:
      cells([Impl.exp_gate(g(), h(), i(), p), Impl.exp_up(g(), h(), i(), p),
        Impl.wait1(g(), h(), i(), p), Impl.exp2(g(), h(), i(), p), Impl.wait2(g(), h(), i(), p)]) ++
        "\n" ++ pair_rows(rest, 1n+p)

def wait_rows(left: Nat, +b: Nat) -> String:
  match left:
    case 0n:
      ""
    case 1n+rest:
      cells(Impl.waits(g(), h(), i(), b)) ++ "\n" ++ wait_rows(rest, 1n+b)

def define(name: String, v: Nat) -> String:
  "#define EXL3_MLP_SCHED_" ++ name ++ " " ++ Nat.show(v) ++ "\n"

def header() -> String:
  +G = Impl.grid()
  +P = Impl.pairs(i())
  +nw = Impl.wait_off(G, h(), i(), G)
  "// Generated by bend/MLP_M16_SCHED_TABLE.bend (ext 8201 fused MLP schedule); do not edit.\n" ++
    define("G", G) ++ define("PF", Impl.pf()) ++
    define("K1", h()) ++ define("N1", i()) ++
    define("K2", i()) ++ define("N2", h()) ++
    define("PAIRS", P) ++ define("BF", 11n) ++ define("PFLD", 5n) ++
    define("NWAIT", nw) ++ define("MC1", Impl.mc1(G, h(), i())) ++ define("MC2", Impl.mc2(G, h(), i())) ++
    "static const unsigned short exl3_mlp_sched_block[" ++ Nat.show(G) ++ " * 11] = {\n" ++
    block_rows(G, 0n, 0n) ++ "};\n" ++
    "static const unsigned short exl3_mlp_sched_pair[" ++ Nat.show(P) ++ " * 5] = {\n" ++
    pair_rows(P, 0n) ++ "};\n" ++
    "static const unsigned short exl3_mlp_sched_wait[" ++ Nat.show(nw) ++ "] = {\n" ++
    wait_rows(G, 0n) ++ "};"

def main() -> IO(Unit):
  IO.print(header())
