# Entering inner row v (parent pv): after its first-inner-sibling position
# the state is path[pv] already; otherwise RELOAD and REPLAY path[pv] first.
def enter(first: Bool, +v: Nat, +pv: Nat, +a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, p: Prog) -> Prog:
  match first:
    case True{}:
      push(v, p)
    case False{}:
      push(v, replay(sel8(pv, a0, a1, a2, a3, a4, a5, a6, a7), push(32n, p)))

# Visit the inner rows in DFS preorder (w = next inner row, done when 0).
def prog_go(fuel: Nat, done: Bool, +w: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, p: Prog) -> Prog:
  match fuel:
    case 0n:
      p
    case 1n+f:
      match done:
        case True{}:
          p
        case False{}:
          +pv = selq(w, q1, q2, q3, q4, q5, q6, q7)
          +k = find(w, w, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
          +nw = succ(Nat.is_eq(k, 0n), k, w, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
