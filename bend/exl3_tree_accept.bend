            leafpart(w, Nat.is_ne(k, 0n), q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7,
              enter(Nat.is_eq(find(pv, pv, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7), w), w, pv, a0, a1, a2, a3, a4, a5, a6, a7, p)))

def program(+h0: Bool, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool, +a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32) -> Prog:
  +k = find(0n, 0n, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
  +nw = succ(Nat.is_eq(k, 0n), k, 0n, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
  prog_go(8n, Nat.is_eq(nw, 0n), nw, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7, a0, a1, a2, a3, a4, a5, a6, a7,
    leafpart(0n, Nat.is_ne(k, 0n), q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7,
      Prog{1n, 0n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n, 255n}))

# Assemble the 128 bytes around the program.
def desc(p: Prog, +k8: Nat, +kind: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +e1: Nat, +e2: Nat, +e3: Nat, +e4: Nat, +e5: Nat, +e6: Nat, +e7: Nat, +a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +o0: Nat, +o1: Nat, +o2: Nat, +o3: Nat, +o4: Nat, +o5: Nat, +o6: Nat, +o7: Nat, +l0: Nat, +l1: Nat, +l2: Nat, +l3: Nat, +l4: Nat, +l5: Nat, +l6: Nat, +l7: Nat, +y0_0: Nat, +y0_1: Nat, +y0_2: Nat, +y0_3: Nat, +y0_4: Nat, +y0_5: Nat, +y0_6: Nat, +y0_7: Nat, +y1_0: Nat, +y1_1: Nat, +y1_2: Nat, +y1_3: Nat, +y1_4: Nat, +y1_5: Nat, +y1_6: Nat, +y1_7: Nat, +y2_0: Nat, +y2_1: Nat, +y2_2: Nat, +y2_3: Nat, +y2_4: Nat, +y2_5: Nat, +y2_6: Nat, +y2_7: Nat, +y3_0: Nat, +y3_1: Nat, +y3_2: Nat, +y3_3: Nat, +y3_4: Nat, +y3_5: Nat, +y3_6: Nat, +y3_7: Nat, +y4_0: Nat, +y4_1: Nat, +y4_2: Nat, +y4_3: Nat, +y4_4: Nat, +y4_5: Nat, +y4_6: Nat, +y4_7: Nat, +y5_0: Nat, +y5_1: Nat, +y5_2: Nat, +y5_3: Nat, +y5_4: Nat, +y5_5: Nat, +y5_6: Nat, +y5_7: Nat, +y6_0: Nat, +y6_1: Nat, +y6_2: Nat, +y6_3: Nat, +y6_4: Nat, +y6_5: Nat, +y6_6: Nat, +y6_7: Nat, +y7_0: Nat, +y7_1: Nat, +y7_2: Nat, +y7_3: Nat, +y7_4: Nat, +y7_5: Nat, +y7_6: Nat, +y7_7: Nat) -> Desc:
