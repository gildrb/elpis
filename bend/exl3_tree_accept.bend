# Production leaves of one ExLlamaV3 8-row tree verify round (DESIGN.md §2,
# §3(d)). Fixed scalar registers, no heap collection: verify ids t0..t7 of
# rows 0..7, tokens x1..x7 and parents q1..q7 of rows 1..7, up to four
# stop-id slots (ns used), remaining output budget and checkpoint.
#
# accept_tree walks the maximal matching path (from the root, repeatedly the
# lowest child whose token equals the current row's verify id), then decides
# with the proven chain leaf exl3_accept.accept on the linearized path
# (k = depth, targets = verify ids along the path, proposals = tokens of its
# non-root rows); last = path[count - 1]. derive computes the 128 TreeDesc
# bytes. Independent list reference: exl3_tree_accept_spec.bend; refinement
# proved in exl3_tree_accept_proof.bend.
#
# Generated by the S4 harness (gen_impl.py); edit the generator, not this file.
import Base
import ./exl3_accept.bend as Chain
import ./exl3_accept_spec.bend as ChainSpec
import ./exl3_tree_accept_spec.bend as Spec

# The verify id of row i (0 past the end).
def sel8(i: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32) -> U32:
  match i:
    case 0n:
      t0
    case 1n+i1:
      match i1:
        case 0n:
          t1
        case 1n+i2:
          match i2:
            case 0n:
              t2
            case 1n+i3:
              match i3:
                case 0n:
                  t3
                case 1n+i4:
                  match i4:
                    case 0n:
                      t4
                    case 1n+i5:
                      match i5:
                        case 0n:
                          t5
                        case 1n+i6:
                          match i6:
                            case 0n:
                              t6
                            case 1n+i7:
                              match i7:
                                case 0n:
                                  t7
                                case 1n+i8:
                                  0

# The token of row i (row 0 and rows past 7 carry none: 0).
def selx(i: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32) -> U32:
  match i:
    case 0n:
      0
    case 1n+i1:
      match i1:
        case 0n:
          x1
        case 1n+i2:
          match i2:
            case 0n:
              x2
            case 1n+i3:
              match i3:
                case 0n:
                  x3
                case 1n+i4:
                  match i4:
                    case 0n:
                      x4
                    case 1n+i5:
                      match i5:
                        case 0n:
                          x5
                        case 1n+i6:
                          match i6:
                            case 0n:
                              x6
                            case 1n+i7:
                              match i7:
                                case 0n:
                                  x7
                                case 1n+i8:
                                  0

# The row of the last committed token for count n: path[n - 1] (the root for
# n <= 1, 0 past the path); matched, never computed with Nat arithmetic.
def selprev(i: Nat, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat, +p6: Nat, +p7: Nat) -> Nat:
  match i:
    case 0n:
      0n
    case 1n+i1:
      match i1:
        case 0n:
          0n
        case 1n+i2:
          match i2:
            case 0n:
              p1
            case 1n+i3:
              match i3:
                case 0n:
                  p2
                case 1n+i4:
                  match i4:
                    case 0n:
                      p3
                    case 1n+i5:
                      match i5:
                        case 0n:
                          p4
                        case 1n+i6:
                          match i6:
                            case 0n:
                              p5
                            case 1n+i7:
                              match i7:
                                case 0n:
                                  p6
                                case 1n+i8:
                                  match i8:
                                    case 0n:
                                      p7
                                    case 1n+i9:
                                      0n

# The lowest row that is a child of cur carrying want (0 = none).
def kid(+cur: Nat, +want: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32) -> Nat:
  Spec.pick(Spec.hit(q1, x1, cur, want), 1n, Spec.pick(Spec.hit(q2, x2, cur, want), 2n, Spec.pick(Spec.hit(q3, x3, cur, want), 3n, Spec.pick(Spec.hit(q4, x4, cur, want), 4n, Spec.pick(Spec.hit(q5, x5, cur, want), 5n, Spec.pick(Spec.hit(q6, x6, cur, want), 6n, Spec.pick(Spec.hit(q7, x7, cur, want), 7n, 0n)))))))

# The matching path: d rows after the root, p1..pd (0 past d).
type Walk is Data:
  Walk{d: Nat, p1: Nat, p2: Nat, p3: Nat, p4: Nat, p5: Nat, p6: Nat, p7: Nat}

# Row 7 of the path is c (0: the path ended after 6 rows). The row is
# tested, never matched, so the leaf never rebuilds it with Nat arithmetic.
def lvl7b(end: Bool, +c: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat, +p6: Nat) -> Walk:
  match end:
    case True{}:
      Walk{6n, p1, p2, p3, p4, p5, p6, 0n}
    case False{}:
      Walk{7n, p1, p2, p3, p4, p5, p6, c}

def lvl7(+c: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat, +p6: Nat) -> Walk:
  lvl7b(Nat.is_eq(c, 0n), c, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7, p1, p2, p3, p4, p5, p6)

# Row 6 of the path is c (0: the path ended after 5 rows). The row is
# tested, never matched, so the leaf never rebuilds it with Nat arithmetic.
def lvl6b(end: Bool, +c: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat) -> Walk:
  match end:
    case True{}:
      Walk{5n, p1, p2, p3, p4, p5, 0n, 0n}
    case False{}:
      lvl7(kid(c, sel8(c, t0, t1, t2, t3, t4, t5, t6, t7), q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7, p1, p2, p3, p4, p5, c)

def lvl6(+c: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat) -> Walk:
