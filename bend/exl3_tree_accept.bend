# Program bytes so far (0xFF pad) and their count.
type Prog is Data:
  Prog{n: Nat, g0: Nat, g1: Nat, g2: Nat, g3: Nat, g4: Nat, g5: Nat, g6: Nat, g7: Nat, g8: Nat, g9: Nat, g10: Nat, g11: Nat, g12: Nat, g13: Nat, g14: Nat, g15: Nat}

# Append a program byte (a full program is left unchanged).
def put16(n: Nat, +byte: Nat, +g0: Nat, +g1: Nat, +g2: Nat, +g3: Nat, +g4: Nat, +g5: Nat, +g6: Nat, +g7: Nat, +g8: Nat, +g9: Nat, +g10: Nat, +g11: Nat, +g12: Nat, +g13: Nat, +g14: Nat, +g15: Nat) -> Prog:
  match n:
    case 0n:
      Prog{1n, byte, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
    case 1n+n1:
      match n1:
        case 0n:
          Prog{2n, g0, byte, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
        case 1n+n2:
          match n2:
            case 0n:
              Prog{3n, g0, g1, byte, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
            case 1n+n3:
              match n3:
                case 0n:
                  Prog{4n, g0, g1, g2, byte, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
                case 1n+n4:
                  match n4:
                    case 0n:
                      Prog{5n, g0, g1, g2, g3, byte, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
                    case 1n+n5:
                      match n5:
                        case 0n:
                          Prog{6n, g0, g1, g2, g3, g4, byte, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}
                        case 1n+n6:
                          match n6:
                            case 0n:
                              Prog{7n, g0, g1, g2, g3, g4, g5, byte, g7, g8, g9, g10, g11, g12, g13, g14, g15}
                            case 1n+n7:
                              match n7:
                                case 0n:
                                  Prog{8n, g0, g1, g2, g3, g4, g5, g6, byte, g8, g9, g10, g11, g12, g13, g14, g15}
                                case 1n+n8:
                                  match n8:
                                    case 0n:
                                      Prog{9n, g0, g1, g2, g3, g4, g5, g6, g7, byte, g9, g10, g11, g12, g13, g14, g15}
                                    case 1n+n9:
                                      match n9:
                                        case 0n:
                                          Prog{10n, g0, g1, g2, g3, g4, g5, g6, g7, g8, byte, g10, g11, g12, g13, g14, g15}
                                        case 1n+n10:
                                          match n10:
                                            case 0n:
                                              Prog{11n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, byte, g11, g12, g13, g14, g15}
                                            case 1n+n11:
                                              match n11:
                                                case 0n:
                                                  Prog{12n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, byte, g12, g13, g14, g15}
                                                case 1n+n12:
                                                  match n12:
                                                    case 0n:
                                                      Prog{13n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, byte, g13, g14, g15}
                                                    case 1n+n13:
                                                      match n13:
                                                        case 0n:
                                                          Prog{14n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, byte, g14, g15}
                                                        case 1n+n14:
                                                          match n14:
                                                            case 0n:
                                                              Prog{15n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, byte, g15}
                                                            case 1n+n15:
                                                              match n15:
                                                                case 0n:
                                                                  Prog{16n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, byte}
                                                                case 1n+n16:
                                                                  Prog{16n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}

def push(+byte: Nat, p: Prog) -> Prog:
  match p:
    case Prog{n, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15}:
      put16(n, byte, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15)

def app(b: Bool, +byte: Nat, p: Prog) -> Prog:
  match b:
    case True{}:
      push(byte, p)
    case False{}:
      p

# The first inner row c > lo that is a child of v (0 = none).
def find(+lo: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool) -> Nat:
  Spec.pick(Bool.and(Nat.is_lt(lo, 1n), Bool.and(Nat.is_eq(q1, v), h1)), 1n, Spec.pick(Bool.and(Nat.is_lt(lo, 2n), Bool.and(Nat.is_eq(q2, v), h2)), 2n, Spec.pick(Bool.and(Nat.is_lt(lo, 3n), Bool.and(Nat.is_eq(q3, v), h3)), 3n, Spec.pick(Bool.and(Nat.is_lt(lo, 4n), Bool.and(Nat.is_eq(q4, v), h4)), 4n, Spec.pick(Bool.and(Nat.is_lt(lo, 5n), Bool.and(Nat.is_eq(q5, v), h5)), 5n, Spec.pick(Bool.and(Nat.is_lt(lo, 6n), Bool.and(Nat.is_eq(q6, v), h6)), 6n, Spec.pick(Bool.and(Nat.is_lt(lo, 7n), Bool.and(Nat.is_eq(q7, v), h7)), 7n, 0n)))))))

# The next inner sibling of u (0 for the root or none).
def sib(root: Bool, +u: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool) -> Nat:
  match root:
    case True{}:
      0n
    case False{}:
      find(u, selq(u, q1, q2, q3, q4, q5, q6, q7), q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)

# After u's subtree: its next inner sibling s (none: 0), else climb to the
# parent (u = 0: done). Rows are tested, never matched (no Nat arithmetic).
def climb(fuel: Nat, nos: Bool, +s: Nat, root: Bool, +u: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool) -> Nat:
  match fuel:
    case 0n:
      0n
    case 1n+f:
      match nos:
        case False{}:
          s
        case True{}:
          match root:
            case True{}:
              0n
            case False{}:
              +pu = selq(u, q1, q2, q3, q4, q5, q6, q7)
              +ns = sib(Nat.is_eq(pu, 0n), pu, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
              climb(f, Nat.is_eq(ns, 0n), ns, Nat.is_eq(pu, 0n), pu, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)

# DFS preorder successor among inner rows: the first inner child k, else climb.
def succ(none: Bool, +k: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +h1: Bool, +h2: Bool, +h3: Bool, +h4: Bool, +h5: Bool, +h6: Bool, +h7: Bool) -> Nat:
  match none:
    case False{}:
      k
    case True{}:
      +ns = sib(Nat.is_eq(v, 0n), v, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)
      climb(8n, Nat.is_eq(ns, 0n), ns, Nat.is_eq(v, 0n), v, q1, q2, q3, q4, q5, q6, q7, h1, h2, h3, h4, h5, h6, h7)


# REPLAY every row of an ancestor mask, ascending (path[v] order).
def replay(+m: U32, p: Prog) -> Prog:
  app(U32.is_ne(U32.and(m, 128), 0), 55n, app(U32.is_ne(U32.and(m, 64), 0), 54n, app(U32.is_ne(U32.and(m, 32), 0), 53n, app(U32.is_ne(U32.and(m, 16), 0), 52n, app(U32.is_ne(U32.and(m, 8), 0), 51n, app(U32.is_ne(U32.and(m, 4), 0), 50n, app(U32.is_ne(U32.and(m, 2), 0), 49n, app(U32.is_ne(U32.and(m, 1), 0), 48n, p))))))))

