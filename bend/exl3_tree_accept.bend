# last = path[count - 1].
def fin(v: ChainSpec.Verdict, +p1: Nat, +p2: Nat, +p3: Nat, +p4: Nat, +p5: Nat, +p6: Nat, +p7: Nat) -> Spec.TreeVerdict:
  match v:
    case ChainSpec.Verdict{+n, e}:
      Spec.TreeVerdict{n, e, selprev(n, p1, p2, p3, p4, p5, p6, p7)}

# The chain rules on the linearized path: k = d, targets t[p_i], proposals x[p_i].
def run(w: Walk, +budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32,
    +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32) -> Spec.TreeVerdict:
  match w:
    case Walk{d, +p1, +p2, +p3, +p4, +p5, +p6, +p7}:
      fin(Chain.accept(d, budget, checkpoint, ns, s0, s1, s2, s3, t0,
        sel8(p1, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p2, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p3, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p4, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p5, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p6, t0, t1, t2, t3, t4, t5, t6, t7), sel8(p7, t0, t1, t2, t3, t4, t5, t6, t7),
        selx(p1, x1, x2, x3, x4, x5, x6, x7), selx(p2, x1, x2, x3, x4, x5, x6, x7), selx(p3, x1, x2, x3, x4, x5, x6, x7), selx(p4, x1, x2, x3, x4, x5, x6, x7), selx(p5, x1, x2, x3, x4, x5, x6, x7), selx(p6, x1, x2, x3, x4, x5, x6, x7), selx(p7, x1, x2, x3, x4, x5, x6, x7)), p1, p2, p3, p4, p5, p6, p7)

# The executed entry: all 8 rows verified, parents q_r < r (checked by the glue).
def accept_tree(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32,
    +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat) -> Spec.TreeVerdict:
  run(lvl1(kid(0n, t0, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7), budget, checkpoint, ns, s0, s1, s2,
    s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7)

# ----------------------------------------------------------------------------
# derive: the 128 TreeDesc bytes (DESIGN.md §2.2) of parents q1..q7.

# n + 1 for the small counts of a tree (depths, leaf ranks: at most 8),
# without machine arithmetic; 9 past 8 (never reached on a legal tree).
def inc(n: Nat) -> Nat:
  match n:
    case 0n:
      1n
    case 1n+n0:
      match n0:
        case 0n:
          2n
        case 1n+n01:
          match n01:
            case 0n:
              3n
            case 1n+n012:
              match n012:
                case 0n:
                  4n
                case 1n+n0123:
                  match n0123:
                    case 0n:
                      5n
                    case 1n+n01234:
                      match n01234:
                        case 0n:
                          6n
                        case 1n+n012345:
                          match n012345:
                            case 0n:
                              7n
                            case 1n+n0123456:
                              match n0123456:
                                case 0n:
                                  8n
                                case 1n+n01234567:
                                  match n01234567:
                                    case 0n:
                                      9n
                                    case 1n+n012345678:
                                      9n

# The value of row i among eight Nat registers (0 past row 7).
def sel8n(i: Nat, +a0: Nat, +a1: Nat, +a2: Nat, +a3: Nat, +a4: Nat, +a5: Nat, +a6: Nat, +a7: Nat) -> Nat:
  match i:
    case 0n:
      a0
    case 1n+i1:
      match i1:
        case 0n:
          a1
        case 1n+i2:
          match i2:
            case 0n:
              a2
            case 1n+i3:
              match i3:
                case 0n:
                  a3
                case 1n+i4:
                  match i4:
                    case 0n:
                      a4
                    case 1n+i5:
                      match i5:
                        case 0n:
                          a5
                        case 1n+i6:
                          match i6:
                            case 0n:
                              a6
                            case 1n+i7:
                              match i7:
                                case 0n:
                                  a7
                                case 1n+i8:
                                  0n

# The parent of row i (0 for the root and past row 7).
def selq(i: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat) -> Nat:
  match i:
    case 0n:
      0n
    case 1n+i1:
      match i1:
        case 0n:
          q1
        case 1n+i2:
          match i2:
            case 0n:
              q2
            case 1n+i3:
              match i3:
                case 0n:
                  q3
                case 1n+i4:
                  match i4:
                    case 0n:
                      q4
                    case 1n+i5:
                      match i5:
                        case 0n:
                          q5
                        case 1n+i6:
                          match i6:
                            case 0n:
                              q6
                            case 1n+i7:
                              match i7:
                                case 0n:
                                  q7
                                case 1n+i8:
                                  0n

type Desc is Data:
