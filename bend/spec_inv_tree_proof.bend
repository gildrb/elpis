# The verify id of a path row, as the chain round's target at row index r.
def head_eq(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +seq: List<&2, U32>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +cur: Nat, +r: Nat, hc: {Nat.is_le(cur, 7n) == True{} : Bool})
  -> {Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur) == row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r) : U32}:
  Equal.trans(U32, Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), cur), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r),
    vrow(~row, seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, cur, hc),
    Equal.trans(U32, row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), cur), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), 0n), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r),
