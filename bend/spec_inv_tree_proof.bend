            Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], c), List.append(&2, U32, Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), [Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c)]),
