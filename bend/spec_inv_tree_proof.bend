# A path row's prefix: its predecessor's plus its own token.
def pstep_cur(+seq: List<&2, U32>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +legal: {Tree.legal([q1, q2, q3, q4, q5, q6, q7], 1n) == True{} : Bool}, +c: Nat, +cur: Nat,
    lo: {Nat.is_le(1n, c) == True{} : Bool}, hi: {Nat.is_le(c, 7n) == True{} : Bool},
    peq: {Tree.parent_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c) == cur : Nat})
