def vrow(~row: List<&2, U32> -> Nat -> U32, +seq: List<&2, U32>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +cur: Nat, hc: {Nat.is_le(cur, 7n) == True{} : Bool})
