def path_targets(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +seq: List<&2, U32>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +legal: {Tree.legal([q1, q2, q3, q4, q5, q6, q7], 1n) == True{} : Bool})
