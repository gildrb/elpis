# Proofs of bend/spec_inv_tree_laws.bend. The tree round is reduced to the chain
# round of spec_inv_proof on the linearized path: along the matching path
# (exl3_tree_path_proof.W0, legal trees) every row extends its predecessor, so
# its prefix is the predecessor's plus its own token (toks, fuel by
# spec_inv_tree_fuel_proof), hence under ~rinv the path's verify ids are the
# chain round's targets for the path's tokens as drafts; the chain laws then
# give the greedy continuation, and the job invariant of spec_inv_proof carries
# over round by round. Generated by the S4 harness (gen_sit_proof.py).
import Base
import ./spec_inv_tree.bend as Impl
import ./spec_inv_tree_laws.bend as Laws
import ./spec_inv_tree_fuel_proof.bend as Fuel
import ./spec_inv_spec.bend as Spec
import ./spec_inv.bend as Chain
import ./spec_inv_laws.bend as ChainLaws
import ./spec_inv_proof.bend as SIP
import ./exl3_tree_accept_spec.bend as Tree
import ./exl3_tree_path_proof.bend as TPath
import ./exl3_accept_spec.bend as Accept
import ./exl3_accept_proof.bend as ChainProof
import ./exl3_round.bend as Round
import ./exl3_round_proof.bend as RoundProof
import ./gemm_m16_partition_proof.bend as Ar

def fst(-A: Type, -B: Type, p: A & B) -> A:
  (a, b) = p
  a

def snd(-A: Type, -B: Type, p: A & B) -> B:
  (a, b) = p
  b

def cons_eq(-a: U32, -b: U32, -as: List<&2, U32>, -bs: List<&2, U32>, ha: {a == b : U32}, hs: {as == bs : List<&2, U32>})
  -> {a <> as == b <> bs : List<&2, U32>}:
  %ha : {a <> as == _ <> bs : List<&2, U32>}
  %hs : {a <> as == a <> _ : List<&2, U32>}
  {==}

