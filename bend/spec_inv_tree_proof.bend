def t_live(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +prompt: List<&2, U32>, +stops: List<&2, U32>, +base: Nat, +interval: Nat, +B: Nat, +t: Impl.Draft,
    +legal: {Impl.legal(t) == True{} : Bool}, +position: Nat, +anchor: Nat, +ck: Nat, +o: List<&2, U32>, +b: Nat,
    h: {Spec.greedy(~row, B, stops, prompt) == List.append(&2, U32, o, Spec.greedy(~row, b, stops, List.append(&2, U32, prompt, o))) : List<&2, U32>},
    lv: {Nat.is_lt(0n, b) == True{} : Bool})
  -> SIP.Inv(~row, stops, prompt, B, Impl.round(~row, prompt, stops, base, interval, t, Chain.Run{Round.State{position, b, anchor, ck, False{}}, o})):
  match t:
    case Impl.Draft{+q1, +q2, +q3, +q4, +q5, +q6, +q7, +x1, +x2, +x3, +x4, +x5, +x6, +x7}:
      match b:
        case 0n:
          Empty.absurd(SIP.Inv(~row, stops, prompt, B, Impl.round(~row, prompt, stops, base, interval, Impl.Draft{q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7}, Chain.Run{Round.State{position, 0n, anchor, ck, False{}}, o})), Ar.ar_false_true(lv))
        case 1n+bp:
          t_live_regs(~row, ~rinv, prompt, stops, base, interval, B, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, legal, position, anchor, ck, o, bp, h)

def t_round(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +prompt: List<&2, U32>, +stops: List<&2, U32>, +base: Nat, +interval: Nat, +B: Nat, +t: Impl.Draft,
    +legal: {Impl.legal(t) == True{} : Bool}, r: Chain.Run, inv: SIP.Inv(~row, stops, prompt, B, r))
  -> SIP.Inv(~row, stops, prompt, B, Impl.round(~row, prompt, stops, base, interval, t, r)):
  match r:
    case Chain.Run{st, +o}:
      match st:
        case Round.State{+position, +b, +anchor, +ck, stopped}:
          match stopped:
            case True{}:
              (h, u) = inv
              (Equal.trans(List<&2, U32>, Spec.greedy(~row, B, stops, prompt), List.append(&2, U32, o, Nil{}),
                List.append(&2, U32, List.append(&2, U32, o, Nil{}), Nil{}), h,
                Equal.cong(List<&2, U32>, List<&2, U32>, x => List.append(&2, U32, x, Nil{}), o, List.append(&2, U32, o, Nil{}),
                  Equal.sym(List<&2, U32>, List.append(&2, U32, o, Nil{}), o, SIP.si_app_nil(o)))), Unit{})
            case False{}:
              (h, lv) = inv
              t_live(~row, ~rinv, prompt, stops, base, interval, B, t, legal, position, anchor, ck, o, b, h, lv)

def t_run(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +prompt: List<&2, U32>, +stops: List<&2, U32>, +base: Nat, +interval: Nat, +B: Nat,
    trees: List<&2, Impl.Draft>, +legal: {Impl.all_legal(trees) == True{} : Bool}, +r: Chain.Run,
    inv: SIP.Inv(~row, stops, prompt, B, r))
  -> SIP.Inv(~row, stops, prompt, B, Impl.run(~row, prompt, stops, base, interval, trees, r)):
  match trees:
    case Nil{}:
      inv
    case +t <> rest:
      t_run(~row, ~rinv, prompt, stops, base, interval, B, rest,
        TPath.and_r(Impl.legal(t), Impl.all_legal(rest), legal),
        Impl.round(~row, prompt, stops, base, interval, t, r),
        t_round(~row, ~rinv, prompt, stops, base, interval, B, t, TPath.and_l(Impl.legal(t), Impl.all_legal(rest), legal), r, inv))

def Laws.tree_prefix_of_greedy(row, rinv, prompt, stops, base, interval, trees, position, budget, anchor, checkpoint, positive, legal):
  SIP.si_law1(~row, stops, prompt, budget,
    Impl.job(~row, prompt, stops, base, interval, trees, position, budget, anchor, checkpoint),
    t_run(~row, ~rinv, prompt, stops, base, interval, budget, trees, legal,
      Chain.Run{Round.State{position, budget, anchor, checkpoint, False{}}, Nil{}},
      SIP.si_inv_start(~row, prompt, stops, budget, position, anchor, checkpoint, positive)))

def Laws.tree_row_index_leak_differs():
  ({==}, {==}, {==}, {==})
