def Laws.tree_round_commits_greedy(row, rinv, seq, t, stops, bp, checkpoint, legal):
  match t:
    case Impl.Draft{+q1, +q2, +q3, +q4, +q5, +q6, +q7, +x1, +x2, +x3, +x4, +x5, +x6, +x7}:
      t0_regs(~row, ~rinv, seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, stops, bp, checkpoint, legal)

def writes_mono(+n: Nat, +w: Nat, +w2: Nat, +h: {Round.writes(n, w) == True{} : Bool}, le: {Nat.is_le(w, w2) == True{} : Bool})
  -> {Round.writes(n, w2) == True{} : Bool}:
  TPath.and_t(Nat.is_lt(0n, n), Nat.is_le(n, 1n+w2),
    TPath.and_l(Nat.is_lt(0n, n), Nat.is_le(n, 1n+w), h),
    Ar.ar_le_trans(n, 1n+w, 1n+w2, TPath.and_r(Nat.is_lt(0n, n), Nat.is_le(n, 1n+w), h), le))

def walk_len(+f: Nat, +c: Nat, +nodes: List<&2, Tree.Node>, +verify: List<&2, U32>)
  -> {Nat.is_le(List.length(&2, Nat, Tree.walk(f, c, nodes, verify)), f) == True{} : Bool}:
  match f:
    case 0n:
      {==}
    case 1n+g:
      match c:
        case 0n:
          {==}
        case 1n+cp:
          walk_len(g, Tree.child(nodes, 1n, 1n+cp, Tree.id_at(verify, 1n+cp)), nodes, verify)

def tfin_inv(~row: List<&2, U32> -> Nat -> U32, +stops: List<&2, U32>, +prompt: List<&2, U32>, +B: Nat, +base: Nat, +interval: Nat, +position: Nat, +anchor: Nat,
    +ck: Nat, +o: List<&2, U32>, +bp: Nat, +ts: List<&2, U32>, v: Accept.Verdict, -ps: List<&2, Nat>,
    h: SIP.Inv(~row, stops, prompt, B, Chain.Run{Round.commit(Round.writes(Accept.count(v), 7n), Accept.count(v), Accept.eos(v), 7n, base, interval, position, 1n+bp, anchor, ck), List.append(&2, U32, o, List.take(&2, U32, ts, Accept.count(v)))}))
  -> SIP.Inv(~row, stops, prompt, B, Chain.Run{Round.commit(Round.writes(Tree.count(Tree.finish(v, ps)), 7n), Tree.count(Tree.finish(v, ps)), Tree.eos(Tree.finish(v, ps)), 7n, base, interval, position, 1n+bp, anchor, ck), List.append(&2, U32, o, List.take(&2, U32, ts, Tree.count(Tree.finish(v, ps))))}):
  match v:
    case Accept.Verdict{n, e}:
      h

