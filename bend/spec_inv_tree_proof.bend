  %peq : {Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], c) == List.append(&2, U32, Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], _), [Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c)]) : List<&2, U32>}
  pstep(seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, legal, c, lo, hi)

# Along a matching path from row cur, the verify ids are the chain round's
# targets for the path's tokens as drafts, starting at cur's prefix.
def TG(~row: List<&2, U32> -> Nat -> U32, ~rinv: @p:List<&2, U32> -> @r:Nat -> {row(p, r) == row(p, 0n) : U32}, +seq: List<&2, U32>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +legal: {Tree.legal([q1, q2, q3, q4, q5, q6, q7], 1n) == True{} : Bool}, +ws: List<&2, Nat>, +cur: Nat, +r: Nat,
    +hc: {Nat.is_le(cur, 7n) == True{} : Bool}, +h: {Tree.pext(ws, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur) == True{} : Bool})
  -> {Tree.targets(cur <> ws, Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}])) == Chain.targets(~row, Tree.proposals(ws, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r) : List<&2, U32>}:
  match ws:
    case Nil{}:
      Equal.cong(U32, List<&2, U32>, y => [y], Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r),
        head_eq(~row, ~rinv, seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, cur, r, hc))
    case +c <> rest:
      +ext = TPath.and_l(Tree.extends([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur, c), Tree.pext(rest, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), c), h)
      +bnd = TPath.and_l(Bool.and(Nat.is_le(1n, c), Nat.is_le(c, 7n)), Tree.hit(Tree.parent_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), cur, Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur)), ext)
      +hitv = TPath.and_r(Bool.and(Nat.is_le(1n, c), Nat.is_le(c, 7n)), Tree.hit(Tree.parent_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), cur, Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur)), ext)
      +lo = TPath.and_l(Nat.is_le(1n, c), Nat.is_le(c, 7n), bnd)
      +hi = TPath.and_r(Nat.is_le(1n, c), Nat.is_le(c, 7n), bnd)
      +peq = Ar.ar_eq_true(Tree.parent_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), cur,
        TPath.and_l(Nat.is_eq(Tree.parent_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), cur), U32.is_eq(Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c), Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur)), hitv))
      cons_eq(Tree.id_at(Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur), row(Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), r), Tree.targets(c <> rest, Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}])),
        Chain.targets(~row, Tree.proposals(rest, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), List.append(&2, U32, Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), [Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c)]), 1n+r),
        head_eq(~row, ~rinv, seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, cur, r, hc),
        Equal.trans(List<&2, U32>, Tree.targets(c <> rest, Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}])),
          Chain.targets(~row, Tree.proposals(rest, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], c), 1n+r),
          Chain.targets(~row, Tree.proposals(rest, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), List.append(&2, U32, Impl.prefix(seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], cur), [Tree.token_at([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], 1n, c)]), 1n+r),
          TG(~row, ~rinv, seq, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7, legal, rest, c, 1n+r, hi, TPath.and_r(Tree.extends([Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), cur, c), Tree.pext(rest, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}], Impl.verify(~row, seq, [Tree.Node{q1, x1}, Tree.Node{q2, x2}, Tree.Node{q3, x3}, Tree.Node{q4, x4}, Tree.Node{q5, x5}, Tree.Node{q6, x6}, Tree.Node{q7, x7}]), c), h)),
