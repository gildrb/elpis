# Proofs of bend/exl3_tree_accept_laws.bend. Structural evidence only: no
# unsafe definitions, axioms, holes or foreign proof code. Generated by the S4
# harness (gen_proof.py); the refinement walks the path level by level (a case
# split on each row of the path), reusing the chain leaf's leaf_refinement at
# the end of the path.
import Base
import ./exl3_tree_accept.bend as Impl
import ./exl3_tree_accept_spec.bend as Spec
import ./exl3_tree_accept_laws.bend as Laws
import ./exl3_accept.bend as Chain
import ./exl3_accept_spec.bend as ChainSpec
import ./exl3_accept_laws.bend as ChainLaws
import ./exl3_accept_proof.bend as ChainProof

# ---------------------------------------------------------------- selects

# Register selects agree with the list reference's lookups for every index.
def sel_id(+i: Nat, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32)
  -> {Impl.sel8(i, t0, t1, t2, t3, t4, t5, t6, t7) == Spec.id_at([t0, t1, t2, t3, t4, t5, t6, t7], i) : U32}:
  match i:
    case 0n:
      {==}
    case 1n+i0:
      match i0:
        case 0n:
          {==}
        case 1n+i01:
          match i01:
            case 0n:
              {==}
            case 1n+i012:
              match i012:
                case 0n:
                  {==}
                case 1n+i0123:
                  match i0123:
                    case 0n:
                      {==}
                    case 1n+i01234:
                      match i01234:
                        case 0n:
                          {==}
                        case 1n+i012345:
                          match i012345:
                            case 0n:
                              {==}
                            case 1n+i0123456:
                              match i0123456:
                                case 0n:
                                  {==}
                                case 1n+i01234567:
                                  {==}

def selx_tok(+i: Nat, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat)
  -> {Impl.selx(i, x1, x2, x3, x4, x5, x6, x7) == Spec.token_at([Spec.Node{q1, x1}, Spec.Node{q2, x2}, Spec.Node{q3, x3}, Spec.Node{q4, x4}, Spec.Node{q5, x5}, Spec.Node{q6, x6}, Spec.Node{q7, x7}], 1n, i) : U32}:
  match i:
    case 0n:
      {==}
    case 1n+i0:
      match i0:
        case 0n:
          {==}
        case 1n+i01:
          match i01:
            case 0n:
              {==}
            case 1n+i012:
              match i012:
                case 0n:
                  {==}
                case 1n+i0123:
                  match i0123:
                    case 0n:
                      {==}
                    case 1n+i01234:
                      match i01234:
                        case 0n:
                          {==}
                        case 1n+i012345:
                          match i012345:
                            case 0n:
                              {==}
                            case 1n+i0123456:
                              match i0123456:
                                case 0n:
                                  {==}
                                case 1n+i01234567:
                                  {==}

# The linearized path through the register selects.
def tsel(ps: List<&2, Nat>, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32) -> List<&2, U32>:
  match ps:
    case Nil{}:
      Nil{}
    case r <> rest:
      Impl.sel8(r, t0, t1, t2, t3, t4, t5, t6, t7) <> tsel(rest, t0, t1, t2, t3, t4, t5, t6, t7)

def xsel(ps: List<&2, Nat>, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32) -> List<&2, U32>:
  match ps:
    case Nil{}:
      Nil{}
    case r <> rest:
      Impl.selx(r, x1, x2, x3, x4, x5, x6, x7) <> xsel(rest, x1, x2, x3, x4, x5, x6, x7)

def tsel_targets(ps: List<&2, Nat>, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32)
  -> {tsel(ps, t0, t1, t2, t3, t4, t5, t6, t7) == Spec.targets(ps, [t0, t1, t2, t3, t4, t5, t6, t7]) : List<&2, U32>}:
  match ps:
    case Nil{}:
      {==}
    case +r <> rest:
      %sel_id(r, t0, t1, t2, t3, t4, t5, t6, t7) : {Impl.sel8(r, t0, t1, t2, t3, t4, t5, t6, t7) <> tsel(rest, t0, t1, t2, t3, t4, t5, t6, t7) == _ <> Spec.targets(rest, [t0, t1, t2, t3, t4, t5, t6, t7]) : List<&2, U32>}
      %tsel_targets(rest, t0, t1, t2, t3, t4, t5, t6, t7) : {Impl.sel8(r, t0, t1, t2, t3, t4, t5, t6, t7) <> tsel(rest, t0, t1, t2, t3, t4, t5, t6, t7) == Impl.sel8(r, t0, t1, t2, t3, t4, t5, t6, t7) <> _ : List<&2, U32>}
      {==}

def xsel_proposals(ps: List<&2, Nat>, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat)
  -> {xsel(ps, x1, x2, x3, x4, x5, x6, x7) == Spec.proposals(ps, [Spec.Node{q1, x1}, Spec.Node{q2, x2}, Spec.Node{q3, x3}, Spec.Node{q4, x4}, Spec.Node{q5, x5}, Spec.Node{q6, x6}, Spec.Node{q7, x7}]) : List<&2, U32>}:
  match ps:
    case Nil{}:
      {==}
    case +r <> rest:
      %selx_tok(r, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7) : {Impl.selx(r, x1, x2, x3, x4, x5, x6, x7) <> xsel(rest, x1, x2, x3, x4, x5, x6, x7) == _ <> Spec.proposals(rest, [Spec.Node{q1, x1}, Spec.Node{q2, x2}, Spec.Node{q3, x3}, Spec.Node{q4, x4}, Spec.Node{q5, x5}, Spec.Node{q6, x6}, Spec.Node{q7, x7}]) : List<&2, U32>}
      %xsel_proposals(rest, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7) : {Impl.selx(r, x1, x2, x3, x4, x5, x6, x7) <> xsel(rest, x1, x2, x3, x4, x5, x6, x7) == Impl.selx(r, x1, x2, x3, x4, x5, x6, x7) <> _ : List<&2, U32>}
      {==}

# ---------------------------------------------------------------- path ends

def selp_row0(+i: Nat)
  -> {Impl.selprev(i, 0n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.row_at([0n], Nat.sub(i, 1n)) : Nat}:
  match i:
    case 0n:
      {==}
    case 1n+i0:
      match i0:
        case 0n:
          {==}
        case 1n+i01:
          match i01:
            case 0n:
              {==}
            case 1n+i012:
              match i012:
                case 0n:
                  {==}
                case 1n+i0123:
                  match i0123:
                    case 0n:
                      {==}
                    case 1n+i01234:
                      match i01234:
                        case 0n:
                          {==}
                        case 1n+i012345:
                          match i012345:
                            case 0n:
                              {==}
                            case 1n+i0123456:
                              match i0123456:
                                case 0n:
                                  {==}
                                case 1n+i01234567:
                                  match i01234567:
                                    case 0n:
                                      {==}
                                    case 1n+i012345678:
                                      {==}

def fin_finish0(v: ChainSpec.Verdict)
  -> {Impl.fin(v, 0n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.finish(v, [0n]) : Spec.TreeVerdict}:
  match v:
    case ChainSpec.Verdict{+n, e}:
      %selp_row0(n) : {Spec.TreeVerdict{n, e, Impl.selprev(n, 0n, 0n, 0n, 0n, 0n, 0n, 0n)} == Spec.TreeVerdict{n, e, _} : Spec.TreeVerdict}
      {==}

# A path of 0 rows after the root: the chain leaf with k = 0 on the linearized path.
