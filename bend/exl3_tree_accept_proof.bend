# Row 1 of the path is c (0: the path ended after 0 rows).
def lvl1_ok(+c: Nat, +budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat)
