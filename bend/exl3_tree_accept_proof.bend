                    case 0n:
                      lvl2_ok(Impl.kid(4n, Impl.sel8(4n, t0, t1, t2, t3, t4, t5, t6, t7), q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7, 4n)
