      fin_chain4(Chain.accept(4n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t0, t0, t0, x1, x2, x3, x4, 0, 0, 0), bound4(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7))

# Row 4 of the chain matches (b) or the path ends after 3 rows.
def cr4(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, b: Bool, hb: {U32.is_eq(x4, t3) == b : Bool})
  -> {Impl.run(Impl.lvl4(Spec.pick(b, 4n, 0n), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, 0n, 1n, 2n, 3n, 4n, 5n, 6n, 1n, 2n, 3n), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7) == Spec.from_chain(Chain.accept(7n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7)) : Spec.TreeVerdict}:
  match b:
    case True{}:
      cr5(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, U32.is_eq(x5, t4), {==})
    case False{}:
      %cut3(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, hb) : {Impl.fin(Chain.accept(3n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t0, t0, t0, t0, x1, x2, x3, 0, 0, 0, 0), 1n, 2n, 3n, 0n, 0n, 0n, 0n) == Spec.from_chain(_) : Spec.TreeVerdict}
      fin_chain3(Chain.accept(3n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t0, t0, t0, t0, x1, x2, x3, 0, 0, 0, 0), bound3(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7))

# Row 3 of the chain matches (b) or the path ends after 2 rows.
def cr3(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, b: Bool, hb: {U32.is_eq(x3, t2) == b : Bool})
  -> {Impl.run(Impl.lvl3(Spec.pick(b, 3n, 0n), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, 0n, 1n, 2n, 3n, 4n, 5n, 6n, 1n, 2n), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7) == Spec.from_chain(Chain.accept(7n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7)) : Spec.TreeVerdict}:
  match b:
    case True{}:
      cr4(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, U32.is_eq(x4, t3), {==})
    case False{}:
      %cut2(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, hb) : {Impl.fin(Chain.accept(2n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t0, t0, t0, t0, t0, x1, x2, 0, 0, 0, 0, 0), 1n, 2n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(_) : Spec.TreeVerdict}
      fin_chain2(Chain.accept(2n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t0, t0, t0, t0, t0, x1, x2, 0, 0, 0, 0, 0), bound2(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7))

# Row 2 of the chain matches (b) or the path ends after 1 rows.
def cr2(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, b: Bool, hb: {U32.is_eq(x2, t1) == b : Bool})
  -> {Impl.run(Impl.lvl2(Spec.pick(b, 2n, 0n), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, 0n, 1n, 2n, 3n, 4n, 5n, 6n, 1n), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7) == Spec.from_chain(Chain.accept(7n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7)) : Spec.TreeVerdict}:
  match b:
    case True{}:
      cr3(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, U32.is_eq(x3, t2), {==})
    case False{}:
      %cut1(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, hb) : {Impl.fin(Chain.accept(1n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t0, t0, t0, t0, t0, t0, x1, 0, 0, 0, 0, 0, 0), 1n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(_) : Spec.TreeVerdict}
      fin_chain1(Chain.accept(1n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t0, t0, t0, t0, t0, t0, x1, 0, 0, 0, 0, 0, 0), bound1(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7))

# Row 1 of the chain matches (b) or the path ends after 0 rows.
def cr1(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, b: Bool, hb: {U32.is_eq(x1, t0) == b : Bool})
  -> {Impl.run(Impl.lvl1(Spec.pick(b, 1n, 0n), t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, 0n, 1n, 2n, 3n, 4n, 5n, 6n), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7) == Spec.from_chain(Chain.accept(7n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7)) : Spec.TreeVerdict}:
  match b:
    case True{}:
      cr2(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, U32.is_eq(x2, t1), {==})
    case False{}:
      %cut0(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, hb) : {Impl.fin(Chain.accept(0n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t0, t0, t0, t0, t0, t0, t0, 0, 0, 0, 0, 0, 0, 0), 0n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(_) : Spec.TreeVerdict}
      fin_chain0(Chain.accept(0n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t0, t0, t0, t0, t0, t0, t0, 0, 0, 0, 0, 0, 0, 0), bound0(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7))

def Laws.chain_reduction(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7):
  cr1(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, U32.is_eq(x1, t0), {==})

