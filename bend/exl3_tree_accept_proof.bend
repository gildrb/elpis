# ---------------------------------------------------------------- laws

def Laws.tree_refinement(budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7):
  lvl1_ok(Impl.kid(0n, t0, q1, q2, q3, q4, q5, q6, q7, x1, x2, x3, x4, x5, x6, x7), budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7, q1, q2, q3, q4, q5, q6, q7)

# ---------------------------------------------------------------- the chain shape

def left(-P: Type, -Q: Type, pq: P & Q) -> P:
  (a, b) = pq
  a

# A final position and a rejecting position decide alike after any prefix.
def dcut(F: List<&2, ChainSpec.Facts>, +s: Bool, +e: Bool, -G: List<&2, ChainSpec.Facts>, +c: Nat)
  -> {ChainSpec.decide(List.append(&2, ChainSpec.Facts, F, [ChainSpec.Facts{s, e, True{}, False{}}]), c) ==
    ChainSpec.decide(List.append(&2, ChainSpec.Facts, F, ChainSpec.Facts{s, e, False{}, True{}} <> G), c) : ChainSpec.Verdict}:
  match F:
    case Nil{}:
      match s:
        case True{}:
          {==}
        case False{}:
          match e:
            case True{}:
              {==}
            case False{}:
              {==}
    case ChainSpec.Facts{s1, e1, f1, r1} <> rest:
      match s1:
        case True{}:
          {==}
        case False{}:
          match e1:
            case True{}:
              {==}
            case False{}:
              match f1:
                case True{}:
                  {==}
                case False{}:
                  match r1:
                    case True{}:
                      {==}
                    case False{}:
                      dcut(rest, s, e, G, 1n+c)

