def selp_row1(+i: Nat, +p1: Nat)
  -> {Impl.selprev(i, p1, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.row_at([0n, p1], Nat.sub(i, 1n)) : Nat}:
  match i:
    case 0n:
      {==}
    case 1n+i0:
      match i0:
        case 0n:
          {==}
        case 1n+i01:
          match i01:
            case 0n:
              {==}
            case 1n+i012:
              match i012:
                case 0n:
                  {==}
                case 1n+i0123:
                  match i0123:
                    case 0n:
                      {==}
                    case 1n+i01234:
                      match i01234:
                        case 0n:
                          {==}
                        case 1n+i012345:
                          match i012345:
                            case 0n:
                              {==}
                            case 1n+i0123456:
                              match i0123456:
                                case 0n:
                                  {==}
                                case 1n+i01234567:
                                  match i01234567:
                                    case 0n:
                                      {==}
                                    case 1n+i012345678:
                                      {==}

def fin_finish1(v: ChainSpec.Verdict, +p1: Nat)
  -> {Impl.fin(v, p1, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.finish(v, [0n, p1]) : Spec.TreeVerdict}:
  match v:
    case ChainSpec.Verdict{+n, e}:
      %selp_row1(n, p1) : {Spec.TreeVerdict{n, e, Impl.selprev(n, p1, 0n, 0n, 0n, 0n, 0n, 0n)} == Spec.TreeVerdict{n, e, _} : Spec.TreeVerdict}
      {==}

# A path of 1 rows after the root: the chain leaf with k = 1 on the linearized path.
def leaf1(+budget: Nat, +checkpoint: Nat, +ns: Nat, +s0: U32, +s1: U32, +s2: U32, +s3: U32, +t0: U32, +t1: U32, +t2: U32, +t3: U32, +t4: U32, +t5: U32, +t6: U32, +t7: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +p1: Nat)
  -> {Impl.run(Impl.Walk{1n, p1, 0n, 0n, 0n, 0n, 0n, 0n}, budget, checkpoint, ns, s0, s1, s2, s3, t0, t1, t2, t3, t4, t5, t6, t7, x1, x2, x3, x4, x5, x6, x7) == Spec.linear([0n, p1], [Spec.Node{q1, x1}, Spec.Node{q2, x2}, Spec.Node{q3, x3}, Spec.Node{q4, x4}, Spec.Node{q5, x5}, Spec.Node{q6, x6}, Spec.Node{q7, x7}], [t0, t1, t2, t3, t4, t5, t6, t7], List.take(&2, U32, [s0, s1, s2, s3], ns), budget, checkpoint) : Spec.TreeVerdict}:
