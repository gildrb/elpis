  %Equal.sym(ChainSpec.Verdict, Chain.accept(0n, budget, checkpoint, ns, s0, s1, s2, s3, t0, t0, t0, t0, t0, t0, t0, t0, 0, 0, 0, 0, 0, 0, 0), ChainSpec.accept([t0], [], List.take(&2, U32, [s0, s1, s2, s3], ns), budget, checkpoint), ChainLaws.leaf_refinement(0n, {==}, budget, checkpoint, ns, s0, s1, s2, s3, t0, t0, t0, t0, t0, t0, t0, t0, 0, 0, 0, 0, 0, 0, 0)) : {Nat.is_le(ChainSpec.count(_), 1n) == True{} : Bool}
