  match v:
    case ChainSpec.Verdict{+n, e}:
      match n:
        case 0n:
          {==}
        case 1n+m:
          match m:
            case 0n:
              {==}
            case 1n+m0:
              match m0:
                case 0n:
                  {==}
                case 1n+m01:
                  Empty.absurd({Impl.fin(ChainSpec.Verdict{1n+m, e}, 1n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(ChainSpec.Verdict{1n+m, e}) : Spec.TreeVerdict}, ChainProof.false_true(bound))

