    ChainLaws.accept_bounds([t0], [], List.take(&2, U32, [s0, s1, s2, s3], ns), budget, checkpoint, {==}))

def fin_chain0(v: ChainSpec.Verdict, bound: {Nat.is_le(ChainSpec.count(v), 1n) == True{} : Bool})
  -> {Impl.fin(v, 0n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(v) : Spec.TreeVerdict}:
  match v:
    case ChainSpec.Verdict{+n, e}:
      match n:
        case 0n:
          {==}
        case 1n+m:
          match m:
            case 0n:
              {==}
            case 1n+m0:
              Empty.absurd({Impl.fin(ChainSpec.Verdict{1n+m, e}, 0n, 0n, 0n, 0n, 0n, 0n, 0n) == Spec.from_chain(ChainSpec.Verdict{1n+m, e}) : Spec.TreeVerdict}, ChainProof.false_true(bound))

