# Rendering of the tree acceptance table (DESIGN.md §3(d) admission), shared by
# EXL3_TREE_ACCEPT.bend (production leaves) and EXL3_TREE_ACCEPT_SPEC.bend (list
# reference) through templates, so both print byte-identical text exactly when
# the two implementations agree on every cell.
#
# One line per legal parent array q1..q7 (q_r < r, lexicographic):
#   "S <q1..q7> <D> <W> <R>"
# D: the 128 derive bytes, hex. Verify id of row r is 100 + r.
# W: for match mask m = 0..127 (bit r - 1 set: token of row r equals its parent's
#    verify id, else 99), budget 262144, checkpoint 0, no stop slots used (the
#    slots hold 100..103): the verdict glyph. This covers every path the walk can take.
# R: mask 127, the chain rules along the lowest-child path: budget 1..9 x
#    checkpoint 0..7; one stop slot holding row r's verify id (r = 0..7); stop
#    counts 0..4 over slots [107, 106, 105, 104].
# Glyph: chr(64 + 2 * count + eos) then chr(48 + last).
#
# Generated by the S4 harness (gen_table.py).
import Base
import ./exl3_tree_accept_spec.bend as Spec

def hex_digit(+n: Nat) -> Char:
  Char.from_u32((U32.add(U32.from_nat(n), U32.mul(U32.from_nat(Nat.div(n, 10n)), 39)) + 48 : U32))

def hex_bytes(bs: List<&2, Nat>, rest: String) -> String:
  match bs:
    case Nil{}:
      rest
    case +b <> more:
      SCon{hex_digit(Nat.div(b, 16n)), SCon{hex_digit(Nat.mod(b, 16n)), hex_bytes(more, rest)}}

def glyph(v: Spec.TreeVerdict, rest: String) -> String:
  match v:
    case Spec.TreeVerdict{n, e, l}:
      match e:
        case False{}:
          SCon{Char.from_u32((U32.from_nat(Nat.double(n)) + 64 : U32)),
            SCon{Char.from_u32((U32.from_nat(l) + 48 : U32)), rest}}
        case True{}:
          SCon{Char.from_u32((U32.from_nat(Nat.double(n)) + 65 : U32)),
            SCon{Char.from_u32((U32.from_nat(l) + 48 : U32)), rest}}

def digit(n: Nat, rest: String) -> String:
  SCon{Char.from_u32((U32.from_nat(n) + 48 : U32)), rest}

# Parent's verify id for a matching token.
def vid(q: Nat) -> U32:
  (U32.from_nat(q) + 100 : U32)

def wcells1(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, rest: String) -> String:
  glyph(acc(q1, q2, q3, q4, q5, q6, q7, 262144n, 0n, 0n, 100, 101, 102, 103, 100, 101, 102, 103, 104, 105, 106, 107, 99, x2, x3, x4, x5, x6, x7),
    glyph(acc(q1, q2, q3, q4, q5, q6, q7, 262144n, 0n, 0n, 100, 101, 102, 103, 100, 101, 102, 103, 104, 105, 106, 107, vid(q1), x2, x3, x4, x5, x6, x7), rest))

def wcells2(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, rest: String) -> String:
  wcells1(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99, x3, x4, x5, x6, x7,
    wcells1(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q2), x3, x4, x5, x6, x7, rest))

def wcells3(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x4: U32, +x5: U32, +x6: U32, +x7: U32, rest: String) -> String:
  wcells2(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99, x4, x5, x6, x7,
    wcells2(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q3), x4, x5, x6, x7, rest))

def wcells4(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x5: U32, +x6: U32, +x7: U32, rest: String) -> String:
  wcells3(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99, x5, x6, x7,
    wcells3(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q4), x5, x6, x7, rest))

def wcells5(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x6: U32, +x7: U32, rest: String) -> String:
  wcells4(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99, x6, x7,
    wcells4(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q5), x6, x7, rest))

def wcells6(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, +x7: U32, rest: String) -> String:
  wcells5(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99, x7,
    wcells5(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q6), x7, rest))

def wcells7(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  wcells6(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, 99,
    wcells6(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, vid(q7), rest))

def rcp(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, n: Nat, +b: Nat, +cp: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  match n:
    case 0n:
      rest
    case 1n+m:
      glyph(acc(q1, q2, q3, q4, q5, q6, q7, b, cp, 0n, 100, 101, 102, 103, 100, 101, 102, 103, 104, 105, 106, 107, vid(q1), vid(q2), vid(q3), vid(q4), vid(q5), vid(q6), vid(q7)),
        rcp(~acc, ~der, m, b, 1n+cp, q1, q2, q3, q4, q5, q6, q7, rest))

def rbud(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, n: Nat, +b: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  match n:
    case 0n:
      rest
    case 1n+m:
      rcp(~acc, ~der, 8n, b, 0n, q1, q2, q3, q4, q5, q6, q7, rbud(~acc, ~der, m, 1n+b, q1, q2, q3, q4, q5, q6, q7, rest))

def rstop(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, n: Nat, +r: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  match n:
    case 0n:
      rest
    case 1n+m:
      glyph(acc(q1, q2, q3, q4, q5, q6, q7, 262144n, 0n, 1n, vid(r), 107, 106, 105, 100, 101, 102, 103, 104, 105, 106, 107, vid(q1), vid(q2), vid(q3), vid(q4), vid(q5), vid(q6), vid(q7)),
        rstop(~acc, ~der, m, 1n+r, q1, q2, q3, q4, q5, q6, q7, rest))

def rns(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, n: Nat, +k: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  match n:
    case 0n:
      rest
    case 1n+m:
      glyph(acc(q1, q2, q3, q4, q5, q6, q7, 262144n, 0n, k, 107, 106, 105, 104, 100, 101, 102, 103, 104, 105, 106, 107, vid(q1), vid(q2), vid(q3), vid(q4), vid(q5), vid(q6), vid(q7)),
        rns(~acc, ~der, m, 1n+k, q1, q2, q3, q4, q5, q6, q7, rest))

def rcells(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat, rest: String) -> String:
  rbud(~acc, ~der, 9n, 1n, q1, q2, q3, q4, q5, q6, q7, rstop(~acc, ~der, 8n, 0n, q1, q2, q3, q4, q5, q6, q7, rns(~acc, ~der, 5n, 0n, q1, q2, q3, q4, q5, q6, q7, rest)))

def line(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat, +q7: Nat) -> String:
  "S " ++ digit(q1, digit(q2, digit(q3, digit(q4, digit(q5, digit(q6, digit(q7, " ")))))))
    ++ hex_bytes(der(q1, q2, q3, q4, q5, q6, q7), " ")
    ++ wcells7(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, " ")
    ++ rcells(~acc, ~der, q1, q2, q3, q4, q5, q6, q7, "")

def level7(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat, +q6: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        IO.print(line(~acc, ~der, q1, q2, q3, q4, q5, q6, v))
        level7(~acc, ~der, more, 1n+v, q1, q2, q3, q4, q5, q6)

def level6(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat, +q5: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level7(~acc, ~der, 7n, 0n, q1, q2, q3, q4, q5, v)
        level6(~acc, ~der, more, 1n+v, q1, q2, q3, q4, q5)

def level5(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat, +q4: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level6(~acc, ~der, 6n, 0n, q1, q2, q3, q4, v)
        level5(~acc, ~der, more, 1n+v, q1, q2, q3, q4)

def level4(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat, +q2: Nat, +q3: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level5(~acc, ~der, 5n, 0n, q1, q2, q3, v)
        level4(~acc, ~der, more, 1n+v, q1, q2, q3)

def level3(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat, +q2: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level4(~acc, ~der, 4n, 0n, q1, q2, v)
        level3(~acc, ~der, more, 1n+v, q1, q2)

def level2(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat, +q1: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level3(~acc, ~der, 3n, 0n, q1, v)
        level2(~acc, ~der, more, 1n+v, q1)

def level1(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>, count: Nat, +v: Nat) -> IO(Unit):
  match count:
    case 0n:
      IO.pure(Unit, Unit{})
    case 1n+more:
      do IO<Unit>:
        level2(~acc, ~der, 2n, 0n, v)
        level1(~acc, ~der, more, 1n+v)

def table(~acc: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Spec.TreeVerdict, ~der: Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> Nat -> List<&2, Nat>) -> IO(Unit):
  do IO<Unit>:
    IO.print("EXL3_TREE_ACCEPT_V1")
    level1(~acc, ~der, 1n, 0n)
    IO.print("END_EXL3_TREE_ACCEPT")
