def nb1_1(+q: Nat, +x: U32, +want: U32, lt: {Nat.is_lt(q, 1n) == True{} : Bool})
  -> {Spec.hit(q, x, 1n, want) == False{} : Bool}:
  match q:
    case 0n:
      {==}
    case 1n+q0:
      match q0:
        case 0n:
          Empty.absurd({Spec.hit(1n, x, 1n, want) == False{} : Bool}, ChainProof.false_true(lt))
        case 1n+q0x:
          Empty.absurd({Spec.hit(Nat.add(2n, q0x), x, 1n, want) == False{} : Bool}, ChainProof.false_true(lt))

