# ---------------------------------------------------------------- the verdict on the path

def fin_count(v: ChainSpec.Verdict, -ps: List<&2, Nat>) -> {ChainSpec.count(v) == Spec.count(Spec.finish(v, ps)) : Nat}:
  match v:
    case ChainSpec.Verdict{n, e}:
      {==}

def fin_last(v: ChainSpec.Verdict, +ps: List<&2, Nat>)
  -> {Spec.last(Spec.finish(v, ps)) == Spec.row_at(ps, Nat.sub(Spec.count(Spec.finish(v, ps)), 1n)) : Nat}:
  match v:
    case ChainSpec.Verdict{+n, e}:
      {==}

def fin_ends(v: ChainSpec.Verdict, -ps: List<&2, Nat>, +cp: Nat, +len: Nat)
  -> {Bool.or(ChainSpec.eos(v), Bool.or(Nat.is_eq(ChainSpec.count(v), cp), Nat.is_eq(ChainSpec.count(v), len))) ==
    Bool.or(Spec.eos(Spec.finish(v, ps)), Bool.or(Nat.is_eq(Spec.count(Spec.finish(v, ps)), cp), Nat.is_eq(Spec.count(Spec.finish(v, ps)), len))) : Bool}:
  match v:
    case ChainSpec.Verdict{n, e}:
      {==}

def len_targets(ps: List<&2, Nat>, +verify: List<&2, U32>)
  -> {List.length(&2, U32, Spec.targets(ps, verify)) == List.length(&2, Nat, ps) : Nat}:
  match ps:
    case Nil{}:
      {==}
    case r <> rest:
      %len_targets(rest, verify) : {1n+List.length(&2, U32, Spec.targets(rest, verify)) == 1n+_ : Nat}
      {==}

def len_proposals(ps: List<&2, Nat>, +nodes: List<&2, Spec.Node>)
  -> {List.length(&2, U32, Spec.proposals(ps, nodes)) == List.length(&2, Nat, ps) : Nat}:
  match ps:
    case Nil{}:
      {==}
    case r <> rest:
      %len_proposals(rest, nodes) : {1n+List.length(&2, U32, Spec.proposals(rest, nodes)) == 1n+_ : Nat}
      {==}

# The linearization of a path (root first) is well shaped for the chain laws.
def shaped(+ws: List<&2, Nat>, +nodes: List<&2, Spec.Node>, +verify: List<&2, U32>)
  -> {List.length(&2, U32, Spec.targets(0n <> ws, verify)) == 1n+List.length(&2, U32, Spec.proposals(ws, nodes)) : Nat}:
  %Equal.sym(Nat, List.length(&2, U32, Spec.targets(ws, verify)), List.length(&2, Nat, ws), len_targets(ws, verify)) : {1n+_ == 1n+List.length(&2, U32, Spec.proposals(ws, nodes)) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, Spec.proposals(ws, nodes)), List.length(&2, Nat, ws), len_proposals(ws, nodes)) : {1n+List.length(&2, Nat, ws) == 1n+_ : Nat}
  {==}

def left(-P: Type, -Q: Type, pq: P & Q) -> P:
  (a, b) = pq
  a

