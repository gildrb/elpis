# Proofs of the path laws of bend/exl3_tree_accept_laws.bend (L3 path_matches,
# committed_rows; L4 maximal). The walk is followed row by row: at each row the
# lowest extending row is found by a case split on the seven hit tests, rows at
# or above the current one are refuted by the legality premise, and the fuel
# premise shows the walk is never cut short. Generated by the S4 harness
# (gen_path_proof.py). No axioms, holes or foreign proof code.
import Base
import ./exl3_tree_accept.bend as Impl
import ./exl3_tree_accept_spec.bend as Spec
import ./exl3_tree_accept_laws.bend as Laws
import ./exl3_accept_spec.bend as ChainSpec
import ./exl3_accept_laws.bend as ChainLaws
import ./exl3_accept_proof.bend as ChainProof

# ---------------------------------------------------------------- Bool and Nat facts

def and_l(+a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, ChainProof.false_true(h))

def and_r(+a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      Empty.absurd({b == True{} : Bool}, ChainProof.false_true(h))

def and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool})
  -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def clash(-a: Bool, e: {a == True{} : Bool}, n: {a == False{} : Bool}) -> Empty:
  ChainProof.false_true(Equal.trans(Bool, False{}, a, True{}, Equal.sym(Bool, a, False{}, n), e))

def or_t_r(+a: Bool) -> {Bool.or(a, True{}) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def nat_refl(+n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      nat_refl(m)

def add_zero(+n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %add_zero(m) : {1n+Nat.add(m, 0n) == 1n+_ : Nat}
      {==}

def add_succ(+n: Nat, +k: Nat) -> {Nat.add(n, 1n+k) == 1n+Nat.add(n, k) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %add_succ(m, k) : {1n+Nat.add(m, 1n+k) == 1n+_ : Nat}
      {==}

def le_down(+k: Nat, +f: Nat, h: {Nat.is_le(1n+k, f) == True{} : Bool}) -> {Nat.is_le(k, f) == True{} : Bool}:
  match k:
    case 0n:
      match f:
        case 0n:
          {==}
        case 1n+g:
          {==}
    case 1n+j:
      match f:
        case 0n:
          Empty.absurd({Nat.is_le(1n+j, 0n) == True{} : Bool}, ChainProof.false_true(h))
        case 1n+g:
          le_down(j, g, h)

# No-matching-row: seven failed hit tests make none_extends true.
def nf7(+a1: Bool, +a2: Bool, +a3: Bool, +a4: Bool, +a5: Bool, +a6: Bool, +a7: Bool,
    e1: {a1 == False{} : Bool}, e2: {a2 == False{} : Bool}, e3: {a3 == False{} : Bool},
    e4: {a4 == False{} : Bool}, e5: {a5 == False{} : Bool}, e6: {a6 == False{} : Bool},
    e7: {a7 == False{} : Bool})
  -> {Bool.and(Bool.not(a1), Bool.and(Bool.not(a2), Bool.and(Bool.not(a3), Bool.and(Bool.not(a4),
      Bool.and(Bool.not(a5), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}:
  match a1:
    case True{}:
      Empty.absurd({Bool.and(Bool.not(True{}), Bool.and(Bool.not(a2), Bool.and(Bool.not(a3), Bool.and(Bool.not(a4), Bool.and(Bool.not(a5), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e1)))
    case False{}:
      match a2:
        case True{}:
          Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), Bool.and(Bool.not(a3), Bool.and(Bool.not(a4), Bool.and(Bool.not(a5), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e2)))
        case False{}:
          match a3:
            case True{}:
              Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), Bool.and(Bool.not(a4), Bool.and(Bool.not(a5), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e3)))
            case False{}:
              match a4:
                case True{}:
                  Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), Bool.and(Bool.not(a5), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e4)))
                case False{}:
                  match a5:
                    case True{}:
                      Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), Bool.and(Bool.not(a6), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e5)))
                    case False{}:
                      match a6:
                        case True{}:
                          Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), Bool.and(Bool.not(a7), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e6)))
                        case False{}:
                          match a7:
                            case True{}:
                              Empty.absurd({Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(False{}), Bool.and(Bool.not(True{}), True{}))))))) == True{} : Bool}, ChainProof.false_true(Equal.sym(Bool, True{}, False{}, e7)))
                            case False{}:
                              {==}

