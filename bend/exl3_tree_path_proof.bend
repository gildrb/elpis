def G(v: ChainSpec.Verdict, +cp: Nat, +x: Nat) -> Type:
  {Bool.or(ChainSpec.eos(v), Bool.or(Nat.is_eq(ChainSpec.count(v), cp), Nat.is_eq(ChainSpec.count(v), x))) == True{} : Bool}

# The last position of a path: stop / exhausted (eos) or final (count = end).
def dlast(+s: Bool, +e: Bool, +k: Nat, +cp: Nat)
  -> G(ChainSpec.decide([ChainSpec.Facts{s, e, True{}, False{}}], k), cp, Nat.add(1n, k)):
  match s:
    case True{}:
      {==}
    case False{}:
      match e:
        case True{}:
          {==}
        case False{}:
          %Equal.sym(Bool, Nat.is_eq(1n+k, 1n+k), True{}, nat_refl(1n+k)) : {Bool.or(False{}, Bool.or(Nat.is_eq(1n+k, cp), _)) == True{} : Bool}
          or_t_r(Nat.is_eq(1n+k, cp))

# A position before the end: rejects only at the checkpoint (the proposal
# matches), so the round ends here with eos or at the checkpoint, or goes on.
def dstep(+s: Bool, +e: Bool, +r: Bool, +k: Nat, +cp: Nat, +x: Nat, -rest: List<&2, ChainSpec.Facts>,
    hr: {Nat.is_eq(1n+k, cp) == r : Bool}, ih: G(ChainSpec.decide(rest, 1n+k), cp, x))
  -> G(ChainSpec.decide(ChainSpec.Facts{s, e, False{}, r} <> rest, k), cp, x):
  match s:
    case True{}:
      {==}
    case False{}:
      match e:
        case True{}:
          {==}
        case False{}:
          match r:
            case True{}:
              %Equal.sym(Bool, Nat.is_eq(1n+k, cp), True{}, hr) : {Bool.or(False{}, Bool.or(_, Nat.is_eq(1n+k, x))) == True{} : Bool}
              {==}
            case False{}:
              ih

def tok_match(+nodes: List<&2, Spec.Node>, +verify: List<&2, U32>, +cur: Nat, +c: Nat,
    h: {Spec.extends(nodes, verify, cur, c) == True{} : Bool})
  -> {U32.is_eq(Spec.token_at(nodes, 1n, c), Spec.id_at(verify, cur)) == True{} : Bool}:
  and_r(Nat.is_eq(Spec.parent_at(nodes, 1n, c), cur), U32.is_eq(Spec.token_at(nodes, 1n, c), Spec.id_at(verify, cur)),
    and_r(Bool.and(Nat.is_le(1n, c), Nat.is_le(c, List.length(&2, Spec.Node, nodes))),
      Spec.hit(Spec.parent_at(nodes, 1n, c), Spec.token_at(nodes, 1n, c), cur, Spec.id_at(verify, cur)), h))

# The chain verdict on a matching path from row cur (committed k before it).
def D(+ws: List<&2, Nat>, +nodes: List<&2, Spec.Node>, +verify: List<&2, U32>, +cur: Nat,
    +stops: List<&2, U32>, +budget: Nat, +cp: Nat, +k: Nat, +h: {Spec.pext(ws, nodes, verify, cur) == True{} : Bool})
  -> G(ChainSpec.decide(ChainSpec.facts(Spec.id_at(verify, cur) <> Spec.targets(ws, verify),
      Spec.proposals(ws, nodes), stops, k, budget, cp), k), cp, Nat.add(1n+List.length(&2, Nat, ws), k)):
  match ws:
    case Nil{}:
      dlast(ChainSpec.member(stops, Spec.id_at(verify, cur)), Nat.is_ge(1n+k, budget), k, cp)
    case +c <> rest:
      hx = tok_match(nodes, verify, cur, c, and_l(Spec.extends(nodes, verify, cur, c), Spec.pext(rest, nodes, verify, c), h))
      ih = D(rest, nodes, verify, c, stops, budget, cp, 1n+k, and_r(Spec.extends(nodes, verify, cur, c), Spec.pext(rest, nodes, verify, c), h))
      +rest_f = ChainSpec.facts(Spec.id_at(verify, c) <> Spec.targets(rest, verify), Spec.proposals(rest, nodes), stops, 1n+k, budget, cp)
      %Equal.sym(Bool, U32.is_eq(Spec.token_at(nodes, 1n, c), Spec.id_at(verify, cur)), True{}, hx) : G(ChainSpec.decide(ChainSpec.Facts{ChainSpec.member(stops, Spec.id_at(verify, cur)), Nat.is_ge(1n+k, budget), False{}, Bool.or(Bool.not(_), Nat.is_eq(1n+k, cp))} <> rest_f, k), cp, Nat.add(1n+(1n+List.length(&2, Nat, rest)), k))
      %add_succ(1n+List.length(&2, Nat, rest), k) : G(ChainSpec.decide(ChainSpec.Facts{ChainSpec.member(stops, Spec.id_at(verify, cur)), Nat.is_ge(1n+k, budget), False{}, Nat.is_eq(1n+k, cp)} <> rest_f, k), cp, _)
      dstep(ChainSpec.member(stops, Spec.id_at(verify, cur)), Nat.is_ge(1n+k, budget), Nat.is_eq(1n+k, cp), k, cp,
        Nat.add(1n+List.length(&2, Nat, rest), 1n+k), rest_f, {==}, ih)

